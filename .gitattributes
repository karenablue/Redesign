# Normalize line endings: text files stored as LF in the repo, checked out
# LF on every platform. Prevents the whole-file CRLF/LF diffs that showed up
# when core.autocrlf=true met files committed with CRLF.
* text=auto eol=lf

# Binary assets — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.mp4 binary
