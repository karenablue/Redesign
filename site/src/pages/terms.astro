---
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/url.js";

const updated = "September 9, 2026";

const sections = [
  {
    id: "acceptance",
    title: "Acceptance of These Terms",
    body: [
      "By accessing or using this website, you agree to these Terms of Use. If you do not agree, please do not use the site.",
    ],
  },
  {
    id: "use-of-site",
    title: "Permitted Use",
    body: [
      "You may use the site for lawful, personal, and informational purposes. You agree not to disrupt the site, attempt to gain unauthorized access to any system, scrape content at scale, or use it to transmit unlawful or harmful material.",
    ],
  },
  {
    id: "intellectual-property",
    title: "Intellectual Property",
    body: [
      'The Sigma Gamma Rho name, letters, crest, coat of arms, seal, and the marks "Greater Service, Greater Progress" and "Poodle" are the property of Sigma Gamma Rho Sorority, Incorporated and are protected by trademark and other laws.',
      "Site content — text, graphics, logos, and images — is owned by or licensed to the Sorority and may not be reproduced or distributed without written permission, except as permitted by the Sorority's branding guidelines for members.",
    ],
  },
  {
    id: "member-accounts",
    title: "Member Accounts & Portal",
    body: [
      "Access to member-only systems, including the Poodle Portal, is governed by separate credentials and policies. You are responsible for keeping your login information confidential and for activity under your account.",
    ],
  },
  {
    id: "third-party-links",
    title: "Third-Party Links",
    body: [
      "The site links to websites operated by chapters, partners, and vendors. We are not responsible for the content, policies, or practices of those sites.",
    ],
  },
  {
    id: "disclaimer",
    title: "Disclaimer",
    body: [
      'The site is provided "as is" and "as available." To the fullest extent permitted by law, the Sorority disclaims all warranties, express or implied, and is not liable for any indirect or consequential damages arising from your use of the site.',
    ],
  },
  {
    id: "changes",
    title: "Changes to These Terms",
    body: [
      "We may revise these Terms of Use at any time. Continued use of the site after changes are posted constitutes acceptance of the revised terms.",
    ],
  },
  {
    id: "governing-law",
    title: "Governing Law",
    body: [
      "These terms are governed by the laws of the State of North Carolina, without regard to its conflict-of-law rules.",
    ],
  },
];
---

<Base
  title="Terms of Use"
  description="The terms governing use of the Sigma Gamma Rho Sorority, Incorporated national website."
>
  <section class="legal-hero">
    <div class="container container--narrow">
      <p class="breadcrumb">
        <a href={withBase("/")}>Home</a> <span aria-hidden="true">/</span>
        <span>Terms of Use</span>
      </p>
      <p class="eyebrow">Legal</p>
      <h1>Terms of Use</h1>
      <p class="legal-hero__updated">Last updated {updated}</p>
    </div>
  </section>

  <section class="legal-body">
    <div class="container container--narrow">
      <p class="legal-note" role="note">
        This is a working draft for the site rebuild and is pending review by the Sorority's legal
        counsel. It is not yet an official policy of Sigma Gamma Rho Sorority, Incorporated.
      </p>

      <p class="legal-intro">
        These Terms of Use govern your access to and use of the Sigma Gamma Rho Sorority,
        Incorporated website. Please read them carefully.
      </p>

      <ol class="legal-toc" aria-label="Sections">
        {sections.map((s) => (
          <li>
            <a href={`#${s.id}`}>{s.title}</a>
          </li>
        ))}
      </ol>

      {sections.map((s) => (
        <section class="legal-section" id={s.id}>
          <h2>{s.title}</h2>
          {s.body.map((p) => (
            <p>{p}</p>
          ))}
        </section>
      ))}

      <section class="legal-section" id="contact">
        <h2>Contact Us</h2>
        <p>
          Questions about these terms can go to International Corporate Headquarters at{" "}
          <a href="mailto:help@sgrho1922.org">help@sgrho1922.org</a>, or through the{" "}
          <a href={withBase("/contact/")}>contact page</a>.
        </p>
      </section>
    </div>
  </section>
</Base>

<style>
  .legal-hero {
    background: var(--cream);
    padding-block: clamp(3rem, 6vw, 4rem);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    color: var(--muted-2);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .breadcrumb a {
    color: inherit;
  }
  .legal-hero h1 {
    margin: var(--space-2) 0 0;
  }
  .legal-hero__updated {
    margin: var(--space-3) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .legal-body {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .legal-note {
    padding: var(--space-4) var(--space-5);
    margin: 0 0 var(--space-8);
    background: var(--tint);
    border-left: 3px solid var(--gold);
    border-radius: var(--radius);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .legal-intro {
    color: var(--muted);
  }

  .legal-toc {
    margin: var(--space-8) 0 var(--space-12);
    padding-left: 1.2rem;
    display: grid;
    gap: var(--space-2);
    color: var(--royal);
  }
  .legal-toc a {
    color: inherit;
    font-weight: 700;
    text-decoration: none;
  }
  .legal-toc a:hover {
    color: var(--gold-dark);
  }

  .legal-section {
    scroll-margin-top: 100px;
    margin-top: var(--space-10);
  }
  .legal-section h2 {
    font-size: var(--text-h3);
    margin: 0 0 var(--space-4);
  }
  .legal-section p {
    color: var(--muted);
  }
  .legal-section a {
    color: var(--royal-dark);
    font-weight: 700;
  }
</style>
