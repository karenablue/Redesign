---
import Base from "../layouts/Base.astro";
import LegalDoc from "../components/LegalDoc.astro";

const updated = "September 2026";

const intro = [
  "These Terms of Use govern your access to and use of the Sigma Gamma Rho Sorority, Incorporated website. Please read them carefully.",
];

const sections = [
  {
    id: "acceptance",
    title: "1. Acceptance of These Terms",
    blocks: [
      {
        p: "By accessing or using this website, you agree to these Terms of Use. If you do not agree, please do not use the site.",
      },
    ],
  },
  {
    id: "permitted-use",
    title: "2. Permitted Use",
    blocks: [
      {
        p: "You may use the site for lawful, personal, and informational purposes. You agree not to disrupt the site, attempt to gain unauthorized access to any system, scrape content at scale, or use it to transmit unlawful or harmful material.",
      },
    ],
  },
  {
    id: "intellectual-property",
    title: "3. Intellectual Property",
    blocks: [
      {
        p: 'The Sigma Gamma Rho name, letters, crest, coat of arms, seal, and the marks "Greater Service, Greater Progress" and "Poodle" are the property of Sigma Gamma Rho Sorority, Incorporated and are protected by trademark and other laws.',
      },
      {
        p: "Site content — text, graphics, logos, and images — is owned by or licensed to the Sorority and may not be reproduced or distributed without written permission, except as permitted by the Sorority's branding guidelines for members.",
      },
    ],
  },
  {
    id: "member-accounts",
    title: "4. Member Accounts & Portal",
    blocks: [
      {
        p: "Access to member-only systems, including the Member Portal, is governed by separate credentials and policies. You are responsible for keeping your login information confidential and for activity under your account.",
      },
    ],
  },
  {
    id: "third-party-links",
    title: "5. Third-Party Links",
    blocks: [
      {
        p: "The site links to websites operated by chapters, partners, and vendors. We are not responsible for the content, policies, or practices of those sites.",
      },
    ],
  },
  {
    id: "disclaimer",
    title: "6. Disclaimer",
    blocks: [
      {
        p: 'The site is provided "as is" and "as available." To the fullest extent permitted by law, the Sorority disclaims all warranties, express or implied, and is not liable for any indirect or consequential damages arising from your use of the site.',
      },
    ],
  },
  {
    id: "changes",
    title: "7. Changes to These Terms",
    blocks: [
      {
        p: "We may revise these Terms of Use at any time. Continued use of the site after changes are posted constitutes acceptance of the revised terms.",
      },
    ],
  },
  {
    id: "governing-law",
    title: "8. Governing Law",
    blocks: [
      {
        p: "These terms are governed by the laws of the State of North Carolina, without regard to its conflict-of-law rules.",
      },
    ],
  },
  {
    id: "contact",
    title: "9. Contact Us",
    blocks: [
      { p: "Questions about these terms can be directed to International Corporate Headquarters:" },
      {
        address: [
          "Sigma Gamma Rho Sorority, Inc.",
          "International Headquarters — Legal Department",
          "P.O. Box 27688",
          "Raleigh, North Carolina 27611",
        ],
      },
    ],
  },
];
---

<Base
  title="Terms of Use"
  description="The terms governing use of the Sigma Gamma Rho Sorority, Incorporated national website."
>
  <LegalDoc
    title="Terms of Use"
    updated={updated}
    draftNote="This is a working draft for the site rebuild and is pending review by the Sorority's legal counsel. It is not yet an official policy of Sigma Gamma Rho Sorority, Incorporated."
    intro={intro}
    sections={sections}
  />
</Base>
