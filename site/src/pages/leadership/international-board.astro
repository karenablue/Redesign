---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../lib/url.js";

// Officers are markdown in src/content/board/ so HQ can update the board
// after each Boule without editing this page. Frontmatter only: every
// field is structured, so there is no markdown body to render.
const board = (await getCollection("board"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => entry.data);

/**
 * Officer tiers, derived from the data so a new board sorts itself:
 * the chair (the `featured` entry, i.e. the International Grand Basileus),
 * then the Grand Anti-Basilei, then every other officer.
 */
const chair = board.find((b) => b.featured) ?? board[0];
const deputies = board.filter((b) => b !== chair && /Anti-Basileus/.test(b.role));
const officers = board.filter((b) => b !== chair && !deputies.includes(b));
---

<Base
  title="International Board of Directors"
  activeTop="About Us"
  description="Sigma Gamma Rho's 2026–2028 International Board of Directors."
>
  <Hero
    eyebrow="2026–2028 Administration"
    title="International Board"
    highlight="of Directors"
    copy="Our International Board of Directors provides strategic leadership to uphold the legacy of our seven illustrious founders and the thousands of celebrated women before us as we seek to further instill Sigma Gamma Rho's core values across the globe."
  />

  <section class="ibd-intro">
    <div class="container ibd-intro__grid">
      <div>
        <p class="eyebrow">Board Composition</p>
        <h2>
          One Collaborative <span>Governing Body.</span>
        </h2>
      </div>
      <div class="ibd-intro__copy">
        <p>
          Chaired by the International Grand Basileus, our collaborative Board consists of the
          National Officers, Founders, and the Regional Syntaktes, Undergraduate Chapter
          Coordinator, and Youth Services Coordinator of each region.
        </p>
        <p>
          Past Grand Basilei serve on the board in an honorary capacity, connecting the Board's
          present-day decisions to the Sorority's full history of leadership.
        </p>
      </div>
    </div>
  </section>

  <section class="ibd-grid-section">
    <div class="container">
      <div class="ibd-heading">
        <p class="eyebrow">International Board of Directors</p>
        <h2>
          2026&ndash;<span>2028</span>
        </h2>
      </div>
      <h3 class="ibd-tier">Executive Officers</h3>
      <article class="ibd-chair">
        <img
          class="ibd-photo"
          src={withBase(chair.image)}
          alt={chair.name}
          width="300"
          height="300"
        />
        <div class="ibd-chair__body">
          <p class="ibd-role">{chair.role}</p>
          <h4 class="ibd-name ibd-name--lg">{chair.name}</h4>
          {chair.note && <p class="ibd-note">{chair.note}</p>}
          <a class="ibd-more" href={withBase("/leadership/international-grand-basileus/")}>
            Meet the Grand Basileus <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </article>

      {deputies.length > 0 && (
        <ul class="ibd-grid ibd-grid--deputies">
          {deputies.map((b) => (
            <li class="ibd-card">
              <img class="ibd-photo" src={withBase(b.image)} alt={b.name} width="300" height="300" loading="lazy" />
              <p class="ibd-role">{b.role}</p>
              <h4 class="ibd-name">{b.name}</h4>
              {b.note && <p class="ibd-note">{b.note}</p>}
            </li>
          ))}
        </ul>
      )}

      <h3 class="ibd-tier">National Officers</h3>
      <ul class="ibd-grid">
        {officers.map((b) => (
          <li class="ibd-card">
            <img class="ibd-photo" src={withBase(b.image)} alt={b.name} width="300" height="300" loading="lazy" />
            <p class="ibd-role">{b.role}</p>
            <h4 class="ibd-name">{b.name}</h4>
            {b.note && <p class="ibd-note">{b.note}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand
    eyebrow="Regional Representation"
    title="Each Region Sends "
    highlight="Its Own Voice."
    copy="The Regional Syntaktes, Undergraduate Chapter Coordinator, and Youth Services Coordinator of every region also serve on the Board."
    actions={[{ label: "Meet Regional Leadership", href: "/leadership/regional-leadership/" }]}
  />
</Base>

<style>
  .ibd-intro {
    background: var(--cream);
    padding-block: clamp(3rem, 5vw, 4rem);
  }
  .ibd-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-12);
    align-items: start;
  }
  .ibd-intro__grid h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .ibd-intro__grid h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .ibd-intro__copy p {
    color: var(--muted);
  }
  @media (max-width: 780px) {
    .ibd-intro__grid {
      grid-template-columns: 1fr;
    }
  }

  .ibd-grid-section {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .ibd-heading {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto var(--space-10);
  }
  .ibd-heading h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .ibd-heading h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  /* Tier label as a divider: the label, then a hairline. */
  .ibd-tier {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: var(--space-12) 0 var(--space-6);
    color: var(--royal);
    font-family: var(--font-head);
    font-weight: 400;
    font-size: var(--text-lg);
    letter-spacing: 0.02em;
  }
  .ibd-tier:first-of-type {
    margin-top: 0;
  }
  .ibd-tier::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  /* One photo treatment for every officer: square, top-anchored, the same
     hairline frame, so varied source photography reads as one set. */
  .ibd-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: 50% 20%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  /* The chair: a single wide card, photo beside the text. */
  .ibd-chair {
    display: grid;
    grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
    max-width: 760px;
    margin: 0 auto;
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
  }
  .ibd-more {
    display: inline-block;
    margin-top: var(--space-4);
    padding-block: var(--space-2);
    color: var(--royal);
    font-weight: 700;
    text-decoration: none;
  }
  .ibd-more:hover {
    color: var(--accent-hover);
    text-decoration-line: underline;
    text-decoration-color: var(--gold);
  }

  /* Flex with centred wrapping, so any short last row is centred. */
  .ibd-grid {
    --ibd-gap: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--ibd-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ibd-grid--deputies {
    max-width: 760px;
    margin: var(--ibd-gap) auto 0;
  }
  .ibd-card {
    flex: 0 1 calc((100% - 2 * var(--ibd-gap)) / 3);
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
  }
  .ibd-grid--deputies .ibd-card {
    flex-basis: calc((100% - var(--ibd-gap)) / 2);
  }
  .ibd-card .ibd-photo {
    margin-bottom: var(--space-4);
  }
  .ibd-role {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .ibd-name {
    margin: var(--space-1) 0 0;
    color: var(--royal);
    font-size: var(--text-md);
    line-height: 1.35;
  }
  .ibd-name--lg {
    font-size: var(--text-h3);
  }
  .ibd-note {
    margin: var(--space-2) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  @media (max-width: 860px) {
    .ibd-card {
      flex-basis: calc((100% - var(--ibd-gap)) / 2);
    }
  }
  @media (max-width: 560px) {
    .ibd-chair {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .ibd-chair .ibd-photo {
      max-width: 240px;
      margin-inline: auto;
    }
    .ibd-grid,
    .ibd-grid--deputies {
      --ibd-gap: var(--space-4);
    }
    .ibd-card {
      padding: var(--space-3);
    }
  }
</style>
