---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import CardGrid from "../../components/CardGrid.astro";
import Card from "../../components/Card.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getCollection } from "astro:content";

// Officers are markdown in src/content/board/ so HQ can update the board
// after each Boule without editing this page. Frontmatter only: every
// field is structured, so there is no markdown body to render.
const board = (await getCollection("board"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => entry.data);
---

<Base
  title="International Board of Directors"
  activeTop="Leadership"
  description="Sigma Gamma Rho's 2026–2028 International Board of Directors."
>
  <Hero
    eyebrow="2026–2028 Administration"
    title="International Board"
    highlight="of Directors"
    copy="Our International Board of Directors provides strategic leadership to uphold the legacy of our seven illustrious founders and the thousands of celebrated women before us as we seek to further instill Sigma Gamma Rho's core values across the globe."
  />

  <section class="ibd-intro">
    <div class="container ibd-intro__grid">
      <div>
        <p class="eyebrow">Board Composition</p>
        <h2>
          One Collaborative <span>Governing Body.</span>
        </h2>
      </div>
      <div class="ibd-intro__copy">
        <p>
          Chaired by the International Grand Basileus, our collaborative Board consists of the
          National Officers, Founders, and the Regional Syntaktes, Undergraduate Chapter
          Coordinator, and Youth Services Coordinator of each region.
        </p>
        <p>
          Past Grand Basilei serve on the board in an honorary capacity, connecting the Board's
          present-day decisions to the Sorority's full history of leadership.
        </p>
      </div>
    </div>
  </section>

  <section class="ibd-grid-section">
    <div class="container">
      <div class="ibd-heading">
        <p class="eyebrow">International Board of Directors</p>
        <h2>
          2026&ndash;<span>2028</span>
        </h2>
      </div>
      <CardGrid min="240px" cols={3}>
        {board.map((b) => (
          <Card image={b.image} imageAlt={b.name} title={b.name}>
            <p class="ibd-role">{b.role}</p>
            {b.note && <p class="ibd-note">{b.note}</p>}
          </Card>
        ))}
      </CardGrid>
    </div>
  </section>

  <CtaBand
    eyebrow="Regional Representation"
    title="Each Region Sends "
    highlight="Its Own Voice."
    copy="The Regional Syntaktes, Undergraduate Chapter Coordinator, and Youth Services Coordinator of every region also serve on the Board."
    actions={[{ label: "Meet Regional Leadership", href: "/leadership/regional-leadership/" }]}
  />
</Base>

<style>
  .ibd-intro {
    background: var(--cream);
    padding-block: clamp(3rem, 5vw, 4rem);
  }
  .ibd-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-12);
    align-items: start;
  }
  .ibd-intro__grid h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .ibd-intro__grid h2 span {
    color: var(--gold-text);
  }
  .ibd-intro__copy p {
    color: var(--muted);
  }
  @media (max-width: 780px) {
    .ibd-intro__grid {
      grid-template-columns: 1fr;
    }
  }

  .ibd-grid-section {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .ibd-heading {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto var(--space-10);
  }
  .ibd-heading h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .ibd-heading h2 span {
    color: var(--gold-text);
  }
  .ibd-role {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold-text);
    margin: 0;
  }
  .ibd-note {
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>
