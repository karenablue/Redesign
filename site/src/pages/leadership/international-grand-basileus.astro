---
/**
 * International Grand Basileus — ported from the original
 * leadership/international-grand-basileus/grandbasileus.html.
 *
 * Treatment: the hero sets the portrait beside the name. Then jump links, a
 * bio (summary + milestones drawn only from the published text), four
 * outlined highlight cards, the education and leadership profile with its
 * XXVI marker beside the headline, and a two-link leadership nav.
 */
import Base from "../../layouts/Base.astro";
import SigmaRule from "../../components/SigmaRule.astro";
import Section from "../../components/Section.astro";
import { withBase } from "../../lib/url.js";

const ledger = [
  {
    title: "Membership",
    body: "Advanced Recruitment, Retention, and Reclamation initiatives at the international level.",
  },
  {
    title: "Global Growth",
    body: "Supported expansion of Sigma Gamma Rho's global presence, including Ghana, Belize, and Tokyo.",
  },
  {
    title: "Administration",
    body: "Brings more than 25 years of nonprofit-sector experience in operations, talent, team leadership, and fiscal oversight.",
  },
  {
    title: "Governance",
    body: "Serves as International President and Chair of the Board of Directors.",
  },
];

/** Every milestone restates a sentence already in the published bio. */
const milestones = [
  "Elected 26th International Grand Basileus at the 60th Biennial Boul\u00e9",
  "Life member of Sigma Gamma Rho Sorority, Inc.",
  "Assistant Director and Regional Director, Northeastern Region",
  "International Vice-President, 2020\u20132024, advancing the R3 initiatives \u2014 Recruitment, Retention, and Reclamation",
  "Led the Associate Engagement Committee and supervised the Membership Services Department in support of International Corporate Headquarters",
  "Helped expand Sigma's global footprint in Ghana, Belize, and Tokyo",
];

const jumps = [
  { href: "#bio", label: "Bio" },
  { href: "#highlights", label: "Highlights" },
  { href: "#experience", label: "Education & Experience" },
];
---

<Base
  title="International Grand Basileus"
  activeTop="About Us"
  description="Marica T. Harris serves as the 26th International Grand Basileus of Sigma Gamma Rho Sorority, Incorporated."
>
  <section class="gb-hero on-dark">
    <div class="container gb-hero__inner">
      <div class="gb-hero__copy">
        <p class="eyebrow">Office of the Grand Basileus</p>
        <h1 class="gb-hero__title">
          Marica T.
          <br />
          <span>Harris</span>
        </h1>
        <p class="gb-hero__title-line">26th International Grand Basileus</p>
        <p class="gb-hero__intro">
          Leading Sigma Gamma Rho into its next century of service with experience spanning
          membership, regional leadership, nonprofit administration, and international growth.
        </p>
      </div>
      <div class="gb-hero__portrait">
        <img
          src={withBase("/images/international-grand-basileus-marica-harris-704x1024.jpg")}
          alt="International Grand Basileus Marica T. Harris"
        />
      </div>
    </div>
  </section>

  <SigmaRule />

  <nav class="gb-jump container" aria-label="On this page">
    {jumps.map((j) => <a href={j.href}>{j.label}</a>)}
  </nav>

  <Section tone="white" id="bio">
    <div class="overview">
      <div class="overview__label">
        <p class="eyebrow">International Leadership</p>
        <h2>
          Experience Built
          <br />
          <span>Across Sigma.</span>
        </h2>
      </div>
      <div class="overview__copy">
        <p class="overview__summary">
          Mrs. Marica T. Harris was elected the 26th International Grand Basileus of Sigma Gamma Rho
          Sorority, Inc., during the 60th Biennial Boulé — a resolute life member poised to guide
          the organization as it embarks on its next century of service.
        </p>
        <h3 class="overview__list-title">Leadership milestones</h3>
        <ul class="milestones">
          {milestones.map((m) => <li>{m}</li>)}
        </ul>
      </div>
    </div>
  </Section>

  <Section tone="cream" pad="tight" id="highlights">
    <h2 class="visually-hidden">Highlights</h2>
    <ul class="ledger">
      {ledger.map((item) => (
        <li class="ledger__item">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="white" id="experience">
    <div class="profile">
      <p class="eyebrow">Education &amp; Professional Experience</p>
      <div class="profile__head">
        <span class="profile__roman" aria-hidden="true">XXVI</span>
        <h2>
          Prepared to Lead <span>Institutionally.</span>
        </h2>
      </div>
      <div class="profile__cols">
        <div>
          <h3>Education &amp; career</h3>
          <p>
            Mrs. Harris has earned several degrees — including a Bachelor of Arts in Psychology, a
            Master of Arts in Counseling, and a Master's in Social Work from prestigious institutions.
            In addition to her educational experience, Mrs. Harris brings over 25 years of
            professional expertise working in the non-profit sector as a senior administrator,
            leading teams, program operations, talent acquisition, and fiscal oversight.
          </p>
        </div>
        <div>
          <h3>Scope of office</h3>
          <p>
            As International President, Mrs. Harris oversees over 100,000 members and serves as the
            Chairman of the Board of Directors, managing the Sorority's five hundred chapters
            worldwide. Her extensive experience and commitment to service make her an exemplary
            leader as the 26th International Grand Basileus of Sigma Gamma Rho Sorority,
            Incorporated.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <nav class="leadership-nav" aria-label="More leadership pages">
    <a href={withBase("/leadership/international-board/")}>
      <span>Next</span>
      <strong>International Board of Directors</strong>
      <b aria-hidden="true">&rarr;</b>
    </a>
    <a href={withBase("/leadership/regional-leadership/")}>
      <span>Explore</span>
      <strong>Regional Leadership</strong>
      <b aria-hidden="true">&rarr;</b>
    </a>
  </nav>
</Base>

<style>
  /* ---- hero ---- */
  .gb-hero {
    background: var(--grad-royal);
    color: #fff;
  }
  .gb-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.75fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: center;
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }
  .gb-hero__title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 400;
    font-size: var(--text-hero);
    line-height: 1.05;
    color: #fff;
  }
  .gb-hero__title span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  /* The office as a LEMON MILK kicker under the name. */
  .gb-hero__title-line {
    margin: var(--space-6) 0 var(--space-4);
    font-family: var(--font-head);
    font-weight: 400;
    font-size: var(--text-lg);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .gb-hero__intro {
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
  }
  .gb-hero__portrait {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .gb-hero__portrait img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 820px) {
    .gb-hero__inner {
      grid-template-columns: 1fr;
    }
    .gb-hero__portrait {
      max-width: 320px;
      margin-inline: auto;
    }
  }

  /* ---- jump links (not sticky: the site header is already pinned) ---- */
  .gb-jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: var(--space-8);
  }
  .gb-jump a {
    padding: 0.5rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--royal);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
  }
  .gb-jump a:hover {
    border-color: var(--royal);
    background: var(--tint);
  }
  :global(#bio),
  :global(#highlights),
  :global(#experience) {
    scroll-margin-top: 72px;
  }

  /* ---- overview ---- */
  .overview {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-16);
    align-items: start;
  }
  .overview__label h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .overview__label h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  /* Executive summary: a lead paragraph set off by a gold rule. Not a
     quotation — there is no published quote to attribute. */
  .overview__summary {
    margin: 0;
    padding-left: var(--space-5);
    border-left: 3px solid var(--gold);
    color: var(--ink);
    font-size: var(--text-lg);
    line-height: 1.6;
  }
  .overview__list-title {
    margin: var(--space-8) 0 var(--space-3);
    color: var(--royal);
    font-size: var(--text-md);
  }
  .milestones {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }
  .milestones li {
    position: relative;
    padding-left: var(--space-6);
    color: var(--muted);
    line-height: 1.6;
  }
  .milestones li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--gold);
  }
  @media (max-width: 820px) {
    .overview {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  /* ---- highlights: outlined cards, no numbers ---- */
  .ledger {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ledger__item {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
  }
  .ledger__item h3 {
    margin: 0 0 var(--space-2);
    color: var(--royal);
    font-size: var(--text-md);
  }
  .ledger__item p {
    color: var(--muted);
    margin: 0;
  }

  /* ---- profile ---- */
  .profile__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-2);
  }
  /* XXVI sits beside the headline it belongs to, not in its own column. */
  .profile__roman {
    flex: none;
    padding-right: var(--space-6);
    border-right: 1px solid var(--line);
    font-family: var(--font-label);
    font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3rem);
    line-height: 1;
    color: var(--accent-text);
  }
  .profile__head h2 {
    flex: 1 1 14rem;
    min-width: 0;
    margin: 0;
    font-size: var(--text-h3);
  }
  .profile__head h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .profile__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-12);
    margin-top: var(--space-8);
  }
  .profile__cols h3 {
    margin: 0 0 var(--space-2);
    color: var(--royal);
    font-size: var(--text-md);
  }
  .profile__cols p {
    margin: 0;
    color: var(--muted);
  }
  /* On narrow phones the numeral takes its own line above the headline. */
  @media (max-width: 480px) {
    .profile__roman {
      padding-right: 0;
      border-right: 0;
    }
    .profile__head h2 {
      flex-basis: 100%;
      font-size: clamp(1.35rem, 5.6vw, 1.5rem);
    }
  }
  @media (max-width: 820px) {
    .profile__cols {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  /* ---- leadership nav ---- */
  .leadership-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    border-top: 1px solid var(--line);
  }
  .leadership-nav a {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: clamp(2rem, 4vw, 2.75rem) clamp(1.5rem, 4vw, 3rem);
    text-decoration: none;
    border-right: 1px solid var(--line);
  }
  .leadership-nav a:last-child {
    border-right: 0;
  }
  .leadership-nav a:hover {
    background: var(--tint);
  }
  .leadership-nav span {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .leadership-nav strong {
    font-size: var(--text-lg);
    color: var(--royal);
  }
  .leadership-nav b {
    color: var(--accent-text);
    font-size: var(--text-lg);
  }
</style>
