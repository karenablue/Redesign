---
/**
 * International Grand Basileus — ported from the original
 * leadership/international-grand-basileus/grandbasileus.html.
 *
 * Treatment: the hero integrates the portrait directly (side-by-side with a
 * large Roman-numeral-style "26" badge on the photo) rather than a plain
 * text-only hero with the photo further down the page. Followed by a Σ
 * divider, a two-column tenure overview, a four-item numbered ledger, an
 * education/professional profile section, and a two-link leadership nav.
 */
import Base from "../../layouts/Base.astro";
import SigmaRule from "../../components/SigmaRule.astro";
import Section from "../../components/Section.astro";
import { withBase } from "../../lib/url.js";

const ledger = [
  {
    n: "01",
    title: "Membership",
    body: "Advanced Recruitment, Retention, and Reclamation initiatives at the international level.",
  },
  {
    n: "02",
    title: "Global Growth",
    body: "Supported expansion of Sigma Gamma Rho's global presence, including Ghana, Belize, and Tokyo.",
  },
  {
    n: "03",
    title: "Administration",
    body: "Brings more than 25 years of nonprofit-sector experience in operations, talent, team leadership, and fiscal oversight.",
  },
  {
    n: "04",
    title: "Governance",
    body: "Serves as International President and Chair of the Board of Directors.",
  },
];
---

<Base
  title="International Grand Basileus"
  activeTop="Leadership"
  description="Marica T. Harris serves as the 26th International Grand Basileus of Sigma Gamma Rho Sorority, Incorporated."
>
  <section class="gb-hero">
    <div class="container gb-hero__inner">
      <div class="gb-hero__copy">
        <p class="eyebrow">Office of the Grand Basileus</p>
        <h1 class="gb-hero__title">
          Marica T.
          <br />
          <span>Harris</span>
        </h1>
        <div class="gold-rule"></div>
        <p class="gb-hero__title-line">26th International Grand Basileus</p>
        <p class="gb-hero__intro">
          Leading Sigma Gamma Rho into its next century of service with experience spanning
          membership, regional leadership, nonprofit administration, and international growth.
        </p>
      </div>
      <div class="gb-hero__portrait">
        <span class="gb-hero__number" aria-hidden="true">
          26
        </span>
        <img
          src={withBase("/images/international-grand-basileus-marica-harris-704x1024.jpg")}
          alt="International Grand Basileus Marica T. Harris"
        />
      </div>
    </div>
  </section>

  <SigmaRule />

  <Section tone="white">
    <div class="overview">
      <div class="overview__label">
        <p class="eyebrow">International Leadership</p>
        <h2>
          Experience Built
          <br />
          <span>Across Sigma.</span>
        </h2>
      </div>
      <div class="overview__copy">
        <p>
          Mrs. Marica T. Harris was elected the 26th International Grand Basileus of Sigma Gamma Rho
          Sorority, Inc., during the 60th Biennial Boulé. Mrs. Harris, a resolute life member of the
          Sorority, steps into this prestigious role with a wealth of experience and a deep
          commitment to service, poised to guide the organization as it embarks on its next century
          of service.
        </p>
        <p>
          Her tenure within Sigma Gamma Rho has been marked by significant contributions at both the
          regional and international levels. She has led as an Assistant Director and Regional
          Director in the Northeastern Region. Most recently, she served as the International
          Vice-President from 2020 to 2024, where she played a crucial role in advancing the
          Sorority's R3 initiatives — Recruitment, Retention, and Reclamation membership
          initiatives.
        </p>
        <p>
          In addition to driving membership, she was instrumental in supporting International
          Corporate Headquarters, leading the Associate Engagement Committee, and supervising the
          Membership Services Department. Her efforts were instrumental in expanding Sigma's global
          footprint in Ghana, Belize, and Tokyo.
        </p>
      </div>
    </div>
  </Section>

  <Section tone="cream" pad="tight">
    <div class="ledger">
      {ledger.map((item) => (
        <div class="ledger__item">
          <span class="ledger__num">{item.n}</span>
          <strong>{item.title}</strong>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section tone="white">
    <div class="profile">
      <div class="profile__aside">
        <span class="profile__roman">XXVI</span>
        <p>International Grand Basileus</p>
      </div>
      <div class="profile__body">
        <p class="eyebrow">Education &amp; Professional Experience</p>
        <h2>
          Prepared to Lead
          <br />
          <span>Institutionally.</span>
        </h2>
        <p>
          Mrs. Harris has earned several degrees — including a Bachelor of Arts in Psychology, a
          Master of Arts in Counseling, and a Master's in Social Work from prestigious institutions.
          In addition to her educational experience, Mrs. Harris brings over 25 years of
          professional expertise working in the non-profit sector as a senior administrator, leading
          teams, program operations, talent acquisition, and fiscal oversight.
        </p>
        <p>
          As International President, Mrs. Harris oversees over 100,000 members and serves as the
          Chairman of the Board of Directors, managing the Sorority's five hundred chapters
          worldwide. Her extensive experience and commitment to service make her an exemplary leader
          as the 26th International Grand Basileus of Sigma Gamma Rho Sorority, Incorporated.
        </p>
      </div>
    </div>
  </Section>

  <nav class="leadership-nav" aria-label="More leadership pages">
    <a href={withBase("/leadership/international-board/")}>
      <span>Next</span>
      <strong>International Board of Directors</strong>
      <b aria-hidden="true">&rarr;</b>
    </a>
    <a href={withBase("/leadership/regional-leadership/")}>
      <span>Explore</span>
      <strong>Regional Leadership</strong>
      <b aria-hidden="true">&rarr;</b>
    </a>
  </nav>
</Base>

<style>
  /* ---- hero ---- */
  .gb-hero {
    background: var(--grad-royal);
    color: #fff;
  }
  .gb-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.75fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: center;
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }
  .gb-hero__title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 400;
    font-size: var(--text-hero);
    line-height: 1.05;
    color: #fff;
  }
  .gb-hero__title span {
    color: var(--gold);
  }
  .gb-hero__title-line {
    font-weight: 700;
    color: var(--gold-bright);
    margin: 0 0 var(--space-4);
  }
  .gb-hero__intro {
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
  }
  .gb-hero__portrait {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  .gb-hero__portrait img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }
  .gb-hero__number {
    position: absolute;
    top: -0.4em;
    right: 0.3em;
    z-index: 2;
    font-family: var(--font-label);
    font-size: clamp(4rem, 9vw, 6.5rem);
    line-height: 1;
    color: rgba(255, 255, 255, 0.18);
  }
  @media (max-width: 820px) {
    .gb-hero__inner {
      grid-template-columns: 1fr;
    }
    .gb-hero__portrait {
      max-width: 320px;
      margin-inline: auto;
    }
  }

  /* ---- overview ---- */
  .overview {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-16);
    align-items: start;
  }
  .overview__label h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .overview__label h2 span {
    color: var(--gold);
  }
  .overview__copy p {
    color: var(--muted);
  }
  @media (max-width: 820px) {
    .overview {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  /* ---- ledger ---- */
  .ledger {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-8);
  }
  .ledger__item {
    display: flex;
    flex-direction: column;
  }
  .ledger__num {
    font-family: var(--font-label);
    font-size: var(--text-xl);
    color: var(--gold);
    margin-bottom: var(--space-2);
  }
  .ledger__item strong {
    color: var(--royal);
    font-size: var(--text-md);
    margin-bottom: var(--space-2);
  }
  .ledger__item p {
    color: var(--muted);
    margin: 0;
  }

  /* ---- profile ---- */
  .profile {
    display: grid;
    grid-template-columns: minmax(0, 0.35fr) minmax(0, 1fr);
    gap: var(--space-16);
    align-items: start;
  }
  .profile__aside {
    text-align: center;
    border-right: 1px solid var(--line);
    padding-right: var(--space-8);
  }
  .profile__roman {
    display: block;
    font-family: var(--font-label);
    font-size: 3rem;
    color: var(--gold);
    line-height: 1;
  }
  .profile__aside p {
    margin: var(--space-3) 0 0;
    font-weight: 700;
    color: var(--royal);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .profile__body h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .profile__body h2 span {
    color: var(--gold);
  }
  .profile__body p:not(.eyebrow) {
    color: var(--muted);
  }
  @media (max-width: 820px) {
    .profile {
      grid-template-columns: 1fr;
    }
    .profile__aside {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 0 0 var(--space-6);
    }
  }

  /* ---- leadership nav ---- */
  .leadership-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    border-top: 1px solid var(--line);
  }
  .leadership-nav a {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: clamp(2rem, 4vw, 2.75rem) clamp(1.5rem, 4vw, 3rem);
    text-decoration: none;
    border-right: 1px solid var(--line);
  }
  .leadership-nav a:last-child {
    border-right: 0;
  }
  .leadership-nav a:hover {
    background: var(--tint);
  }
  .leadership-nav span {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-dark);
  }
  .leadership-nav strong {
    font-size: var(--text-lg);
    color: var(--royal);
  }
  .leadership-nav b {
    color: var(--gold);
    font-size: var(--text-lg);
  }
</style>
