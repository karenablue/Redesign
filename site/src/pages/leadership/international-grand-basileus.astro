---
/**
 * International Grand Basileus — a single-person profile page.
 *
 * Treatment: no card grid anywhere. The page is dominated by one tall
 * portrait next to a biography, then a navy accomplishments band with a
 * checkmark list, then a pull-quote. This is the template for the other
 * individual-officer pages (Past Grand Basilei entries, board member bios).
 */
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import Section from "../../components/Section.astro";
import CtaBand from "../../components/CtaBand.astro";
import { withBase } from "../../lib/url.js";

const termFacts = [
  { k: "Office", v: "26th International Grand Basileus" },
  { k: "Elected", v: "60th Biennial Boulé" },
  { k: "Also serves as", v: "International President & Chair of the Board" },
];

const accomplishments = [
  "Advanced Recruitment, Retention, and Reclamation initiatives at the international level.",
  "Supported expansion of Sigma Gamma Rho's global presence, including Ghana, Belize, and Tokyo.",
  "Strengthened governance, financial stewardship, and organizational accountability.",
  "Deepened partnerships across health, education, and civic-engagement programming.",
];
---
<Base
  title="International Grand Basileus"
  activeTop="Leadership"
  description="Marica T. Harris serves as the 26th International Grand Basileus of Sigma Gamma Rho Sorority, Incorporated."
>
  <Hero
    variant="plain"
    accent="navy"
    align="center"
    eyebrow="Office of the Grand Basileus"
    title="Marica T. "
    highlight="Harris"
    copy="26th International Grand Basileus of Sigma Gamma Rho Sorority, Incorporated — International President and Chair of the Board of Directors."
  />

  <Section tone="white">
    <div class="profile">
      <figure class="profile__portrait">
        <img src={withBase("/images/international-grand-basileus-marica-harris-704x1024.jpg")} alt="Marica T. Harris, 26th International Grand Basileus" />
      </figure>
      <div class="profile__bio">
        <p class="eyebrow">Prepared to Lead Institutionally</p>
        <h2>Experience Built <span>Over Decades of Service</span></h2>
        <p>Grand Basileus Harris brings a record of chapter, regional, and international leadership to the Sorority's highest elected office. Her focus has been institutional: membership growth, governance, and the long-term capacity of the organization.</p>
        <p>As International President she chairs the Board of Directors and represents Sigma Gamma Rho to members, partners, and the public worldwide.</p>
        <dl class="profile__facts">
          {termFacts.map((f) => (
            <div>
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </Section>

  <Section tone="navy" heading="feature" eyebrow="During This Administration" title="International leadership, in practice">
    <ul class="checklist">
      {accomplishments.map((a) => (
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 13l4 4L19 7" />
          </svg>
          <span>{a}</span>
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="cream" width="narrow">
    <blockquote class="pullquote">
      "We lead an institution that is more than a century old. Our responsibility is to leave it stronger, more accountable, and more capable than we found it."
      <cite>— International Grand Basileus Marica T. Harris</cite>
    </blockquote>
  </Section>

  <CtaBand
    eyebrow="Leadership"
    title="The Board of"
    highlight="Directors"
    copy="Meet the international officers and regional directors who govern Sigma Gamma Rho alongside the Grand Basileus."
    actions={[
      { label: "International Board of Directors", href: "/leadership/international-board/" },
      { label: "Past Grand Basilei", href: "/leadership/past-grand-basilei/", variant: "outline" },
    ]}
  />
</Base>

<style>
  .profile {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }
  .profile__portrait {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    position: sticky;
    top: 120px;
  }
  .profile__portrait img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
  .profile__bio p:not(.eyebrow) { color: var(--muted); }
  .profile__facts {
    margin: var(--space-8) 0 0;
    display: grid;
    gap: var(--space-4);
    border-top: 1px solid var(--line);
    padding-top: var(--space-6);
  }
  .profile__facts div { display: grid; grid-template-columns: 160px 1fr; gap: var(--space-4); }
  .profile__facts dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .profile__facts dd { margin: 0; font-weight: 600; color: var(--ink); }

  .checklist { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-6); max-width: 760px; }
  .checklist li { display: grid; grid-template-columns: 22px 1fr; gap: var(--space-4); align-items: start; }
  .checklist svg { color: var(--gold-bright); margin-top: 2px; }
  .checklist span { color: rgba(255, 255, 255, 0.88); }

  .pullquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--royal);
  }
  .pullquote cite {
    display: block;
    margin-top: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-style: normal;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .profile { grid-template-columns: 1fr; }
    .profile__portrait { position: static; max-width: 420px; }
    .profile__facts div { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>
