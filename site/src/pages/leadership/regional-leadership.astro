---

<Base
  title="Regional Leadership"
  activeTop="Leadership"
  description="Regional leaders connecting international strategy with chapters across Sigma Gamma Rho's five regions."
>
  <section class="rl-hero">
    <div class="container rl-hero__inner">
      <p class="eyebrow">Leadership Across the Sisterhood</p>
      <h1>
        Five Regions.
        <br />
        <span>One Standard.</span>
      </h1>
      <div class="gold-rule"></div>
      <p>
        Regional leaders connect international strategy with chapters, undergraduate leadership,
        members, and communities across Sigma Gamma Rho's geographic structure.
      </p>
      <nav class="rl-jump">
        {regions.map((r) => (
          <a href={`#${r.id}`}>{r.name}</a>
        ))}
      </nav>
    </div>
  </section>

  <SigmaRule />

  {regions.map((r) => (
    <section id={r.id} class:list={["region-block", { "region-block--dark": r.dark }]}>
      <div class="container region-block__inner">
        <div class="region-heading">
          <img class="region-logo" src={withBase(r.logo)} alt={`${r.name} Region logo`} />
          <div>
            <p class="eyebrow">{r.name} Region</p>
            <h2>{r.name}</h2>
            <p class="region-territory">{r.territory}</p>
            <div class="region-socials">
              <a href={r.site} target="_blank" rel="noopener" aria-label="Region website">
                🌐
              </a>
              <a href={r.fb} target="_blank" rel="noopener" aria-label="Region Facebook">
                f
              </a>
              <a href={r.ig} target="_blank" rel="noopener" aria-label="Region Instagram">
                ◎
              </a>
              {r.x && (
                <a href={r.x} target="_blank" rel="noopener" aria-label="Region X (Twitter)">
                  𝕏
                </a>
              )}
            </div>
          </div>
        </div>
        <div class="region-leaders">
          {r.leaders.map((l) => (
            <article class="region-leader">
              <img src={withBase(l.img)} alt={l.name} />
              <p>{l.role}</p>
              <h3>{l.name}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}
</Base>

<style>
  .rl-hero {
    background: var(--grad-royal);
    color: #fff;
  }
  .rl-hero__inner {
    padding-block: clamp(3.5rem, 6vw, 5rem);
    max-width: 46rem;
  }
  .rl-hero h1 {
    color: #fff;
    margin: var(--space-2) 0 0;
  }
  .rl-hero h1 span {
    color: var(--gold);
  }
  .rl-hero > .container > p:not(.eyebrow) {
    color: rgba(255, 255, 255, 0.85);
  }
  .rl-jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-8);
  }
  .rl-jump a {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
  }
  .rl-jump a:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--gold);
  }

  .region-block {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    background: var(--white);
    scroll-margin-top: 90px;
  }
  .region-block--dark {
    background: var(--cream);
  }
  .region-block__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: var(--space-12);
    align-items: start;
  }
  .region-heading {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
  }
  .region-logo {
    width: 64px;
    height: 64px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .region-heading h2 {
    margin: var(--space-1) 0 0;
    font-size: var(--text-h3);
  }
  .region-territory {
    color: var(--muted);
    font-size: var(--text-sm);
    margin: var(--space-3) 0;
  }
  .region-socials {
    display: flex;
    gap: var(--space-2);
  }
  .region-socials a {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--royal);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .region-socials a:hover {
    background: var(--royal);
    color: #fff;
    border-color: var(--royal);
  }

  .region-leaders {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .region-leader {
    text-align: center;
  }
  .region-leader img {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: var(--space-3);
  }
  .region-leader p {
    font-size: var(--text-xs);
    color: var(--muted-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
  }
  .region-leader h3 {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
  }

  @media (max-width: 780px) {
    .region-block__inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .region-leaders {
      grid-template-columns: 1fr;
    }
  }
</style>
