---

<Base
  title="Regional Leadership"
  activeTop="Leadership"
  description="Regional leaders connecting international strategy with chapters across Sigma Gamma Rho's five regions."
>
  <section class="rl-hero on-dark">
    <div class="container rl-hero__inner">
      <p class="eyebrow">Leadership Across the Sisterhood</p>
      <h1>
        Five Regions.
        <br />
        <span>One Standard.</span>
      </h1>
      <div class="gold-rule"></div>
      <p>
        Regional leaders connect international strategy with chapters, undergraduate leadership,
        members, and communities across Sigma Gamma Rho's geographic structure.
      </p>
      <nav class="rl-jump">
        {regions.map((r) => (
          <a href={`#${r.id}`}>{r.name}</a>
        ))}
      </nav>
    </div>
  </section>

  <SigmaRule />

  {regions.map((r) => (
    <section id={r.id} class:list={["region-block", { "region-block--dark": r.dark }]}>
      <div class="container region-block__inner">
        <div class="region-heading">
          <img class="region-logo" src={withBase(r.logo)} alt={`${r.name} Region logo`} loading="lazy" decoding="async" />
          <div>
            <p class="eyebrow">{r.name} Region</p>
            <h2>{r.name}</h2>
            <p class="region-territory">{r.territory}</p>
            <div class="region-socials">
              <a href={r.site} target="_blank" rel="noopener" aria-label="Region website">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z" />
                </svg>
              </a>
              <a href={r.fb} target="_blank" rel="noopener" aria-label="Region Facebook">
                <svg viewBox="0 0 32 32" fill="currentColor">
                  <path d="M16,2c-7.732,0-14,6.268-14,14,0,6.566,4.52,12.075,10.618,13.588v-9.31h-2.887v-4.278h2.887v-1.843c0-4.765,2.156-6.974,6.835-6.974,.887,0,2.417,.174,3.043,.348v3.878c-.33-.035-.904-.052-1.617-.052-2.296,0-3.183,.87-3.183,3.13v1.513h4.573l-.786,4.278h-3.787v9.619c6.932-.837,12.304-6.74,12.304-13.897,0-7.732-6.268-14-14-14Z" />
                </svg>
              </a>
              <a href={r.ig} target="_blank" rel="noopener" aria-label="Region Instagram">
                <svg viewBox="0 0 32 32" fill="currentColor">
                  <path d="M10.202,2.098c-1.49,.07-2.507,.308-3.396,.657-.92,.359-1.7,.84-2.477,1.619-.776,.779-1.254,1.56-1.61,2.481-.345,.891-.578,1.909-.644,3.4-.066,1.49-.08,1.97-.073,5.771s.024,4.278,.096,5.772c.071,1.489,.308,2.506,.657,3.396,.359,.92,.84,1.7,1.619,2.477,.779,.776,1.559,1.253,2.483,1.61,.89,.344,1.909,.579,3.399,.644,1.49,.065,1.97,.08,5.771,.073,3.801-.007,4.279-.024,5.773-.095s2.505-.309,3.395-.657c.92-.36,1.701-.84,2.477-1.62s1.254-1.561,1.609-2.483c.345-.89,.579-1.909,.644-3.398,.065-1.494,.081-1.971,.073-5.773s-.024-4.278-.095-5.771-.308-2.507-.657-3.397c-.36-.92-.84-1.7-1.619-2.477s-1.561-1.254-2.483-1.609c-.891-.345-1.909-.58-3.399-.644s-1.97-.081-5.772-.074-4.278,.024-5.771,.096m.164,25.309c-1.365-.059-2.106-.286-2.6-.476-.654-.252-1.12-.557-1.612-1.044s-.795-.955-1.05-1.608c-.192-.494-.423-1.234-.487-2.599-.069-1.475-.084-1.918-.092-5.656s.006-4.18,.071-5.656c.058-1.364,.286-2.106,.476-2.6,.252-.655,.556-1.12,1.044-1.612s.955-.795,1.608-1.05c.493-.193,1.234-.422,2.598-.487,1.476-.07,1.919-.084,5.656-.092,3.737-.008,4.181,.006,5.658,.071,1.364,.059,2.106,.285,2.599,.476,.654,.252,1.12,.555,1.612,1.044s.795,.954,1.051,1.609c.193,.492,.422,1.232,.486,2.597,.07,1.476,.086,1.919,.093,5.656,.007,3.737-.006,4.181-.071,5.656-.06,1.365-.286,2.106-.476,2.601-.252,.654-.556,1.12-1.045,1.612s-.955,.795-1.608,1.05c-.493,.192-1.234,.422-2.597,.487-1.476,.069-1.919,.084-5.657,.092s-4.18-.007-5.656-.071M21.779,8.517c.002,.928,.755,1.679,1.683,1.677s1.679-.755,1.677-1.683c-.002-.928-.755-1.679-1.683-1.677,0,0,0,0,0,0-.928,.002-1.678,.755-1.677,1.683m-12.967,7.496c.008,3.97,3.232,7.182,7.202,7.174s7.183-3.232,7.176-7.202c-.008-3.97-3.233-7.183-7.203-7.175s-7.182,3.233-7.174,7.203m2.522-.005c-.005-2.577,2.08-4.671,4.658-4.676,2.577-.005,4.671,2.08,4.676,4.658,.005,2.577-2.08,4.671-4.658,4.676-2.577,.005-4.671-2.079-4.676-4.656h0" />
                </svg>
              </a>
              {r.x && (
                <a href={r.x} target="_blank" rel="noopener" aria-label="Region X (Twitter)">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231ZM17.083 19.77h1.833L7.084 4.126H5.117Z" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        </div>
        <div class="region-leaders">
          {r.leaders.map((l) => (
            <article class="region-leader">
              <img src={withBase(l.img)} alt={l.name} loading="lazy" decoding="async" />
              <p>{l.role}</p>
              <h3>{l.name}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}
</Base>

<style>
  .rl-hero {
    background: var(--grad-royal);
    color: #fff;
  }
  .rl-hero__inner {
    padding-block: clamp(3.5rem, 6vw, 5rem);
    max-width: 46rem;
  }
  .rl-hero h1 {
    color: #fff;
    margin: var(--space-2) 0 0;
  }
  .rl-hero h1 span {
    color: var(--gold);
  }
  .rl-hero > .container > p:not(.eyebrow) {
    color: rgba(255, 255, 255, 0.85);
  }
  .rl-jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-8);
  }
  .rl-jump a {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
  }
  .rl-jump a:hover {
    background: rgba(255, 255, 255, 0.12);
    border-    color: var(--accent-hover);
    text-decoration-line: underline;
    text-decoration-color: var(--gold);
  }

  .region-block {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    background: var(--white);
    scroll-margin-top: 90px;
  }
  .region-block--dark {
    background: var(--cream);
  }
  .region-block__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: var(--space-12);
    align-items: start;
  }
  .region-heading {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
  }
  .region-logo {
    width: 64px;
    height: 64px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .region-heading h2 {
    margin: var(--space-1) 0 0;
    font-size: var(--text-h3);
  }
  .region-territory {
    color: var(--muted);
    font-size: var(--text-sm);
    margin: var(--space-3) 0;
  }
  .region-socials {
    display: flex;
    gap: var(--space-2);
  }
  .region-socials a {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--royal);
    text-decoration: none;
  }
  .region-socials a svg {
    width: 15px;
    height: 15px;
  }
  .region-socials a:hover {
    background: var(--royal);
    color: #fff;
    border-color: var(--royal);
  }

  .region-leaders {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .region-leader {
    text-align: center;
  }
  .region-leader img {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: var(--space-3);
  }
  .region-leader p {
    font-size: var(--text-xs);
    color: var(--muted-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
  }
  .region-leader h3 {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
  }

  @media (max-width: 780px) {
    .region-block__inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .region-leaders {
      grid-template-columns: 1fr;
    }
  }
</style>
