---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { primaryNav } from "../data/nav.js";
import { withBase } from "../lib/url.js";

// Top-level sections, for a "try one of these" list instead of a dead end.
const sections = primaryNav.filter((item) => item.href || item.children?.length);
---

<Base
  title="Page Not Found"
  description="That page could not be found on the Sigma Gamma Rho national website."
>
  <PageHero
    stack
    eyebrow="Error 404"
    title="We couldn't find"
    highlight="that page."
    copy="The link may be outdated, or the address may have a typo. The page you're looking for isn't here — but the rest of the site still is."
    watermark="404"
    size="compact"
  >
    <a class="btn" href={withBase("/")}>Back to Home</a>
    <a class="btn btn--outline on-dark" href={withBase("/contact/")}>Contact Headquarters</a>
  </PageHero>

  <section class="nf">
    <div class="container">
      <nav class="nf__sections" aria-label="Main sections">
        <p class="nf__sections-label">Or head straight to a section</p>
        <ul>
          {sections.map((item) => (
            <li>
              <a href={withBase(item.href ?? item.children?.[0]?.href ?? "/")}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</Base>

<style>
  .nf {
    background: var(--cream);
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .nf__sections {
    text-align: center;
  }
  .nf__sections-label {
    margin: 0 0 var(--space-4);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .nf__sections ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nf__sections a {
    font-weight: 700;
    color: var(--royal);
    text-decoration: none;
  }
  .nf__sections a:hover {
    color: var(--accent-hover);
    text-decoration-line: underline;
    text-decoration-color: var(--gold);
  }
</style>
