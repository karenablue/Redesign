---
import Base from "../layouts/Base.astro";
import { primaryNav } from "../data/nav.js";
import { withBase } from "../lib/url.js";

// Top-level sections, for a "try one of these" list instead of a dead end.
const sections = primaryNav.filter((item) => item.href || item.children?.length);
---

<Base
  title="Page Not Found"
  description="That page could not be found on the Sigma Gamma Rho national website."
>
  <section class="nf">
    <div class="container container--narrow nf__inner">
      <p class="eyebrow">Error 404</p>
      <h1>We couldn't find that page.</h1>
      <p class="nf__lead">
        The link may be outdated, or the address may have a typo. The page you're looking for isn't
        here — but the rest of the site still is.
      </p>

      <div class="nf__actions">
        <a class="btn" href={withBase("/")}>
          Back to Home
        </a>
        <a class="btn btn--outline" href={withBase("/contact/")}>
          Contact Headquarters
        </a>
      </div>

      <nav class="nf__sections" aria-label="Main sections">
        <p class="nf__sections-label">Or head straight to a section</p>
        <ul>
          {sections.map((item) => (
            <li>
              <a href={withBase(item.href ?? item.children?.[0]?.href ?? "/")}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</Base>

<style>
  .nf {
    background: var(--cream);
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .nf__inner {
    text-align: center;
  }
  .nf h1 {
    margin: var(--space-2) 0 0;
  }
  .nf__lead {
    max-width: 46ch;
    margin: var(--space-5) auto 0;
    color: var(--muted);
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .nf__sections {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--line);
  }
  .nf__sections-label {
    margin: 0 0 var(--space-4);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .nf__sections ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nf__sections a {
    font-weight: 700;
    color: var(--royal);
    text-decoration: none;
  }
  .nf__sections a:hover {
    color: var(--gold-text);
  }
</style>
