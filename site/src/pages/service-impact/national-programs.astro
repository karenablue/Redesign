---
/**
 * National Programs — ported from the original
 * service-impact/national-programs/nationalprograms.html.
 *
 * Treatment: hero with a jump-nav and a three-figure ribbon (HQ's reported
 * figures, unchanged), then a 60/40 showcase per program on one light canvas:
 * a large photograph and a narrative card. A program with no real photograph
 * shows its official mark in a framed panel until one is supplied. Closes on
 * documented program partners and "Service Through the Decades".
 */
import Base from "../../layouts/Base.astro";
import CtaBand from "../../components/CtaBand.astro";
import ProgramLogo from "../../components/ProgramLogo.astro";
import type { ProgramLogoName } from "../../data/program-logos";
import { withBase } from "../../lib/url.js";

const heroStats = [
  { value: "2,145,830", label: "Hours of Service" },
  { value: "$7,450,200", label: "Donated to Philanthropy" },
  { value: "$3,125,500", label: "Awarded in Scholarships" },
];

const PARTNER_URL = "/service-impact/corporate-partnerships/";

/** Partners already documented on this site (Corporate Partnerships). */
const programPartners = [
  { name: "USA Swimming", logo: "/images/USA Swimming.svg", note: "Swim 1922" },
  {
    name: "National Alliance on Mental Illness",
    logo: "/images/National Alliance on Mental Illness.jpg",
    note: "Women's Wellness",
  },
  {
    name: "National Education Fund",
    logo: "/images/foundations/nef.png",
    note: "Allied foundation",
  },
  { name: "SPEAR Foundation", logo: "/images/foundations/spear.png", note: "Allied foundation" },
  {
    name: "Seven Pearls Foundation",
    logo: "/images/foundations/seven-pearls.png",
    note: "Allied foundation",
  },
];

const jumpLinks = [
  { id: "bigbookbag", label: "BigBookBag" },
  { id: "wellness", label: "Women's Wellness" },
  { id: "swim", label: "Swim 1922" },
  { id: "cradle", label: "CRADLE Care" },
  { id: "youth", label: "Youth Symposium" },
];

const programs = [
  {
    id: "bigbookbag",
    kicker: "National Initiative • Est. 1996",
    name: "Operation BigBookBag®",
    lead: "Removing educational barriers by placing the tools students need directly into their hands.",
    body: [
      "Operation BigBookBag addresses the needs of school-aged children who are educationally at risk, including youth served by shelters, schools, hospitals, and extended-care facilities. Chapters collect and distribute educational materials, equipment, studying aids, and school supplies.",
      "Established in 1996 under Dr. LaRona J. Morris, 18th International Grand Basileus, the program has expanded to include STEM exposure, tutoring, mentoring, and year-round educational support.",
    ],
    focus: ["School Supplies", "STEM Exposure", "Tutoring", "Mentoring"],
    photo: "/images/operation-bigbookbag-4.jpg" as string | null,
  },
  {
    id: "wellness",
    flip: true,
    kicker: "National Initiative",
    name: "Women's Wellness Initiative",
    lead: "Supporting informed, empowered decisions about physical, mental, and emotional health.",
    body: [
      "The Women's Wellness Initiative focuses attention on health concerns that impact women, particularly women of color. Program areas include breast cancer awareness, intimate and domestic violence, heart health, diabetes, mental health, and other issues affecting women's well-being.",
      "The initiative encourages healthy lifestyles, informed health decisions, risk reduction, and stronger representation of African American women in health research.",
    ],
    focus: ["Heart Health", "Mental Health", "Breast Health", "Health Equity"],
    photo: null as string | null,
  },
  {
    id: "swim",
    kicker: "National Initiative",
    name: "SWIM 1922®",
    lead: "Increasing water safety, swimming access, and confidence in communities historically excluded from aquatic participation.",
    body: [
      "Swim 1922 addresses racial disparities in swimming and drowning by providing opportunities for youth and adults to learn water safety and swimming skills. Through the partnership with USA Swimming, members and swimming professionals bring instruction and exposure directly into local communities.",
    ],
    focus: ["Water Safety", "Swimming Access", "Confidence", "Community Education"],
    photo: "/images/swim-1922-1-768x432.jpg" as string | null,
  },
  {
    id: "cradle",
    flip: true,
    kicker: "National Initiative",
    name: "Project CRADLE Care®",
    lead: "Advancing healthier maternal and infant outcomes through education, advocacy, outreach, and awareness.",
    body: [
      "Project CRADLE Care is designed to raise awareness of inequitable maternal and infant health outcomes affecting Black women. The program combines community outreach, education, advocacy, and implicit-bias awareness to address disparities that can affect families across generations.",
      "Through collaboration with March of Dimes, the program connects communities with information, support, and resources intended to strengthen maternal and infant health.",
    ],
    focus: ["Maternal Health", "Infant Health", "Advocacy", "Health Equity"],
    photo: "/images/project-cradle-care-3.jpg" as string | null,
  },
  {
    id: "youth",
    kicker: "National Initiative",
    name: "Annual Youth Symposium",
    lead: "A nationwide day of relevant, hands-on programming designed to empower young people and strengthen their futures.",
    body: [
      "Held by alumnae chapters on the second Saturday of March during Sigma Week, the Annual Youth Symposium addresses issues affecting young people through interactive education, leadership development, and a relevant annual theme. Undergraduate chapters and affiliates support the nationwide effort.",
      "Originated under Dr. LaRona J. Morris during her 1996–2000 administration, the program continues with a standardized agenda designed to support educational and behavioral outcomes for youth.",
    ],
    focus: ["Leadership", "Education", "Life Skills", "Youth Empowerment"],
    photo: "/images/youth-symposium-1-768x432.jpg" as string | null,
  },
];
---

<Base
  title="National Programs"
  activeTop="Programs & Impact"
  description="Sigma Gamma Rho's national programs in education, health, swimming access, maternal care, and youth leadership."
>
  <section class="programs-hero on-dark">
    <div class="container programs-hero__inner">
      <div class="programs-hero__opening">
      <div>
      <p class="eyebrow">Service &amp; Impact</p>
      <h1 class="programs-hero__title">
        Greater Service <span class="editorial-accent">in action.</span>
      </h1>
      <div class="gold-rule"></div>
      <p class="programs-hero__copy">
        National programs translate Sigma Gamma Rho's commitment to service into focused action —
        advancing education, women's wellness, water safety, maternal and infant health, and youth
        development.
      </p>
      </div>
      <div class="programs-hero__invitation">
        <span class="programs-hero__number" aria-hidden="true">05</span>
        <p>Five national programs.<br />One commitment to community.</p>
        <a class="btn" href={withBase("/membership/chapter-locator/")}>Connect with a Chapter</a>
        <a class="programs-hero__support" href={withBase("/service-impact/partner-foundations/")}>Support the Work <span aria-hidden="true">&rarr;</span></a>
      </div>
      </div>

      <nav class="jump-nav" aria-label="Jump to a national program">
        {jumpLinks.map((j) => (
          <a href={`#${j.id}`}>{j.label}</a>
        ))}
      </nav>

      <div class="hero-stat-band">
        {heroStats.map((s) => (
          <div class="hero-stat">
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="service-intro">
    <div class="container service-intro__inner">
      <div>
        <p class="eyebrow">A Tradition of Service</p>
        <h2>
          Programs Built to <span>Meet the Moment</span>
        </h2>
      </div>
      <div class="service-intro__copy">
        <p>
          Since 1922, Sigma Gamma Rho Sorority, Inc. has served communities nationally and abroad.
          The Sorority works alongside national organizations and community partners to strengthen
          educational access, health outcomes, youth development, safety, and quality of life.
        </p>
        <p>
          Each national program focuses that commitment on an area where intentional service can
          create measurable, lasting progress.
        </p>
      </div>
    </div>
  </section>

  <div class="showcase">
    {programs.map((p, i) => (
      <section id={p.id} class:list={["program", { "program--alt": i % 2 === 1 }]}>
        <div class:list={["container program__shell", { "program__shell--flip": i % 2 === 1 }]}>
          <figure class:list={["program__visual", { "program__visual--mark": !p.photo }]}>
            {p.photo ? (
              <img
                src={withBase(p.photo)}
                alt={`${p.name.replace("®", "")} in action`}
                width="900"
                height="600"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <ProgramLogo name={p.id as ProgramLogoName} alt={`${p.name} logo`} maxWidth={420} />
            )}
          </figure>
          <div class="program__card">
            <p class="program__kicker"><span class="program__number" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span> {p.kicker}</p>
            {p.photo && (
              <div class="program__logo">
                <ProgramLogo name={p.id as ProgramLogoName} />
              </div>
            )}
            <h2 class="program__name">{p.name}</h2>
            <p class="program__lead">{p.lead}</p>
            {p.body.map((para) => (
              <p>{para}</p>
            ))}
            <div class="program__focus">
              {p.focus.map((f) => (
                <span>{f}</span>
              ))}
            </div>
            <a class="program__cta" href={withBase(PARTNER_URL)}>
              Partner With Us <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="partners-strip" aria-labelledby="partners-title">
    <div class="container">
      <h2 id="partners-title">Program Partners &amp; Allied Foundations</h2>
      <ul>
        {programPartners.map((x) => (
          <li>
            <img src={withBase(x.logo)} alt={x.name} loading="lazy" decoding="async" />
            <span>{x.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="service-history">
    <div class="container service-history__inner">
      <div>
        <p class="eyebrow">A Broader Service Legacy</p>
        <h2>
          Service Through <span>the Decades</span>
        </h2>
      </div>
      <div class="service-history__copy">
        <p>
          Today's national programs continue a service tradition that has taken many forms. Sigma
          Gamma Rho's broader history includes initiatives such as Project Reassurance, Project
          Africa, and Project Mwanamugimu, alongside decades of local chapter programming and
          collaboration with national organizations.
        </p>
        <p class="service-history__callout">
          The programs evolve. The obligation remains:{" "}
          <strong>
            Greater Service, Greater Progress<sup class="reg">&reg;</sup>.
          </strong>
        </p>
      </div>
    </div>
  </section>
  <CtaBand
    eyebrow="Put Purpose Into Practice"
    title="The work happens"
    highlight="in community."
    copy="Connect with a local chapter to learn about service opportunities, or bring your organization's resources to a national program."
    actions={[
      { label: "Find Your Chapter", href: "/membership/chapter-locator/" },
      { label: "Become a Partner", href: "/service-impact/corporate-partnerships/", variant: "outline" },
    ]}
  />
</Base>

<style>
  /* ---- hero ---- */
  .programs-hero {
    background: var(--navy);
    color: var(--white);
  }
  .programs-hero__inner {
    padding-block: clamp(3.5rem, 7vw, 5rem);
  }
  .programs-hero__opening {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }
  .programs-hero__title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 400;
    font-size: var(--text-hero);
    color: #fff;
  }
  .programs-hero__title span {
    display: block;
    color: var(--gold);
  }
  .gold-rule {
    margin-inline: 0;
  }
  .programs-hero__copy {
    color: rgba(255, 255, 255, 0.88);
    max-width: 40rem;
    margin-inline: 0;
  }
  .programs-hero__invitation {
    padding-left: var(--space-8);
    border-left: 1px solid var(--line-dark);
  }
  .programs-hero__number {
    display: block;
    color: var(--gold);
    font-family: var(--font-display);
    font-size: clamp(4rem, 8vw, 7rem);
    line-height: 1;
    margin-bottom: var(--space-4);
  }
  .programs-hero__invitation p {
    color: var(--text-on-dark-soft);
    font-size: var(--text-base);
  }
  .programs-hero__support {
    display: block;
    width: fit-content;
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    font-weight: 700;
    text-underline-offset: 0.3em;
  }
  .program__kicker {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .program__number {
    color: var(--royal);
    font-family: var(--font-editorial);
    font-size: var(--text-h3);
    font-weight: 400;
  }
  @media (max-width: 800px) {
    .programs-hero__opening {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .programs-hero__invitation {
      padding: var(--space-6) 0 0;
      border-left: 0;
      border-top: 1px solid var(--line-dark);
    }
    .programs-hero__number {
      display: none;
    }
  }

  .jump-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .jump-nav a {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
  }
  .jump-nav a:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #fff;
  }

  /* One horizontal ribbon: three equal columns with hairline dividers. */
  .hero-stat-band {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }
  .hero-stat {
    display: flex;
    flex-direction: column;
    padding-inline: var(--space-4);
  }
  .hero-stat + .hero-stat {
    border-left: 1px solid rgba(255, 255, 255, 0.15);
  }
  @media (max-width: 800px) {
    .hero-stat-band {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .hero-stat + .hero-stat {
      border-left: 0;
    }
  }
  .hero-stat strong {
    font-family: var(--font-label);
    /* Sized to its third of the ribbon; --text-stat collides at desktop. */
    font-size: clamp(2rem, 1rem + 2.6vw, 3.25rem);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: #fff;
  }
  .hero-stat span {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
  }

  /* ---- service intro ---- */
  .service-intro {
    background: var(--white);
    padding-block: clamp(3rem, 5vw, 4rem);
  }
  .service-intro__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-12);
    align-items: start;
  }
  .service-intro__inner h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .service-intro__inner h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .service-intro__copy p {
    color: var(--muted);
  }
  @media (max-width: 780px) {
    .service-intro__inner {
      grid-template-columns: 1fr;
    }
  }

  /* ---- program showcases: 60/40, one light canvas ---- */
  .program {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
    scroll-margin-top: 72px;
  }
  .program--alt {
    background: var(--cream);
  }
  .program__shell {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }
  .program__shell--flip {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
  }
  .program__shell--flip .program__visual {
    order: 2;
  }
  .program__visual {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .program__visual img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .program__visual--mark {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    padding: var(--space-10);
    border: 1px solid var(--line);
    background: var(--white);
  }
  .program__kicker {
    margin: 0 0 var(--space-4);
    color: var(--muted-2);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .program--alt .program__kicker {
    color: var(--muted);
  }
  .program__logo {
    margin-bottom: var(--space-4);
  }
  .program__name {
    margin: 0 0 var(--space-4);
    font-size: var(--text-h3);
    line-height: 1.15;
  }
  .program__lead {
    font-weight: 700;
    color: var(--ink);
  }
  .program__card p:not(.program__kicker, .program__lead) {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .program__focus {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }
  .program__focus span {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    color: var(--royal);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .program__cta {
    display: inline-block;
    margin-top: var(--space-6);
    color: var(--royal);
    font-weight: 700;
  }
  @media (max-width: 900px) {
    .program__shell,
    .program__shell--flip {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .program__shell--flip .program__visual {
      order: 0;
    }
  }

  /* ---- partner strip ---- */
  .partners-strip {
    background: var(--white);
    padding-block: clamp(3rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }
  .partners-strip h2 {
    margin: 0 0 var(--space-8);
    text-align: center;
    font-size: var(--text-h3);
  }
  .partners-strip ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-8) var(--space-12);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .partners-strip li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }
  .partners-strip img {
    height: 72px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
  }
  .partners-strip span {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  /* ---- service history ---- */
  .service-history {
    background: var(--cream);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .service-history__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-12);
    align-items: start;
  }
  .service-history__inner h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .service-history__inner h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .service-history__copy p {
    color: var(--muted);
  }
  .service-history__callout {
    font-weight: 700;
    color: var(--royal);
  }
  .service-history__callout strong {
    color: var(--accent-text);
  }
  @media (max-width: 780px) {
    .service-history__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
