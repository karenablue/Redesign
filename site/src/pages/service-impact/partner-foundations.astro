---
import Base from "../../layouts/Base.astro";
import CtaBand from "../../components/CtaBand.astro";
import { withBase } from "../../lib/url.js";

/*
 * Copy is limited to each foundation's own published language.
 * Seven Pearls: sevenpearls.org (mission line, 501(c)(3) statement, the
 * Women's Health Initiative and Crowning Events). Its seal comes from the
 * Seven Pearls Foundation Brand Style Guide 2025.
 */
type Foundation = {
  id: string;
  name: string;
  logo: string;
  tag: string;
  lead: string;
  body: string;
  pillars: { title: string; body: string }[];
  link: { href: string; label: string };
};

const foundations: Foundation[] = [
  {
    id: "nef",
    name: "National Education Fund",
    logo: "/images/foundations/nef.png",
    tag: "Education • Opportunity • Leadership",
    lead: "Expanding educational opportunity by helping students overcome financial barriers and preparing future leaders to thrive.",
    body: "The Sigma Gamma Rho Sorority National Education Fund, Inc. is the charitable foundation of Sigma Gamma Rho Sorority, Inc. Its work centers scholarships, leadership development, and community education designed to improve academic opportunity and quality of life.",
    pillars: [
      {
        title: "Scholarships",
        body: "Helping students pursue higher education by reducing financial barriers.",
      },
      {
        title: "Leadership Development",
        body: "Supporting emerging leaders through mentoring, workshops, and professional development.",
      },
      {
        title: "Community Impact",
        body: "Strengthening communities through educational initiatives, outreach, and symposiums.",
      },
    ],
    link: { href: "https://www.sgrnationaleducationfund.org/", label: "Visit NEF" },
  },
  {
    id: "spear",
    name: "SPEAR Foundation",
    logo: "/images/foundations/spear.png",
    tag: "Research • Advocacy • Community Support",
    lead: "Helping communities turn vision into action through strategic support, public education, research, and sustainable partnerships.",
    body: "The Sigma Public Education and Research Foundation advances social, civic, cultural, economic, and educational progress by empowering vulnerable and at-risk families through service, education, advocacy, and research.",
    pillars: [
      {
        title: "Advocacy & Research",
        body: "Supporting evidence-based advocacy and research that informs solutions and expands opportunity.",
      },
      {
        title: "Fiscal Sponsorship",
        body: "Equipping chapters and community organizations with resources to develop and sustain programs that reduce poverty.",
      },
      {
        title: "Community Impact",
        body: "Supporting public education and community-service initiatives that address the needs of vulnerable families.",
      },
    ],
    link: { href: "https://www.spearfoundation.org/", label: "Visit SPEAR" },
  },
  {
    id: "seven-pearls",
    name: "Seven Pearls Foundation",
    logo: "/images/foundations/seven-pearls.png",
    tag: "Leadership • Community • Change",
    lead: "Empowering Leaders, Transforming Communities, & Inspiring Change.",
    body: "Seven Pearls Foundation, Inc. is a 501(c)(3) non-profit organization empowering women and girls through education, leadership, sisterhood, and community-driven initiatives, in honor of the Seven of 1922.",
    pillars: [
      {
        title: "Women's Health Initiative",
        body: "Encouraging women to take charge of their heart health through prevention, early detection, and self-care.",
      },
      {
        title: "Crowning Events",
        body: "Recognizing and honoring the achievements and efforts of inspiring women.",
      },
      {
        title: "Women & Girls",
        body: "Education, leadership, and sisterhood initiatives driven by community.",
      },
    ],
    link: { href: "https://www.sevenpearls.org/support.html", label: "Support Seven Pearls" },
  },
];
---

<Base
  title="Partner Foundations"
  activeTop="Service & Impact"
  description="The National Education Fund, SPEAR Foundation, and Seven Pearls Foundation — Sigma Gamma Rho's partner foundations for education, research, and community support."
>
  <section class="pf-hero on-dark">
    <div class="container pf-hero__inner">
      <p class="eyebrow">Service &amp; Impact</p>
      <h1>
        Foundations That <span>Expand the Work</span>
      </h1>
      <div class="gold-rule"></div>
      <p>
        Through education, research, advocacy, fiscal support, and strategic partnerships, Sigma
        Gamma Rho's partner foundations help transform community vision into sustained impact.
      </p>
      <nav class="pf-jump">
        <a href="#nef">National Education Fund</a>
        <a href="#spear">SPEAR Foundation</a>
        <a href="#seven-pearls">Seven Pearls Foundation</a>
      </nav>
    </div>
    <div class="pf-hero__mark" aria-hidden="true">
      FOUNDATIONS
    </div>
  </section>

  <section class="pf-intro">
    <div class="container pf-intro__grid">
      <div>
        <p class="eyebrow">Extending Greater Service</p>
        <h2>
          Purpose Backed by <span>Infrastructure</span>
        </h2>
      </div>
      <div class="pf-intro__copy">
        <p>
          Community service grows stronger when it is supported by institutions designed to fund
          opportunity, develop leaders, strengthen programs, and turn ideas into sustainable action.
        </p>
        <p>
          Three partner foundations play distinct but complementary roles in that work: the National
          Education Fund, the Sigma Public Education and Research Foundation, and the Seven Pearls
          Foundation.
        </p>
      </div>
    </div>
  </section>

  <section class="pf-cards">
    <ul class="container pf-grid">
      {foundations.map((f) => (
        <li class="pf-card" id={f.id}>
          <div class="pf-emblem">
            <img src={withBase(f.logo)} alt="" width="96" height="96" loading="lazy" decoding="async" />
          </div>
          <h2>{f.name}</h2>
          <p class="pf-tag">{f.tag}</p>
          <p class="pf-lead">{f.lead}</p>
          <p class="pf-body">{f.body}</p>
          <ul class="pf-pillars">
            {f.pillars.map((it) => (
              <li>
                <h3>{it.title}</h3>
                <p>{it.body}</p>
              </li>
            ))}
          </ul>
          <a class="btn btn--outline pf-action" href={f.link.href} target="_blank" rel="noopener">
            {f.link.label} <span aria-hidden="true">&#8599;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <CtaBand
    eyebrow="Shared Purpose"
    title="Different Roles. "
    highlight="One Greater Mission."
    copy="Scholarships create access. Leadership development builds capacity. Research strengthens decisions. Fiscal sponsorship helps programs grow. Together, these foundations extend the infrastructure behind Greater Service."
    actions={[
      { label: "Explore National Programs", href: "/service-impact/national-programs/" },
      {
        label: "Corporate Partnerships",
        href: "/service-impact/corporate-partnerships/",
        variant: "outline",
      },
    ]}
  />
</Base>

<style>
  .pf-hero {
    position: relative;
    overflow: hidden;
    background: var(--grad-royal);
    color: #fff;
  }
  .pf-hero__inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(3.5rem, 6vw, 5rem);
    max-width: 46rem;
  }
  .pf-hero h1 {
    color: #fff;
    margin: var(--space-2) 0 0;
  }
  .pf-hero h1 span {
    color: var(--gold);
  }
  .pf-hero > .container > p:not(.eyebrow) {
    color: rgba(255, 255, 255, 0.85);
  }
  .pf-jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .pf-jump a {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
  }
  .pf-jump a:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #fff;
  }
  .pf-hero__mark {
    position: absolute;
    right: -0.5rem;
    bottom: -2rem;
    z-index: 1;
    color: rgba(255, 255, 255, 0.04);
    font-size: clamp(4rem, 12vw, 9rem);
    font-family: var(--font-label);
  }

  .pf-intro {
    background: var(--white);
    padding-block: clamp(3rem, 5vw, 4rem);
  }
  .pf-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-12);
    align-items: start;
  }
  .pf-intro__grid h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .pf-intro__grid h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .pf-intro__copy p {
    color: var(--muted);
  }
  @media (max-width: 780px) {
    .pf-intro__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Three equal cards on one light canvas. */
  .pf-cards {
    background: var(--cream);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .pf-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    padding-inline: 0;
    list-style: none;
  }
  .pf-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    scroll-margin-top: 200px;
  }
  .pf-emblem {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    margin-bottom: var(--space-5);
  }
  .pf-emblem img {
    width: 96px;
    height: 96px;
    object-fit: contain;
  }
  .pf-card h2 {
    margin: 0;
    color: var(--royal);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-lg);
    line-height: 1.3;
  }
  .pf-tag {
    align-self: flex-start;
    margin: var(--space-3) 0 0;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--gold);
    border-radius: 999px;
    color: var(--royal);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .pf-lead {
    margin: var(--space-5) 0 0;
    color: var(--ink);
    font-weight: 600;
    line-height: 1.5;
  }
  .pf-body {
    margin: var(--space-3) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .pf-pillars {
    display: grid;
    margin: var(--space-5) 0 var(--space-6);
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .pf-pillars li {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
  }
  .pf-pillars h3 {
    margin: 0;
    color: var(--royal);
    font-size: var(--text-sm);
  }
  .pf-pillars p {
    margin: var(--space-1) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  /* The action sits on the card foot so all three line up. */
  .pf-action {
    margin-top: auto;
    align-self: flex-start;
    white-space: nowrap;
  }
  @media (max-width: 1000px) {
    .pf-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 40rem;
    }
  }
</style>
