---
import Base from "../../layouts/Base.astro";
import CardGrid from "../../components/CardGrid.astro";
import CtaBand from "../../components/CtaBand.astro";
import { withBase } from "../../lib/url.js";

const focusAreas = ["Education", "Health", "Economic Empowerment", "Community Advocacy"];

const partners = [
  {
    logo: "/images/Alzheimer's Association.svg",
    type: "Health & Awareness",
    name: "Alzheimer's Association",
    note: "Supports brain-health awareness, community education, volunteer engagement, and outreach to families affected by Alzheimer's disease.",
    tag: "Community Education",
  },
  {
    logo: "/images/Amazon.png",
    type: "Technology & Education",
    name: "Amazon",
    note: "Supports AI awareness and upskilling through certification resources, community education, and access to technology-focused learning opportunities.",
    tag: "AI Upskilling",
  },
  {
    logo: "/images/American Cancer Society.svg",
    type: "Health Equity",
    name: "American Cancer Society",
    note: "Advances cancer prevention, early detection, health-equity education, and community participation in cancer-awareness initiatives.",
    tag: "Cancer Prevention",
  },
  {
    logo: "/images/Chase.svg",
    type: "Financial Empowerment",
    name: "Chase",
    note: "Supports financial literacy, wealth-building education, and member access to workshops, Money Mondays, and other learning opportunities.",
    tag: "Wealth Building",
  },
  {
    logo: "/images/Good Health Wins.png",
    type: "Public Health",
    name: "Good Health Wins",
    note: "Partners with Sigma Gamma Rho to promote vaccine awareness, vaccine equity, local outreach, and chapter-based community health programming.",
    tag: "Vaccine Equity",
  },
  {
    logo: "/images/Herff Jones.png",
    type: "Official Insignia",
    name: "Herff Jones",
    note: "Serves as the official and exclusive provider of Sigma Gamma Rho jewelry and insignia, supporting approved use of the Sorority's symbols and identity.",
    tag: "Official Provider",
  },
  {
    logo: "/images/Hip Hop Sisters Network.png",
    type: "Culture & Leadership",
    name: "Hip Hop Sisters Network",
    note: "Supports women's leadership, cultural advocacy, community service, wealth-building education, and connections with honorary members.",
    tag: "Cultural Advocacy",
  },
  {
    logo: "/images/Kasper.png",
    type: "Retail & Apparel",
    name: "Kasper",
    note: "Production partner for the Macy's Sorority Collection and the official Sigma Gamma Rho blazer, connecting affinity apparel with Sorority visibility.",
    tag: "Official Blazer",
  },
  {
    logo: "/images/partner-logo-macys.png",
    type: "Retail & Philanthropy",
    name: "Macy's",
    note: "Supports Sigma Gamma Rho's philanthropic work and five programmatic thrusts through the Kasper Sorority Collection and related community engagement.",
    tag: "Program Support",
  },
  {
    logo: "/images/NAACP.svg",
    type: "Civil Rights",
    name: "NAACP",
    note: "Collaborates with Sigma Gamma Rho around advocacy, voter engagement, civic participation, educational equity, and economic and social justice.",
    tag: "Civic Action",
  },
  {
    logo: "/images/National Alliance on Mental Illness.jpg",
    type: "Mental Health",
    name: "National Alliance on Mental Illness",
    note: "Supports mental-health awareness, stigma reduction, community conversations, resources, training, and chapter initiatives focused on Black communities.",
    tag: "Mental Wellness",
  },
  {
    logo: "/images/St. Jude Children's Research Hospital.png",
    type: "Children's Health",
    name: "St. Jude Children's Research Hospital",
    note: "Supports lifesaving treatment, sickle-cell and gene-editing initiatives, fundraising, internships, Walk/Run participation, and national awareness.",
    tag: "Pediatric Health",
  },
  {
    logo: "/images/USA Swimming.svg",
    type: "Aquatics & Safety",
    name: "USA Swimming",
    note: "Collaborates through Swim 1922 to expand learn-to-swim access, strengthen water safety, and create positive swimming experiences for children nationwide.",
    tag: "Swim 1922",
  },
  {
    logo: "/images/Western Governors University.svg",
    type: "Higher Education",
    name: "Western Governors University",
    note: "Provides scholarship opportunities for members, staff, and affiliates pursuing bachelor's and master's degrees.",
    tag: "Scholarships",
  },
];

const collabs = [
  {
    n: "01",
    kicker: "Program Partnership",
    title: "Swim 1922 + USA Swimming",
    body: "A partnership built around access, water safety, and changing the relationship between historically underrepresented communities and the sport of swimming.",
    link: "/service-impact/national-programs/#swim",
    label: "Explore Swim 1922",
  },
  {
    n: "02",
    kicker: "Health Partnership",
    title: "NAMI + Women's Wellness",
    body: "Mental-health education and stigma reduction strengthen the broader work of the Women's Wellness Initiative and local chapter programming.",
    link: "/service-impact/national-programs/#wellness",
    label: "Explore Women's Wellness",
  },
  {
    n: "03",
    kicker: "Education Partnership",
    title: "WGU + Member Advancement",
    body: "Scholarship access expands the Sorority's long-standing commitment to continuing education and professional development.",
    link: "/membership/become-a-member/",
    label: "Explore Membership",
  },
];
---

<Base
  title="Corporate Partnerships"
  activeTop="Service & Impact"
  description="Sigma Gamma Rho collaborates with corporations, nonprofits, and national organizations to strengthen programs and expand community impact."
>
  <section class="cp-hero on-dark">
    <div class="container cp-hero__inner">
      <p class="eyebrow">Service &amp; Impact</p>
      <h1>
        Partnerships That <span>Move the Mission Forward</span>
      </h1>
      <div class="gold-rule"></div>
      <p>
        Sigma Gamma Rho collaborates with corporations, nonprofits, foundations, and national
        organizations whose resources, expertise, and reach strengthen programs and expand community
        impact.
      </p>
      <div class="cp-hero__actions">
        <a class="btn" href="#partner-grid">
          Explore Partnerships
        </a>
        <a
          class="btn btn--outline on-dark"
          href="https://forms.office.com/r/ruwe5VFBgr"
          target="_blank"
          rel="noopener"
        >
          Partnership Opportunities
        </a>
      </div>
    </div>
  </section>

  <section class="cp-intro">
    <div class="container cp-intro__grid">
      <div>
        <p class="eyebrow">Meaningful Collaboration</p>
        <h2>
          Shared Values. <span>Shared Impact.</span>
        </h2>
      </div>
      <div class="cp-intro__copy">
        <p>
          Sigma Gamma Rho Sorority, Inc. welcomes partners who share its commitment to service,
          education, and uplifting communities through meaningful collaboration. Sponsorship support
          helps advance programs, events, and initiatives that create lasting impact locally and
          nationally.
        </p>
        <p>
          <a href="https://forms.office.com/r/ruwe5VFBgr" target="_blank" rel="noopener">
            Click here to apply for sponsorship and partnership opportunities.
          </a>
          <br />
          Want to ask a few questions about the program?{" "}
          <a href="mailto:help@sgrho1922.org">Email us directly.</a>
        </p>
      </div>
    </div>
  </section>

  <section class="cp-focus">
    <div class="container cp-focus__grid">
      {focusAreas.map((f) => (
        <span>{f}</span>
      ))}
    </div>
  </section>

  <section class="cp-partners" id="partner-grid">
    <div class="container">
      <div class="cp-heading">
        <div>
          <p class="eyebrow">List of Sponsors</p>
          <h2>
            Working Together for <span>Greater Progress</span>
          </h2>
        </div>
        <p>
          Current partnerships span health, education, civil rights, financial literacy, community
          service, retail, culture, and member development.
        </p>
      </div>
      <CardGrid min="260px" cols={3}>
        {partners.map((p) => (
          <div class="partner-card">
            <div class="partner-card__logo">
              <img src={withBase(p.logo)} alt={`${p.name} logo`} loading="lazy" decoding="async" />
            </div>
            <p class="partner-card__type">{p.type}</p>
            <h3>{p.name}</h3>
            <p>{p.note}</p>
            <span class="partner-card__tag">{p.tag}</span>
          </div>
        ))}
      </CardGrid>
    </div>
  </section>

  <section class="cp-collabs">
    <div class="container cp-collabs__grid">
      {collabs.map((c) => (
        <article class="cp-collab">
          <span class="cp-collab__num">{c.n}</span>
          <p class="cp-collab__kicker">{c.kicker}</p>
          <h3>{c.title}</h3>
          <p>{c.body}</p>
          <a href={withBase(c.link)}>
            {c.label} <span aria-hidden="true">&rarr;</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="cp-crosslink">
    <div class="container cp-crosslink__inner">
      <div>
        <p class="eyebrow eyebrow--light">Philanthropic Partners</p>
        <h2>NEF &amp; SPEAR</h2>
        <p>
          Sigma Gamma Rho's National Education Fund and SPEAR Foundation also support education,
          public service, research, fiscal sponsorship, and community programs.
        </p>
      </div>
      <a class="btn" href={withBase("/service-impact/partner-foundations/")}>
        Explore Partner Foundations
      </a>
    </div>
  </section>

  <CtaBand
    eyebrow="Partner With Sigma Gamma Rho"
    title="Build Something That "
    highlight="Creates Lasting Impact."
    copy="Organizations aligned with Sigma Gamma Rho's commitment to service, education, and stronger communities are invited to explore sponsorship and partnership opportunities."
    actions={[
      { label: "Explore Partnership Opportunities", href: "https://forms.office.com/r/ruwe5VFBgr" },
      { label: "Contact Us", href: "/contact/", variant: "outline" },
    ]}
  />
</Base>

<style>
  .cp-hero {
    background: var(--grad-royal);
    color: #fff;
  }
  .cp-hero__inner {
    padding-block: clamp(3.5rem, 6vw, 5rem);
    max-width: 48rem;
  }
  .cp-hero h1 {
    color: #fff;
    margin: var(--space-2) 0 0;
  }
  .cp-hero h1 span {
    color: var(--gold);
  }
  .cp-hero > .container > p:not(.eyebrow) {
    color: rgba(255, 255, 255, 0.85);
  }
  .cp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .cp-intro {
    background: var(--white);
    padding-block: clamp(3rem, 5vw, 4rem);
  }
  .cp-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-12);
    align-items: start;
  }
  .cp-intro__grid h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .cp-intro__grid h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .cp-intro__copy p {
    color: var(--muted);
  }
  .cp-intro__copy a {
    color: var(--royal);
    font-weight: 700;
  }
  @media (max-width: 780px) {
    .cp-intro__grid {
      grid-template-columns: 1fr;
    }
  }

  .cp-focus {
    background: var(--cream);
    padding-block: var(--space-8);
  }
  .cp-focus__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-8);
  }
  .cp-focus__grid span {
    font-family: var(--font-label);
    font-size: var(--text-sm);
    color: var(--royal);
    letter-spacing: 0.04em;
  }

  .cp-partners {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .cp-heading {
    max-width: 50rem;
    margin: 0 auto var(--space-10);
    text-align: center;
  }
  .cp-heading h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .cp-heading h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .cp-heading > p {
    color: var(--muted);
    margin-top: var(--space-4);
  }
  .partner-card {
    background: var(--tint);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
  }
  .partner-card__logo {
    height: 48px;
    display: flex;
    align-items: center;
    margin-bottom: var(--space-2);
  }
  .partner-card__logo img {
    max-height: 48px;
    max-width: 140px;
    object-fit: contain;
  }
  .partner-card__type {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0;
  }
  .partner-card h3 {
    margin: 0;
    font-size: var(--text-md);
  }
  .partner-card p {
    color: var(--muted);
    font-size: var(--text-sm);
    margin: 0;
    flex: 1;
  }
  .partner-card__tag {
    align-self: flex-start;
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgba(32, 65, 165, 0.1);
    color: var(--royal);
  }

  .cp-collabs {
    background: var(--cream);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .cp-collabs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: var(--space-8);
  }
  .cp-collab {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }
  .cp-collab__num {
    font-family: var(--font-label);
    color: var(--accent-text);
    font-size: var(--text-lg);
  }
  .cp-collab__kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin: var(--space-2) 0 0;
  }
  .cp-collab h3 {
    margin: var(--space-1) 0 var(--space-3);
    font-size: var(--text-md);
  }
  .cp-collab p {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .cp-collab a {
    color: var(--royal);
    font-weight: 700;
    text-decoration: none;
  }
  .cp-collab a:hover {
    color: var(--accent-hover);
    text-decoration-line: underline;
    text-decoration-color: var(--gold);
  }

  .cp-crosslink {
    background: var(--grad-royal);
    color: #fff;
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }
  .cp-crosslink__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }
  .cp-crosslink h2 {
    color: #fff;
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .cp-crosslink p {
    color: rgba(255, 255, 255, 0.85);
    margin-top: var(--space-3);
    max-width: 32rem;
  }
  .eyebrow--light {
    color: var(--gold);
  }
</style>
