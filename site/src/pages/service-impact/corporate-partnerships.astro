---
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/url.js";

const FORM_URL = "https://forms.office.com/r/ruwe5VFBgr";

/*
 * Figures in the proof block are the ones the site already states (the
 * International Grand Basileus bio: over 100,000 members, 500 chapters).
 * No prospectus PDF or sponsorship tiers exist yet; add them here when HQ
 * publishes them.
 */
const proof = [
  {
    title: "Multigenerational Reach",
    body: "More than 100,000 members and 500 chapters worldwide, from collegiate and alumnae chapters to youth affiliates.",
  },
  {
    title: "Ready-to-Activate Programs",
    body: "National programs open to co-branded support, including Swim 1922, Project Cradle Care, and Operation BigBookBag.",
  },
  {
    title: "Grassroots Footprint",
    body: "Chapter-led service across five regions, reaching communities in the United States and internationally.",
  },
];

const partners = [
  {
    logo: "/images/Alzheimer's Association.svg",
    type: "Health & Awareness",
    name: "Alzheimer's Association",
    note: "Supports brain-health awareness, community education, volunteer engagement, and outreach to families affected by Alzheimer's disease.",
    tag: "Community Education",
  },
  {
    logo: "/images/Amazon.png",
    type: "Technology & Education",
    name: "Amazon",
    note: "Supports AI awareness and upskilling through certification resources, community education, and access to technology-focused learning opportunities.",
    tag: "AI Upskilling",
  },
  {
    logo: "/images/American Cancer Society.svg",
    type: "Health Equity",
    name: "American Cancer Society",
    note: "Advances cancer prevention, early detection, health-equity education, and community participation in cancer-awareness initiatives.",
    tag: "Cancer Prevention",
  },
  {
    logo: "/images/Chase.svg",
    type: "Financial Empowerment",
    name: "Chase",
    note: "Supports financial literacy, wealth-building education, and member access to workshops, Money Mondays, and other learning opportunities.",
    tag: "Wealth Building",
  },
  {
    logo: "/images/Good Health Wins.png",
    type: "Public Health",
    name: "Good Health Wins",
    note: "Partners with Sigma Gamma Rho to promote vaccine awareness, vaccine equity, local outreach, and chapter-based community health programming.",
    tag: "Vaccine Equity",
  },
  {
    logo: "/images/Herff Jones.png",
    type: "Official Insignia",
    name: "Herff Jones",
    note: "Serves as the official and exclusive provider of Sigma Gamma Rho jewelry and insignia, supporting approved use of the Sorority's symbols and identity.",
    tag: "Official Provider",
  },
  {
    logo: "/images/Hip Hop Sisters Network.png",
    type: "Culture & Leadership",
    name: "Hip Hop Sisters Network",
    note: "Supports women's leadership, cultural advocacy, community service, wealth-building education, and connections with honorary members.",
    tag: "Cultural Advocacy",
  },
  {
    logo: "/images/Kasper.png",
    type: "Retail & Apparel",
    name: "Kasper",
    note: "Production partner for the Macy's Sorority Collection and the official Sigma Gamma Rho blazer, connecting affinity apparel with Sorority visibility.",
    tag: "Official Blazer",
  },
  {
    logo: "/images/partner-logo-macys.png",
    type: "Retail & Philanthropy",
    name: "Macy's",
    note: "Supports Sigma Gamma Rho's philanthropic work and five programmatic thrusts through the Kasper Sorority Collection and related community engagement.",
    tag: "Program Support",
  },
  {
    logo: "/images/NAACP-dark.svg",
    type: "Civil Rights",
    name: "NAACP",
    note: "Collaborates with Sigma Gamma Rho around advocacy, voter engagement, civic participation, educational equity, and economic and social justice.",
    tag: "Civic Action",
  },
  {
    logo: "/images/National Alliance on Mental Illness.jpg",
    type: "Mental Health",
    name: "National Alliance on Mental Illness",
    note: "Supports mental-health awareness, stigma reduction, community conversations, resources, training, and chapter initiatives focused on Black communities.",
    tag: "Mental Wellness",
  },
  {
    logo: "/images/partners/st-jude.png",
    type: "Children's Health",
    name: "St. Jude Children's Research Hospital",
    note: "Supports lifesaving treatment, sickle-cell and gene-editing initiatives, fundraising, internships, Walk/Run participation, and national awareness.",
    tag: "Pediatric Health",
  },
  {
    logo: "/images/USA Swimming.svg",
    type: "Aquatics & Safety",
    name: "USA Swimming",
    note: "Collaborates through Swim 1922 to expand learn-to-swim access, strengthen water safety, and create positive swimming experiences for children nationwide.",
    tag: "Swim 1922",
  },
  {
    logo: "/images/Western Governors University.svg",
    type: "Higher Education",
    name: "Western Governors University",
    note: "Provides scholarship opportunities for members, staff, and affiliates pursuing bachelor's and master's degrees.",
    tag: "Scholarships",
  },
];

/** Two tiers, sorted from the one list so a new partner only needs a line. */
const CORPORATE = ["Amazon", "Chase", "Herff Jones", "Kasper", "Macy's", "Western Governors University"];
const corporate = partners.filter((x) => CORPORATE.includes(x.name));
const community = partners.filter((x) => !CORPORATE.includes(x.name));

const allied = [
  { name: "National Education Fund", logo: "/images/foundations/nef.png", id: "nef" },
  { name: "SPEAR Foundation", logo: "/images/foundations/spear.png", id: "spear" },
  { name: "Seven Pearls Foundation", logo: "/images/foundations/seven-pearls.png", id: "seven-pearls" },
];

const collabs = [
  {
    logo: "/images/USA Swimming.svg",
    partner: "USA Swimming",
    kicker: "Program Partnership",
    title: "Swim 1922 + USA Swimming",
    body: "A partnership built around access, water safety, and changing the relationship between historically underrepresented communities and the sport of swimming.",
    link: "/service-impact/national-programs/#swim",
    label: "Explore Swim 1922",
  },
  {
    logo: "/images/National Alliance on Mental Illness.jpg",
    partner: "National Alliance on Mental Illness",
    kicker: "Health Partnership",
    title: "NAMI + Women's Wellness",
    body: "Mental-health education and stigma reduction strengthen the broader work of the Women's Wellness Initiative and local chapter programming.",
    link: "/service-impact/national-programs/#wellness",
    label: "Explore Women's Wellness",
  },
  {
    logo: "/images/Western Governors University.svg",
    partner: "Western Governors University",
    kicker: "Education Partnership",
    title: "WGU + Member Advancement",
    body: "Scholarship access expands the Sorority's long-standing commitment to continuing education and professional development.",
    link: "/membership/become-a-member/",
    label: "Explore Membership",
  },
];
---

<Base
  title="Corporate Partnerships"
  activeTop="Programs & Impact"
  description="Sigma Gamma Rho collaborates with corporations, nonprofits, and national organizations to strengthen programs and expand community impact."
>
  <section class="cp-hero on-dark">
    <div class="container cp-hero__inner">
      <p class="eyebrow">Service &amp; Impact</p>
      <h1>
        Partnerships That <span>Move the Mission Forward</span>
      </h1>
      <div class="gold-rule"></div>
      <p>
        Sigma Gamma Rho collaborates with corporations, nonprofits, foundations, and national
        organizations whose resources, expertise, and reach strengthen programs and expand community
        impact.
      </p>
      <div class="cp-hero__actions">
        <a class="btn" href="#partner-grid">
          Explore Partnerships
        </a>
        <a
          class="btn btn--outline on-dark"
          href={FORM_URL}
          target="_blank"
          rel="noopener"
        >
          Partnership Opportunities
        </a>
      </div>
    </div>
  </section>

  <section class="cp-proof">
    <div class="container">
      <div class="cp-heading">
        <p class="eyebrow">Why Partner With Sigma Gamma Rho</p>
        <h2>
          Reach, Programs, <span>and Presence.</span>
        </h2>
      </div>
      <ul class="cp-proof__row">
        {proof.map((x) => (
          <li>
            <h3>{x.title}</h3>
            <p>{x.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="cp-alliances">
    <div class="container">
      <div class="cp-heading">
        <p class="eyebrow">Strategic Alliances</p>
        <h2>
          Partnerships Built Into <span>National Programs</span>
        </h2>
      </div>
      <ul class="cp-alliances__row">
        {collabs.map((c) => (
          <li class="cp-alliance">
            <div class="cp-logo cp-logo--lg">
              <img src={withBase(c.logo)} alt={`${c.partner} logo`} loading="lazy" decoding="async" />
            </div>
            <span class="cp-badge">{c.kicker}</span>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
            <a href={withBase(c.link)}>
              {c.label} <span aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="cp-partners" id="partner-grid">
    <div class="container">
      <div class="cp-heading">
        <p class="eyebrow">Our Partners</p>
        <h2>
          Working Together for <span>Greater Progress</span>
        </h2>
        <p>
          Current partnerships span health, education, civil rights, financial literacy, community
          service, retail, culture, and member development.
        </p>
      </div>

      {[
        { title: "Corporate Partners", list: corporate },
        { title: "Health & Community Partners", list: community },
      ].map((tier) => (
        <div class="cp-tier">
          <h3 class="cp-tier__title">{tier.title}</h3>
          <ul class="cp-grid">
            {tier.list.map((x) => (
              <li class="partner-card">
                <div class="cp-logo">
                  <img src={withBase(x.logo)} alt={`${x.name} logo`} loading="lazy" decoding="async" />
                </div>
                <p class="partner-card__type">{x.type}</p>
                <h4>{x.name}</h4>
                <p>{x.note}</p>
                <span class="partner-card__tag">{x.tag}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="cp-allied">
    <div class="container cp-allied__inner">
      <div>
        <p class="eyebrow">Allied Foundations</p>
        <h2>Philanthropy Through Our Foundations</h2>
        <p>
          The National Education Fund, SPEAR Foundation, and Seven Pearls Foundation extend the
          Sorority's work in education, research, and community support.
        </p>
      </div>
      <ul class="cp-allied__logos">
        {allied.map((f) => (
          <li>
            <a href={withBase(`/service-impact/partner-foundations/#${f.id}`)}>
              <img src={withBase(f.logo)} alt={f.name} width="88" height="88" loading="lazy" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="cp-inquire">
    <div class="container cp-inquire__inner">
      <div>
        <h2>Start a Partnership Conversation</h2>
        <p>
          Tell us about your organization and goals. The partnership form goes directly to
          International Corporate Headquarters.
        </p>
      </div>
      <div class="cp-inquire__actions">
        <a class="btn" href={FORM_URL} target="_blank" rel="noopener">
          Submit a Partnership Inquiry <span aria-hidden="true">&#8599;</span>
        </a>
        <a class="btn btn--outline" href="mailto:help@sgrho1922.org">Email help@sgrho1922.org</a>
      </div>
    </div>
  </section>

</Base>

<style>
  .cp-hero {
    background: var(--grad-royal);
    color: #fff;
  }
  .cp-hero__inner {
    padding-block: clamp(3.5rem, 6vw, 5rem);
    max-width: 48rem;
  }
  .cp-hero h1 {
    color: #fff;
    margin: var(--space-2) 0 0;
  }
  .cp-hero h1 span {
    color: var(--gold);
  }
  .cp-hero > .container > p:not(.eyebrow) {
    color: rgba(255, 255, 255, 0.85);
  }
  .cp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  /* ---- proof: three columns, hairline dividers ---- */
  .cp-proof {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .cp-proof__row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--line);
  }
  .cp-proof__row li {
    padding: var(--space-8) var(--space-6);
  }
  .cp-proof__row li + li {
    border-left: 1px solid var(--line);
  }
  .cp-proof__row h3 {
    margin: 0 0 var(--space-3);
    color: var(--royal);
    font-size: var(--text-lg);
  }
  .cp-proof__row p {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 820px) {
    .cp-proof__row {
      grid-template-columns: 1fr;
      border-bottom: 0;
    }
    .cp-proof__row li,
    .cp-proof__row li + li {
      padding-inline: 0;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }
  }

  /* ---- logo boxes: fixed height, centred, greyscale until hover ---- */
  .cp-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 64px;
    margin-bottom: var(--space-4);
  }
  .cp-logo img {
    max-height: 56px;
    max-width: 160px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.85;
    transition:
      filter 0.2s ease,
      opacity 0.2s ease;
  }
  .partner-card:hover .cp-logo img,
  .cp-alliance:hover .cp-logo img,
  .cp-alliance:focus-within .cp-logo img {
    filter: none;
    opacity: 1;
  }
  .cp-logo--lg {
    height: 96px;
  }
  .cp-logo--lg img {
    max-height: 88px;
    max-width: 200px;
  }
  @media (prefers-reduced-motion: reduce) {
    .cp-logo img {
      transition: none;
    }
  }

  /* ---- strategic alliances ---- */
  .cp-alliances {
    background: var(--cream);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .cp-alliances__row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cp-alliance {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
  }
  .cp-badge {
    align-self: center;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--gold);
    border-radius: 999px;
    color: var(--royal);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .cp-alliance h3 {
    margin: var(--space-4) 0 var(--space-2);
    color: var(--royal);
    font-size: var(--text-md);
    text-align: center;
  }
  .cp-alliance p {
    margin: 0 0 var(--space-5);
    color: var(--muted);
    font-size: var(--text-sm);
    text-align: center;
  }
  .cp-alliance a {
    margin-top: auto;
    align-self: center;
    color: var(--royal);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  @media (max-width: 900px) {
    .cp-alliances__row {
      grid-template-columns: 1fr;
    }
  }

  .cp-partners {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .cp-heading {
    max-width: 50rem;
    margin: 0 auto var(--space-10);
    text-align: center;
  }
  .cp-heading h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .cp-heading h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .cp-heading > p {
    color: var(--muted);
    margin-top: var(--space-4);
  }
  .cp-tier + .cp-tier {
    margin-top: var(--space-12);
  }
  .cp-tier__title {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0 0 var(--space-6);
    color: var(--royal);
    font-size: var(--text-lg);
  }
  .cp-tier__title::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  .cp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .partner-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .partner-card .cp-logo {
    justify-content: flex-start;
    margin-bottom: var(--space-2);
  }
  .partner-card__type {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0;
  }
  .partner-card h4 {
    margin: 0;
    font-size: var(--text-md);
  }
  .partner-card p {
    color: var(--muted);
    font-size: var(--text-sm);
    margin: 0;
  }
  /* Only the description absorbs spare height, so every card's label and
     name sit on the same lines and the tags share a baseline. */
  .partner-card p:not([class]) {
    flex: 1;
  }
  .partner-card__tag {
    align-self: flex-start;
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgba(32, 65, 165, 0.1);
    color: var(--royal);
  }

  /* ---- allied foundations: light, not a navy stripe ---- */
  .cp-allied {
    background: var(--cream);
    padding-block: clamp(3rem, 5vw, 4rem);
  }
  .cp-allied__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-10);
    align-items: center;
  }
  .cp-allied h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .cp-allied p:not(.eyebrow) {
    margin: var(--space-3) 0 0;
    color: var(--muted);
    max-width: 36rem;
  }
  .cp-allied__logos {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cp-allied__logos a {
    display: grid;
    place-items: center;
    width: 120px;
    height: 120px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    transition: border-color 0.2s ease;
  }
  .cp-allied__logos a:hover {
    border-color: var(--royal);
  }
  .cp-allied__logos img {
    width: 88px;
    height: 88px;
    object-fit: contain;
  }
  @media (max-width: 900px) {
    .cp-allied__inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .cp-allied__logos {
      gap: var(--space-3);
    }
    .cp-allied__logos a {
      width: 88px;
      height: 88px;
    }
    .cp-allied__logos img {
      width: 68px;
      height: 68px;
    }
  }

  /* ---- inquiry ---- */
  .cp-inquire {
    background: var(--white);
    padding-block: clamp(3rem, 5vw, 4rem);
  }
  .cp-inquire__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6) var(--space-10);
    padding: var(--space-8);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .cp-inquire h2 {
    margin: 0;
    font-size: var(--text-h3);
  }
  .cp-inquire p {
    margin: var(--space-3) 0 0;
    color: var(--muted);
    max-width: 36rem;
  }
  .cp-inquire__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
</style>
