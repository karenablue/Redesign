---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import SigmaRule from "../../components/SigmaRule.astro";
import { withBase } from "../../lib/url.js";
import { reg } from "../../lib/reg.js";

const affiliates = [
  {
    key: "rhosebuds",
    name: "Rhosebuds",
    short: "Rhosebuds",
    age: "Ages 8–11",
    logo: "/images/affiliates/rhosebuds.png",
    meta: "Youth affiliate",
    lead: "The earliest step in the Sigma Gamma Rho affiliate journey—introducing girls to sisterhood years before they're old enough to join a Rhoer Club®.",
    body: "Sigma Gamma Rho members serve as mentors, guiding each Rhosebud toward becoming a well-rounded young woman equipped to succeed academically and give back to her community. Activities are age-appropriate and hands-on, laying an early foundation in self-confidence, creativity, and civic awareness.",
    facts: [
      ["Colors", "Light Blue and Yellow"],
      ["Flower", "Yellow Rosebud"],
    ],
    focus: ["Confidence", "Character", "Creativity", "Service"],
  },
  {
    key: "rhoers",
    name: "Rhoer Club®",
    short: "Rhoers",
    age: "Ages 12–18",
    logo: "/images/affiliates/rhoers.png",
    meta: "Founded 1939",
    lead: "Carrying Founder Mary Lou Allison Gardner Little's original vision for youth development into a new generation of Rhoers.",
    body: "Rhoer Clubs are sponsored by local alumnae chapters and operate at the local, regional, and national level, numbering more than 500 worldwide. The program blends academic and personal counseling with a rites-of-passage curriculum, preparing members for adulthood with confidence and a lasting commitment to service.",
    facts: [
      ["Founded", "1939, 14th Boulé, New York City"],
      ["Colors", "Royal Blue and Gold"],
      ["Flower", "Yellow Daisy"],
      ["Mascot", "Monarch Butterfly"],
    ],
    focus: ["Mentorship", "Leadership", "Education", "Community Service"],
  },
  {
    key: "philos",
    name: "Philo Affiliate®",
    short: "Philos",
    age: "Adult women",
    logo: "/images/affiliates/philos.png",
    meta: "Friends of Sigma • Founded 1980",
    lead: "Professional women who are not college-initiated members but who actively support the Sorority's mission and programs.",
    body: 'Sigma Gamma Rho has worked with non-Greek-affiliated women throughout its history. Beginning in 1943, these supporters were organized into local auxiliary groups under a range of local names, with early roots in the Galveston–Houston area; in 1954 the Sorority formally adopted "Philo"—from the Greek for "friend"—as the affiliate\'s official designation, and in 1980 it became a national organization under Evelyn H. Hood, the Sorority\'s 14th International Grand Basileus. It has since grown to more than 1,000 members across the United States and internationally, working alongside the Sorority on service projects, educational and cultural programming, community outreach, and fundraising.',
    facts: [
      ["1943", "Early auxiliary roots in the Galveston–Houston area"],
      ["1954", '"Philo" officially adopted'],
      ["1980", "Organized nationally under Evelyn H. Hood"],
      ["Colors", "Gold and White"],
      ["Flower", "White Carnation, Gold Ribbon"],
    ],
    focus: ["Volunteer Service", "Community Impact", "Leadership", "Support of Sigma Programs"],
  },
];
---

<Base
  title="Affiliates"
  activeTop="Membership & Intake"
  description="Rhosebuds, Rhoers, and Philos — Sigma Gamma Rho's three affiliate experiences for youth development, leadership, and community partnership."
>
  <PageHero
    stack
    eyebrow="Membership • Affiliates"
    title="Growing in service."
    highlight="Connected to Sigma."
    copy="Our affiliate structure extends development, service, mentorship, and community connection beyond initiated membership—meeting girls and women at distinct stages of life."
    image="/optimized/hero-philos.webp"
    focal="50% 30%"
    jumpLabel="Affiliate groups"
    jump={affiliates.map((a) => ({ href: `#${a.key}`, label: a.short }))}
  />

  <SigmaRule />

  <section class="aff-intro">
    <div class="container aff-intro__grid">
      <div>
        <p class="eyebrow">Three Affiliate Experiences</p>
        <h2>
          Different stages. <span>Shared purpose.</span>
        </h2>
      </div>
      <p>
        Rhosebuds, Rhoers, and Philos® each have a distinct role. Together, they reflect Sigma Gamma
        Rho's long-standing commitment to youth development, leadership, service, and community
        partnership.
      </p>
    </div>
  </section>

  <section class="aff-showcase">
    <div class="container">
      <p class="eyebrow">The Affiliate Pathway</p>
      <h2 class="aff-path__title">
        From girlhood <span>to lifelong friendship.</span>
      </h2>
      <ol class="aff-path">
        {affiliates.map((a) => (
          <li class="aff-path__step">
            <a href={`#${a.key}`}>
              <img src={withBase(a.logo)} alt="" width="64" height="64" loading="lazy" />
              <span class="aff-path__name" set:html={reg(a.name)} />
              <span class="aff-badge">{a.age}</span>
            </a>
          </li>
        ))}
      </ol>

      <div class="aff-stages">
        {affiliates.map((a) => (
          <article class="aff-stage" id={a.key}>
            <figure class="aff-stage__media">
              <img
                src={withBase(a.logo)}
                alt={`Sigma Gamma Rho ${a.short} Affiliate logo`}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="aff-stage__body">
              <div class="aff-stage__copy">
                <p class="aff-stage__meta">
                  <span class="aff-badge">{a.age}</span>
                  <span>{a.meta}</span>
                </p>
                <h3 set:html={reg(a.name)} />
                <p class="aff-lead">{a.lead}</p>
                <p>{a.body}</p>
                <a class="btn btn--outline" href={withBase("/membership/chapter-locator/")}>
                  Find a Chapter for {a.short}
                </a>
              </div>
              <div class="aff-stage__side">
                <dl class="aff-facts">
                  {a.facts.map(([k, v]) => (
                    <>
                      <dt>{k}</dt>
                      <dd>{v}</dd>
                    </>
                  ))}
                </dl>
                <div class="aff-focus">
                  {a.focus.map((f) => (
                    <span>{f}</span>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="aff-cta">
    <div class="container aff-cta__inner">
      <div>
        <p class="eyebrow eyebrow--light">Find Your Connection</p>
        <h2>Interested in an affiliate near you?</h2>
        <p>
          Affiliate participation is coordinated through chapters and regional structures. Start by
          locating a Sigma Gamma Rho chapter in your area.
        </p>
      </div>
      <a class="btn" href={withBase("/membership/chapter-locator/")}>
        Find a Chapter <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
</Base>

<style>

  .aff-intro {
    background: var(--white);
    padding-block: clamp(3rem, 5vw, 4rem);
  }
  .aff-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-12);
    align-items: start;
  }
  .aff-intro__grid h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .aff-intro__grid h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .aff-intro__grid > p {
    color: var(--muted);
  }
  @media (max-width: 780px) {
    .aff-intro__grid {
      grid-template-columns: 1fr;
    }
  }

  .aff-showcase {
    background: var(--cream);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .aff-path__title {
    margin: var(--space-2) 0 var(--space-8);
    font-size: var(--text-h3);
  }
  .aff-path__title span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  /* Three stages joined by a gold line: the order is the point. */
  .aff-path {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
  }
  .aff-path__step {
    position: relative;
  }
  .aff-path__step + .aff-path__step::before {
    content: "";
    position: absolute;
    top: 50%;
    right: 100%;
    width: var(--space-8);
    height: 1px;
    background: var(--gold);
  }
  .aff-path__step a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    text-align: center;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }
  .aff-path__step a:hover {
    border-color: var(--royal);
  }
  .aff-path__step img {
    width: 64px;
    height: 64px;
    object-fit: contain;
  }
  .aff-path__name {
    color: var(--royal);
    font-weight: 700;
    font-size: var(--text-md);
  }
  .aff-badge {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--tint);
    color: var(--royal);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: normal;
    text-transform: none;
    white-space: nowrap;
  }

  .aff-stage {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.4fr);
    gap: var(--space-14);
    align-items: start;
    padding-block: var(--space-12);
    scroll-margin-top: 72px;
  }
  .aff-stage + .aff-stage {
    border-top: 1px solid var(--line);
  }
  .aff-stage__media {
    margin: 0;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-10);
    display: grid;
    place-items: center;
  }
  .aff-stage__media img {
    max-width: 160px;
  }
  .aff-stage__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    color: var(--muted-2);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .aff-stage__body {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-10);
  }
  .aff-stage__copy h3 {
    margin: var(--space-3) 0 0;
    color: var(--royal);
    font-family: var(--font-head);
    font-weight: 400;
    font-size: var(--text-h3);
  }
  .aff-lead {
    font-weight: 700;
    color: var(--ink);
  }
  .aff-stage__copy > p:not(.aff-stage__meta, .aff-lead) {
    color: var(--muted);
  }
  .aff-facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.3rem var(--space-3);
    margin: 0 0 var(--space-5);
  }
  .aff-facts dt {
    font-weight: 700;
    color: var(--royal);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }
  .aff-facts dd {
    margin: 0 0 var(--space-2);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .aff-focus {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .aff-focus span {
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: rgba(223, 177, 54, 0.15);
    color: var(--accent-text);
  }
  @media (max-width: 900px) {
    .aff-stage,
    .aff-stage__body {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .aff-stage__media {
      padding: var(--space-6);
    }
    .aff-stage__media img {
      max-width: 120px;
    }
  }
  @media (max-width: 680px) {
    .aff-path {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .aff-path__step + .aff-path__step::before {
      top: auto;
      bottom: 100%;
      right: auto;
      left: 50%;
      width: 1px;
      height: var(--space-5);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aff-path__step a {
      transition: none;
    }
  }

  .aff-cta {
    background: var(--grad-royal);
    color: #fff;
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }
  .aff-cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }
  .aff-cta h2 {
    color: #fff;
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .aff-cta p {
    color: rgba(255, 255, 255, 0.85);
    margin-top: var(--space-3);
    max-width: 32rem;
  }
  .eyebrow--light {
    color: var(--gold);
  }
</style>
