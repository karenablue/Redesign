---
import Base from "../../layouts/Base.astro";
import SigmaRule from "../../components/SigmaRule.astro";
import { withBase } from "../../lib/url.js";

const affiliates = [
  {
    key: "rhosebuds",
    num: "01",
    name: "Rhosebuds",
    age: "Ages 8–11",
    logo: "/images/SGR-Affiliate-Logo-Rhosebuds.png",
    kicker: "Ages 8–11",
    lead: "The earliest step in the Sigma Gamma Rho affiliate journey—introducing girls to sisterhood years before they're old enough to join a Rhoer Club.",
    body: "Sigma Gamma Rho members serve as mentors, guiding each Rhosebud toward becoming a well-rounded young woman equipped to succeed academically and give back to her community. Activities are age-appropriate and hands-on, laying an early foundation in self-confidence, creativity, and civic awareness.",
    facts: [
      ["Colors", "Light Blue and Yellow"],
      ["Flower", "Yellow Rosebud"],
    ],
    focus: ["Confidence", "Character", "Creativity", "Service"],
  },
  {
    key: "rhoers",
    num: "02",
    name: "Rhoers",
    age: "Ages 12–18",
    logo: "/images/SGR-Affiliate-Logo-Rhoers.png",
    kicker: "Ages 12–18 • Founded 1939",
    lead: "Carrying Founder Mary Lou Allison Gardner Little's original vision for youth development into a new generation of Rhoers.",
    body: "Rhoer Clubs are sponsored by local alumnae chapters and operate at the local, regional, and national level, numbering more than 500 worldwide. The program blends academic and personal counseling with a rites-of-passage curriculum, preparing members for adulthood with confidence and a lasting commitment to service.",
    facts: [
      ["Founded", "1939, 14th Boulé, New York City"],
      ["Colors", "Royal Blue and Gold"],
      ["Flower", "Yellow Daisy"],
      ["Mascot", "Monarch Butterfly"],
    ],
    focus: ["Mentorship", "Leadership", "Education", "Community Service"],
  },
  {
    key: "philos",
    num: "03",
    name: "Philos",
    age: "Friends of Sigma",
    logo: "/images/SGR-Affiliate-Logo-Philos.png",
    kicker: "Friends of Sigma • Founded 1980",
    lead: "Professional women who are not college-initiated members but who actively support the Sorority's mission and programs.",
    body: 'Sigma Gamma Rho has worked with non-Greek-affiliated women throughout its history. Beginning in 1943, these supporters were organized into local auxiliary groups under a range of local names, with early roots in the Galveston–Houston area; in 1954 the Sorority formally adopted "Philo"—from the Greek for "friend"—as the affiliate\'s official designation, and in 1980 it became a national organization under Evelyn H. Hood, the Sorority\'s 14th International Grand Basileus. It has since grown to more than 1,000 members across the United States and internationally, working alongside the Sorority on service projects, educational and cultural programming, community outreach, and fundraising.',
    facts: [
      ["1943", "Early auxiliary roots in the Galveston–Houston area"],
      ["1954", '"Philo" officially adopted'],
      ["1980", "Organized nationally under Evelyn H. Hood"],
      ["Colors", "Gold and White"],
      ["Flower", "White Carnation, Gold Ribbon"],
    ],
    focus: ["Volunteer Service", "Community Impact", "Leadership", "Support of Sigma Programs"],
  },
];
---

<Base
  title="Affiliates"
  activeTop="Membership"
  description="Rhosebuds, Rhoers, and Philos — Sigma Gamma Rho's three affiliate experiences for youth development, leadership, and community partnership."
>
  <section class="aff-hero on-dark">
    <div class="container aff-hero__inner">
      <p class="eyebrow">Membership • Affiliates</p>
      <h1>
        Growing in Service.
        <br />
        <span>Connected to Sigma.</span>
      </h1>
      <div class="gold-rule"></div>
      <p>
        Our affiliate structure extends development, service, mentorship, and community connection
        beyond initiated membership—meeting girls and women at distinct stages of life.
      </p>
      <nav class="aff-hero__nav">
        {affiliates.map((a) => (
          <a href={`#panel-${a.key}`} data-jump={a.key}>
            {a.name}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <SigmaRule />

  <section class="aff-intro">
    <div class="container aff-intro__grid">
      <div>
        <p class="eyebrow">Three Affiliate Experiences</p>
        <h2>
          Different stages. <span>Shared purpose.</span>
        </h2>
      </div>
      <p>
        Rhosebuds, Rhoers, and Philos each have a distinct role. Together, they reflect Sigma Gamma
        Rho's long-standing commitment to youth development, leadership, service, and community
        partnership.
      </p>
    </div>
  </section>

  <section class="aff-showcase">
    <div class="container">
      <div class="aff-tabs" role="tablist">
        {affiliates.map((a, i) => (
          <button
            type="button"
            class:list={["aff-tab", { "is-active": i === 0 }]}
            data-tab={a.key}
            role="tab"
            aria-selected={i === 0}
          >
            <span class="aff-tab__num">{a.num}</span>
            <span class="aff-tab__name">{a.name}</span>
            <span class="aff-tab__age">{a.age}</span>
          </button>
        ))}
      </div>

      {affiliates.map((a, i) => (
        <div
          class:list={["aff-panel", { "is-active": i === 0 }]}
          id={`panel-${a.key}`}
          role="tabpanel"
        >
          <figure class="aff-panel__media">
            <img src={withBase(a.logo)} alt={`Sigma Gamma Rho ${a.name} Affiliate logo`} loading="lazy" decoding="async" />
          </figure>
          <div class="aff-panel__body">
            <div class="aff-panel__copy">
              <p class="eyebrow">{a.kicker}</p>
              <h2>
                {a.name} <span>Affiliate</span>
              </h2>
              <p class="aff-lead">{a.lead}</p>
              <p>{a.body}</p>
            </div>
            <div class="aff-panel__side">
              <dl class="aff-facts">
                {a.facts.map(([k, v]) => (
                  <>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </>
                ))}
              </dl>
              <div class="aff-focus">
                {a.focus.map((f) => (
                  <span>{f}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="aff-cta">
    <div class="container aff-cta__inner">
      <div>
        <p class="eyebrow eyebrow--light">Find Your Connection</p>
        <h2>Interested in an affiliate near you?</h2>
        <p>
          Affiliate participation is coordinated through chapters and regional structures. Start by
          locating a Sigma Gamma Rho chapter in your area.
        </p>
      </div>
      <a class="btn" href={withBase("/membership/chapter-locator/")}>
        Find a Chapter <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .aff-hero {
    background: var(--grad-royal);
    color: #fff;
  }
  .aff-hero__inner {
    padding-block: clamp(3.5rem, 6vw, 5rem);
    max-width: 46rem;
  }
  .aff-hero h1 {
    color: #fff;
    margin: var(--space-2) 0 0;
  }
  .aff-hero h1 span {
    color: var(--gold);
  }
  .aff-hero > .container > p:not(.eyebrow) {
    color: rgba(255, 255, 255, 0.85);
  }
  .aff-hero__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-8);
  }
  .aff-hero__nav a {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
  }
  .aff-hero__nav a:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--gold-text);
  }

  .aff-intro {
    background: var(--white);
    padding-block: clamp(3rem, 5vw, 4rem);
  }
  .aff-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-12);
    align-items: start;
  }
  .aff-intro__grid h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .aff-intro__grid h2 span {
    color: var(--gold-text);
  }
  .aff-intro__grid > p {
    color: var(--muted);
  }
  @media (max-width: 780px) {
    .aff-intro__grid {
      grid-template-columns: 1fr;
    }
  }

  .aff-showcase {
    background: var(--cream);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .aff-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
  }
  .aff-tab {
    flex: 1;
    min-width: 160px;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: var(--space-4) var(--space-5);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    cursor: pointer;
    text-align: left;
  }
  .aff-tab.is-active {
    border-color: var(--royal);
    background: var(--royal);
  }
  .aff-tab__num {
    font-family: var(--font-label);
    color: var(--gold-text);
    font-size: var(--text-sm);
  }
  /* The active tab's ground flips to royal, where the dark type-safe gold
     drops to 3.4:1 — full-chroma bright gold reads 5.8:1 there. */
  .aff-tab.is-active .aff-tab__num {
    color: var(--gold-bright);
  }
  .aff-tab__name {
    font-weight: 700;
    color: var(--royal);
  }
  .aff-tab.is-active .aff-tab__name {
    color: #fff;
  }
  .aff-tab__age {
    font-size: var(--text-xs);
    color: var(--muted-2);
  }
  .aff-tab.is-active .aff-tab__age {
    color: rgba(255, 255, 255, 0.75);
  }

  .aff-panel {
    display: none;
  }
  .aff-panel.is-active {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.4fr);
    gap: var(--space-14);
    align-items: center;
  }
  .aff-panel__media {
    margin: 0;
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: var(--space-10);
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-md);
  }
  .aff-panel__media img {
    max-width: 160px;
  }
  .aff-panel__body {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-10);
  }
  .aff-panel__copy h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .aff-panel__copy h2 span {
    color: var(--gold-text);
  }
  .aff-lead {
    font-weight: 700;
    color: var(--ink);
  }
  .aff-panel__copy > p:not(.eyebrow, .aff-lead) {
    color: var(--muted);
  }
  .aff-facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.3rem var(--space-3);
    margin: 0 0 var(--space-5);
  }
  .aff-facts dt {
    font-weight: 700;
    color: var(--royal);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }
  .aff-facts dd {
    margin: 0 0 var(--space-2);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .aff-focus {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .aff-focus span {
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: rgba(223, 177, 54, 0.15);
    color: var(--gold-text);
  }
  @media (max-width: 900px) {
    .aff-panel.is-active {
      grid-template-columns: 1fr;
    }
    .aff-panel__body {
      grid-template-columns: 1fr;
    }
    .aff-panel__media img {
      max-width: 120px;
    }
  }

  .aff-cta {
    background: var(--grad-royal);
    color: #fff;
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }
  .aff-cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }
  .aff-cta h2 {
    color: #fff;
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .aff-cta p {
    color: rgba(255, 255, 255, 0.85);
    margin-top: var(--space-3);
    max-width: 32rem;
  }
  .eyebrow--light {
    color: var(--gold-bright);
  }
</style>

<script>
  const tabs = document.querySelectorAll(".aff-tab");
  const panels = document.querySelectorAll(".aff-panel");
  const jumps = document.querySelectorAll("[data-jump]");

  function activate(key: string) {
    tabs.forEach((t) => {
      const on = (t as HTMLElement).dataset.tab === key;
      t.classList.toggle("is-active", on);
      t.setAttribute("aria-selected", String(on));
    });
    panels.forEach((p) => p.classList.toggle("is-active", p.id === `panel-${key}`));
  }

  tabs.forEach((tab) =>
    tab.addEventListener("click", () => activate((tab as HTMLElement).dataset.tab ?? ""))
  );
  jumps.forEach((link) =>
    link.addEventListener("click", () => activate((link as HTMLElement).dataset.jump ?? ""))
  );
</script>
