---
/**
 * Find a Chapter — ported from the original membership/chapter-locator/chapterlocator.html.
 *
 * Deliberately does NOT fabricate a chapter dataset. The original design is
 * explicit that the map/search panel is a placeholder awaiting a real chapter
 * directory feed, and that the actual working path today is the five real
 * regional locator sites linked below. Reproduce that honesty rather than
 * inventing sample chapters to make the search "look" functional.
 */
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/url.js";

const regions = [
  {
    name: "Central",
    img: "/images/Central Region.png",
    body: "Serving undergraduate and alumnae chapters across the central United States.",
    href: "https://www.sgrhocentral.com/chapter-locator",
  },
  {
    name: "Northeastern",
    img: "/images/Northeastern Region.jpg",
    body: "Serving chapters across the northeastern United States and affiliated international areas.",
    href: "https://www.sgrhoneregion.org/chapter-locator-2",
  },
  {
    name: "Southeastern",
    img: "/images/Southeastern Region.jpg",
    body: "Alabama, The Bahamas, Florida, Georgia, Mississippi, South Carolina, Tennessee, and the U.S. Virgin Islands.",
    href: "https://www.seregionsgrho.org/team-3",
  },
  {
    name: "Southwestern",
    img: "/images/Southwestern Region.jpg",
    body: "Serving chapters throughout the southwestern United States and affiliated areas.",
    href: "https://www.sigmaswregion.com/locate",
  },
  {
    name: "Western",
    img: "/images/Western Region.jpg",
    body: "Serving chapters across the western United States and affiliated international areas.",
    href: "https://www.westernsgrho.org/wr-chapter-directory",
  },
];
---

<Base
  title="Chapter Locator"
  activeTop="Membership"
  description="Find Sigma Gamma Rho Sorority, Incorporated undergraduate and alumnae chapters across the Sorority's five regions."
>
  <section class="locator-hero on-dark">
    <div class="locator-hero__grid" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="eyebrow">Membership &bull; Chapter Locator</p>
      <h1 class="hero-inner__title">
        Find Your Place
        <br />
        <span>in the Sisterhood.</span>
      </h1>
      <div class="gold-rule"></div>
      <p class="hero-lead">
        Sigma Gamma Rho is organized across five regions, with undergraduate and alumnae chapters
        serving campuses and communities throughout the United States and internationally. Start on
        the map below.
      </p>
    </div>
    <div class="hero-word" aria-hidden="true">
      CHAPTERS
    </div>
  </section>

  <div class="sigma-rule sigma-rule-gold" aria-hidden="true">
    <span class="sigma-line"></span>
    <span class="sigma-medallion">&Sigma;</span>
    <span class="sigma-line"></span>
  </div>

  <section class="directory-section">
    <div class="container directory-shell">
      <div class="directory-heading">
        <p class="eyebrow">National Directory</p>
        <h2>
          The Map Is Your <span>Starting Point.</span>
        </h2>
        <p>
          Search by location or university to find the nearest undergraduate or alumnae chapter.
          Regional directories below remain the authoritative path for current chapter listings.
        </p>
        <div class="filter-group" role="group" aria-label="Chapter filters">
          <button class="filter is-active" type="button" data-filter="all">
            All Chapters
          </button>
          <button class="filter" type="button" data-filter="alumnae">
            Alumnae
          </button>
          <button class="filter" type="button" data-filter="undergraduate">
            Undergraduate
          </button>
        </div>
      </div>

      <div class="directory-display">
        <div class="map-panel">
          <div class="map-grid" aria-hidden="true"></div>

          <div class="map-search">
            <form class="locator-search" id="chapter-search-form">
              <label class="visually-hidden" for="chapter-search">
                Search chapters
              </label>
              <div class="search-field">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="10.5" cy="10.5" r="6.5"></circle>
                  <path d="M15.5 15.5 21 21"></path>
                </svg>
                <input
                  id="chapter-search"
                  name="chapterSearch"
                  type="search"
                  placeholder="City, State, ZIP Code, or University"
                  autocomplete="off"
                />
              </div>
              <button class="search-button" type="submit">
                Search Chapters
              </button>
            </form>
            <p class="search-note" id="search-message" aria-live="polite">
              Search interface ready for the national chapter dataset.
            </p>
          </div>

          <div class="map-copy">
            <span class="map-pin">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 22s7-6.1 7-13A7 7 0 1 0 5 9c0 6.9 7 13 7 13Z"></path>
                <circle cx="12" cy="9" r="2.4"></circle>
              </svg>
            </span>
            <strong>Interactive Chapter Map</strong>
            <p>
              This area is ready for a chapter dataset and mapping service when you connect one.
            </p>
          </div>

          <div class="map-legend">
            <span>
              <i class="legend-dot legend-dot--alumnae"></i> Alumnae
            </span>
            <span>
              <i class="legend-dot legend-dot--undergraduate"></i> Undergraduate
            </span>
          </div>
        </div>

        <div class="results-panel">
          <p class="directory-label">Chapter Results</p>
          <div class="empty-state" id="empty-state">
            <span class="empty-sigma" aria-hidden="true">
              &Sigma;
            </span>
            <h3>Search by location or university.</h3>
            <p>
              Matching chapter results will populate here after the national dataset is connected.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="sigma-rule sigma-rule-royal" aria-hidden="true">
    <span class="sigma-line"></span>
    <span class="sigma-medallion">&Sigma;</span>
    <span class="sigma-line"></span>
  </div>

  <section class="regions-section">
    <div class="container regions-heading">
      <span class="heading-sigma" aria-hidden="true">
        &Sigma;
      </span>
      <p class="eyebrow">Supplemental &bull; Five Regions</p>
      <h2>
        Or Browse Sigma Gamma Rho <span>by Region.</span>
      </h2>
      <p>
        Each region maintains its own chapter directory and regional leadership structure. Select a
        region below to continue to its official chapter information.
      </p>
    </div>

    <div class="container region-showcase">
      {regions.map((r) => (
        <article class="region-card">
          <div class="region-art">
            <img src={withBase(r.img)} alt={`Sigma Gamma Rho ${r.name} Region logo`} loading="lazy" decoding="async" />
          </div>
          <div class="region-copy">
            <p class="region-kicker">{r.name} Region</p>
            <h3>{r.name}</h3>
            <p>{r.body}</p>
            <a href={r.href} target="_blank" rel="noopener">
              View {r.name} Chapters <span aria-hidden="true">&#8599;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="membership-bridge on-dark">
    <div class="container membership-bridge__inner">
      <div>
        <p class="eyebrow eyebrow--light">Prospective Membership</p>
        <h2>
          Looking for a chapter because you are <span>considering membership?</span>
        </h2>
        <p>
          Review membership eligibility and expectations before contacting a chapter. The membership
          page explains undergraduate and alumnae pathways, standards, frequently asked questions,
          and official process.
        </p>
      </div>
      <a href={withBase("/membership/become-a-member/")} class="gold-button">
        Review Membership
      </a>
    </div>
  </section>
</Base>

<style>
  /* ---- hero ---- */
  .locator-hero {
    position: relative;
    overflow: hidden;
    color: #fff;
    background: linear-gradient(200deg, #17357f 0%, var(--royal-mid) 45%, #07142e 100%);
  }
  .locator-hero__grid {
    position: absolute;
    inset: 0;
    opacity: 0.06;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.22) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.22) 1px, transparent 1px);
    background-size: 68px 68px;
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(3.5rem, 7vw, 4.5rem);
    max-width: 56rem;
  }
  .hero-inner__title {
    max-width: 780px;
    margin: 0;
    color: #fff;
    font-family: var(--font-head);
    font-weight: 400;
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    line-height: 1;
  }
  .hero-inner__title span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .hero-lead {
    max-width: 42rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.92);
    font-size: var(--text-lg);
    line-height: 1.62;
  }
  .hero-word {
    position: absolute;
    right: -0.5rem;
    bottom: -2.5rem;
    z-index: 1;
    color: rgba(255, 255, 255, 0.03);
    font-size: clamp(6rem, 15vw, 13rem);
    font-weight: 700;
    letter-spacing: -0.05em;
  }

  /* ---- sigma dividers ---- */
  .sigma-rule {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    max-width: 74rem;
    margin-inline: auto;
    padding-block: var(--space-10);
  }
  .sigma-rule-gold {
    background: var(--navy);
  }
  .sigma-rule-royal {
    background: var(--white);
  }
  .sigma-line {
    flex: 1;
    height: 1px;
  }
  .sigma-rule-gold .sigma-line {
    background: linear-gradient(90deg, transparent, var(--gold));
  }
  .sigma-rule-gold .sigma-line:last-child {
    background: linear-gradient(270deg, transparent, var(--gold));
  }
  .sigma-rule-royal .sigma-line {
    background: linear-gradient(90deg, transparent, var(--royal));
  }
  .sigma-rule-royal .sigma-line:last-child {
    background: linear-gradient(270deg, transparent, var(--royal));
  }
  .sigma-medallion {
    width: 3.25rem;
    height: 3.25rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 1.4rem;
  }
  .sigma-rule-gold .sigma-medallion {
    color: var(--accent-text);
    border: 1px solid var(--gold);
  }
  .sigma-rule-royal .sigma-medallion {
    color: var(--royal);
    border: 1px solid var(--royal);
  }

  /* ---- directory section ---- */
  .directory-section {
    background: var(--tint);
  }
  .directory-shell {
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: var(--space-16);
    align-items: start;
  }
  .directory-heading h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .directory-heading h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .directory-heading > p:not(.eyebrow) {
    color: var(--muted);
    margin-top: var(--space-4);
  }
  .filter-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }
  .filter {
    min-height: 37px;
    padding: 0 0.9rem;
    border: 1px solid var(--line);
    color: var(--royal);
    background: transparent;
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
    border-radius: var(--radius);
  }
  .filter.is-active,
  .filter:hover {
    color: #fff;
    background: var(--royal);
    border-color: var(--royal);
  }
  .directory-display {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    min-height: 32rem;
  }
  .map-panel {
    position: relative;
    overflow: hidden;
    color: #fff;
    background:
      linear-gradient(rgba(32, 65, 165, 0.88), rgba(7, 20, 46, 0.91)),
      linear-gradient(135deg, #2041a5, #07142e);
    min-height: 32rem;
  }
  .map-grid {
    position: absolute;
    inset: 0;
    opacity: 0.13;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.3) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.3) 1px, transparent 1px);
    background-size: 42px 42px;
  }
  .map-search {
    position: relative;
    z-index: 4;
    width: min(360px, calc(100% - 2rem));
    margin: 1.6rem 0 0 1.6rem;
    padding: 1.4rem 1.4rem 1.1rem;
    border-top: 2px solid var(--gold);
    background: rgba(255, 255, 255, 0.97);
    color: var(--ink);
    box-shadow: 0 24px 54px rgba(0, 0, 0, 0.28);
  }
  .search-field {
    min-height: 58px;
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: var(--space-3);
    align-items: center;
    padding: 0 0.9rem;
    border: 1px solid var(--line);
    background: #fff;
  }
  .search-field svg {
    width: 20px;
    fill: none;
    stroke: var(--gold);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .search-field input {
    width: 100%;
    border: 0;
    outline: 0;
    color: var(--navy);
    background: transparent;
    font: inherit;
    font-size: var(--text-sm);
  }
  .search-button {
    width: 100%;
    min-height: 48px;
    margin-top: var(--space-3);
    border: 0;
    color: var(--navy);
    background: var(--gold);
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
  }
  .search-button:hover {
    background: var(--royal);
    color: #fff;
  }
  .search-note {
    min-height: 18px;
    margin: 0.8rem 0 0;
    color: var(--muted-2);
    font-size: var(--text-xs);
    line-height: 1.55;
  }

  .map-copy {
    position: relative;
    z-index: 2;
    padding: 1.5rem 2.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 18rem;
  }
  .map-pin {
    width: 3.6rem;
    height: 3.6rem;
    margin-bottom: var(--space-5);
    display: grid;
    place-items: center;
    border: 1px solid rgba(223, 177, 54, 0.65);
    border-radius: 50%;
    color: var(--accent-text);
  }
  .map-pin svg {
    width: 27px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .map-copy strong {
    color: #fff;
    font-family: var(--font-head);
    font-size: var(--text-lg);
  }
  .map-copy p {
    max-width: 22rem;
    margin: var(--space-3) 0 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: var(--text-sm);
    line-height: 1.7;
  }
  .map-legend {
    position: absolute;
    left: 1.75rem;
    bottom: 1.5rem;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    color: rgba(255, 255, 255, 0.65);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .map-legend span {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .legend-dot {
    width: 9px;
    height: 9px;
    display: inline-block;
    border-radius: 50%;
  }
  .legend-dot--alumnae {
    background: var(--gold);
  }
  .legend-dot--undergraduate {
    background: #fff;
  }

  .results-panel {
    position: relative;
    min-height: 32rem;
    padding: var(--space-8);
    background: #fff;
  }
  .directory-label {
    color: var(--accent-text);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0;
  }
  .empty-state {
    min-height: 25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  .empty-sigma {
    margin-bottom: var(--space-4);
    color: rgba(32, 65, 165, 0.15);
    font-size: 4rem;
    line-height: 1;
  }
  .empty-state h3 {
    max-width: 19rem;
    margin: 0;
    font-size: var(--text-h3);
  }
  .empty-state p {
    max-width: 23rem;
    margin: var(--space-3) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  /* ---- regions ---- */
  .regions-section {
    background: var(--white);
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
  }
  .regions-heading {
    position: relative;
    text-align: center;
    max-width: 50rem;
    margin-inline: auto;
    margin-bottom: var(--space-12);
  }
  .heading-sigma {
    display: block;
    color: var(--accent-text);
    font-size: 1.5rem;
    margin-bottom: var(--space-4);
  }
  .regions-heading h2 {
    margin: var(--space-2) auto 0;
    font-size: var(--text-h3);
  }
  .regions-heading h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .regions-heading > p:not(.eyebrow) {
    color: var(--muted);
    margin-top: var(--space-4);
  }

  /* Five uniform cards: flex with centred wrapping gives 3 + 2 on desktop. */
  .region-showcase {
    --rg-gap: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--rg-gap);
  }
  .region-card {
    flex: 0 1 calc((100% - 2 * var(--rg-gap)) / 3);
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    overflow: hidden;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  .region-card:hover {
    border-color: var(--royal);
    transform: translateY(-2px);
  }
  .region-art {
    display: grid;
    place-items: center;
    height: 180px;
    padding: var(--space-6);
    border-bottom: 1px solid var(--line);
  }
  .region-art img {
    width: auto;
    max-width: min(100%, 140px);
    max-height: 132px;
    object-fit: contain;
  }
  .region-copy {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-6);
  }
  .region-kicker {
    margin: 0 0 0.4rem;
    color: var(--accent-text);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .region-copy h3 {
    margin: 0;
    font-size: var(--text-md);
  }
  .region-copy > p {
    margin: var(--space-3) 0 var(--space-5);
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.72;
  }
  /* The link pins to the card foot and stretches over the whole card. */
  .region-copy a {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 4px;
    color: var(--royal);
    border-bottom: 1px solid var(--gold);
    text-decoration: none;
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .region-copy a::after {
    content: "";
    position: absolute;
    inset: -999px;
  }
  .region-copy a:focus-visible {
    outline: none;
  }
  .region-card:has(a:focus-visible) {
    outline: 2px solid var(--royal);
    outline-offset: 3px;
  }
  .region-copy a span {
    color: var(--accent-text);
  }
  @media (prefers-reduced-motion: reduce) {
    .region-card {
      transition: none;
    }
    .region-card:hover {
      transform: none;
    }
  }

  /* ---- membership bridge ---- */
  .membership-bridge {
    color: #fff;
    background:
      radial-gradient(circle at 82% 25%, rgba(69, 103, 198, 0.24), transparent 24%),
      linear-gradient(135deg, #07142e, var(--royal-mid));
    border-top: 3px solid var(--gold);
  }
  .membership-bridge__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-12);
    align-items: center;
    padding-block: clamp(3rem, 6vw, 4.25rem);
  }
  .membership-bridge h2 {
    max-width: 48rem;
    color: #fff;
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .membership-bridge h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .membership-bridge p:not(.eyebrow) {
    max-width: 45rem;
    margin: var(--space-4) 0 0;
    color: rgba(255, 255, 255, 0.72);
  }
  .eyebrow--light {
    color: var(--gold);
  }
  .gold-button {
    flex-shrink: 0;
    padding: 0.9em 1.8em;
    border-radius: var(--radius);
    color: var(--navy);
    background: var(--gold);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--text-sm);
    white-space: nowrap;
  }
  .gold-button:hover {
    background: var(--royal);
    color: #fff;
  }

  @media (max-width: 900px) {
    .directory-shell {
      grid-template-columns: 1fr;
    }
    .directory-heading {
      position: static;
    }
    .directory-display {
      grid-template-columns: 1fr;
    }
    .region-card {
      flex-basis: calc((100% - var(--rg-gap)) / 2);
    }
    .membership-bridge__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }
  @media (max-width: 560px) {
    .region-card {
      flex-basis: 100%;
    }
  }
</style>

<script>
  const form = document.getElementById("chapter-search-form");
  const input = document.getElementById("chapter-search") as HTMLInputElement | null;
  const message = document.getElementById("search-message");
  const filters = document.querySelectorAll(".filter");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!input || !message) return;
    const query = input.value.trim();
    if (!query) {
      message.textContent = "Enter a city, state, ZIP code, or university to search.";
      input.focus();
      return;
    }
    message.textContent = `Directory search is ready for "${query}". Connect the national chapter dataset to return live chapter results.`;
  });

  filters.forEach((filter) => {
    filter.addEventListener("click", () => {
      filters.forEach((b) => b.classList.remove("is-active"));
      filter.classList.add("is-active");
    });
  });
</script>
