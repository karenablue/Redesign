---
/**
 * Find a Chapter — the utility page.
 *
 * Treatment: deliberately the plainest, fastest page in the set. No hero
 * photo, no CardGrid, no timeline — a compact navy banner drops straight
 * into a search + filter bar and a scannable result list. The interaction
 * model (live client-side search/filter) is unique to this page because the
 * task is unique: find one chapter fast, not read a story.
 */
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import CtaBand from "../../components/CtaBand.astro";
import { regions, chapters } from "../../data/chapters.js";

const types = ["Collegiate", "Alumnae"];
---
<Base
  title="Find a Chapter"
  activeTop="Membership"
  description="Search Sigma Gamma Rho Sorority, Incorporated's collegiate and alumnae chapters by region, city, or state."
>
  <Hero
    variant="plain"
    accent="navy"
    align="left"
    size="compact"
    eyebrow="Membership"
    title="Find a Chapter "
    highlight="Near You"
    copy="Search by chapter name, city, or state, or filter by region and chapter type to find a community of Sigma women near you."
  />

  <section class="locator">
    <div class="container">
      <div class="locator__bar">
        <label class="locator__search" role="search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            id="chapter-search"
            type="search"
            placeholder="Search by chapter, city, or state…"
            aria-label="Search chapters"
          />
        </label>

        <div class="locator__filters">
          <div class="filter-group" role="group" aria-label="Filter by region">
            <span class="filter-group__label">Region</span>
            <div class="filter-group__pills">
              <button type="button" class="pill is-active" data-region-filter="all">All</button>
              {regions.map((r) => (
                <button type="button" class="pill" data-region-filter={r}>{r}</button>
              ))}
            </div>
          </div>

          <div class="filter-group" role="group" aria-label="Filter by chapter type">
            <span class="filter-group__label">Type</span>
            <div class="filter-group__pills">
              <button type="button" class="pill is-active" data-type-filter="all">All</button>
              {types.map((t) => (
                <button type="button" class="pill" data-type-filter={t}>{t}</button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="locator__meta">
        <p id="result-count" aria-live="polite"><strong>{chapters.length}</strong> chapters</p>
        <button type="button" id="reset-filters" class="reset-link" hidden>Clear filters</button>
      </div>

      <ul class="locator__results" id="chapter-results">
        {chapters.map((c) => (
          <li
            class="row"
            data-region={c.region}
            data-type={c.type}
            data-search={`${c.name} ${c.city} ${c.state}`.toLowerCase()}
          >
            <span class={`row__badge row__badge--${c.type === "Collegiate" ? "collegiate" : "alumnae"}`}>{c.type}</span>
            <div class="row__main">
              <h3>{c.name}</h3>
              <p class="row__loc">{c.city}, {c.state} <span class="row__dot" aria-hidden="true">&middot;</span> {c.region} Region</p>
            </div>
            <span class="row__year">Est. {c.established}</span>
          </li>
        ))}
      </ul>

      <p class="locator__empty" id="chapter-empty" hidden>
        No chapters match your search. Try a different city, state, or filter.
      </p>
    </div>
  </section>

  <CtaBand
    eyebrow="Don't See Your City?"
    title="New chapters are"
    highlight="chartering every year"
    copy="Membership begins with a chartered chapter's official intake process. If there isn't one near you yet, start with membership eligibility."
    actions={[
      { label: "Membership Eligibility", href: "/membership/become-a-member/" },
      { label: "Contact Us", href: "/contact/", variant: "outline" },
    ]}
  />
</Base>

<style>
  .locator { padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem); background: var(--white); }

  /* ---- bar ---- */
  .locator__bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: var(--space-8);
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--line);
  }
  .locator__search {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex: 1 1 320px;
    max-width: 420px;
    padding: 0.85rem 1.1rem;
    background: var(--tint);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--royal);
  }
  .locator__search input {
    flex: 1;
    border: 0;
    background: transparent;
    font: inherit;
    color: var(--ink);
  }
  .locator__search input:focus { outline: none; }

  .locator__filters { display: flex; flex-wrap: wrap; gap: var(--space-8); }
  .filter-group { display: flex; flex-direction: column; gap: var(--space-2); }
  .filter-group__label {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .filter-group__pills { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .pill {
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .pill:hover { border-color: var(--royal); color: var(--royal); }
  .pill.is-active { background: var(--royal); border-color: var(--royal); color: #fff; }

  /* ---- meta row ---- */
  .locator__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }
  .locator__meta p { margin: 0; color: var(--muted); font-size: var(--text-sm); }
  .locator__meta strong { color: var(--royal); }
  .reset-link {
    border: 0;
    background: none;
    padding: 0;
    color: var(--royal);
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: underline;
    cursor: pointer;
  }

  /* ---- results ---- */
  .locator__results { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-5) var(--space-6);
    background: var(--tint);
    border-radius: var(--radius);
    border: 1px solid transparent;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .row:hover { border-color: var(--line); background: var(--white); }
  .row__badge {
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .row__badge--collegiate { background: rgba(32, 65, 165, 0.12); color: var(--royal); }
  .row__badge--alumnae { background: rgba(223, 177, 54, 0.18); color: var(--gold-dark); }
  .row__main h3 { margin: 0; font-size: var(--text-md); color: var(--royal); }
  .row__loc { margin: 0.2rem 0 0; font-size: var(--text-sm); color: var(--muted); }
  .row__dot { margin: 0 0.2rem; }
  .row__year { font-size: var(--text-sm); color: var(--muted-2); white-space: nowrap; }

  .locator__empty {
    text-align: center;
    padding: var(--space-16) var(--space-6);
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .row { grid-template-columns: auto 1fr; }
    .row__year { grid-column: 2; }
  }
</style>

<script>
  const searchInput = document.getElementById("chapter-search");
  const resetBtn = document.getElementById("reset-filters");
  const countEl = document.getElementById("result-count");
  const emptyEl = document.getElementById("chapter-empty");
  const rows = Array.from(document.querySelectorAll("#chapter-results .row"));
  const regionButtons = Array.from(document.querySelectorAll("[data-region-filter]"));
  const typeButtons = Array.from(document.querySelectorAll("[data-type-filter]"));

  let region = "all";
  let type = "all";
  let query = "";

  function setActive(buttons, value) {
    buttons.forEach((b) => {
      const key = b.dataset.regionFilter ?? b.dataset.typeFilter;
      b.classList.toggle("is-active", key === value);
      b.setAttribute("aria-pressed", String(key === value));
    });
  }

  function applyFilters() {
    let visible = 0;
    rows.forEach((row) => {
      const matchesRegion = region === "all" || row.dataset.region === region;
      const matchesType = type === "all" || row.dataset.type === type;
      const matchesQuery = query === "" || row.dataset.search.includes(query);
      const show = matchesRegion && matchesType && matchesQuery;
      row.hidden = !show;
      if (show) visible += 1;
    });
    countEl.innerHTML = `<strong>${visible}</strong> chapter${visible === 1 ? "" : "s"}`;
    emptyEl.hidden = visible !== 0;
    resetBtn.hidden = region === "all" && type === "all" && query === "";
  }

  regionButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      region = btn.dataset.regionFilter;
      setActive(regionButtons, region);
      applyFilters();
    });
  });

  typeButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      type = btn.dataset.typeFilter;
      setActive(typeButtons, type);
      applyFilters();
    });
  });

  searchInput.addEventListener("input", (e) => {
    query = e.target.value.trim().toLowerCase();
    applyFilters();
  });

  resetBtn.addEventListener("click", () => {
    region = "all";
    type = "all";
    query = "";
    searchInput.value = "";
    setActive(regionButtons, "all");
    setActive(typeButtons, "all");
    applyFilters();
  });
</script>
