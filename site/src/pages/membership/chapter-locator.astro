---
/**
 * Chapter Locator. The list is HQ's own chapter records (the feed behind the
 * old site's locator), filled out from the regional directories; see
 * scripts/sync-chapters.mjs and src/data/chapter-directory.md. Undergraduate
 * and alumnae chapters only. The map is an enhancement over the list: it
 * loads MapLibre only when scrolled near, and shows whatever the filters show.
 */
import directory from "../../data/chapter-directory.json";
import PageHero from "../../components/PageHero.astro";
import CardGrid from "../../components/CardGrid.astro";
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/url.js";
import { compareChapterNames } from "../../lib/chapter-order";
import { chapterLinks } from "../../lib/chapter-links";
import { socialPaths } from "../../lib/social-icons";

const chapters = [...directory.chapters]
  .sort((a, b) => compareChapterNames(a.name, b.name) || a.region.localeCompare(b.region))
  .map((chapter) => ({ ...chapter, links: chapterLinks(chapter) }));
// One copy of each logo in use, referenced by every card that needs it.
const socialInUse = [
  ...new Map(chapters.flatMap((c) => c.links.social).map((s) => [s.key, s.label])),
];
const retrieved = new Date(`${directory.retrieved}T12:00:00`).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
const mappedCount = chapters.filter((c) => "lat" in c).length;

const regions = [
  {
    name: "Central",
    img: "/images/regions/central.png",
    body: "Serving undergraduate and alumnae chapters across the central United States.",
    href: "https://www.sgrhocentral.com/chapter-locator",
  },
  {
    name: "Northeastern",
    img: "/images/regions/northeastern.png",
    body: "Serving chapters across the northeastern United States and affiliated international areas.",
    href: "https://www.sgrhoneregion.org/chapter-locator-2",
  },
  {
    name: "Southeastern",
    img: "/images/regions/southeastern.png",
    body: "Alabama, The Bahamas, Florida, Georgia, Mississippi, South Carolina, Tennessee, and the U.S. Virgin Islands.",
    href: "https://www.seregionsgrho.org/team-3",
  },
  {
    name: "Southwestern",
    img: "/images/regions/southwestern.png",
    body: "Serving chapters throughout the southwestern United States and affiliated areas.",
    href: "https://www.sigmaswregion.com/locate",
  },
  {
    name: "Western",
    img: "/images/regions/western.png",
    body: "Serving chapters across the western United States and affiliated international areas.",
    href: "https://www.westernsgrho.org/wr-chapter-directory",
  },
];
---

<Base
  title="Chapter Locator"
  activeTop="Membership & Intake"
  description="Find Sigma Gamma Rho Sorority, Incorporated undergraduate and alumnae chapters across the Sorority's five regions."
>
  <PageHero
    stack
    eyebrow="Membership • Chapter Locator"
    title="Find your place"
    highlight="in the sisterhood."
    copy="Sigma Gamma Rho is organized across five regions, with undergraduate and alumnae chapters serving campuses and communities throughout the United States and internationally. Search chapter listings or browse a regional directory below."
    image="/optimized/cover-beta-psi-sigma.webp"
    imageWidth={1365}
    cover
    focal="50% 35%"
    detail={{
      value: String(directory.chapters.length),
      label: "Undergraduate and alumnae chapters in Headquarters’ records",
    }}
  >
    <a class="btn" href="#chapter-search-form">Search Chapters</a>
  </PageHero>

  <section class="directory-section" aria-labelledby="directory-title">
    <div class="container directory-shell">
      <div class="directory-heading">
        <p class="eyebrow">Find a Chapter</p>
        <h2 id="directory-title">Start with Your Community.</h2>
        <p>
          Search by chapter name, city, state, or university. Explore undergraduate chapters for
          campus membership or alumnae chapters for community membership.
        </p>
      </div>
      <div class="chapter-type-guide" aria-label="Chapter types">
        <div>
          <p class="chapter-type-guide__label">Campus-based</p>
          <h3>Undergraduate Chapters</h3>
          <p>For students pursuing collegiate membership at an eligible institution.</p>
          <button type="button" data-quick-filter="undergraduate">
            Show undergraduate chapters
          </button>
        </div>
        <div>
          <p class="chapter-type-guide__label">Community-based</p>
          <h3>Alumnae Chapters</h3>
          <p>For degree-holding women seeking service and sisterhood beyond college.</p>
          <button type="button" data-quick-filter="alumnae">
            Show alumnae chapters
          </button>
        </div>
      </div>
      <form
        id="chapter-search-form"
        class="locator-search"
        role="search"
        aria-label="Chapter directory"
      >
        <div class="search-control">
          <label for="chapter-search">Chapter or location</label>
          <input
            id="chapter-search"
            name="q"
            type="search"
            placeholder="City, state, chapter, or university"
            autocomplete="off"
          />
        </div>
        <div class="search-control">
          <label for="chapter-region">Region</label>
          <select id="chapter-region" name="region">
            <option value="all">All regions</option>
            {regions.map((r) => (
              <option value={r.name}>{r.name}</option>
            ))}
          </select>
        </div>
        <button class="search-button" type="submit">
          Find Chapters
        </button>
      </form>
      <div class="directory-toolbar">
        <div class="filter-group" role="group" aria-label="Chapter type">
          <button class="filter is-active" type="button" data-filter="all" aria-pressed="true">
            All Chapters
          </button>
          <button class="filter" type="button" data-filter="alumnae" aria-pressed="false">
            Alumnae
          </button>
          <button class="filter" type="button" data-filter="undergraduate" aria-pressed="false">
            Undergraduate
          </button>
        </div>
        <button id="clear-search" class="clear-search" type="button" hidden>
          Clear filters
        </button>
      </div>
      <p id="search-message" class="search-note" role="status" aria-live="polite">
        {directory.chapters.length} chapters
      </p>
      <figure class="chapter-map">
        <div
          id="chapter-map"
          class="chapter-map__canvas"
          data-vendor={withBase("/vendor/maplibre/")}
          role="region"
          aria-label="Map of the chapters listed below"
        >
          <p class="chapter-map__placeholder">The map loads as you scroll to it.</p>
        </div>
        <figcaption>
          {mappedCount} of {directory.chapters.length} chapters have a map location; every chapter
          is in the list below. Map data &copy;{" "}
          <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">
            OpenStreetMap contributors<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
          , tiles by{" "}
          <a href="https://openfreemap.org" target="_blank" rel="noopener">
            OpenFreeMap<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
          .
        </figcaption>
      </figure>
      {socialInUse.length > 0 && (
        <svg class="social-sprite" aria-hidden="true" focusable="false">
          {socialInUse.map(([key, label]) => (
            <symbol id={`social-${key}`} viewBox="0 0 32 32">
              <path d={socialPaths[label]} fill-rule="evenodd" />
            </symbol>
          ))}
        </svg>
      )}
      <CardGrid min="280px" cols={3} gap="var(--space-5)">
        {chapters.map((chapter) => (
          <article
            class="chapter-result"
            data-search={[
              chapter.name,
              chapter.university,
              chapter.city,
              chapter.state,
              chapter.region,
            ].join(" ")}
            data-state={chapter.state}
            data-type={chapter.type}
            data-region={chapter.region}
            data-name={chapter.name}
            data-place={[chapter.city, chapter.state].filter(Boolean).join(", ")}
            {...("lat" in chapter ? { "data-lat": chapter.lat, "data-lng": chapter.lng } : {})}
          >
            <p class="chapter-result__type">
              {chapter.type === "alumnae" ? "Alumnae" : "Undergraduate"} &middot;{" "}
              {chapter.region ? `${chapter.region} Region` : "Region not listed"}
            </p>
            <h3>{chapter.name}</h3>
            <p class="chapter-result__location">
              {[chapter.city, chapter.state].filter(Boolean).join(", ")}
            </p>
            {chapter.university && <p class="chapter-result__university">{chapter.university}</p>}
            <div class="chapter-result__links">
              {chapter.links.website ? (
                <a href={chapter.links.website} target="_blank" rel="noopener">
                  Chapter website &nearr;
                  <span class="visually-hidden"> for {chapter.name} (opens in a new tab)</span>
                </a>
              ) : (
                chapter.region && (
                  <a
                    href={regions.find((region) => region.name === chapter.region)?.href}
                    target="_blank"
                    rel="noopener"
                  >
                    View regional directory &nearr;
                    <span class="visually-hidden"> for {chapter.name} (opens in a new tab)</span>
                  </a>
                )
              )}
              {chapter.links.social.length > 0 && (
                <ul class="chapter-result__social" aria-label={`${chapter.name} on social media`}>
                  {chapter.links.social.map((s) => (
                    <li>
                      <a
                        href={s.href}
                        target="_blank"
                        rel="noopener"
                        aria-label={`${chapter.name} on ${s.label} (opens in a new tab)`}
                      >
                        <svg width="18" height="18" aria-hidden="true" focusable="false">
                          <use href={`#social-${s.key}`} />
                        </svg>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))}
      </CardGrid>
      <div id="empty-state" class="empty-state" hidden>
        <h3>No listings found in this collection.</h3>
        <p>
          This list comes from International Corporate Headquarters&rsquo; chapter records as of
          {retrieved}. If a chapter you expect is missing, its regional directory may have newer
          information.
        </p>
        <a href="#regional-directories">Browse regional directories &darr;</a>
      </div>
      <button id="show-more" class="btn btn--outline" type="button" hidden>
        Show more chapters
      </button>
      <p class="directory-source">
        Chapters listed from International Corporate Headquarters&rsquo; records as of {retrieved}.
      </p>
      <noscript>
        <p>
          Use your browser's Find feature to search these listings, or browse the official regional
          directories.
        </p>
      </noscript>
    </div>
  </section>

  <div class="sigma-rule sigma-rule-royal" aria-hidden="true">
    <span class="sigma-line"></span>
    <span class="sigma-medallion">&Sigma;</span>
    <span class="sigma-line"></span>
  </div>

  <section class="regions-section" id="regional-directories">
    <div class="container regions-heading">
      <span class="heading-sigma" aria-hidden="true">
        &Sigma;
      </span>
      <p class="eyebrow">Official Directories &bull; Five Regions</p>
      <h2>
        Or Browse Sigma Gamma Rho <span>by Region.</span>
      </h2>
      <p>
        Each region maintains its own chapter directory and regional leadership structure. Select a
        region below to continue to its official chapter information.
      </p>
    </div>

    <div class="container region-showcase">
      {regions.map((r) => (
        <article class="region-card">
          <div class="region-art">
            <img
              src={withBase(r.img)}
              alt={`Sigma Gamma Rho ${r.name} Region logo`}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="region-copy">
            <p class="region-kicker">{r.name} Region</p>
            <h3>{r.name}</h3>
            <p>{r.body}</p>
            <a href={r.href} target="_blank" rel="noopener">
              View {r.name} Chapters <span aria-hidden="true">&#8599;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="membership-bridge on-dark">
    <div class="container membership-bridge__inner">
      <div>
        <p class="eyebrow eyebrow--light">Prospective Membership</p>
        <h2>
          Looking for a chapter because you are <span>considering membership?</span>
        </h2>
        <p>
          Review membership eligibility and expectations before contacting a chapter. The membership
          page explains undergraduate and alumnae pathways, standards, frequently asked questions,
          and official process.
        </p>
      </div>
      <a href={withBase("/membership/become-a-member/")} class="gold-button">
        Review Membership
      </a>
    </div>
  </section>
</Base>

<style>
  /* ---- hero ---- */
  .locator-search {
    scroll-margin-top: 12rem;
  }

  /* ---- sigma dividers ---- */
  .sigma-rule {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    max-width: 74rem;
    margin-inline: auto;
    padding-block: var(--space-10);
  }
  .sigma-rule-royal {
    background: var(--white);
  }
  .sigma-line {
    flex: 1;
    height: 1px;
  }
  .sigma-rule-royal .sigma-line {
    background: linear-gradient(90deg, transparent, var(--royal));
  }
  .sigma-rule-royal .sigma-line:last-child {
    background: linear-gradient(270deg, transparent, var(--royal));
  }
  .sigma-medallion {
    width: 3.25rem;
    height: 3.25rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 1.4rem;
  }
  .sigma-rule-royal .sigma-medallion {
    color: var(--royal);
    border: 1px solid var(--royal);
  }

  .directory-section {
    background: var(--tint);
  }
  .directory-shell {
    padding-block: var(--section-y);
  }
  .directory-heading {
    max-width: 48rem;
  }
  .directory-heading h2 {
    margin: var(--space-2) 0 var(--space-4);
    font-size: var(--text-h2);
    font-family: var(--font-editorial);
  }
  .directory-heading > p:not(.eyebrow) {
    color: var(--muted);
  }
  .chapter-type-guide {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  .chapter-type-guide > div {
    padding: var(--space-5);
    border-left: 4px solid var(--gold);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }
  .chapter-type-guide__label {
    margin: 0 0 var(--space-2);
    color: var(--royal);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .chapter-type-guide h3 {
    margin: 0;
    color: var(--navy);
    font-family: var(--font-body);
    font-size: var(--text-lg);
  }
  .chapter-type-guide p:not(.chapter-type-guide__label) {
    margin: var(--space-2) 0 var(--space-4);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .chapter-type-guide button {
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--line-link);
    background: transparent;
    color: var(--royal);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }
  .locator-search {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: 2fr 1fr auto;
    gap: var(--space-4);
    align-items: end;
  }
  .search-control {
    min-width: 0;
  }
  .search-control label {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--navy);
    font-weight: 700;
    font-size: var(--text-sm);
  }
  .search-control input,
  .search-control select {
    width: 100%;
    min-height: 52px;
    padding: var(--space-3);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font: inherit;
    background: var(--white);
    color: var(--navy);
  }
  .search-button {
    min-height: 52px;
    padding-inline: var(--space-6);
    border: 0;
    border-radius: var(--radius);
    color: var(--navy);
    background: var(--gold);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }
  .search-button:hover {
    background: var(--royal);
    color: var(--white);
  }
  .directory-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .filter-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .filter {
    min-height: 44px;
    padding-inline: var(--space-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--royal);
    background: var(--white);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }
  .filter.is-active,
  .filter:hover {
    color: var(--white);
    background: var(--royal);
    border-color: var(--royal);
  }
  .clear-search {
    border: 0;
    padding: var(--space-3);
    color: var(--royal);
    background: transparent;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  .search-note {
    color: var(--muted);
    margin-block: var(--space-6);
    font-size: var(--text-sm);
  }
  .chapter-result {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    border-top: 3px solid var(--gold);
    background: var(--white);
    min-width: 0;
  }
  .chapter-result__type {
    margin: 0 0 var(--space-3);
    color: var(--royal);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .chapter-result h3 {
    margin: 0 0 var(--space-3);
    color: var(--navy);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: 1.4;
  }
  .chapter-result__location {
    margin: 0;
    font-weight: 600;
  }
  .chapter-result__university {
    margin-top: var(--space-2);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .chapter-result__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-top: auto;
    padding-top: var(--space-6);
  }
  .chapter-result__links > a {
    color: var(--royal);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .chapter-result__social {
    display: flex;
    gap: var(--space-1);
    /* The 36px tap targets overhang the row, so cards with and without logos line up. */
    margin: calc(-1 * var(--space-2)) calc(-1 * var(--space-2)) calc(-1 * var(--space-2)) 0;
    padding: 0;
    list-style: none;
  }
  .chapter-result__social a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--royal);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .chapter-result__social a:hover {
    background: var(--tint);
    color: var(--navy);
  }
  .chapter-result__social svg {
    fill: currentColor;
  }
  .social-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  .empty-state {
    padding: var(--space-8);
    background: var(--white);
    border: 1px solid var(--line);
  }
  .empty-state h3 {
    font-size: var(--text-lg);
  }
  .empty-state p {
    max-width: 45rem;
    color: var(--muted);
  }
  #show-more {
    margin-top: var(--space-8);
  }
  [hidden] {
    display: none !important;
  }
  @media (max-width: 768px) {
    .chapter-type-guide {
      grid-template-columns: 1fr;
    }
    .locator-search {
      margin-top: var(--space-8);
      grid-template-columns: 1fr;
    }
  }

  /* ---- regions ---- */
  .regions-section {
    background: var(--white);
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
  }
  .regions-heading {
    position: relative;
    text-align: center;
    max-width: 50rem;
    margin-inline: auto;
    margin-bottom: var(--space-12);
  }
  .heading-sigma {
    display: block;
    color: var(--accent-text);
    font-size: 1.5rem;
    margin-bottom: var(--space-4);
  }
  .regions-heading h2 {
    margin: var(--space-2) auto 0;
    font-size: var(--text-h3);
  }
  .regions-heading h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .regions-heading > p:not(.eyebrow) {
    color: var(--muted);
    margin-top: var(--space-4);
  }

  /* Five uniform cards: flex with centred wrapping gives 3 + 2 on desktop. */
  .region-showcase {
    --rg-gap: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--rg-gap);
  }
  .region-card {
    flex: 0 1 calc((100% - 2 * var(--rg-gap)) / 3);
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    overflow: hidden;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  .region-card:hover {
    border-color: var(--royal);
    transform: translateY(-2px);
  }
  .region-art {
    display: grid;
    place-items: center;
    height: 176px;
    padding: var(--space-6);
    background: var(--tint);
    border-bottom: 1px solid var(--line);
  }
  /* The marks are pre-cut transparent PNGs (images/regions/), so each one
     renders at the same size with no source background showing. */
  .region-art img {
    width: 128px;
    height: 128px;
    object-fit: contain;
  }
  .region-copy {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-6);
  }
  .region-kicker {
    margin: 0 0 0.4rem;
    color: var(--accent-text);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .region-copy h3 {
    margin: 0;
    font-size: var(--text-md);
  }
  .region-copy > p {
    margin: var(--space-3) 0 var(--space-5);
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.72;
  }
  /* The link pins to the card foot and stretches over the whole card. */
  .region-copy a {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 4px;
    color: var(--royal);
    border-bottom: 1px solid var(--gold);
    text-decoration: none;
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .region-copy a::after {
    content: "";
    position: absolute;
    inset: -999px;
  }
  .region-copy a:focus-visible {
    outline: none;
  }
  .region-card:has(a:focus-visible) {
    outline: 2px solid var(--royal);
    outline-offset: 3px;
  }
  .region-copy a span {
    color: var(--accent-text);
  }
  @media (prefers-reduced-motion: reduce) {
    .region-card {
      transition: none;
    }
    .region-card:hover {
      transform: none;
    }
  }

  /* ---- membership bridge ---- */
  .membership-bridge {
    color: var(--white);
    background:
      radial-gradient(circle at 82% 25%, var(--hero-glow), transparent 24%),
      linear-gradient(135deg, var(--navy), var(--royal-mid));
    border-top: 3px solid var(--gold);
  }
  .membership-bridge__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-12);
    align-items: center;
    padding-block: clamp(3rem, 6vw, 4.25rem);
  }
  .membership-bridge h2 {
    max-width: 48rem;
    color: var(--white);
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .membership-bridge h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .membership-bridge p:not(.eyebrow) {
    max-width: 45rem;
    margin: var(--space-4) 0 0;
    color: var(--text-on-dark-soft);
  }
  .eyebrow--light {
    color: var(--gold);
  }
  .gold-button {
    flex-shrink: 0;
    padding: 0.9em 1.8em;
    border-radius: var(--radius);
    color: var(--navy);
    background: var(--gold);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--text-sm);
    white-space: nowrap;
  }
  .gold-button:hover {
    background: var(--royal);
    color: var(--white);
  }

  @media (max-width: 900px) {
    .region-card {
      flex-basis: calc((100% - var(--rg-gap)) / 2);
    }
    .membership-bridge__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }
  @media (max-width: 560px) {
    .region-card {
      flex-basis: 100%;
    }
  }

  /* ---- map ---- */
  .chapter-map {
    margin: 0 0 var(--space-8);
  }
  .chapter-map__canvas {
    position: relative;
    height: clamp(280px, 45vw, 440px);
    border: 1px solid var(--line);
    background: var(--tint);
    overflow: hidden;
  }
  .chapter-map__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .chapter-map figcaption {
    margin-top: var(--space-2);
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .chapter-map figcaption a {
    color: var(--royal-dark);
  }
  .directory-source {
    margin-top: var(--space-6);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  :global(.chapter-popup strong) {
    display: block;
    color: var(--royal);
    font-size: var(--text-base);
  }
  :global(.chapter-popup span) {
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>

<script>
  import { matchesChapter } from "../../lib/chapter-search";
  const form = document.querySelector<HTMLFormElement>("#chapter-search-form");
  const input = document.querySelector<HTMLInputElement>("#chapter-search");
  const region = document.querySelector<HTMLSelectElement>("#chapter-region");
  const message = document.querySelector<HTMLElement>("#search-message");
  const empty = document.querySelector<HTMLElement>("#empty-state");
  const more = document.querySelector<HTMLButtonElement>("#show-more");
  const clear = document.querySelector<HTMLButtonElement>("#clear-search");
  const filters = document.querySelectorAll<HTMLButtonElement>(".filter");
  const quickFilters = document.querySelectorAll<HTMLButtonElement>("[data-quick-filter]");
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".chapter-result"));
  let type = "all";
  let limit = 12;
  function render(updateUrl = true) {
    if (!input || !region || !message || !empty || !more || !clear) return;
    const query = input.value.trim();
    const matches = cards.filter((card) =>
      matchesChapter(
        {
          search: card.dataset.search ?? "",
          state: card.dataset.state ?? "",
          type: card.dataset.type ?? "",
          region: card.dataset.region ?? "",
        },
        query,
        type,
        region.value
      )
    );
    cards.forEach((card) => {
      card.hidden = true;
    });
    matches.slice(0, limit).forEach((card) => {
      card.hidden = false;
    });
    filters.forEach((button) => {
      const active = button.dataset.filter === type;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-pressed", String(active));
    });
    showOnMap(matches);
    empty.hidden = matches.length > 0;
    more.hidden = matches.length <= limit;
    clear.hidden = !query && type === "all" && region.value === "all";
    message.textContent = /^\d{5}(?:-\d{4})?$/.test(query)
      ? "ZIP search is unavailable. Enter a city or state instead."
      : `${matches.length} ${matches.length === 1 ? "listing" : "listings"} found${query ? ` for "${query}"` : ""}. Showing ${Math.min(limit, matches.length)}.`;
    if (updateUrl) {
      const url = new URL(location.href);
      for (const [key, value] of [
        ["q", query],
        ["type", type],
        ["region", region.value],
      ]) {
        if (value && value !== "all") url.searchParams.set(key, value);
        else url.searchParams.delete(key);
      }
      history.pushState(null, "", url);
    }
  }
  function restore() {
    if (!input || !region) return;
    const params = new URLSearchParams(location.search);
    input.value = params.get("q") ?? "";
    const selected = params.get("region") ?? "all";
    region.value = Array.from(region.options).some((option) => option.value === selected)
      ? selected
      : "all";
    type = ["alumnae", "undergraduate"].includes(params.get("type") ?? "")
      ? params.get("type")!
      : "all";
    limit = 12;
    render(false);
  }
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    limit = 12;
    render();
  });
  region?.addEventListener("change", () => {
    limit = 12;
    render();
  });
  filters.forEach((button) =>
    button.addEventListener("click", () => {
      type = button.dataset.filter ?? "all";
      limit = 12;
      render();
    })
  );
  quickFilters.forEach((button) => {
    button.addEventListener("click", () => {
      const matchingFilter = Array.from(filters).find(
        (filter) => filter.dataset.filter === button.dataset.quickFilter
      );
      matchingFilter?.click();
      form?.scrollIntoView({
        behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
        block: "start",
      });
    });
  });
  more?.addEventListener("click", () => {
    limit += 12;
    render(false);
  });
  clear?.addEventListener("click", () => {
    if (!input || !region) return;
    input.value = "";
    region.value = "all";
    type = "all";
    limit = 12;
    render();
    input.focus();
  });
  window.addEventListener("popstate", restore);

  /* ---- map: loaded on approach, fed the same matches as the list ---- */
  type Maplibre = typeof import("maplibre-gl");
  const mapEl = document.querySelector<HTMLElement>("#chapter-map");
  let lastMatches: HTMLElement[] = cards;
  let setMapData: ((matches: HTMLElement[]) => void) | null = null;
  function toGeoJSON(matches: HTMLElement[]) {
    return {
      type: "FeatureCollection" as const,
      features: matches
        .filter((c) => c.dataset.lat && c.dataset.lng)
        .map((c) => ({
          type: "Feature" as const,
          geometry: {
            type: "Point" as const,
            coordinates: [Number(c.dataset.lng), Number(c.dataset.lat)],
          },
          properties: {
            name: c.dataset.name ?? "",
            place: c.dataset.place ?? "",
            kind: c.dataset.type === "alumnae" ? "Alumnae" : "Undergraduate",
          },
        })),
    };
  }
  function showOnMap(matches: HTMLElement[]) {
    lastMatches = matches;
    setMapData?.(matches);
  }
  async function loadMap() {
    if (!mapEl) return;
    const base = mapEl.dataset.vendor ?? "/vendor/maplibre/";
    const css = document.createElement("link");
    css.rel = "stylesheet";
    css.href = `${base}maplibre-gl.css`;
    document.head.append(css);
    const gl: Maplibre = await import(/* @vite-ignore */ `${base}maplibre-gl.mjs`);
    mapEl.textContent = "";
    const map = new gl.Map({
      container: mapEl,
      style: "https://tiles.openfreemap.org/styles/positron",
      center: [-88, 36],
      zoom: 3,
      cooperativeGestures: true,
      attributionControl: false,
    });
    map.addControl(new gl.NavigationControl({ showCompass: false }), "top-right");
    map.on("load", () => {
      map.addSource("chapters", {
        type: "geojson",
        data: toGeoJSON(lastMatches),
        cluster: true,
        clusterRadius: 40,
      });
      map.addLayer({
        id: "clusters",
        type: "circle",
        source: "chapters",
        filter: ["has", "point_count"],
        paint: {
          "circle-color": "#2041a5",
          "circle-stroke-color": "#dfb136",
          "circle-stroke-width": 2,
          "circle-radius": ["step", ["get", "point_count"], 14, 10, 18, 50, 24],
        },
      });
      map.addLayer({
        id: "cluster-count",
        type: "symbol",
        source: "chapters",
        filter: ["has", "point_count"],
        // A font OpenFreeMap serves; MapLibre's default stack is a 404 there.
        layout: {
          "text-field": ["get", "point_count_abbreviated"],
          "text-font": ["Noto Sans Bold"],
          "text-size": 12,
        },
        paint: { "text-color": "#ffffff" },
      });
      map.addLayer({
        id: "chapter",
        type: "circle",
        source: "chapters",
        filter: ["!", ["has", "point_count"]],
        paint: {
          "circle-color": "#2041a5",
          "circle-radius": 6,
          "circle-stroke-color": "#ffffff",
          "circle-stroke-width": 2,
        },
      });
      map.on("click", "clusters", async (e) => {
        const feature = e.features?.[0];
        if (!feature) return;
        const source = map.getSource("chapters") as import("maplibre-gl").GeoJSONSource;
        const zoom = await source.getClusterExpansionZoom(feature.properties.cluster_id);
        map.easeTo({ center: (feature.geometry as GeoJSON.Point).coordinates as [number, number], zoom });
      });
      map.on("click", "chapter", (e) => {
        const feature = e.features?.[0];
        if (!feature) return;
        const { name, place, kind } = feature.properties as Record<string, string>;
        const box = document.createElement("div");
        box.className = "chapter-popup";
        const title = document.createElement("strong");
        title.textContent = name;
        const detail = document.createElement("span");
        detail.textContent = [kind, place].filter(Boolean).join(" · ");
        box.append(title, detail);
        new gl.Popup({ offset: 10 })
          .setLngLat((feature.geometry as GeoJSON.Point).coordinates as [number, number])
          .setDOMContent(box)
          .addTo(map);
      });
      for (const layer of ["clusters", "chapter"]) {
        map.on("mouseenter", layer, () => (map.getCanvas().style.cursor = "pointer"));
        map.on("mouseleave", layer, () => (map.getCanvas().style.cursor = ""));
      }
      setMapData = (matches) => {
        const data = toGeoJSON(matches);
        (map.getSource("chapters") as import("maplibre-gl").GeoJSONSource | undefined)?.setData(data);
        // A narrowed search zooms to its chapters; the full list shows the country.
        if (matches.length === cards.length || data.features.length === 0) {
          map.easeTo({ center: [-88, 36], zoom: 3 });
          return;
        }
        const bounds = new gl.LngLatBounds();
        for (const f of data.features) bounds.extend(f.geometry.coordinates as [number, number]);
        map.fitBounds(bounds, { padding: 60, maxZoom: 9, duration: 600 });
      };
      setMapData(lastMatches);
    });
  }
  if (mapEl) {
    const watch = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          watch.disconnect();
          loadMap().catch(() => {
            mapEl.innerHTML =
              '<p class="chapter-map__placeholder">The map could not load. Every chapter is in the list below.</p>';
          });
        }
      },
      { rootMargin: "200px" }
    );
    watch.observe(mapEl);
  }

  restore();
</script>
