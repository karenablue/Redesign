---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { withBase } from "../../lib/url.js";

/*
 * Source for every step and contact on this page: the "Reactivations and
 * Transfers" FY26 one-pager from International Corporate Headquarters.
 *
 * Yearly dues and regional/foundation assessment amounts are deliberately
 * NOT published here: they change each fiscal year, and the Poodle Portal
 * shows each member her own current total. Only the flat transfer fee is
 * stated. Check it against each new one-pager.
 */
const PORTAL_URL = "https://portal.sgrho1922.org/";
const TRANSFER_FEE = 15;

const portalSections = [
  ["Section 1", "Reactivating Member Information", "Review the information you provided."],
  [
    "Section 2",
    "Sigma History",
    "Induction chapter, induction date, last active chapter, last active state of residence, current state of residence, and current region of residence.",
  ],
  ["Section 3", "Education", "Upload a copy of your degree or diploma."],
  ["Section 4", "Membership Options", "Membership type and desired chapter."],
  ["Section 5", "Terms & Conditions", "Photography/videography release and arbitration agreement."],
];

/** What a reactivation total is made of, per the one-pager. No amounts. */
const assessmentParts = [
  ["National headtax", "Operational dues to the national organization."],
  ["Insurance", "Coverage included with every reactivation."],
  ["Regional assessment", "Set by your region and paid with your reactivation."],
  ["Foundation assessments", "The National Education Fund (NEF) and SPEAR, for graduate members."],
  ["Reactivation & processing", "The reactivation fee and the credit-card processing fee."],
];

const regions = [
  { name: "Central", email: "grammateus@sgrhocentral.com", site: "https://www.sgrhocentral.com" },
  {
    name: "Northeastern",
    email: "grammateus@sgrhoneregion.com",
    site: "https://www.sgrhoneregion.com",
  },
  {
    name: "Southeastern",
    email: "grammateus@seregionsgrho.org",
    site: "https://www.seregionsgrho.org",
  },
  {
    name: "Southwestern",
    email: "grammateus@sigmaswregion.com",
    site: "https://www.sigmaswregion.com",
  },
  { name: "Western", email: "grammateus@westernsgrho.org", site: "https://www.westernsgrho.org" },
];

const foundations = [
  {
    name: "National Education Fund (NEF)",
    href: "https://www.sgrnationaleducationfund.org/home",
    label: "Pay the NEF assessment",
  },
  {
    name: "Sigma Public Education Foundation & Research (SPEAR)",
    href: "https://www.flipcause.com/secure/cause_pdetails/MTQ2MDUw",
    label: "Pay the SPEAR assessment",
  },
];

const transferSteps = [
  "Log in to the national website, sgrho1922.org.",
  "Click the Login button to sign in to the Members Only Portal.",
  "Select your name at the top of the page to open your Member Profile.",
  "On your Member Profile, click the TRANSFER tab.",
  "Follow the instructions, then save and close the dialogue box.",
  "Once processed, the invoice is available to pay from your member profile.",
];

const bare = (url: string) => url.replace(/^https?:\/\//, "");
---

<Base
  title="Reactivate Membership"
  activeTop="Membership & Intake"
  description="Who needs to reactivate, the Poodle Portal steps, what your assessment covers, and how transfers work in Sigma Gamma Rho."
>
  <PageHero
    stack
    crumbs={[
      { label: "Home", href: "/" },
      { label: "Membership", href: "/membership/become-a-member/" },
      { label: "Reactivate Membership" },
    ]}
    eyebrow="Membership"
    title="Welcome back"
    highlight="to the sisterhood."
    copy="Reactivating your membership reconnects you with Sigma Gamma Rho, your chapter, and Sorors around the world."
    image="/optimized/hero-alumnae-sorors.webp"
    focal="50% 35%"
  >
    <a class="btn" href="#steps">Begin Your Return</a>
    <a class="btn btn--outline" href={withBase("/membership/chapter-locator/")}>Find Your Chapter</a>
  </PageHero>

  <section class="rx-main">
    <div class="container rx-layout">
      <nav class="rx-toc" aria-label="On this page">
        <p class="rx-toc__label">On This Page</p>
        <a href="#eligibility">Who Needs to Reactivate</a>
        <a href="#steps">Steps to Reactivation</a>
        <a href="#costs">What Your Assessment Covers</a>
        <a href="#regional">Regional Contacts</a>
        <a href="#foundations">Foundation Assessments</a>
        <a href="#transfers">Transfers</a>
        <div class="rx-toc__cta">
          <p>Have questions before you start?</p>
          <a href={withBase("/resources/help-center/")}>Visit Help Center &rarr;</a>
        </div>
      </nav>

      <div class="rx-copy">
        <section class="rx-block" id="eligibility">
          <h2>Who Needs to Reactivate</h2>
          <p class="rx-lead">
            Members who have been financially inactive for <strong>one (1) year or more</strong>.
          </p>
          <p>
            Reactivation happens online through the national website. Have a copy of your degree or
            diploma ready to upload before you begin.
          </p>
        </section>

        <section class="rx-block" id="steps">
          <h2>Steps to Reactivation</h2>
          <ol class="rx-steps">
            <li>
              <strong>Log on to sgrho1922.org.</strong>
              <p>
                Go to{" "}
                <a href="https://sgrho1922.org/" rel="noopener">
                  www.sgrho1922.org
                </a>
                .
              </p>
            </li>
            <li>
              <strong>Click the REACTIVATE tab.</strong>
            </li>
            <li>
              <strong>Create an account if you do not already have an active one.</strong>
              <p>
                You will provide your name, email, phone number and address, and create a username.
              </p>
            </li>
            <li>
              <strong>Click Next.</strong>
            </li>
            <li>
              <strong>Complete the five sections of the form.</strong>
              <dl class="rx-sections">
                {portalSections.map(([n, title, body]) => (
                  <div>
                    <dt>
                      <span>{n}</span> {title}
                    </dt>
                    <dd>{body}</dd>
                  </div>
                ))}
              </dl>
            </li>
          </ol>
          <div class="rx-actions">
            <a class="btn" href="https://sgrho1922.org/" rel="noopener">
              Start Reactivation
            </a>
          </div>
        </section>

        <section class="rx-block" id="costs">
          <h2>What Your Assessment Covers</h2>
          <p>
            Your reactivation total depends on your membership category and region, and it is set
            each fiscal year. The Poodle Portal calculates your exact amount. Every total is made up
            of the same parts:
          </p>
          <ul class="rx-covers">
            {assessmentParts.map(([title, body]) => (
              <li>
                <strong>{title}</strong>
                <span>{body}</span>
              </li>
            ))}
          </ul>
          <div class="rx-actions">
            <a class="btn" href={PORTAL_URL} rel="noopener">
              View Current Dues &amp; Calculate Your Total in the Poodle Portal{" "}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </section>

        <section class="rx-block" id="regional">
          <h2>Regional Contacts</h2>
          <p>Questions about your regional assessment go to your region's Grammateus.</p>
          <ul class="rx-regions">
            {regions.map((r) => (
              <li>
                <strong>{r.name} Region</strong>
                <a href={`mailto:${r.email}`}>{r.email}</a>
                <a href={r.site} rel="noopener">
                  {bare(r.site)}
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="rx-block" id="foundations">
          <h2>Foundation Assessments</h2>
          <p>
            Graduate members pay two foundation assessments. <em>Graduate</em> covers Life Members,
            Cultured Pearls, General Members, Members-at-Large and Graduate members. Undergraduates
            are exempt.
          </p>
          <ul class="rx-funds">
            {foundations.map((f) => (
              <li>
                <h3>{f.name}</h3>
                <a href={f.href} rel="noopener">
                  {f.label} <span aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="rx-block" id="transfers">
          <div class="rx-transfer">
            <div class="rx-transfer__head">
              <h2>Transfers</h2>
              <p class="rx-transfer__fee">
                ${TRANSFER_FEE} <span>transfer fee, includes credit-card processing</span>
              </p>
            </div>
            <p>
              Moving to a different chapter is a transfer, not a reactivation. It starts from your
              Member Profile in the Members Only Portal.
            </p>
            <ol class="rx-transfer__steps">
              {transferSteps.map((t) => (
                <li>{t}</li>
              ))}
            </ol>
          </div>
        </section>

        <aside class="rx-help">
          <strong>Need help?</strong>
          <p>
            International Corporate Headquarters: <a href="tel:+19196789720">(919) 678-9720</a>.
          </p>
          <div class="rx-actions">
            <a class="btn btn--outline" href={withBase("/resources/help-center/")}>
              Visit Help Center
            </a>
            <a class="btn btn--outline" href={withBase("/contact/")}>
              Contact Headquarters
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>

  .rx-main {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .rx-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.3fr) minmax(0, 1fr);
    gap: var(--space-14);
    align-items: start;
  }
  .rx-toc {
    position: sticky;
    top: 200px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .rx-toc__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin: 0;
  }
  .rx-toc a {
    color: var(--royal);
    font-weight: 700;
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .rx-toc a:hover {
    color: var(--accent-hover);
    text-decoration-line: underline;
    text-decoration-color: var(--gold);
  }
  .rx-toc__cta {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .rx-toc__cta p {
    color: var(--muted);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-2);
  }

  .rx-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-14);
    min-width: 0;
  }
  .rx-block {
    scroll-margin-top: 72px;
  }
  .rx-block h2 {
    margin: 0 0 var(--space-4);
  }
  .rx-block > p {
    color: var(--muted);
    max-width: 65ch;
  }
  .rx-block > p.rx-lead {
    color: var(--ink);
    font-size: var(--text-lg);
    padding-left: var(--space-5);
    border-left: 3px solid var(--gold);
  }
  .rx-lead strong {
    color: var(--royal);
  }

  /* A real sequence, so the steps keep their numbers. */
  .rx-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    counter-reset: step;
  }
  .rx-steps > li {
    padding-left: var(--space-10);
    position: relative;
  }
  .rx-steps > li::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    left: 0;
    top: -2px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--royal);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .rx-steps strong {
    color: var(--royal);
  }
  .rx-steps p {
    color: var(--muted);
    margin: var(--space-1) 0 0;
  }
  .rx-sections {
    display: grid;
    margin: var(--space-4) 0 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .rx-sections > div {
    padding: var(--space-3) var(--space-4);
  }
  .rx-sections > div + div {
    border-top: 1px solid var(--line);
  }
  .rx-sections dt {
    color: var(--royal);
    font-weight: 700;
  }
  .rx-sections dt span {
    color: var(--muted-2);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-right: var(--space-2);
  }
  .rx-sections dd {
    margin: var(--space-1) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .rx-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  /* What a total is made of: a ruled definition list, no amounts. */
  .rx-covers {
    display: grid;
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .rx-covers li {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    gap: var(--space-2) var(--space-6);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line);
  }
  .rx-covers strong {
    color: var(--royal);
  }
  .rx-covers span {
    color: var(--muted);
  }
  .rx-regions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: var(--space-5);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }
  .rx-regions li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: var(--text-sm);
  }
  .rx-regions strong {
    color: var(--ink);
    font-size: var(--text-base);
  }
  .rx-regions a {
    color: var(--royal);
    overflow-wrap: anywhere;
  }

  .rx-funds {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rx-funds li {
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .rx-funds h3 {
    margin: 0 0 var(--space-3);
    color: var(--royal);
    font-size: var(--text-md);
  }
  .rx-funds a {
    color: var(--royal);
    font-weight: 700;
    font-size: var(--text-sm);
  }

  .rx-transfer {
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--tint);
  }
  .rx-transfer__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
  }
  .rx-transfer__head h2 {
    margin: 0;
  }
  .rx-transfer__fee {
    margin: 0;
    color: var(--royal);
    font-size: var(--text-h3);
    font-weight: 700;
  }
  .rx-transfer__fee span {
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 400;
  }
  .rx-transfer > p {
    color: var(--muted);
    margin: var(--space-4) 0;
  }
  .rx-transfer__steps {
    margin: 0;
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-2);
    color: var(--ink);
  }

  .rx-help {
    padding-top: var(--space-8);
    border-top: 1px solid var(--line);
  }
  .rx-help strong {
    color: var(--royal);
  }
  .rx-help p {
    margin: var(--space-2) 0 0;
    color: var(--muted);
  }
  .rx-help a:not(.btn) {
    color: var(--royal);
    font-weight: 700;
  }
  .rx-help .rx-actions {
    margin-top: var(--space-4);
  }

  @media (max-width: 860px) {
    .rx-layout {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
    .rx-toc {
      position: static;
    }
  }
  @media (max-width: 620px) {
    .rx-covers li {
      grid-template-columns: 1fr;
    }
  }
</style>
