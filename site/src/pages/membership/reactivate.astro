---
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/url.js";

const steps = [
  {
    title: "Confirm your last active chapter.",
    body: "Locate the chapter you were initiated into or last held active membership with, using the Chapter Locator if needed.",
  },
  {
    title: "Contact International Corporate Headquarters.",
    body: "Reach the Membership Services team to confirm your record and any outstanding requirements.",
  },
  {
    title: "Submit your reactivation request and dues.",
    body: "Complete the reactivation request and remit any applicable dues or fees as instructed by Headquarters.",
  },
  {
    title: "Receive confirmation.",
    body: "Once processed, you'll receive confirmation of your restored active status and chapter assignment.",
  },
];

const faqs = [
  {
    q: "I don't know my last chapter's name — can I still reactivate?",
    a: "Yes. Headquarters can look up your membership record using your name and approximate initiation date.",
  },
  {
    q: "Can I join a different chapter than the one I was initiated into?",
    a: "In many cases, yes — especially if you've relocated. Headquarters can advise on chapter transfer options.",
  },
  {
    q: "Is there a deadline to reactivate?",
    a: "No. Reactivation is available year-round, regardless of how long you've been inactive.",
  },
];
---

<Base
  title="Reactivate Membership"
  activeTop="Membership"
  description="Reactivating your membership reconnects you with Sigma Gamma Rho, your chapter, and Sorors around the world."
>
  <section class="rx-hero">
    <div class="container">
      <p class="breadcrumb">
        <a href={withBase("/")}>Home</a> <span>/</span>{" "}
        <a href={withBase("/membership/become-a-member/")}>Membership</a> <span>/</span>{" "}
        <span>Reactivate Membership</span>
      </p>
      <p class="eyebrow">Membership</p>
      <h1>
        Welcome Back
        <br />
        <span>to the Sisterhood.</span>
      </h1>
      <p>
        Reactivating your membership reconnects you with Sigma Gamma Rho, your chapter, and Sorors
        around the world.
      </p>
    </div>
  </section>

  <section class="rx-main">
    <div class="container rx-layout">
      <nav class="rx-toc" aria-label="On this page">
        <p class="rx-toc__label">On This Page</p>
        <a href="#eligibility">1. Who Can Reactivate</a>
        <a href="#steps">2. Reactivation Steps</a>
        <a href="#faq">3. Frequently Asked Questions</a>
        <div class="rx-toc__cta">
          <p>Have questions before you start?</p>
          <a href={withBase("/resources/help-center/")}>Visit Help Center &rarr;</a>
        </div>
      </nav>

      <div class="rx-copy">
        <section class="rx-block" id="eligibility">
          <span class="rx-index">01</span>
          <h2>Who Can Reactivate</h2>
          <p>
            Any Soror in good standing prior to lapsing may apply to reactivate her membership,
            regardless of how long she has been inactive. Reactivation restores your standing with
            your chapter (or a new chapter, if you've relocated) and with the international
            organization.
          </p>
        </section>

        <section class="rx-block" id="steps">
          <span class="rx-index">02</span>
          <h2>Reactivation Steps</h2>
          <ol class="rx-steps">
            {steps.map((s) => (
              <li>
                <strong>{s.title}</strong>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
          <div class="rx-callout">
            <strong>Ready to start?</strong>
            <span>
              Reach Membership Services through the Help Center or contact Headquarters directly.
            </span>
            <div class="rx-callout__actions">
              <a class="btn" href={withBase("/resources/help-center/")}>
                Visit Help Center
              </a>
              <a class="btn btn--outline" href={withBase("/contact/")}>
                Contact Headquarters
              </a>
            </div>
          </div>
        </section>

        <section class="rx-block" id="faq">
          <span class="rx-index">03</span>
          <h2>Frequently Asked Questions</h2>
          {faqs.map((f) => (
            <p>
              <strong>{f.q}</strong>
              <br />
              {f.a}
            </p>
          ))}
        </section>
      </div>
    </div>
  </section>
</Base>

<style>
  .rx-hero {
    background: var(--cream);
    padding-block: clamp(3rem, 6vw, 4rem);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    color: var(--muted-2);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .breadcrumb a {
    color: inherit;
  }
  .rx-hero h1 {
    max-width: 600px;
    margin: var(--space-2) 0 0;
  }
  .rx-hero > .container > p:last-child {
    max-width: 540px;
    margin: var(--space-5) 0 0;
    color: var(--muted);
  }

  .rx-main {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .rx-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.35fr) minmax(0, 1fr);
    gap: var(--space-14);
    align-items: start;
  }
  .rx-toc {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .rx-toc__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin: 0;
  }
  .rx-toc a {
    color: var(--royal);
    font-weight: 700;
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .rx-toc a:hover {
    color: var(--gold-dark);
  }
  .rx-toc__cta {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .rx-toc__cta p {
    color: var(--muted);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-2);
  }
  .rx-toc__cta a {
    color: var(--gold-dark);
  }

  .rx-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .rx-block {
    scroll-margin-top: 100px;
  }
  .rx-index {
    display: inline-block;
    font-family: var(--font-label);
    color: var(--gold);
    font-size: var(--text-md);
    margin-bottom: var(--space-2);
  }
  .rx-block h2 {
    margin: 0 0 var(--space-4);
  }
  .rx-block > p {
    color: var(--muted);
  }

  .rx-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    counter-reset: step;
  }
  .rx-steps li {
    padding-left: var(--space-10);
    position: relative;
  }
  .rx-steps li::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--royal);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .rx-steps strong {
    color: var(--royal);
  }
  .rx-steps p {
    color: var(--muted);
    margin: var(--space-1) 0 0;
  }

  .rx-callout {
    margin-top: var(--space-8);
    padding: var(--space-6);
    background: var(--tint);
    border-radius: var(--radius-lg);
  }
  .rx-callout strong {
    display: block;
    color: var(--royal);
    margin-bottom: var(--space-2);
  }
  .rx-callout span {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .rx-callout__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .rx-block p strong {
    display: block;
    color: var(--royal);
    margin-bottom: var(--space-1);
  }

  @media (max-width: 860px) {
    .rx-layout {
      grid-template-columns: 1fr;
    }
    .rx-toc {
      position: static;
    }
  }
</style>
