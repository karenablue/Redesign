---
/**
 * Membership Accountability — the public explanation of suspension,
 * expulsion and denouncement, and the public register itself.
 *
 * Register entries live in src/content/accountability/ (see the rules in
 * content.config.ts). The collection ships empty: names are published only
 * from HQ's official register, after counsel approves. Until then each
 * category shows its definition and no table. Wording of the advisory and
 * the five definitions should be confirmed by HQ (and counsel) before launch.
 *
 * HQ's own register in the member portal returns an error to signed-out
 * visitors (HTTP 400, checked 2026-09-26), so it is offered as a sign-in link
 * for members, not as the public's main action.
 */
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { withBase } from "../../lib/url.js";
import { getCollection } from "astro:content";

const REGISTER_URL =
  "https://members.sgrho1922.org/SGRho/SGRho/SGRho_Membership/Expulsions___Suspensions.aspx";

type AccountabilityCategory =
  | "member-suspensions"
  | "chapter-suspensions"
  | "expulsions"
  | "charter-revocations"
  | "denouncements";

type AccountabilityRecord = {
  name: string;
  chapter: string;
  region: string;
  date: string;
  status: string;
  state?: string;
  location?: string;
  firstName?: string;
  lastName?: string;
  endDate?: string;
  fine?: string;
  chapterName?: string;
  lastAffiliatedChapter?: string;
  university?: string;
};

type AccountabilityCell = {
  value: string;
  status?: string;
};

type AccountabilityCategoryConfig = {
  key: AccountabilityCategory;
  title: string;
  body: string;
  action: string;
  columns: string[];
  records: AccountabilityRecord[];
};

// Suspensions whose last day has passed are dropped at build time.
const today = new Date().toISOString().slice(0, 10);
const entries = (await getCollection("accountability"))
  .map((e) => e.data)
  .filter((r) => !r.endDate || r.endDate >= today)
  .sort((a, b) => b.effective.localeCompare(a.effective));
const recordsFor = (category: AccountabilityCategory): AccountabilityRecord[] =>
  entries
    .filter((r) => r.category === category)
    .map((r) => ({
      name: [r.firstName, r.lastName].filter(Boolean).join(" "),
      chapter: r.chapter,
      chapterName: r.chapter,
      lastAffiliatedChapter: r.chapter,
      region: r.region,
      date: r.effective,
      status: r.status ?? "Denounced",
      state: r.state,
      location: r.location,
      firstName: r.firstName,
      lastName: r.lastName,
      endDate: r.endDate,
      fine: r.fine,
      university: r.university,
    }));
const lastListed = entries.map((r) => r.listed).sort().at(-1);

const categories: AccountabilityCategoryConfig[] = [
  {
    key: "member-suspensions",
    title: "Member Suspensions",
    body: "Suspension temporarily disqualifies an individual from participating in any Sorority activities or representing the organization in any capacity until restored to good standing by the Regional Syntaktes, with the approval of the International Grand Basileus.",
    action: "View Member Suspensions",
    columns: [
      "Region",
      "State",
      "Name of Last Affiliated Chapter",
      "Location of Last Affiliated Chapter",
      "First Name",
      "Last Name",
      "End Date",
      "Fine",
    ],
    records: recordsFor("member-suspensions"),
  },
  {
    key: "chapter-suspensions",
    title: "Chapter Suspensions",
    body: "Chapter suspension temporarily restricts a chapter's operations, participation, and public representation until the chapter is restored to good standing by the appropriate governing authority.",
    action: "View Chapter Suspensions",
    columns: ["Region", "State", "Chapter Name", "Location", "End Date", "Fine"],
    records: recordsFor("chapter-suspensions"),
  },
  {
    key: "expulsions",
    title: "Expulsions",
    body: "Expulsion permanently terminates an individual's membership and revokes all rights, privileges, and regalia usage.",
    action: "View Expulsions",
    columns: [
      "Region",
      "Last Affiliated Chapter",
      "Last Affiliated Chapter Location",
      "First Name",
      "Last Name",
    ],
    records: recordsFor("expulsions"),
  },
  {
    key: "charter-revocations",
    title: "Charter Revocation",
    body: "Charter revocation permanently removes a chapter's charter and authorization to operate as a chapter of Sigma Gamma Rho Sorority, Inc.",
    action: "View Charter Revocations",
    columns: ["Region", "Chapter", "University"],
    records: recordsFor("charter-revocations"),
  },
  {
    key: "denouncements",
    title: "Voluntary Denouncements",
    body: "Voluntary denouncement permanently severs an individual from the sisterhood. Denounced individuals hold no membership rights and may not use the Sorority's registered trademarks or symbols.",
    action: "View Denouncements",
    columns: ["Member", "Chapter", "Region", "Date", "Status"],
    records: recordsFor("denouncements"),
  },
];

const formatDate = (date: string) =>
  new Date(`${date}T12:00:00`).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });

const cellsForRecord = (
  record: AccountabilityRecord,
  category: AccountabilityCategory
): AccountabilityCell[] => {
  switch (category) {
    case "member-suspensions":
      return [
        { value: record.region },
        { value: record.state ?? "-" },
        { value: record.chapter },
        { value: record.location ?? "-" },
        { value: record.firstName ?? "-" },
        { value: record.lastName ?? "-" },
        { value: record.endDate ? formatDate(record.endDate) : "-" },
        { value: record.fine ?? "-" },
      ];
    case "chapter-suspensions":
      return [
        { value: record.region },
        { value: record.state ?? "-" },
        { value: record.chapterName ?? record.chapter },
        { value: record.location ?? "-" },
        { value: record.endDate ? formatDate(record.endDate) : "-" },
        { value: record.fine ?? "-" },
      ];
    case "expulsions":
      return [
        { value: record.region },
        { value: record.lastAffiliatedChapter ?? record.chapter },
        { value: record.location ?? "-" },
        { value: record.firstName ?? "-" },
        { value: record.lastName ?? "-" },
      ];
    case "charter-revocations":
      return [
        { value: record.region },
        { value: record.chapterName ?? record.chapter },
        { value: record.university ?? "-" },
      ];
    case "denouncements":
      return [
        { value: record.name },
        { value: record.chapter },
        { value: record.region },
        { value: formatDate(record.date) },
        { value: record.status, status: record.status },
      ];
  }
};
---

<Base
  title="Membership Accountability"
  activeTop="Membership & Intake"
  description="How Sigma Gamma Rho Sorority, Inc. handles suspension, expulsion and denouncement, and how to verify a member's or chapter's standing."
  bodyClass="page-accountability"
>
  <PageHero
    stack
    crumbs={[
      { label: "Home", href: "/" },
      { label: "Membership", href: "/membership/become-a-member/" },
      { label: "Membership Accountability" },
    ]}
    eyebrow="Membership Accountability"
    title="Membership"
    highlight="accountability."
    image="/optimized/hero-charter.webp"
    focal="66% 42%"
    archival
    jumpLabel="The five lists"
    jump={categories.map((c) => ({ href: `#category-${c.key}`, label: c.title }))}
  />

  <section class="ma-main">
    <div class="container">
      <div class="ma-notice">
        <h2>Public Notice &amp; Trademark Advisory</h2>
        <p>
          Sigma Gamma Rho Sorority, Inc.<sup class="reg">&reg;</sup> prohibits hazing, unauthorized
          intake activities, and conduct contrary to its Constitution and Bylaws.
        </p>
        <p>
          Individuals who have been suspended, expelled, or who have voluntarily denounced
          membership are <strong>not in good standing</strong>. They may not wear, display, or use
          the registered trademarks, crest, letters, regalia, or symbols of Sigma Gamma Rho
          Sorority, Inc.<sup class="reg">&reg;</sup> Intake, events, or representation on behalf of
          the Sorority by these individuals, or by unrecognized chapters, are unauthorized.
        </p>
        <div class="ma-notice__actions">
          {entries.length > 0 && (
            <a class="btn" href="#registers">
              View the Public Register
            </a>
          )}
          <a class={entries.length > 0 ? "btn btn--outline" : "btn"} href={withBase("/contact/")}>
            Verify Standing with Headquarters
          </a>
        </div>
      </div>

      <p class="ma-note">
        International Corporate Headquarters maintains the official listing.
        {lastListed && (
          <>
            This public register was last updated{" "}
            <time datetime={lastListed}>{formatDate(lastListed)}</time>.
          </>
        )}{" "}
        Members can also check standing in the{" "}
        <a href={REGISTER_URL} target="_blank" rel="noopener">
          member portal register
          <span class="visually-hidden"> (sign-in required, opens in a new tab)</span>
        </a>
        .
      </p>

      <div class="ma-registers" id="registers">
        {categories.map((category) => (
            <section
              class="ma-register"
              id={`category-${category.key}`}
              aria-labelledby={`category-${category.key}-title`}
            >
              <div class="ma-register__header">
                <div>
                  <p class="eyebrow">Official Register</p>
                  <h2 id={`category-${category.key}-title`}>{category.title}</h2>
                  <p class="ma-register__intro">{category.body}</p>
                </div>
              </div>

              {category.records.length > 0 && (
                <form class="ma-register__search" role="search">
                  <label for={`search-${category.key}`}>Filter {category.title}</label>
                  <div class="ma-search__controls">
                    <input
                      id={`search-${category.key}`}
                      name={`search-${category.key}`}
                      type="search"
                      placeholder="Search this table"
                      autocomplete="off"
                      data-register-search
                    />
                    <button class="btn btn--outline" type="reset">
                      Clear
                    </button>
                  </div>
                  <p class="ma-search__status" aria-live="polite">
                    Showing all records.
                  </p>
                </form>
              )}

              <div class="ma-register__table-wrap">
                <table class="ma-register__table">
                  <thead>
                    <tr>
                      {category.columns.map((column) => (
                        <th scope="col">{column}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {category.records.length === 0 ? (
                      <tr>
                        <td class="ma-register__empty" colspan={category.columns.length}>
                          This list has not been published on this site yet. To check whether
                          someone is in good standing, contact International Corporate
                          Headquarters at{" "}
                          <a href="mailto:help@sgrho1922.org">help@sgrho1922.org</a>.
                        </td>
                      </tr>
                    ) : (
                      category.records.map((record) => (
                        <tr
                          class={category.key.includes("suspensions") ? "is-suspension-row" : ""}
                          data-record-row
                        >
                          {cellsForRecord(record, category.key).map((cell) => (
                            <td>
                              {cell.status ? (
                                <span
                                  class={`status-badge status-badge--${cell.status.toLowerCase().replace(/\s+/g, "-")}`}
                                >
                                  {cell.status}
                                </span>
                              ) : (
                                cell.value
                              )}
                            </td>
                          ))}
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>

              {category.records.length > 0 && (
                <p class="ma-register__note" data-register-count>
                  {category.records.length} record{category.records.length === 1 ? "" : "s"}
                </p>
              )}
            </section>
          ))}
      </div>

      <div class="ma-verify">
        <p>
          To verify the standing of any chapter or individual, contact International Corporate
          Headquarters at <a href="mailto:help@sgrho1922.org">help@sgrho1922.org</a>.
        </p>
        <a class="btn" href={withBase("/resources/anti-hazing-policy/")}>
          Read the Anti-Hazing Policy
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  const registers = Array.from(document.querySelectorAll<HTMLElement>(".ma-register"));

  registers.forEach((register) => {
    const searchForm = register.querySelector<HTMLFormElement>(".ma-register__search");
    const searchInput = register.querySelector<HTMLInputElement>("[data-register-search]");
    const searchStatus = register.querySelector<HTMLElement>(".ma-search__status");

    const filterRecords = () => {
      if (!searchInput || !searchStatus) return;

      const query = searchInput.value.trim().toLocaleLowerCase();
      const rows = Array.from(register.querySelectorAll<HTMLTableRowElement>("[data-record-row]"));
      let matchCount = 0;

      rows.forEach((row) => {
        const matches = !query || row.textContent?.toLocaleLowerCase().includes(query);
        row.hidden = !matches;
        if (matches) matchCount += 1;
      });

      const count = register.querySelector<HTMLElement>("[data-register-count]");
      if (count) {
        count.textContent = `${matchCount} ${matchCount === 1 ? "record" : "records"}${query ? " matching" : ""}`;
      }

      searchStatus.textContent = query
        ? `${matchCount} ${matchCount === 1 ? "record" : "records"} matching "${searchInput.value.trim()}".`
        : "Showing all records.";
    };

    searchInput?.addEventListener("input", filterRecords);
    searchForm?.addEventListener("reset", () => requestAnimationFrame(filterRecords));
  });
</script>

<style>
  .ma-notice__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .ma-main {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .ma-notice {
    max-width: 52rem;
    padding: var(--space-6) var(--space-8);
    border-top: 1px solid var(--gold);
    background: var(--cream);
  }
  .ma-notice h2 {
    margin: 0 0 var(--space-4);
    color: var(--navy);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-md);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ma-notice p {
    margin: 0 0 var(--space-3);
    color: var(--ink);
    max-width: 65ch;
  }
  .ma-notice p:last-child {
    margin-bottom: 0;
  }

  /* Three categories: white cards, a royal top rule, the action on the foot. */
  .ma-note {
    margin: var(--space-4) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .ma-registers {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-12);
    min-width: 0;
  }
  .ma-register__search {
    margin-bottom: var(--space-6);
    padding: 0 0 var(--space-6);
    border-bottom: 1px solid var(--line);
    background: transparent;
  }
  .ma-register__search label {
    display: block;
    margin-bottom: var(--space-3);
    color: var(--navy);
    font-size: var(--text-sm);
    font-weight: 800;
  }
  .ma-search__controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .ma-register__search input {
    flex: 1 1 20rem;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    background: var(--white);
    font: inherit;
  }
  .ma-register__search input:focus-visible {
    outline: 3px solid rgba(38, 70, 158, 0.25);
    outline-offset: 2px;
    border-color: var(--royal);
  }
  .ma-search__status {
    margin: var(--space-3) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .ma-register {
    min-width: 0;
    padding: var(--space-8) 0;
    border-top: 1px solid var(--gold);
    background: var(--cream);
  }
  .ma-register__intro {
    max-width: 46rem;
    margin: var(--space-3) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.7;
  }
  .ma-register__header {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }
  .ma-register__header h2 {
    margin: 0;
    color: var(--navy);
    font-size: clamp(var(--text-xl), 3vw, var(--text-h2));
  }
  .ma-register__table-wrap {
    min-width: 0;
    overflow-x: auto;
  }
  .ma-register__table {
    width: 100%;
    border-collapse: collapse;
    background: var(--white);
  }
  .ma-register__table th,
  .ma-register__table td {
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .ma-register__table th {
    color: var(--navy);
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .ma-register__table td {
    color: var(--ink);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .ma-register__empty {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.7;
    text-align: center;
  }
  .ma-register__table tbody tr.is-suspension-row {
    background: rgba(210, 149, 34, 0.06);
    box-shadow: inset 3px 0 0 var(--gold);
  }
  .ma-register__table tbody tr.is-suspension-row td:nth-child(3) {
    font-weight: 700;
    color: var(--navy);
  }
  .status-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .status-badge--suspended,
  .status-badge--off-suspension {
    color: var(--navy);
    background: rgba(210, 149, 34, 0.18);
    border: 1px solid rgba(210, 149, 34, 0.5);
  }
  .status-badge--expelled,
  .status-badge--revoked,
  .status-badge--denounced {
    color: var(--white);
    background: var(--royal);
    border: 1px solid var(--royal);
  }
  .ma-register__note {
    margin: var(--space-4) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .ma-verify {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--line);
  }
  .ma-verify p {
    margin: 0;
    max-width: 44rem;
    color: var(--ink);
  }
  .ma-verify a:not(.btn) {
    color: var(--royal);
    font-weight: 700;
  }
</style>
