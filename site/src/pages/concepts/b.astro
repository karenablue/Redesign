---
/**
 * Homepage concept B: 1922 / Today. Every section is a pair divided by a
 * gold seam: the archive on the left in black and white, the sisterhood
 * today on the right in colour. The argument is one only Sigma Gamma Rho
 * can make: seven educators at Butler in 1922, 100,000+ women since.
 * Captions use only what the site already states. Design review only
 * (noindex); not linked from the site.
 */
import Base from "../../layouts/Base.astro";
import ConceptBar from "../../components/ConceptBar.astro";
import { withBase } from "../../lib/url.js";

const PORTAL_URL = "https://portal.sgrho1922.org/";
const pairs = [
  {
    then: {
      img: "/optimized/concepts/charter-1924.webp",
      alt: "Alpha Chapter charter members, 1924",
      caption: "Alpha Chapter charter members, 1924",
    },
    now: {
      img: "/optimized/hero-beta-psi-sigma.webp",
      alt: "Four members in yellow, laughing together on a brick wall",
      caption: "700+ collegiate and alumnae chapters today",
    },
    title: "From one chapter to seven hundred",
    text: "The sisterhood that began with a single chapter now meets in collegiate and alumnae chapters across 50+ states and territories and 10 countries.",
    link: { label: "Find a chapter", href: "/membership/chapter-locator/" },
  },
  {
    then: {
      img: "/optimized/concepts/butler.webp",
      alt: "Historic Butler University campus",
      caption: "Butler University, Indianapolis",
    },
    now: {
      img: "/optimized/concepts/board-boule-2.webp",
      alt: "The 2026–2028 International Board of Directors on stage at the 61st Boulé",
      caption: "The 61st International Biennial Boulé, Tampa, 2026",
    },
    title: "From Butler to the Boulé",
    text: "The only NPHC sorority founded at a predominantly white institution now gathers thousands of members, partners and guests at its International Biennial Boulé.",
    link: {
      label: "Read about the 61st Boulé",
      href: "/news-events/latest-news/61st-biennial-boule/",
    },
  },
];
---

<Base
  title="Concept B: 1922 / Today"
  description="Homepage design concept B."
  bodyClass="concept concept-b"
  noindex
>
  <ConceptBar current="b" />

  <section class="diptych on-dark" aria-labelledby="diptych-title">
    <figure class="diptych__half diptych__then">
      <img
        src={withBase("/optimized/concepts/founders-full.webp")}
        alt="Portraits of the seven Founders"
        fetchpriority="high"
      />
      <figcaption class="diptych__year" aria-hidden="true">
        1922
      </figcaption>
    </figure>
    <figure class="diptych__half diptych__now">
      <img
        src={withBase("/optimized/concepts/board-boule.webp")}
        alt="The 2026–2028 International Board of Directors on stage at the 61st Boulé"
      />
      <figcaption class="diptych__year" aria-hidden="true">
        Today
      </figcaption>
    </figure>
    <div class="diptych__seam" aria-hidden="true"></div>
    <div class="diptych__words">
      <div class="container">
        <h1 id="diptych-title">
          Seven educators then.
          <span>More than 100,000 women since.</span>
        </h1>
        <div class="diptych__actions">
          <a class="btn" href={withBase("/membership/become-a-member/")}>
            Become a member
          </a>
          <a class="btn btn--outline on-dark" href={withBase("/about/herstory/")}>
            Read our Herstory
          </a>
          <a class="diptych__login" href={PORTAL_URL} target="_blank" rel="noopener">
            Member login<span class="visually-hidden"> (opens the Poodle Portal in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {pairs.map((p, i) => (
    <section class:list={["pair", { "pair--tint": i % 2 === 1 }]} aria-labelledby={`pair-${i}`}>
      <div class="container">
        <div class="pair__photos">
          <figure class="pair__then">
            <img src={withBase(p.then.img)} alt={p.then.alt} loading="lazy" />
            <figcaption>{p.then.caption}</figcaption>
          </figure>
          <figure class="pair__now">
            <img src={withBase(p.now.img)} alt={p.now.alt} loading="lazy" />
            <figcaption>{p.now.caption}</figcaption>
          </figure>
        </div>
        <div class="pair__words">
          <h2 id={`pair-${i}`}>{p.title}</h2>
          <p>{p.text}</p>
          <a href={withBase(p.link.href)}>{p.link.label}</a>
        </div>
      </div>
    </section>
  ))}

  <section class="motto on-dark" aria-labelledby="motto-title">
    <div class="container motto__inner">
      <h2 id="motto-title">
        Greater Service,
        <br />
        Greater Progress<sup>&reg;</sup>
      </h2>
      <p>
        Maternal health, water safety, school supplies, women's wellness and youth leadership: five
        national programs carry the Founders' purpose into communities today.
      </p>
      <a class="btn" href={withBase("/service-impact/national-programs/")}>
        See the national programs
      </a>
    </div>
  </section>
</Base>

<style>
  /* ---- The diptych: the one bold moment ---- */
  .diptych {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: minmax(26rem, 62vh) auto;
    background: var(--navy);
    color: #fff;
  }
  .diptych__half {
    position: relative;
    margin: 0;
    overflow: hidden;
  }
  .diptych__half img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .diptych__then img {
    filter: grayscale(100%) contrast(1.05);
  }
  .diptych__now img {
    object-position: 55% 40%;
  }
  .diptych__half::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(8, 22, 51, 0.9) 0%, rgba(8, 22, 51, 0) 55%);
  }
  .diptych__year {
    position: absolute;
    z-index: 1;
    bottom: var(--space-6);
    font-family: var(--font-label);
    font-size: clamp(3rem, 9vw, 8rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
  }
  .diptych__then .diptych__year {
    right: var(--space-8);
    color: #fff;
  }
  .diptych__now .diptych__year {
    left: var(--space-8);
    color: var(--gold);
  }
  /* The seam: a gold rule down the middle of the page, drawn once. */
  .diptych__seam {
    grid-row: 1;
    grid-column: 1 / -1;
    justify-self: center;
    position: relative;
    z-index: 2;
    width: 4px;
    height: 100%;
    background: var(--gold);
    transform-origin: top;
    animation: seam 1100ms var(--ease-out-strong) both;
  }
  @keyframes seam {
    from {
      transform: scaleY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .diptych__seam {
      animation: none;
    }
  }
  .diptych__half {
    grid-row: 1;
  }
  .diptych__then {
    grid-column: 1;
  }
  .diptych__now {
    grid-column: 2;
  }
  .diptych__words {
    grid-row: 2;
    grid-column: 1 / -1;
    padding-block: var(--space-10) var(--space-12);
    text-align: center;
  }
  .diptych h1 {
    margin: 0;
    font-family: var(--font-editorial);
    font-weight: 500;
    font-size: clamp(2rem, 4.4vw, 3.75rem);
    line-height: 1.12;
    color: #fff;
  }
  .diptych h1 span {
    display: block;
    color: var(--gold);
    font-style: italic;
  }
  .diptych__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-8);
  }
  .diptych__login {
    color: #fff;
    font-weight: 700;
  }

  /* ---- Pairs: then and now, divided by the same seam ---- */
  .pair {
    padding-block: clamp(3.5rem, 7vw, 6rem);
    background: #fff;
  }
  .pair--tint {
    background: var(--tint);
  }
  .pair__photos {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    background: var(--gold);
  }
  .pair__photos figure {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--navy);
  }
  .pair__photos img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pair__then img {
    filter: grayscale(100%);
  }
  .pair__photos figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-8) var(--space-4) var(--space-3);
    background: linear-gradient(0deg, rgba(8, 22, 51, 0.85), rgba(8, 22, 51, 0));
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .pair__words {
    max-width: 44rem;
    margin: var(--space-8) auto 0;
    text-align: center;
  }
  .pair h2 {
    margin: 0;
    font-family: var(--font-editorial);
    font-weight: 500;
    font-size: clamp(1.8rem, 3.4vw, 2.75rem);
    line-height: 1.15;
    color: var(--navy);
  }
  .pair p {
    margin: var(--space-4) 0;
    color: var(--muted);
    font-size: var(--text-md);
    line-height: 1.7;
  }
  .pair a {
    color: var(--royal);
    font-weight: 700;
  }

  /* ---- Motto ---- */
  .motto {
    padding-block: clamp(4rem, 8vw, 6.5rem);
    background: var(--navy);
    color: #fff;
    text-align: center;
  }
  .motto__inner {
    max-width: 48rem;
  }
  .motto h2 {
    margin: 0;
    font-family: var(--font-label);
    font-weight: 400;
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1;
    color: var(--gold);
  }
  .motto p {
    margin: var(--space-6) auto var(--space-8);
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--text-md);
    line-height: 1.7;
  }

  @media (max-width: 700px) {
    .diptych {
      grid-template-rows: 15rem 15rem auto;
      grid-template-columns: 1fr;
    }
    .diptych__then {
      grid-row: 1;
      grid-column: 1;
    }
    .diptych__now {
      grid-row: 2;
      grid-column: 1;
    }
    .diptych__words {
      grid-row: 3;
    }
    .diptych__seam {
      grid-row: 2;
      align-self: start;
      justify-self: stretch;
      width: auto;
      height: 4px;
      margin-top: -2px;
      transform-origin: left;
      animation-name: seam-across;
    }
    @keyframes seam-across {
      from {
        transform: scaleX(0);
      }
    }
    .diptych__then .diptych__year,
    .diptych__now .diptych__year {
      left: var(--space-5);
      right: auto;
    }
    .pair__photos {
      grid-template-columns: 1fr;
    }
  }
</style>
