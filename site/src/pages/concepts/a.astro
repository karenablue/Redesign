---
/**
 * Homepage concept A: The Cover. The first screen is a magazine cover: one
 * full-bleed photograph of a chapter, "One Sigma" set as the masthead, and
 * three cover lines that open real stories. Everything after it is quiet
 * editorial spreads. All copy and figures come from the live site's pages.
 * Design review only (noindex); not linked from the site.
 */
import Base from "../../layouts/Base.astro";
import ConceptBar from "../../components/ConceptBar.astro";
import { withBase } from "../../lib/url.js";

const PORTAL_URL = "https://portal.sgrho1922.org/";
const coverLines = [
  {
    title: "Boulé by the Bay",
    text: "Thousands of members, partners and guests gathered in Tampa for the 61st International Biennial Boulé.",
    href: "/news-events/latest-news/61st-biennial-boule/",
  },
  {
    title: "Water safety, one pool at a time",
    text: "SWIM 1922® brings water safety and swim instruction into local communities through USA Swimming.",
    href: "/service-impact/national-programs/#swim",
  },
  {
    title: "Meet the 2026–2028 board",
    text: "The International Board of Directors, chaired by the 26th International Grand Basileus.",
    href: "/leadership/international-board/",
  },
];
const programs = [
  { name: "Project CRADLE Care®", what: "Supporting Black maternal health", href: "#cradle" },
  { name: "Operation BigBookBag®", what: "Equipping students to learn", href: "#bigbookbag" },
  { name: "Women's Wellness Initiative", what: "Supporting women's well-being", href: "#wellness" },
];
---

<Base
  title="Concept A: The Cover"
  description="Homepage design concept A."
  bodyClass="concept concept-a"
  noindex
>
  <ConceptBar current="a" />

  <section class="cover on-dark" aria-labelledby="cover-title">
    <img
      class="cover__photo"
      src={withBase("/optimized/concepts/cover-beta-alpha.webp")}
      srcset={`${withBase("/optimized/concepts/cover-beta-alpha-900.webp")} 900w, ${withBase("/optimized/concepts/cover-beta-alpha.webp")} 1920w`}
      sizes="100vw"
      alt="Chapter members in yellow dresses, standing in a line on a lawn"
      fetchpriority="high"
    />
    <div class="cover__shade" aria-hidden="true"></div>
    <div class="container cover__grid">
      <div class="cover__masthead">
        <p class="cover__issue">
          Sigma Gamma Rho Sorority, Inc.<sup>&reg;</sup> Since 1922
        </p>
        <h1 id="cover-title" class="cover__title">
          One Sigma
        </h1>
      </div>
      <div class="cover__bottom">
        <div class="cover__intro">
          <p class="cover__deck">
            Seven founders. A century of greater service. One sisterhood, in every region.
          </p>
          <div class="cover__actions">
            <a class="btn" href={withBase("/membership/become-a-member/")}>
              Become a member
            </a>
            <a class="btn btn--outline on-dark" href={PORTAL_URL} target="_blank" rel="noopener">
              Member login
              <span class="visually-hidden"> (opens the Poodle Portal in a new tab)</span>
            </a>
          </div>
        </div>
        <ul class="cover__lines" aria-label="In this issue">
          {coverLines.map((c) => (
            <li>
              <a href={withBase(c.href)}>
                <strong>{c.title}</strong>
                <span>{c.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="reach" aria-label="Our reach">
    <p class="container reach__sentence">
      More than <b>100,000</b> women, in <b>700+</b> collegiate and alumnae chapters, across{" "}
      <b>50+</b> states and territories and <b>10</b> countries.
    </p>
  </section>

  <section class="spread" aria-labelledby="spread-quote">
    <figure class="spread__photo">
      <img
        src={withBase("/optimized/hero-grand-basileus.webp")}
        alt="Marica T. Harris, 26th International Grand Basileus"
        loading="lazy"
      />
    </figure>
    <div class="spread__text">
      <h2 id="spread-quote" class="visually-hidden">
        The administration's theme
      </h2>
      <blockquote>
        <p>
          “I will focus on strengthening our sisterhood in the spirit of ‘One Sigma’, the theme of
          unity across the board through the Sorority’s administration.”
        </p>
        <footer>
          <strong>Marica T. Harris</strong>
          <span>26th International Grand Basileus</span>
        </footer>
      </blockquote>
      <a class="spread__link" href={withBase("/leadership/international-grand-basileus/")}>
        Meet the Grand Basileus
      </a>
    </div>
  </section>

  <section class="feature" aria-labelledby="feature-swim">
    <img
      class="feature__photo"
      src={withBase("/optimized/concepts/swim.webp")}
      alt="A Swim 1922 instructor high-fives a young swimmer at the pool's edge"
      loading="lazy"
    />
    <div class="container feature__text">
      <p class="feature__kicker">National programs</p>
      <h2 id="feature-swim">Teaching water safety</h2>
      <p>
        SWIM 1922® brings water safety and swim instruction into local communities through USA
        Swimming.
      </p>
      <a class="btn" href={withBase("/service-impact/national-programs/#swim")}>
        Explore SWIM 1922
      </a>
    </div>
  </section>

  <section class="feature feature--flip" aria-labelledby="feature-youth">
    <img
      class="feature__photo"
      src={withBase("/optimized/concepts/youth.webp")}
      alt="Members with young people at a Youth Symposium"
      loading="lazy"
    />
    <div class="container feature__text">
      <h2 id="feature-youth">Strengthening young futures</h2>
      <p>
        The Annual Youth Symposium engages young people in hands-on education, leadership
        development, and life skills.
      </p>
      <a class="btn" href={withBase("/service-impact/national-programs/#youth")}>
        Explore the Youth Symposium
      </a>
    </div>
  </section>

  <section class="more container" aria-labelledby="more-title">
    <h2 id="more-title">More of the work</h2>
    <ul>
      {programs.map((p) => (
        <li>
          <a href={withBase(`/service-impact/national-programs/${p.href}`)}>
            <strong>{p.name}</strong>
            <span>{p.what}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="join on-dark" aria-labelledby="join-title">
    <img
      class="join__photo"
      src={withBase("/optimized/concepts/join-pair.webp")}
      alt=""
      loading="lazy"
    />
    <div class="container join__text">
      <h2 id="join-title">Find your chapter</h2>
      <p>Undergraduate and alumnae chapters, from campuses to cities, in every region.</p>
      <div class="cover__actions">
        <a class="btn" href={withBase("/membership/chapter-locator/")}>
          Search chapters
        </a>
        <a class="btn btn--outline on-dark" href={withBase("/membership/become-a-member/")}>
          How to join
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- The cover: the one bold moment ---- */
  .cover {
    position: relative;
    display: grid;
    min-height: min(calc(100svh - 7rem), 900px);
    overflow: hidden;
    color: #fff;
    background: var(--navy);
  }
  .cover__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 58%;
  }
  .cover__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(8, 22, 51, 0.7) 0%, rgba(8, 22, 51, 0) 34%),
      linear-gradient(
        0deg,
        rgba(8, 22, 51, 0.94) 0%,
        rgba(8, 22, 51, 0.6) 38%,
        rgba(8, 22, 51, 0) 70%
      );
  }
  /* A magazine cover: the masthead across the top, over the trees; the
     deck and cover lines at the foot; the faces left clear between. */
  .cover__grid {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding-block: var(--space-8) var(--space-12);
  }
  .cover__bottom {
    grid-row: 3;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--space-10);
    align-items: end;
  }
  .cover__issue {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.85);
  }
  .cover__title {
    margin: 0;
    font-family: var(--font-label);
    font-weight: 400;
    font-size: clamp(2.9rem, 11.5vw, 10.5rem);
    line-height: 0.85;
    white-space: nowrap;
    letter-spacing: -0.045em;
    color: #fff;
  }
  .cover__deck {
    max-width: 30rem;
    margin: 0;
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.35;
    color: #fff;
  }
  .cover__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .cover__lines {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--gold);
  }
  .cover__lines a {
    display: block;
    padding: var(--space-4) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
    color: #fff;
    text-decoration: none;
  }
  .cover__lines strong {
    display: block;
    font-family: var(--font-editorial);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--gold);
  }
  .cover__lines span {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.86);
  }
  .cover__lines a:hover strong {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  /* One orchestrated moment: the cover photo settles and the cover lines
     arrive once, after the masthead. */
  .cover__photo {
    animation: sgr-settle 12s var(--ease-out-strong) both;
  }
  .cover__lines li {
    animation: cover-line 700ms var(--ease-out-strong) both;
  }
  .cover__lines li:nth-child(1) {
    animation-delay: 350ms;
  }
  .cover__lines li:nth-child(2) {
    animation-delay: 450ms;
  }
  .cover__lines li:nth-child(3) {
    animation-delay: 550ms;
  }
  @keyframes cover-line {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cover__photo,
    .cover__lines li {
      animation: none;
    }
  }

  /* ---- The numbers as one sentence ---- */
  .reach {
    padding-block: clamp(4rem, 9vw, 7rem);
    background: #fff;
  }
  .reach__sentence {
    max-width: 62rem;
    margin: 0 auto;
    font-family: var(--font-editorial);
    font-size: clamp(1.7rem, 3.6vw, 3rem);
    line-height: 1.3;
    color: var(--navy);
  }
  .reach__sentence b {
    font-family: var(--font-label);
    font-weight: 400;
    font-size: 1.15em;
    letter-spacing: -0.02em;
    color: var(--royal);
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 0.07em;
    text-underline-offset: 0.12em;
  }

  /* ---- Spread: portrait and quote, 7 / 5 ---- */
  .spread {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    background: var(--navy);
    color: #fff;
  }
  .spread__photo {
    margin: 0;
    min-height: 34rem;
  }
  .spread__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
  }
  .spread__text {
    align-self: center;
    padding: clamp(2.5rem, 6vw, 5rem);
  }
  .spread blockquote {
    margin: 0;
  }
  .spread blockquote p {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.35;
  }
  .spread footer {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 2px solid var(--gold);
  }
  .spread footer strong,
  .spread footer span {
    display: block;
  }
  .spread footer span {
    color: rgba(255, 255, 255, 0.8);
    font-size: var(--text-sm);
  }
  .spread__link {
    display: inline-block;
    margin-top: var(--space-6);
    color: var(--gold);
    font-weight: 700;
  }

  /* ---- Program features: half-bleed photo beside the words ---- */
  .feature {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 32rem;
    background: #fff;
  }
  .feature__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .feature__text {
    align-self: center;
    width: auto;
    max-width: 34rem;
    margin: 0;
    padding: clamp(2.5rem, 6vw, 5rem);
  }
  .feature--flip .feature__photo {
    order: 2;
  }
  .feature__kicker {
    margin: 0 0 var(--space-3);
    color: var(--royal);
    font-weight: 700;
  }
  .feature h2 {
    margin: 0;
    font-family: var(--font-editorial);
    font-weight: 500;
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.1;
    color: var(--navy);
  }
  .feature p:not(.feature__kicker) {
    margin: var(--space-4) 0 var(--space-6);
    color: var(--muted);
    font-size: var(--text-md);
    line-height: 1.7;
  }

  /* ---- More of the work: a quiet list ---- */
  .more {
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .more h2 {
    margin: 0 0 var(--space-6);
    font-family: var(--font-editorial);
    font-weight: 500;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    color: var(--navy);
  }
  .more ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .more a {
    display: block;
    padding-top: var(--space-4);
    border-top: 2px solid var(--gold);
    text-decoration: none;
  }
  .more strong {
    display: block;
    color: var(--royal);
    font-size: var(--text-md);
  }
  .more span {
    display: block;
    margin-top: var(--space-1);
    color: var(--muted);
  }
  .more a:hover strong {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* ---- Join: the pair photograph, full bleed ---- */
  .join {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 28rem;
    overflow: hidden;
    background: var(--navy);
    color: #fff;
  }
  .join__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 30%;
  }
  .join::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(8, 22, 51, 0.95) 0%,
      rgba(8, 22, 51, 0.75) 45%,
      rgba(8, 22, 51, 0.1) 80%
    );
  }
  .join__text {
    position: relative;
    z-index: 2;
  }
  .join h2 {
    margin: 0;
    font-family: var(--font-label);
    font-weight: 400;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 0.95;
    color: #fff;
  }
  .join p {
    max-width: 28rem;
    margin: var(--space-4) 0 0;
    font-size: var(--text-md);
    color: rgba(255, 255, 255, 0.88);
  }

  @media (max-width: 900px) {
    .cover__bottom {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    /* On a phone the photograph sits under the masthead as a block, faces
       in view, and the words follow on navy. */
    .cover__photo {
      height: 26rem;
      object-position: 42% 62%;
    }
    .cover__shade {
      background: linear-gradient(
        180deg,
        rgba(8, 22, 51, 0.7) 0,
        rgba(8, 22, 51, 0) 8rem,
        rgba(8, 22, 51, 0) 18rem,
        #081633 26rem
      );
    }
    .cover__grid {
      row-gap: 13rem;
    }
    .spread,
    .feature {
      grid-template-columns: 1fr;
    }
    .spread__photo {
      min-height: 22rem;
    }
    .feature__photo,
    .feature--flip .feature__photo {
      order: 0;
      height: 16rem;
    }
    .more ul {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
