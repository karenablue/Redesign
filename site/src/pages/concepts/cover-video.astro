---
/**
 * The new homepage cover with the hero film behind it instead of the
 * still, for Karena to compare (2026-09-26). Review only (noindex); delete
 * with src/pages/concepts/ once she chooses.
 */
import Base from "../../layouts/Base.astro";
import HomeCover from "../../components/HomeCover.astro";
import { withBase } from "../../lib/url.js";
---

<Base title="Cover with video" description="Homepage cover, video version." bodyClass="page-home" noindex>
  <nav class="compare" aria-label="Compare the cover">
    <div class="container">
      <strong>Cover with the video.</strong>
      <a href={withBase("/")}>See the cover with the photo (the homepage)</a>
    </div>
  </nav>
  <HomeCover video />
</Base>

<style>
  .compare {
    background: #fff8d6;
    border-bottom: 1px solid var(--gold);
    font-size: var(--text-sm);
  }
  .compare .container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-3);
  }
  .compare a {
    color: var(--royal);
    font-weight: 600;
  }
</style>
