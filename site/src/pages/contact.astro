---
/**
 * Contact — the institutional contact hub.
 *
 * Left: HQ's address, phone, email, and routing to the pages that handle
 * common requests. Right: an inquiry form that composes an email to
 * help@sgrho1922.org (see scripts/compose-email.ts), with a link to the
 * Freshdesk ticket form for anyone who wants a tracking number. Office hours
 * are not published, so none are stated.
 */
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { withBase } from "../lib/url.js";

const EMAIL = "help@sgrho1922.org";
const TICKET_URL = "https://helpsgrho1922.freshdesk.com/support/tickets/new";
const PORTAL_URL = "https://portal.sgrho1922.org/";

const routes = [
  {
    label: "Media & Press",
    note: "Official statements, press inquiries, and brand resources",
    href: "/news-events/media-relations/",
  },
  {
    label: "Reactivation & Transfers",
    note: "Return to active membership or understand the transfer process",
    href: "/membership/reactivate/",
  },
  {
    label: "Becoming a Member",
    note: "Eligibility, collegiate and alumnae pathways, and official process",
    href: "/membership/become-a-member/",
  },
  {
    label: "Licensed Vendors",
    note: "Vendor authorization, licensing tiers, and consumer verification",
    href: "/resources/vendor/",
  },
  {
    label: "Sponsorship & Partnerships",
    note: "National programs, strategic collaboration, and partnership inquiries",
    href: "/service-impact/corporate-partnerships/",
  },
  {
    label: "Verify a Member's Standing",
    note: "Membership accountability and official standing resources",
    href: "/membership/accountability/",
  },
];

const affiliations = [
  "Prospective member (collegiate)",
  "Prospective member (alumnae)",
  "Active or inactive Soror",
  "Corporate sponsor or partner",
  "Licensed vendor",
  "General public",
];
const departments = [
  "Membership Services & Verification",
  "Operations & National Events",
  "Media & Communications",
  "Financial Inquiries",
  "Something else",
];
---

<Base
  title="Contact"
  activeTop="Contact"
  description="Contact Sigma Gamma Rho's International Corporate Headquarters: address, phone, email, and an inquiry form."
>
  <PageHero
    stack
    eyebrow="Contact Sigma Gamma Rho"
    title="Connect with"
    highlight="Headquarters."
    copy="Find the right team for your question, open a support ticket, or reach International Corporate Headquarters directly."
    size="compact"
  >
    <a class="btn" href={TICKET_URL} target="_blank" rel="noopener">Open a Support Ticket <span aria-hidden="true">&#8599;</span></a>
    <a class="btn btn--outline on-dark" href="#headquarters-contact">Contact Details <span aria-hidden="true">&darr;</span></a>
  </PageHero>

  <section class="ct-routing" aria-labelledby="ct-routing-title">
    <div class="container">
      <div class="ct-routing__heading">
        <p class="eyebrow">Start Here</p>
        <h2 id="ct-routing-title">Choose the Right Destination</h2>
        <p>Many common requests already have a dedicated resource and a faster next step.</p>
      </div>
      <ul class="ct-routes">
        {routes.map((route) => (
          <li>
            <a href={withBase(route.href)}>
              <span>
                <strong>{route.label}</strong>
                <small>{route.note}</small>
              </span>
              <b aria-hidden="true">&rarr;</b>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="ct-main" id="headquarters-contact">
    <div class="container ct-grid">
      <aside class="ct-card">
        <h2>International Corporate Headquarters</h2>
        <dl>
          <div>
            <dt>Office</dt>
            <dd>
              1000 Southhill Dr, STE 200
              <br />
              Cary, NC 27513
            </dd>
          </div>
          <div>
            <dt>Mailing</dt>
            <dd>
              P.O. Box 27688
              <br />
              Raleigh, NC 27611
            </dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd>
              <a href="tel:+19196789720">(919) 678-9720</a>
            </dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd>
              <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
            </dd>
          </div>
        </dl>
      </aside>

      <form
        class="ct-form inquiry-form"
        data-compose
        data-subject="Website Inquiry"
        data-subject-field="cf-dept"
        action={`mailto:${EMAIL}`}
        method="post"
        enctype="text/plain"
      >
        <h2>Send an Inquiry</h2>
        <p class="ct-form__hint">
          This opens a pre-filled email in your mail app. Prefer a tracking number?{" "}
          <a href={TICKET_URL} target="_blank" rel="noopener">
            Submit a help desk ticket
          </a>
          .
        </p>
        <div class="inquiry-form__row">
          <label>
            <span>Full name</span>
            <input
              id="cf-name"
              data-label="Name"
              name="name"
              type="text"
              autocomplete="name"
              required
            />
          </label>
          <label>
            <span>Email address</span>
            <input
              id="cf-email"
              data-label="Email"
              name="email"
              type="email"
              autocomplete="email"
              required
            />
          </label>
        </div>
        <div class="inquiry-form__row">
          <label>
            <span>
              Phone <small>(optional)</small>
            </span>
            <input id="cf-phone" data-label="Phone" name="phone" type="tel" autocomplete="tel" />
          </label>
          <label>
            <span>
              Member ID <small>(optional)</small>
            </span>
            <input id="cf-member" data-label="Member ID" name="member" type="text" />
          </label>
        </div>
        <div class="inquiry-form__row">
          <label>
            <span>I am a</span>
            <select id="cf-aff" data-label="Affiliation" name="affiliation" required>
              <option value="">Choose one</option>
              {affiliations.map((a) => (
                <option>{a}</option>
              ))}
            </select>
          </label>
          <label>
            <span>Department</span>
            <select id="cf-dept" data-label="Department" name="department" required>
              <option value="">Choose one</option>
              {departments.map((d) => (
                <option>{d}</option>
              ))}
            </select>
          </label>
        </div>
        <label>
          <span>Message</span>
          <textarea
            id="cf-message"
            data-body
            name="message"
            rows="6"
            placeholder="How can we help?"
            required
          ></textarea>
        </label>
        <button class="btn ct-submit" type="submit">
          Submit Inquiry <span aria-hidden="true">&rarr;</span>
        </button>
      </form>
    </div>
  </section>

  <CtaBand
    eyebrow="For our members"
    title="Your membership."
    highlight="At your fingertips."
    copy="Check dues status, update your contact details, and manage your member profile."
    actions={[{ label: "Log in to Poodle Portal", href: PORTAL_URL }]}
  />
</Base>

<script>
  import { wireComposeForms } from "../scripts/compose-email";

  wireComposeForms();
</script>

<style>
  .ct-routing {
    padding-block: clamp(3rem, 5vw, 4.5rem);
    background: var(--white);
  }
  .ct-routing__heading {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.9fr);
    gap: var(--space-4) var(--space-10);
    align-items: end;
    margin-bottom: var(--space-8);
  }
  .ct-routing__heading .eyebrow {
    grid-column: 1 / -1;
  }
  .ct-routing__heading h2,
  .ct-routing__heading p {
    margin: 0;
  }
  .ct-routing__heading h2 {
    font-family: var(--font-editorial);
    letter-spacing: -0.025em;
  }
  .ct-routing__heading p:last-child {
    color: var(--muted);
  }
  .ct-routes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ct-routes a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-5);
    border-top: 1px solid var(--line-strong);
    background: var(--cream);
    color: var(--ink);
    text-decoration: none;
    transition:
      box-shadow 0.18s ease,
      transform 0.18s ease;
  }
  .ct-routes a:hover {
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }
  .ct-routes strong,
  .ct-routes small {
    display: block;
  }
  .ct-routes strong {
    color: var(--navy);
  }
  .ct-routes small {
    margin-top: var(--space-2);
    color: var(--muted);
    font-size: var(--text-xs);
    line-height: 1.5;
  }
  .ct-routes b {
    color: var(--royal);
  }

  .ct-main {
    scroll-margin-top: var(--space-24);
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .ct-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-10);
    align-items: start;
  }
  .ct-card,
  .ct-form {
    padding: var(--space-8);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .ct-card h2,
  .ct-form h2 {
    margin: 0 0 var(--space-5);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--ink);
  }
  .ct-card dl {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }
  .ct-card dt {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ct-card dd {
    margin: var(--space-1) 0 0;
    color: var(--ink);
    font-weight: 600;
  }
  .ct-card dd a {
    color: var(--royal);
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .ct-form {
    display: grid;
    gap: var(--space-5);
  }
  .ct-form h2 {
    margin: 0;
  }
  .ct-form__hint {
    margin: calc(var(--space-3) * -1) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .ct-form__hint a {
    color: var(--royal);
    font-weight: 700;
  }
  .ct-form small {
    color: var(--muted);
    font-weight: 400;
  }
  .ct-submit {
    justify-content: center;
    width: 100%;
  }
  @media (max-width: 900px) {
    .ct-routing__heading,
    .ct-routes {
      grid-template-columns: minmax(0, 1fr);
    }
    .ct-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ct-routes a {
      transition: none;
    }
  }
  @media (max-width: 560px) {
    .ct-card,
    .ct-form {
      padding: var(--space-5);
    }
  }

</style>
