---
/**
 * Contact — ported from the original contact/index.html.
 *
 * Treatment: a dotted-cream breadcrumb hero ("Let's Talk Sisterhood."), then
 * four alternating FeatureRow sections routing each audience (Headquarters,
 * Membership, Media & Press, Vendors & Partners) to the right destination.
 */
import Base from "../layouts/Base.astro";
import FeatureRow from "../components/FeatureRow.astro";
import { withBase } from "../lib/url.js";
---

<Base
  title="Contact"
  activeTop="Contact"
  description="Find the appropriate contact path for questions, support, partnerships, media, and general inquiries."
>
  <section class="contact-hero">
    <div class="container contact-hero__inner">
      <p class="breadcrumb">
        <a href={withBase("/")}>Home</a> <span>/</span> <span>Contact</span>
      </p>
      <p class="eyebrow">Contact</p>
      <h1 class="contact-hero__title">
        Let's Talk
        <br />
        <span>Sisterhood.</span>
      </h1>
      <p class="contact-hero__lead">
        Whichever door you knock on, we'll get you to the right place.
      </p>
    </div>
  </section>

  <FeatureRow
    eyebrow="Headquarters"
    image="/images/Sigma Gamma Rho Sorority Mosaic Crest.jpg"
    imageAlt="Sigma Gamma Rho Sorority crest mosaic"
    index={0}
  >
    <h3>
      Member &amp; <span class="gold">Organizational Support.</span>
    </h3>
    <p>
      General questions, records, and organizational support are handled by International Corporate
      Headquarters.
    </p>
    <ul class="contact-facts">
      <li>P.O. Box 27688 &bull; Raleigh, NC 27611</li>
      <li>Office: (919) 678-9720</li>
      <li>
        <a href="mailto:help@sgrho1922.org">help@sgrho1922.org</a>
      </li>
    </ul>
    <a class="zigzag-link" href={withBase("/about/headquarters/")}>
      Meet the ICHQ Team &rarr;
    </a>
  </FeatureRow>

  <FeatureRow
    eyebrow="Membership"
    image="/images/ug sorors 5.jpg"
    imageAlt="Sigma Gamma Rho undergraduate members together"
    index={1}
  >
    <h3>
      Questions About <span class="gold">Joining or Reactivating?</span>
    </h3>
    <p>
      Prospective members and returning Sorors can start with the membership and reactivation pages,
      or reach the Help Center for guidance.
    </p>
    <ul class="contact-facts">
      <li>
        <a href={withBase("/membership/become-a-member/")}>Become a Member</a>
      </li>
      <li>
        <a href={withBase("/membership/reactivate/")}>Reactivate Membership</a>
      </li>
      <li>
        <a href={withBase("/resources/help-center/")}>Visit the Help Center</a>
      </li>
    </ul>
  </FeatureRow>

  <FeatureRow
    eyebrow="Media & Press"
    image="/images/Congressional Day on the Hill 2.jpg"
    imageAlt="Sigma Gamma Rho members at Congressional Day on the Hill"
    index={0}
  >
    <h3>
      Reporting on <span class="gold">Sigma Gamma Rho?</span>
    </h3>
    <p>
      Journalists, media outlets, and press contacts should reach the national Media Relations team
      directly.
    </p>
    <a class="zigzag-link" href={withBase("/news-events/media-relations/")}>
      Media Relations &rarr;
    </a>
  </FeatureRow>

  <FeatureRow
    eyebrow="Vendors & Partners"
    image="/images/boule.jpg"
    imageAlt="Sigma Gamma Rho members at Boulé"
    index={1}
  >
    <h3>
      Want to <span class="gold">Work With Us?</span>
    </h3>
    <p>
      Approved vendors and prospective corporate or foundation partners can find guidelines and next
      steps here.
    </p>
    <ul class="contact-facts">
      <li>
        <a href={withBase("/resources/vendor/")}>Vendor Information</a>
      </li>
      <li>
        <a href={withBase("/service-impact/corporate-partnerships/")}>Corporate Partnerships</a>
      </li>
    </ul>
  </FeatureRow>
</Base>

<style>
  .contact-hero {
    position: relative;
    overflow: hidden;
    background: var(--cream);
    color: var(--navy);
  }
  .contact-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(32, 65, 165, 0.18) 1.5px, transparent 1.5px);
    background-size: 26px 26px;
    mask-image: radial-gradient(circle at 82% 30%, #000 0%, transparent 65%);
  }
  .contact-hero__inner {
    position: relative;
    padding-block: clamp(3rem, 6vw, 4rem);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    color: rgba(32, 65, 165, 0.6);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .breadcrumb a {
    color: inherit;
  }
  .contact-hero__title {
    max-width: 600px;
    margin: 0;
    font-family: var(--font-head);
    font-weight: 400;
    font-size: clamp(2.6rem, 5vw, 3.6rem);
    line-height: 1.05;
    color: var(--navy);
  }
  .contact-hero__title span {
    color: var(--royal);
  }
  .contact-hero__lead {
    max-width: 540px;
    margin: var(--space-5) 0 0;
    color: var(--muted);
  }

  .gold {
    color: var(--gold);
  }
  .contact-facts {
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }
  .contact-facts li {
    padding: var(--space-3) 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .contact-facts a {
    color: var(--royal);
    text-decoration: none;
    font-weight: 700;
  }
  .zigzag-link {
    display: inline-block;
    margin-top: var(--space-5);
    color: var(--royal);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--text-sm);
  }
  .zigzag-link:hover {
    color: var(--gold);
  }
</style>
