---
/**
 * Contact — the utility/conversion page for reaching the national org.
 *
 * Treatment: compact gold hero, then a two-column split (form + direct-reach
 * panel) with no photography. No backend exists for this prototype, so the
 * form composes a mailto: to the real help desk address instead of faking a
 * success state — see the inline script below.
 */
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import { footerContact, socialLinks } from "../data/nav.js";

const reasons = [
  "General Inquiry",
  "Membership",
  "Media & Press",
  "Corporate Partnership",
  "Chapter Support",
];

const quickLinks = [
  { label: "Become a Member", href: "/membership/become-a-member/" },
  { label: "Find a Chapter", href: "/membership/chapter-locator/" },
  { label: "National Programs", href: "/service-impact/national-programs/" },
];
---
<Base
  title="Contact"
  activeTop="Contact"
  description="Reach Sigma Gamma Rho Sorority, Incorporated's International Corporate Headquarters — membership, media, partnership, and chapter support inquiries."
>
  <Hero
    variant="plain"
    accent="gold"
    align="left"
    size="compact"
    eyebrow="Contact"
    title="Let's Start a "
    highlight="Conversation"
    copy="Membership, media, partnership, or chapter questions — reach the International Corporate Headquarters directly, or use the form below."
  />

  <section class="contact">
    <div class="container contact__grid">
      <form class="contact__form" id="contact-form">
        <div class="field">
          <label for="name">Full Name<span aria-hidden="true">*</span></label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">Email<span aria-hidden="true">*</span></label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="reason">Reason for Contact<span aria-hidden="true">*</span></label>
          <select id="reason" name="reason" required>
            {reasons.map((r) => <option value={r}>{r}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="message">Message<span aria-hidden="true">*</span></label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn">Send Message</button>
        <p class="contact__note" id="contact-note">
          This is a design prototype — sending opens your email client addressed to {footerContact.email} rather than submitting to a live inbox.
        </p>
      </form>

      <aside class="contact__direct">
        <h2>Reach Us Directly</h2>
        <address>
          {footerContact.lines.map((line) => <span>{line}</span>)}
        </address>
        <a class="contact__link" href={`tel:${footerContact.phone}`}>{footerContact.phoneLabel}</a>
        <a class="contact__link" href={`mailto:${footerContact.email}`}>{footerContact.email}</a>

        <ul class="contact__social">
          {socialLinks.map((s) => (
            <li><a href={s.href} aria-label={s.label}>{s.label}</a></li>
          ))}
        </ul>

        <div class="contact__quick">
          <p class="contact__label">Looking for Something Specific?</p>
          <ul>
            {quickLinks.map((l) => (
              <li><a href={l.href}>{l.label} <span aria-hidden="true">&rarr;</span></a></li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script define:vars={{ contactEmail: footerContact.email }}>
  const form = document.getElementById("contact-form");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const subject = `[${data.get("reason")}] Website contact from ${data.get("name")}`;
    const body = `${data.get("message")}\n\n— ${data.get("name")} (${data.get("email")})`;
    window.location.href = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .contact { padding-block: clamp(3rem, 6vw, 5rem); background: var(--white); }
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .contact__form { display: grid; gap: var(--space-6); }
  .field { display: grid; gap: var(--space-2); }
  .field label {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--royal);
  }
  .field label span { color: var(--gold-dark); margin-left: 0.15em; }
  .field input, .field select, .field textarea {
    font: inherit;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink);
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: 2px solid var(--gold);
    outline-offset: 1px;
    border-color: var(--royal);
  }
  .contact__form .btn { justify-self: start; }
  .contact__note { margin: 0; font-size: var(--text-xs); color: var(--muted-2); }

  .contact__direct {
    background: var(--tint);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 3vw, 2.5rem);
    display: grid;
    gap: var(--space-5);
  }
  .contact__direct h2 { font-size: var(--text-h3); margin: 0; }
  .contact__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin: 0 0 var(--space-2);
  }
  .contact__direct address { font-style: normal; display: flex; flex-direction: column; gap: 0.15rem; color: var(--ink); }
  .contact__direct address span:first-child {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin-bottom: var(--space-1);
  }
  .contact__link { color: var(--royal); font-weight: 700; text-decoration: none; }
  .contact__link:hover { color: var(--gold-dark); }

  .contact__social { display: flex; flex-wrap: wrap; gap: var(--space-3); list-style: none; margin: 0; padding: 0; }
  .contact__social a {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--royal);
    text-decoration: none;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .contact__social a:hover { border-color: var(--royal); background: var(--white); }

  .contact__quick { border-top: 1px solid var(--line); padding-top: var(--space-5); }
  .contact__quick ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .contact__quick a { color: var(--royal); font-weight: 600; text-decoration: none; }
  .contact__quick a:hover { color: var(--gold-dark); }

  @media (max-width: 820px) {
    .contact__grid { grid-template-columns: 1fr; }
  }
</style>
