---
/**
 * Contact — the institutional contact hub.
 *
 * Left: HQ's address, phone, email, and routing to the pages that handle
 * common requests. Right: an inquiry form that composes an email to
 * help@sgrho1922.org (see scripts/compose-email.ts), with a link to the
 * Freshdesk ticket form for anyone who wants a tracking number. Office hours
 * are not published, so none are stated.
 */
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/url.js";

const EMAIL = "help@sgrho1922.org";
const TICKET_URL = "https://helpsgrho1922.freshdesk.com/support/tickets/new";
const PORTAL_URL = "https://portal.sgrho1922.org/";

const routes = [
  { label: "Media & Press", href: "/news-events/media-relations/" },
  { label: "Reactivation & Transfers", href: "/membership/reactivate/" },
  { label: "Becoming a Member", href: "/membership/become-a-member/" },
  { label: "Licensed Vendors", href: "/resources/vendor/" },
  { label: "Sponsorship & Partnerships", href: "/service-impact/corporate-partnerships/" },
  { label: "Verify a Member's Standing", href: "/membership/accountability/" },
];

const affiliations = [
  "Prospective member (collegiate)",
  "Prospective member (alumnae)",
  "Active or inactive Soror",
  "Corporate sponsor or partner",
  "Licensed vendor",
  "General public",
];
const departments = [
  "Membership Services & Verification",
  "Operations & National Events",
  "Media & Communications",
  "Financial Inquiries",
  "Something else",
];
---

<Base
  title="Contact"
  activeTop="Contact"
  description="Contact Sigma Gamma Rho's International Corporate Headquarters: address, phone, email, and an inquiry form."
>
  <section class="ct-hero">
    <div class="container">
      <p class="breadcrumb">
        <a href={withBase("/")}>Home</a> <span>/</span> <span>Contact</span>
      </p>
      <p class="eyebrow">Contact</p>
      <h1>Contact Headquarters</h1>
      <p class="ct-hero__lead">
        Reach International Corporate Headquarters directly, or send an inquiry and we'll route it to
        the right department.
      </p>
    </div>
  </section>

  <section class="ct-main">
    <div class="container ct-grid">
      <aside class="ct-card">
        <h2>International Corporate Headquarters</h2>
        <dl>
          <div>
            <dt>Office</dt>
            <dd>1000 Southhill Dr, STE 200<br />Cary, NC 27513</dd>
          </div>
          <div>
            <dt>Mailing</dt>
            <dd>P.O. Box 27688<br />Raleigh, NC 27611</dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd><a href="tel:+19196789720">(919) 678-9720</a></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
          </div>
        </dl>
        <h3>Go straight to</h3>
        <ul class="ct-routes">
          {routes.map((r) => (
            <li>
              <a href={withBase(r.href)}>
                {r.label} <span aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>

      <form
        class="ct-form inquiry-form"
        data-compose
        data-subject="Website Inquiry"
        data-subject-field="cf-dept"
        action={`mailto:${EMAIL}`}
        method="post"
        enctype="text/plain"
      >
        <h2>Send an Inquiry</h2>
        <p class="ct-form__hint">
          This opens a pre-filled email in your mail app. Prefer a tracking number?{" "}
          <a href={TICKET_URL} target="_blank" rel="noopener">Submit a help desk ticket</a>.
        </p>
        <div class="inquiry-form__row">
          <label>
            <span>Full name</span>
            <input id="cf-name" data-label="Name" name="name" type="text" autocomplete="name" required />
          </label>
          <label>
            <span>Email address</span>
            <input id="cf-email" data-label="Email" name="email" type="email" autocomplete="email" required />
          </label>
        </div>
        <div class="inquiry-form__row">
          <label>
            <span>Phone <small>(optional)</small></span>
            <input id="cf-phone" data-label="Phone" name="phone" type="tel" autocomplete="tel" />
          </label>
          <label>
            <span>Member ID <small>(optional)</small></span>
            <input id="cf-member" data-label="Member ID" name="member" type="text" />
          </label>
        </div>
        <div class="inquiry-form__row">
          <label>
            <span>I am a</span>
            <select id="cf-aff" data-label="Affiliation" name="affiliation" required>
              <option value="">Choose one</option>
              {affiliations.map((a) => <option>{a}</option>)}
            </select>
          </label>
          <label>
            <span>Department</span>
            <select id="cf-dept" data-label="Department" name="department" required>
              <option value="">Choose one</option>
              {departments.map((d) => <option>{d}</option>)}
            </select>
          </label>
        </div>
        <label>
          <span>Message</span>
          <textarea id="cf-message" data-body name="message" rows="6" placeholder="How can we help?" required></textarea>
        </label>
        <button class="btn ct-submit" type="submit">
          Submit Inquiry <span aria-hidden="true">&rarr;</span>
        </button>
      </form>
    </div>
  </section>

  <section class="ct-portal on-dark">
    <div class="container ct-portal__inner">
      <div>
        <h2>Already a member?</h2>
        <p>Check dues status, update your contact details, and manage your membership in your member profile.</p>
      </div>
      <a class="btn" href={PORTAL_URL} target="_blank" rel="noopener">
        Log in to Poodle Portal <span aria-hidden="true">&#8599;</span>
      </a>
    </div>
  </section>
</Base>

<script>
  import { wireComposeForms } from "../scripts/compose-email";

  wireComposeForms();
</script>

<style>
  .ct-hero {
    background: var(--cream);
    padding-block: clamp(3rem, 6vw, 4rem);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    color: var(--muted-2);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .breadcrumb a {
    color: inherit;
  }
  .ct-hero h1 {
    margin: var(--space-2) 0 0;
  }
  .ct-hero__lead {
    max-width: 40rem;
    margin: var(--space-4) 0 0;
    color: var(--muted);
  }

  .ct-main {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .ct-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-10);
    align-items: start;
  }
  .ct-card,
  .ct-form {
    padding: var(--space-8);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .ct-card h2,
  .ct-form h2 {
    margin: 0 0 var(--space-5);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--ink);
  }
  .ct-card dl {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }
  .ct-card dt {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ct-card dd {
    margin: var(--space-1) 0 0;
    color: var(--ink);
    font-weight: 600;
  }
  .ct-card dd a {
    color: var(--royal);
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .ct-card h3 {
    margin: var(--space-8) 0 var(--space-2);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ct-routes {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ct-routes a {
    display: block;
    padding-block: var(--space-2);
    color: var(--royal);
    font-weight: 700;
    text-decoration: none;
  }
  .ct-routes a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
    text-decoration-color: var(--gold);
  }

  .ct-form {
    display: grid;
    gap: var(--space-5);
  }
  .ct-form h2 {
    margin: 0;
  }
  .ct-form__hint {
    margin: calc(var(--space-3) * -1) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .ct-form__hint a {
    color: var(--royal);
    font-weight: 700;
  }
  .ct-form small {
    color: var(--muted);
    font-weight: 400;
  }
  .ct-submit {
    justify-content: center;
    width: 100%;
  }
  @media (max-width: 900px) {
    .ct-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .ct-card,
    .ct-form {
      padding: var(--space-5);
    }
  }

  .ct-portal {
    background: var(--grad-royal);
    color: #fff;
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }
  .ct-portal__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5) var(--space-10);
  }
  .ct-portal h2 {
    margin: 0;
    color: #fff;
    font-size: var(--text-h3);
  }
  .ct-portal p {
    margin: var(--space-2) 0 0;
    max-width: 40rem;
    color: rgba(255, 255, 255, 0.85);
  }
</style>
