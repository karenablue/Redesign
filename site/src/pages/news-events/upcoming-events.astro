---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import CardGrid from "../../components/CardGrid.astro";
import { nationalCalendar } from "../../data/national-calendar";
import { getCollection, render } from "astro:content";
import { withBase } from "../../lib/url.js";

/*
 * Events are markdown files in src/content/events/, so HQ can edit them
 * through a CMS after handover without anyone touching this page. `order`
 * carries the curated season sequence: it cannot be derived by sorting,
 * because several entries have fuzzy dates ("Sep–Oct", a day of "—").
 *
 * The list groups consecutive entries by the month they start in. Most entries
 * carry no year yet. An entry with a confirmed `start` date gets an
 * "Add to calendar" link to its .ics file (pages/news-events/calendar/);
 * entries without one show no link, rather than a guessed year.
 */
const entries = (await getCollection("events")).sort((a, b) => a.data.order - b.data.order);
const events = await Promise.all(
  entries.map(async (entry) => ({
    ...entry.data,
    id: entry.id,
    Body: (await render(entry)).Content,
  }))
);

const MONTHS: Record<string, string> = {
  Jan: "January",
  Feb: "February",
  Mar: "March",
  Apr: "April",
  May: "May",
  Jun: "June",
  Jul: "July",
  Aug: "August",
  Sep: "September",
  Oct: "October",
  Nov: "November",
  Dec: "December",
};
const monthName = (m: string) =>
  m
    .split("–")
    .map((p) => MONTHS[p.trim()] ?? p)
    .join(" – ");
const format = (location: string) =>
  /virtual/i.test(location)
    ? "Virtual"
    : /various/i.test(location)
      ? "Multiple locations"
      : "In person";
const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, "-");

const featured = events.find((e) => e.featured);
const listed = events.filter((e) => e !== featured);

// A range like "Sep–Oct" files under the month it starts in; its badge still
// shows the full range.
const startMonth = (m: string) => m.split("–")[0].trim();
const groups: { month: string; items: typeof listed }[] = [];
for (const e of listed) {
  const key = startMonth(e.month);
  const last = groups.at(-1);
  if (last && last.month === key) last.items.push(e);
  else groups.push({ month: key, items: [e] });
}
const categories = [...new Set(listed.map((e) => e.tag))];
---

<Base
  title="Upcoming Events"
  activeTop="News & Events"
  description="Connect, serve, and celebrate with Sigma Gamma Rho sorors across every region."
>
  <PageHero
    stack
    eyebrow="Upcoming Events • National Calendars"
    title="Come together."
    highlight="Carry service forward."
    copy="Connect, serve, and celebrate with sorors across every region. Explore a year of community impact and recognition, then find your next gathering."
    image="/optimized/hero-capitol-hill.webp"
    focal="60% 40%"
  >
    <a class="btn" href="#national-calendars">2026–27 National Calendars <span aria-hidden="true">&darr;</span></a>
    <a class="btn btn--outline on-dark" href="#event-list">Events &amp; Gatherings <span aria-hidden="true">&darr;</span></a>
  </PageHero>

  <section
    class="section national-calendar"
    id="national-calendars"
    aria-labelledby="calendar-title"
  >
    <div class="container">
      <div class="national-calendar__head">
        <p class="eyebrow">September 2026 – July 2027</p>
        <h2 id="calendar-title">A Year of Service &amp; Recognition</h2>
        <p>
          Explore the Community Impact and Recognition calendars by month. Monthly focuses and
          observances appear alongside activities with announced dates.
        </p>
      </div>
      <div class="national-calendar__months">
        {nationalCalendar.map((month, index) => (
          <details class="calendar-month" open={index === 0}>
            <summary>
              <h3>{month.label}</h3>
              <span class="calendar-month__toggle" aria-hidden="true">
                +
              </span>
            </summary>
            <div class="calendar-month__content">
              <CardGrid min="320px" cols={2}>
                {[
                  { label: "Community Impact", items: month.impact, tone: "impact" },
                  { label: "Recognition", items: month.recognition, tone: "recognition" },
                ]
                  .filter((calendar) => calendar.items.length)
                  .map((calendar) => (
                    <section
                      class:list={["calendar-column", `calendar-column--${calendar.tone}`]}
                      aria-labelledby={`${month.id}-${calendar.tone}`}
                    >
                      <h4 id={`${month.id}-${calendar.tone}`}>{calendar.label}</h4>
                      <ul>
                        {calendar.items.map((item) => (
                          <li>
                            <span class="calendar-entry__date">{item.date}</span>
                            <span class="calendar-entry__title">{item.title}</span>
                            {item.note && <p class="calendar-entry__note">{item.note}</p>}
                          </li>
                        ))}
                      </ul>
                    </section>
                  ))}
              </CardGrid>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="ue-main" id="event-list">
    <div class="container">
      {featured && (
        <article class="ue-feature">
          <div class="ue-badge ue-badge--lg" aria-hidden="true">
            <span>{featured.month}</span>
            <strong>{featured.day}</strong>
          </div>
          <div class="ue-feature__copy">
            <p class="ue-kicker">Featured &bull; {featured.tag}</p>
            <h2>{featured.title}</h2>
            <p class="ue-where">
              {monthName(featured.month)} {featured.day} &bull; {featured.location}
            </p>
            <div class="ue-summary">
              <featured.Body />
            </div>
            {featured.start && (
              <a class="ue-ics" href={withBase(`/news-events/calendar/${featured.id}.ics`)} download>
                Add to calendar
                <span class="visually-hidden">: {featured.title} (.ics file)</span>
              </a>
            )}
          </div>
        </article>
      )}

      <div class="ue-filters" role="group" aria-label="Filter events by category" hidden>
        <button type="button" class="is-active" aria-pressed="true" data-cat="all">
          All Events
        </button>
        {categories.map((c) => (
          <button type="button" aria-pressed="false" data-cat={slug(c)}>
            {c}
          </button>
        ))}
      </div>

      <div class="ue-list">
        {groups.map((g) => (
          <section class="ue-month" aria-labelledby={`m-${slug(g.month)}-${g.items[0].order}`}>
            <h2 class="ue-month__title" id={`m-${slug(g.month)}-${g.items[0].order}`}>
              {monthName(g.month)}
            </h2>
            <ul>
              {g.items.map((e) => (
                <li class="ue-row" data-cat={slug(e.tag)}>
                  <div class="ue-badge" aria-hidden="true">
                    <span>{e.month}</span>
                    <strong>{e.day}</strong>
                  </div>
                  <div class="ue-row__body">
                    <p class="ue-tags">
                      <span class="ue-tag">{e.tag}</span>
                      <span class="ue-format">{format(e.location)}</span>
                    </p>
                    <h3>{e.title}</h3>
                    <p class="ue-where">
                      <span class="visually-hidden">
                        {monthName(e.month)} {e.day},{" "}
                      </span>
                      {e.location}
                    </p>
                    <div class="ue-summary">
                      <e.Body />
                    </div>
                    {e.start && (
                      <a class="ue-ics" href={withBase(`/news-events/calendar/${e.id}.ics`)} download>
                        Add to calendar
                        <span class="visually-hidden">: {e.title} (.ics file)</span>
                      </a>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <p class="ue-empty" hidden>
        No events in this category right now.
      </p>

    </div>
  </section>
  <CtaBand
    eyebrow="Connect locally"
    title="Your community."
    highlight="Your next connection."
    copy="For chapter events and opportunities to serve close to home, connect with a Sigma Gamma Rho chapter near you."
    actions={[{ label: "Find a Chapter", href: "/membership/chapter-locator/" }]}
  />
</Base>

<script>
  const bar = document.querySelector<HTMLElement>(".ue-filters");
  if (bar) {
    bar.hidden = false;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>("button")];
    const rows = [...document.querySelectorAll<HTMLElement>(".ue-row")];
    const months = [...document.querySelectorAll<HTMLElement>(".ue-month")];
    const empty = document.querySelector<HTMLElement>(".ue-empty");
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        const cat = b.dataset.cat;
        buttons.forEach((x) => {
          const on = x === b;
          x.classList.toggle("is-active", on);
          x.setAttribute("aria-pressed", String(on));
        });
        rows.forEach((r) => (r.hidden = !(cat === "all" || r.dataset.cat === cat)));
        // A month with nothing left to show drops its heading too.
        months.forEach((m) => (m.hidden = !m.querySelector(".ue-row:not([hidden])")));
        if (empty) empty.hidden = rows.some((r) => !r.hidden);
      })
    );
  }
</script>

<style>
  .national-calendar {
    background: var(--white);
    scroll-margin-top: var(--space-24);
  }
  .national-calendar__head {
    max-width: 48rem;
    margin-bottom: var(--space-10);
  }
  .national-calendar__head h2 {
    margin: 0 0 var(--space-4);
    color: var(--royal);
    font-family: var(--font-editorial);
    font-weight: 600;
  }
  .national-calendar__head > p:last-child {
    margin: 0;
    color: var(--muted);
  }
  .calendar-month {
    border-top: 1px solid var(--line);
  }
  .calendar-month:last-child {
    border-bottom: 1px solid var(--line);
  }
  .calendar-month summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 72px;
    padding-block: var(--space-5);
    list-style: none;
    cursor: pointer;
  }
  .calendar-month summary::-webkit-details-marker {
    display: none;
  }
  .calendar-month summary:hover h3 {
    color: var(--navy);
  }
  .calendar-month h3 {
    margin: 0;
    color: var(--royal);
    font-family: var(--font-editorial);
    font-size: var(--text-h3);
    font-weight: 600;
  }
  .calendar-month__toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line-gold);
    border-radius: 50%;
    color: var(--royal);
    font-size: var(--text-lg);
  }
  .calendar-month[open] .calendar-month__toggle {
    transform: rotate(45deg);
  }
  .calendar-month__content {
    padding-bottom: var(--space-8);
  }
  .calendar-column {
    min-width: 0;
    padding: var(--space-6);
    border-top: 1px solid var(--line-gold);
    background: var(--cream);
  }
  .calendar-column--recognition {
    border-top-color: var(--line-strong);
    background: var(--tint);
  }
  .calendar-column h4 {
    margin: 0 0 var(--space-4);
    color: var(--royal);
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 700;
  }
  .calendar-column ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .calendar-column li {
    padding-block: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .calendar-entry__date {
    display: block;
    margin-bottom: var(--space-1);
    color: var(--royal);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .calendar-entry__title {
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .calendar-entry__note {
    margin: var(--space-2) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  #event-list {
    scroll-margin-top: var(--space-24);
    border-top: 1px solid var(--line);
  }
  .ue-main {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  /* ---- date badge: calendar tile ---- */
  .ue-badge {
    flex: none;
    display: flex;
    flex-direction: column;
    width: 84px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-align: center;
    background: var(--white);
  }
  .ue-badge span {
    padding: 0.3rem 0.25rem;
    background: var(--royal);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ue-badge strong {
    padding: 0.55rem 0.25rem;
    color: var(--ink);
    font-size: var(--text-lg);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .ue-badge--lg {
    width: 120px;
  }
  .ue-badge--lg strong {
    padding-block: 1rem;
    font-size: var(--text-h3);
  }

  /* ---- featured ---- */
  .ue-feature {
    display: flex;
    gap: var(--space-8);
    align-items: center;
    margin-bottom: var(--space-12);
    padding: var(--space-8);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--tint);
  }
  .ue-kicker {
    margin: 0;
    /* --muted, not --muted-2: this sits on the tint ground (4.47:1 otherwise). */
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ue-feature h2 {
    font-family: var(--font-editorial);
    margin: var(--space-2) 0 var(--space-2);
    font-size: var(--text-h3);
  }
  .ue-where {
    margin: 0;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .ue-summary :global(p) {
    margin: var(--space-2) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  /* ---- filters ---- */
  .ue-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }
  .ue-filters button {
    min-height: 40px;
    padding: 0 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    color: var(--royal);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }
  .ue-filters button:hover {
    border-color: var(--royal);
  }
  .ue-filters button.is-active {
    border-color: var(--royal);
    background: var(--royal);
    color: #fff;
  }

  /* ---- chronological list ---- */
  .ue-month + .ue-month {
    margin-top: var(--space-10);
  }
  .ue-month__title {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0 0 var(--space-2);
    color: var(--royal);
    font-size: var(--text-lg);
  }
  .ue-month__title::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  .ue-month ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ue-row {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--line);
  }
  .ue-row__body {
    min-width: 0;
  }
  .ue-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }
  .ue-tag,
  .ue-format {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .ue-tag {
    background: var(--tint);
    color: var(--royal);
  }
  .ue-format {
    border: 1px solid var(--line);
    color: var(--ink);
  }
  .ue-row h3 {
    margin: var(--space-2) 0 var(--space-1);
    color: var(--royal);
    font-size: var(--text-md);
  }
  .ue-empty {
    color: var(--muted);
  }
  .ue-ics {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--space-2);
    color: var(--royal-dark);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration-color: var(--gold);
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .ue-feature {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-6);
    }
    .ue-row {
      gap: var(--space-4);
    }
    .ue-badge {
      width: 68px;
    }
    .ue-badge strong {
      font-size: var(--text-md);
    }
  }
</style>
