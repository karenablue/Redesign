---
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/url.js";

const events = [
  {
    month: "Sep",
    day: "12",
    tag: "Signature",
    title: "Phenomenal Women of Excellence Gala",
    location: "Atlanta, GA",
    body: "International Officers open the Fall Into Greater tour with the season's flagship evening of recognition and Sigma excellence.",
  },
  {
    month: "Sep",
    day: "12",
    tag: "Signature",
    title: "Legacy & Unity Brunch",
    location: "Atlanta, GA",
    body: "Sorors gather to celebrate sisterhood and legacy alongside the International Officers.",
  },
  {
    month: "Sep–Oct",
    day: "—",
    tag: "Regional",
    title: "Regional Fall Area Meetings",
    location: "Various Locations",
    body: "Chapters across every region convene for fall programming, training, and fellowship.",
  },
  {
    month: "Sep",
    day: "15–19",
    tag: "Advocacy",
    title: "Congressional Black Caucus",
    location: "Washington, D.C.",
    body: "International Officers represent Sigma Gamma Rho at the Congressional Black Caucus Annual Legislative Conference.",
  },
  {
    month: "Sep",
    day: "15",
    tag: "Advocacy",
    title: "Black Women's Agenda Annual Symposium",
    location: "Washington, D.C.",
    body: "Sigma joins coalition partners to advance policy priorities affecting Black women and girls.",
  },
  {
    month: "Sep",
    day: "16",
    tag: "Advocacy",
    title: "The LINKS Annual Legislative Luncheon",
    location: "Washington, D.C.",
    body: "Sorors join The Links, Incorporated for a legislative luncheon in the nation's capital.",
  },
  {
    month: "Oct",
    day: "21",
    tag: "Wellness",
    title: "Rhoyal Table Talk: Breast Health & Cancer Awareness",
    location: "Virtual",
    body: "The Women's Wellness Initiative opens the Rhoyal Table Talk Series with real conversations on breast health and cancer awareness. Open to the public, 5pm PST / 7pm CST / 8pm EST.",
  },
  {
    month: "Oct",
    day: "22–25",
    tag: "Coalition",
    title: "National Council of Negro Women",
    location: "Atlanta, GA",
    body: "Sigma Gamma Rho stands alongside NCNW at its national convening.",
  },
  {
    month: "Nov",
    day: "—",
    tag: "National",
    title: "Greater Founders' Day Activations",
    location: "Various Locations",
    body: "Chapters worldwide mark the anniversary of the Sorority's 1922 founding with activations throughout the month.",
  },
  {
    month: "Nov",
    day: "18",
    tag: "Wellness",
    title: "Rhoyal Table Talk: Uterine & Fibroid Awareness",
    location: "Virtual",
    body: "The Rhoyal Table Talk Series continues with a conversation on uterine and fibroid health. Open to the public, 5pm PST / 7pm CST / 8pm EST.",
  },
  {
    month: "Nov",
    day: "25",
    tag: "Community",
    title: "Macy's Thanksgiving Day Parade",
    location: "New York City, NY",
    body: "Sigma Gamma Rho joins the nation's Thanksgiving tradition on the streets of New York City.",
  },
  {
    month: "Dec",
    day: "3–6",
    tag: "Professional",
    title: "Association of Fraternal Advisors",
    location: "Chicago, IL",
    body: "International Officers connect with fraternal and sorority advisors from across the country.",
  },
  {
    month: "Feb",
    day: "17",
    tag: "Wellness",
    title: "Rhoyal Table Talk: Healthy Heart Awareness",
    location: "Virtual",
    body: "The Rhoyal Table Talk Series turns to heart health and prevention. Open to the public, 5pm PST / 7pm CST / 8pm EST.",
  },
  {
    month: "Mar",
    day: "17",
    tag: "Wellness",
    title: "Rhoyal Table Talk: Domestic Violence Awareness",
    location: "Virtual",
    body: "The Rhoyal Table Talk Series addresses domestic violence awareness and self-advocacy. Open to the public, 5pm PST / 7pm CST / 8pm EST.",
  },
  {
    month: "May",
    day: "19",
    tag: "Wellness",
    title: "Rhoyal Table Talk: Men's Mental Health Awareness",
    location: "Virtual",
    body: "The Rhoyal Table Talk Series closes its first season with a conversation on men's mental health. Open to the public, 5pm PST / 7pm CST / 8pm EST.",
  },
];
---

<Base
  title="Upcoming Events"
  activeTop="News & Events"
  description="Connect, serve, and celebrate with Sigma Gamma Rho sorors across every region."
>
  <section class="ue-hero">
    <div class="container">
      <p class="breadcrumb">
        <a href={withBase("/")}>Home</a> <span>/</span>{" "}
        <a href={withBase("/news-events/latest-news/")}>News &amp; Events</a> <span>/</span>{" "}
        <span>Upcoming Events</span>
      </p>
      <p class="eyebrow">News &amp; Events</p>
      <h1>Upcoming Events</h1>
      <p>Connect, serve, and celebrate with sorors across every region.</p>
    </div>
  </section>

  <section class="ue-main">
    <div class="container">
      {/* The event titles below are h3. Without a real h2 between them and the
          page h1, the outline jumps h1 -> h3, which screen-reader users
          navigate by. Promoting them to h2 is not the fix: global h2 is LEMON
          MILK and card titles are deliberately Montserrat. */}
      <h2 class="visually-hidden">All upcoming events</h2>
      <div class="ue-grid">
        {events.map((e) => (
          <article class="ue-card">
            <div class="ue-date">
              <span>{e.month}</span>
              <strong>{e.day}</strong>
            </div>
            <div class="ue-body">
              <span class="ue-tag">{e.tag}</span>
              <h3>{e.title}</h3>
              <p class="ue-location">{e.location}</p>
              <p>{e.body}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="ue-cta">
        Looking for a chapter-level event near you?{" "}
        <a href={withBase("/membership/chapter-locator/")}>Find a Chapter &rarr;</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .ue-hero {
    background: var(--cream);
    padding-block: clamp(3rem, 5vw, 4rem);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    color: var(--muted-2);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .breadcrumb a {
    color: inherit;
  }
  .ue-hero h1 {
    margin: var(--space-2) 0 0;
  }
  .ue-hero > .container > p:last-child {
    color: var(--muted);
    margin-top: var(--space-3);
  }

  .ue-main {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .ue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: var(--space-6);
  }
  .ue-card {
    display: flex;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--tint);
    border-radius: var(--radius-lg);
  }
  .ue-date {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15em;
    min-width: 70px;
    padding: 0.5em 0.4em;
    background: var(--white);
    border-radius: var(--radius);
    text-align: center;
  }
  .ue-date span {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .ue-date strong {
    font-size: var(--text-lg);
    color: var(--royal);
    white-space: nowrap;
  }
  .ue-tag {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .ue-body h3 {
    margin: var(--space-2) 0 var(--space-1);
    font-size: var(--text-md);
  }
  .ue-location {
    margin: 0 0 var(--space-2);
    color: var(--royal);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .ue-body > p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .ue-cta {
    text-align: center;
    margin-top: var(--space-12);
    color: var(--muted);
  }
  .ue-cta a {
    color: var(--royal);
    font-weight: 700;
    text-decoration: none;
  }
</style>
