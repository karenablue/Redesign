---
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/url.js";
import { getCollection, render } from "astro:content";

// Events are markdown files in src/content/events/, so HQ can edit them
// through a CMS after handover without anyone touching this page. `order`
// carries the curated season sequence: it cannot be derived by sorting,
// because several entries have fuzzy dates ("Sep–Oct", a day of "—").
const entries = (await getCollection("events")).sort((a, b) => a.data.order - b.data.order);
const events = await Promise.all(
  entries.map(async (entry) => ({ ...entry.data, Body: (await render(entry)).Content })),
);
---

<Base
  title="Upcoming Events"
  activeTop="News & Events"
  description="Connect, serve, and celebrate with Sigma Gamma Rho sorors across every region."
>
  <section class="ue-hero">
    <div class="container">
      <p class="breadcrumb">
        <a href={withBase("/")}>Home</a> <span>/</span>{" "}
        <a href={withBase("/news-events/latest-news/")}>News &amp; Events</a> <span>/</span>{" "}
        <span>Upcoming Events</span>
      </p>
      <p class="eyebrow">News &amp; Events</p>
      <h1>Upcoming Events</h1>
      <p>Connect, serve, and celebrate with sorors across every region.</p>
    </div>
  </section>

  <section class="ue-main">
    <div class="container">
      {/* The event titles below are h3. Without a real h2 between them and the
          page h1, the outline jumps h1 -> h3, which screen-reader users
          navigate by. Promoting them to h2 is not the fix: global h2 is LEMON
          MILK and card titles are deliberately Montserrat. */}
      <h2 class="visually-hidden">All upcoming events</h2>
      <div class="ue-grid">
        {events.map((e) => (
          <article class="ue-card">
            <div class="ue-date">
              <span>{e.month}</span>
              <strong>{e.day}</strong>
            </div>
            <div class="ue-body">
              <span class="ue-tag">{e.tag}</span>
              <h3>{e.title}</h3>
              <p class="ue-location">{e.location}</p>
              <e.Body />
            </div>
          </article>
        ))}
      </div>
      <p class="ue-cta">
        Looking for a chapter-level event near you?{" "}
        <a href={withBase("/membership/chapter-locator/")}>Find a Chapter &rarr;</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .ue-hero {
    background: var(--cream);
    padding-block: clamp(3rem, 5vw, 4rem);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    color: var(--muted-2);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .breadcrumb a {
    color: inherit;
  }
  .ue-hero h1 {
    margin: var(--space-2) 0 0;
  }
  .ue-hero > .container > p:last-child {
    color: var(--muted);
    margin-top: var(--space-3);
  }

  .ue-main {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .ue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: var(--space-6);
  }
  .ue-card {
    display: flex;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--tint);
    border-radius: var(--radius-lg);
  }
  .ue-date {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15em;
    min-width: 70px;
    padding: 0.5em 0.4em;
    background: var(--white);
    border-radius: var(--radius);
    text-align: center;
  }
  .ue-date span {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .ue-date strong {
    font-size: var(--text-lg);
    color: var(--royal);
    white-space: nowrap;
  }
  .ue-tag {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .ue-body h3 {
    margin: var(--space-2) 0 var(--space-1);
    font-size: var(--text-md);
  }
  .ue-location {
    margin: 0 0 var(--space-2);
    color: var(--royal);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .ue-body > p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .ue-cta {
    text-align: center;
    margin-top: var(--space-12);
    color: var(--muted);
  }
  .ue-cta a {
    color: var(--royal);
    font-weight: 700;
    text-decoration: none;
  }
</style>
