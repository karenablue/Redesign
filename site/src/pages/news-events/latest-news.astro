---
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/url.js";
import { getCollection, render } from "astro:content";

// News items are markdown in src/content/news/, so HQ can post an update
// after handover without touching this page. `order` is the display order;
// prose lives in each file's markdown body.
const newsEntries = (await getCollection("news")).sort((a, b) => a.data.order - b.data.order);
const cards = await Promise.all(
  newsEntries.map(async (entry) => ({ ...entry.data, Body: (await render(entry)).Content })),
);
---

<Base
  title="Latest News"
  activeTop="News & Events"
  description="Announcements and updates from across the international sisterhood of Sigma Gamma Rho."
>
  <section class="ln-hero">
    <div class="container">
      <p class="breadcrumb">
        <a href={withBase("/")}>Home</a> <span>/</span> <span>News &amp; Events</span>{" "}
        <span>/</span> <span>Latest News</span>
      </p>
      <p class="eyebrow">News &amp; Events</p>
      <h1>Latest News</h1>
      <p>Announcements and updates from across the international sisterhood.</p>
    </div>
  </section>

  <section class="ln-main">
    <div class="container">
      <article class="ln-feature">
        <figure>
          <img
            src={withBase("/images/boule.jpg")}
            alt="Sigma Gamma Rho members at the 61st International Biennial Boule in Tampa"
          />
        </figure>
        <div class="ln-feature__copy">
          <span class="ln-tag">Featured</span>
          <h2>Tampa Welcomes Sigma Gamma Rho for the 61st International Biennial Boule</h2>
          <p>
            Thousands of members, partners, and guests gathered at the Tampa Convention Center July
            22&ndash;26 for the 61st International Biennial Boule &mdash; the first Sigma Gamma Rho
            international convention held in Tampa since 1976. The city projected the gathering
            would generate more than $5.1 million in direct regional economic impact, alongside
            on-the-ground service including 300 newborn care packages, 3,000 backpacks for K&ndash;8
            students, and 300 free swim lessons for local youth. "Our presence in Tampa represents
            an investment in people, partnerships, and progress," said 26th International Grand
            Basileus Marica T. Harris.
          </p>
        </div>
      </article>

      <div class="ln-grid">
        {cards.map((c) => {
          const Tag = c.href ? "a" : "article";
          const props = c.href
            ? {
                href: c.href.startsWith("http") ? c.href : withBase(c.href),
                ...(c.external ? { target: "_blank", rel: "noopener" } : {}),
              }
            : {};
          return (
            <Tag class="ln-card" {...props}>
              <figure>
                <img src={withBase(c.image)} alt={c.title} loading="lazy" decoding="async" />
              </figure>
              <span class="ln-tag">{c.tag}</span>
              <h3>{c.title}</h3>
              <c.Body />
            </Tag>
          );
        })}
      </div>

    </div>
  </section>
</Base>

<style>
  .ln-hero {
    background: var(--cream);
    padding-block: clamp(3rem, 5vw, 4rem);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    color: var(--muted-2);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .breadcrumb a {
    color: inherit;
  }
  .ln-hero h1 {
    margin: var(--space-2) 0 0;
  }
  .ln-hero > .container > p:last-child {
    color: var(--muted);
    margin-top: var(--space-3);
  }

  .ln-main {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .ln-feature {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--space-12);
    align-items: center;
    margin-bottom: var(--space-14);
    padding-bottom: var(--space-14);
    border-bottom: 1px solid var(--line);
  }
  .ln-feature figure {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .ln-feature img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
  }
  .ln-tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--space-2);
  }
  .ln-feature__copy h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-h3);
  }
  .ln-feature__copy p {
    color: var(--muted);
  }
  .ln-feature__copy a {
    color: var(--royal);
    font-weight: 700;
    text-decoration: none;
  }
  /* Below ~720px the two columns leave the copy side about 100px wide, which
     no headline can wrap into — the page then scrolled sideways by 50-70px.
     Stack instead, image first. */
  @media (max-width: 720px) {
    .ln-feature {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .ln-feature figure {
      order: -1;
    }
  }

  .ln-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: var(--space-8);
  }
  .ln-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .ln-card figure {
    margin: 0;
  }
  .ln-card img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    display: block;
  }
  .ln-card .ln-tag {
    margin: var(--space-5) var(--space-5) 0;
  }
  .ln-card h3 {
    margin: var(--space-2) var(--space-5) var(--space-2);
    font-size: var(--text-md);
  }
  .ln-card p {
    margin: 0 var(--space-5) var(--space-5);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .ln-more {
    text-align: center;
    margin-top: var(--space-12);
  }
  .ln-more a {
    color: var(--royal);
    font-weight: 700;
    text-decoration: none;
  }
</style>
