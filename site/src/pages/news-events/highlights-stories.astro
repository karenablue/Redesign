---
import Base from "../../layouts/Base.astro";
import CtaBand from "../../components/CtaBand.astro";
import { withBase } from "../../lib/url.js";

const photos = [
  {
    img: "/images/Sigma Gamma Rho 75th Anniversary Stained Glass Window.jpg",
    caption: "75th Anniversary Commemoration",
    size: "tall",
  },
  { img: "/images/youth-symposium-4-768x432.jpg", caption: "Annual Youth Symposium" },
  { img: "/images/swim-1922-2-768x432.jpg", caption: "Swim 1922" },
  { img: "/images/operation-bigbookbag-4.jpg", caption: "Operation BigBookBag", size: "wide" },
  { img: "/images/Women’s Wellness Initiative.png", caption: "Women's Wellness Initiative" },
  { img: "/images/etaiota.jpg", caption: "Eta Iota Chapter" },
  {
    img: "/images/Sigma Gamma Rho 75th Anniversary Walking Path.jpg",
    caption: "Legacy at Butler University",
    size: "tall",
  },
  { img: "/images/Kappa Xi.jpg", caption: "Kappa Xi Chapter" },
  { img: "/images/central region macy.jpg", caption: "Central Region" },
  {
    img: "/images/Women’s Wellness Initiative.png",
    caption: "Women's Wellness Initiative",
    size: "wide",
  },
];
---

<Base
  title="Highlights & Stories"
  activeTop="News & Events"
  description="Sisterhood and service in motion — photo highlights from across Sigma Gamma Rho."
>
  <section class="hl-hero">
    <div class="container">
      <p class="breadcrumb">
        <a href={withBase("/")}>Home</a> <span>/</span>{" "}
        <a href={withBase("/news-events/latest-news/")}>News &amp; Events</a> <span>/</span>{" "}
        <span>Highlights &amp; Stories</span>
      </p>
      <p class="eyebrow">News &amp; Events</p>
      <h1>Highlights &amp; Stories</h1>
      <p>Sisterhood and service in motion.</p>
    </div>
  </section>

  <section class="hl-gallery">
    <div class="container hl-grid">
      {photos.map((p) => (
        <figure class:list={["hl-item", p.size && `hl-item--${p.size}`]}>
          <img src={withBase(p.img)} alt={p.caption} loading="lazy" />
          <figcaption>{p.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <CtaBand
    eyebrow="Have a Story to Share?"
    title="Send Us Your "
    highlight="Chapter's Highlights."
    copy="Chapters can submit photos and stories through International Corporate Headquarters for future features."
    actions={[{ label: "Contact Headquarters", href: "/contact/" }]}
  />
</Base>

<style>
  .hl-hero {
    background: var(--cream);
    padding-block: clamp(3rem, 5vw, 4rem);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    color: var(--muted-2);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .breadcrumb a {
    color: inherit;
  }
  .hl-hero h1 {
    margin: var(--space-2) 0 0;
  }
  .hl-hero > .container > p:last-child {
    color: var(--muted);
    margin-top: var(--space-3);
  }

  .hl-gallery {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .hl-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 220px;
    gap: var(--space-4);
  }
  .hl-item {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .hl-item--tall {
    grid-row: span 2;
  }
  .hl-item--wide {
    grid-column: span 2;
  }
  .hl-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hl-item figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-3) var(--space-4);
    background: linear-gradient(0deg, rgba(8, 22, 51, 0.85), transparent);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .hl-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .hl-item--wide {
      grid-column: span 2;
    }
  }
  @media (max-width: 560px) {
    .hl-grid {
      grid-template-columns: 1fr;
    }
    .hl-item--wide,
    .hl-item--tall {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>
