---
/**
 * Full story for the Latest News lead item. Copy is the text the lead card
 * carried before the newsroom redesign, unchanged. Photographs are frames
 * from HQ's own Boulé recap films (images/boule-2026/SOURCES.md).
 */
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import { withBase } from "../../../lib/url.js";
---

<Base
  title="61st International Biennial Boulé in Tampa"
  activeTop="News & Events"
  description="Sigma Gamma Rho members, partners, and guests gathered in Tampa for the 61st International Biennial Boulé, July 22–26, 2026."
>
  <PageHero
    crumbs={[
      { label: "Home", href: "/" },
      { label: "Latest News", href: "/news-events/latest-news/" },
      { label: "61st Biennial Boulé" },
    ]}
    eyebrow="Boulé • July 2026"
    title="Tampa welcomes Sigma Gamma Rho"
    highlight="for the 61st International Biennial Boulé"
    size="compact"
  />
  <article class="story">
    {/* The lead picture runs wider than the text, the way a feature opens. */}
    <figure class="container story__lead">
      <img
        src={withBase("/optimized/hero-boule-marquee.webp")}
        srcset={`${withBase("/optimized/hero-boule-marquee-640.webp")} 640w, ${withBase("/optimized/hero-boule-marquee.webp")} 1200w`}
        sizes="(min-width: 1148px) 1100px, 100vw"
        alt="Members beside the lit Boulé by the Bay sign on the Tampa waterfront at dusk"
        width="1200"
        height="675"
      />
      <figcaption>
        61st International Biennial Boulé &bull; Tampa, Florida &bull; July 22&ndash;26, 2026
      </figcaption>
    </figure>
    <div class="container story__inner">
      <p>
        Thousands of members, partners, and guests gathered at the Tampa Convention Center July
        22&ndash;26 for the 61st International Biennial Boulé &mdash; the first Sigma Gamma Rho
        international convention held in Tampa since 1976.
      </p>
      <p>
        The city projected the gathering would generate more than $5.1 million in direct regional
        economic impact, alongside on-the-ground service including 300 newborn care packages, 3,000
        backpacks for K&ndash;8 students, and 300 free swim lessons for local youth.
      </p>
      <figure>
        <img
          src={withBase("/optimized/home-bigbookbag-boule.webp")}
          srcset={`${withBase("/optimized/home-bigbookbag-boule-640.webp")} 640w, ${withBase("/optimized/home-bigbookbag-boule.webp")} 1200w`}
          sizes="(min-width: 800px) 48rem, 100vw"
          alt="Members holding up backpacks for students during the Boulé's Community Impact Day"
          width="1200"
          height="675"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Operation BigBookBag&reg; &bull; Community Impact Day, Tampa</figcaption>
      </figure>
      <blockquote>
        <p>
          &ldquo;Our presence in Tampa represents an investment in people, partnerships, and
          progress.&rdquo;
        </p>
        <footer>26th International Grand Basileus Marica T. Harris</footer>
      </blockquote>
      <aside class="story__action" aria-labelledby="story-action-title">
        <p class="eyebrow">Service beyond the gathering</p>
        <h2 id="story-action-title">See the programs behind the impact.</h2>
        <p>Explore Project CRADLE Care, Operation BigBookBag, and Swim 1922.</p>
        <a class="btn" href={withBase("/service-impact/national-programs/")}>
          Explore Our National Programs <span aria-hidden="true">&rarr;</span>
        </a>
      </aside>
      <p class="story__back">
        <a href={withBase("/news-events/latest-news/")}>
          <span aria-hidden="true">&larr;</span> Back to Latest News
        </a>
      </p>
    </div>
  </article>
</Base>

<style>
  .story {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .story__inner {
    max-width: 48rem;
  }
  .story figure {
    margin: 0 0 var(--space-8);
  }
  .story .story__lead {
    margin: 0 auto clamp(2.5rem, 5vw, 3.5rem);
  }
  .story .story__lead img {
    aspect-ratio: 21 / 9;
    object-position: 50% 62%;
  }
  @media (max-width: 700px) {
    .story .story__lead img {
      aspect-ratio: 16 / 9;
    }
  }
  .story figure img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .story figcaption {
    margin-top: var(--space-2);
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .story p {
    color: var(--ink);
    font-size: var(--text-lg);
    line-height: 1.7;
  }
  .story blockquote {
    margin: var(--space-8) 0;
    padding-left: var(--space-6);
    border-left: 3px solid var(--gold);
  }
  .story blockquote p {
    margin: 0;
    color: var(--royal);
    font-size: var(--text-h3);
    line-height: 1.4;
    font-family: var(--font-editorial);
    font-style: italic;
  }
  .story blockquote footer {
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .story__back a {
    color: var(--royal);
    font-size: var(--text-base);
    font-weight: 700;
  }
  .story__action {
    margin-block: var(--space-12);
    padding: var(--space-8);
    background: var(--cream);
    border: 1px solid var(--line);
  }
  .story__action h2 {
    font-family: var(--font-editorial);
    font-size: var(--text-h3);
  }
  .story__action p {
    font-size: var(--text-base);
  }
  .story__action .eyebrow {
    color: var(--royal);
    font-size: var(--text-xs);
  }
</style>
