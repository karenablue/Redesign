---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import { withBase } from "../../../lib/url.js";
import { getCollection, render } from "astro:content";

/*
 * News items are markdown in src/content/news/, so HQ can post an update
 * after handover without touching this page. `order` is the display order;
 * prose lives in each file's markdown body. The first two items get the
 * large secondary slots; the rest run as compact rows.
 */
const newsEntries = (await getCollection("news")).sort((a, b) => a.data.order - b.data.order);
const items = await Promise.all(
  newsEntries.map(async (entry) => {
    const d = entry.data;
    return {
      ...d,
      topic: d.tag,
      link: d.href
        ? {
            href: d.href.startsWith("http") ? d.href : withBase(d.href),
            ...(d.external ? { target: "_blank", rel: "noopener" } : {}),
          }
        : null,
      Body: (await render(entry)).Content,
    };
  })
);
const secondary = items.slice(0, 2);
const archive = items.slice(2);
const topics = [...new Set(items.map((i) => i.topic))];
const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, "-");

const LEAD_URL = "/news-events/latest-news/61st-biennial-boule/";
---

<Base
  title="Latest News"
  activeTop="News & Events"
  description="Announcements and updates from across the international sisterhood of Sigma Gamma Rho."
  preloadImage="/optimized/boule.webp"
>
  <PageHero
    tone="paper"
    editorial
    stack
    crumbs={[{ label: "Home", href: "/" }, { label: "News & Events" }, { label: "Latest News" }]}
    eyebrow="The Sigma Gamma Rho Newsroom"
    title="Latest news."
    highlight="A sisterhood in motion."
    copy="Stories of service, announcements, and moments that move our international sisterhood forward."
    size="compact"
  >
    <a class="btn btn--outline on-dark" href={withBase("/news-events/upcoming-events/")}>
      Explore Events &amp; Calendars <span aria-hidden="true">&rarr;</span>
    </a>
  </PageHero>

  <section class="ln-main">
    <div class="container">
      <article class="ln-lead" data-reveal>
        <a class="ln-lead__media" href={withBase(LEAD_URL)} tabindex="-1" aria-hidden="true">
          <img src={withBase("/optimized/boule.webp")} alt="" width="1200" height="675" />
          <span class="ln-lead__badge">International Boulé</span>
        </a>
        <div class="ln-lead__copy">
          <p class="ln-meta">Boulé &bull; July 2026</p>
          <h2>
            <a href={withBase(LEAD_URL)}>
              Tampa Welcomes Sigma Gamma Rho for the 61st International Biennial Boulé
            </a>
          </h2>
          <p>
            Thousands of members, partners, and guests gathered at the Tampa Convention Center July
            22&ndash;26, the first Sigma Gamma Rho international convention in Tampa since 1976. The
            week paired business with service: newborn care packages, backpacks, and free swim
            lessons for local families.
          </p>
          <a class="ln-more" href={withBase(LEAD_URL)}>
            Read the full story <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </article>

      <div class="ln-layout">
        <div class="ln-feed">
          <div class="ln-filters" role="group" aria-label="Filter stories by topic" hidden>
            <button type="button" class="is-active" aria-pressed="true" data-topic="all">
              All Stories
            </button>
            {topics.map((t) => (
              <button type="button" aria-pressed="false" data-topic={slug(t)}>
                {t}
              </button>
            ))}
          </div>

          <h2 class="visually-hidden">More stories</h2>
          <ul class="ln-secondary">
            {secondary.map((c) => (
              <li class="ln-story" data-topic={slug(c.topic)}>
                {c.image && (
                  <img
                    class:list={{ "ln-brand-image": c.topic === "Partnership" }}
                    src={withBase(c.image)}
                    alt=""
                    width="600"
                    height="400"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <p class="ln-meta">
                  {c.topic}
                  {c.date && <> &bull; {c.date}</>}
                </p>
                <h3>{c.link ? <a {...c.link}>{c.title}</a> : c.title}</h3>
                <div class="ln-summary">
                  <c.Body />
                </div>
              </li>
            ))}
          </ul>

          <ul class="ln-archive">
            {archive.map((c, index) => (
              <li class="ln-row" data-topic={slug(c.topic)}>
                {c.image ? (
                  <img
                    src={withBase(c.image)}
                    alt=""
                    width="160"
                    height="120"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="ln-row__blank" aria-hidden="true">
                    {String(index + 3).padStart(2, "0")}
                  </span>
                )}
                <div>
                  <p class="ln-meta">
                    {c.topic}
                    {c.date && <> &bull; {c.date}</>}
                  </p>
                  <h3>{c.link ? <a {...c.link}>{c.title}</a> : c.title}</h3>
                  <div class="ln-summary">
                    <c.Body />
                  </div>
                </div>
              </li>
            ))}
          </ul>
          <p class="ln-empty" hidden>
            No stories in this topic yet.
          </p>
        </div>

        <aside class="ln-press" aria-label="For the press">
          <h2>For the Press</h2>
          <p>
            Interview, statement, and archival requests are coordinated by International Corporate
            Headquarters.
          </p>
          <a class="btn" href={withBase("/news-events/media-relations/")}>
            Media Relations
          </a>
          <a class="ln-press__link" href={withBase("/news-events/media-relations/")}>
            Brand assets &amp; logo suite <span aria-hidden="true">&rarr;</span>
          </a>
          <a class="ln-press__link" href={withBase("/news-events/upcoming-events/")}>
            Upcoming events <span aria-hidden="true">&rarr;</span>
          </a>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script>
  const bar = document.querySelector<HTMLElement>(".ln-filters");
  if (bar) {
    bar.hidden = false;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>("button")];
    const stories = [...document.querySelectorAll<HTMLElement>("[data-topic]:not(button)")];
    const empty = document.querySelector<HTMLElement>(".ln-empty");
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        const topic = b.dataset.topic;
        buttons.forEach((x) => {
          const on = x === b;
          x.classList.toggle("is-active", on);
          x.setAttribute("aria-pressed", String(on));
        });
        let shown = 0;
        stories.forEach((s) => {
          const match = topic === "all" || s.dataset.topic === topic;
          s.hidden = !match;
          if (match) shown++;
        });
        if (empty) empty.hidden = shown > 0;
      })
    );
  }
</script>

<style>
  .ln-main {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .ln-meta {
    margin: 0;
    color: var(--muted-2);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ---- lead story: 60/40 ---- */
  .ln-lead {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--space-10);
    align-items: stretch;
    padding-bottom: var(--space-14);
    border-bottom: 1px solid var(--line);
  }
  .ln-lead__media {
    position: relative;
    display: block;
    overflow: hidden;
  }
  .ln-lead__media img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 360px;
    object-fit: cover;
  }
  .ln-lead__badge {
    position: absolute;
    left: var(--space-4);
    top: var(--space-4);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius);
    background: var(--navy);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ln-lead__copy {
    padding-block: var(--space-6);
  }
  @media (max-width: 820px) {
    .ln-lead__media img {
      min-height: 0;
      aspect-ratio: 16 / 10;
      height: auto;
    }
    .ln-lead__copy {
      padding: 0;
    }
  }
  .ln-lead h2 {
    margin: var(--space-3) 0 var(--space-4);
    font-family: var(--font-editorial);
    font-size: var(--text-h2);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }
  .ln-lead h2 a {
    color: var(--royal);
    text-decoration: none;
  }
  .ln-lead h2 a:hover {
    color: var(--accent-hover);
  }
  .ln-lead__copy > p:not(.ln-meta) {
    margin: 0;
    color: var(--muted);
  }
  .ln-more {
    display: inline-block;
    margin-top: var(--space-5);
    color: var(--royal);
    font-weight: 700;
  }

  /* ---- feed + press box ---- */
  .ln-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: var(--space-12);
    align-items: start;
    margin-top: var(--space-12);
  }
  .ln-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }
  .ln-filters button {
    min-height: 40px;
    padding: 0 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    color: var(--royal);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }
  .ln-filters button:hover {
    border-color: var(--royal);
  }
  .ln-filters button.is-active {
    border-color: var(--royal);
    background: var(--royal);
    color: #fff;
  }

  .ln-secondary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
    margin: 0 0 var(--space-10);
    padding: 0;
    list-style: none;
  }
  .ln-story img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: var(--space-4);
  }
  .ln-story .ln-brand-image {
    object-fit: contain;
    background: var(--cream);
  }
  .ln-story h3,
  .ln-row h3 {
    margin: var(--space-2) 0 var(--space-2);
    font-size: var(--text-lg);
    line-height: 1.3;
  }
  .ln-story h3 {
    font-family: var(--font-editorial);
    font-size: var(--text-h3);
    font-weight: 600;
  }
  .ln-row h3 {
    font-size: var(--text-md);
  }
  .ln-story h3 a,
  .ln-row h3 a {
    color: var(--royal);
    text-decoration: none;
  }
  .ln-story h3 a:hover,
  .ln-row h3 a:hover {
    color: var(--accent-hover);
    text-decoration-line: underline;
    text-decoration-color: var(--gold);
  }
  .ln-summary :global(p) {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .ln-archive {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .ln-row {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--line);
  }
  .ln-row img,
  .ln-row__blank {
    display: block;
    width: 160px;
    height: 120px;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .ln-row__blank {
    display: grid;
    place-items: center;
    background: var(--cream);
    color: var(--royal);
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 4vw, 3.5rem);
    border-radius: 0;
  }
  .ln-empty {
    color: var(--muted);
  }

  .ln-press {
    position: sticky;
    top: 200px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--line);
    background: var(--cream);
  }
  .ln-press h2 {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--royal);
  }
  .ln-press p {
    margin: 0 0 var(--space-2);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .ln-press .btn {
    align-self: flex-start;
  }
  .ln-press__link {
    color: var(--royal);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  @media (max-width: 1000px) {
    .ln-lead,
    .ln-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .ln-press {
      position: static;
    }
  }
  @media (max-width: 640px) {
    .ln-secondary {
      grid-template-columns: minmax(0, 1fr);
    }
    .ln-row {
      grid-template-columns: 96px minmax(0, 1fr);
      gap: var(--space-4);
    }
    .ln-row img,
    .ln-row__blank {
      width: 96px;
      height: 72px;
    }
  }
</style>
