---
/**
 * Vendor — the licensed-vendor gateway.
 *
 * Tiers, fees, application windows, directory, forms and RFPs are taken from
 * sgrho1922.org/vendors/. Tier numbers are HQ's own (new vendors start in
 * Tier 3); the cards are ordered by sales volume, not renumbered. Window
 * status is worked out in the visitor's browser so it never goes stale; the
 * build-time label is only the no-JavaScript fallback.
 */
import Base from "../../layouts/Base.astro";

const DIRECTORY_URL = "https://sgrho1922.store/pages/vendordirectory";
const REPORT_URL = "https://fs20.formsite.com/8i8VIT/azr7aj4amf/index";
const INTEREST_URL = "https://fs20.formsite.com/8i8VIT/fygbapbygy/index";
const GUIDELINES_URL = "https://sgrho1922.org/wp-content/uploads/2026/07/SGR-Brand-Guidelines-FY2027.pdf";
const HQ_VENDORS_URL = "https://sgrho1922.org/vendors/";
const BECOME_URL = "https://helpsgrho1922.freshdesk.com/support/solutions/articles/69000836285-how-do-i-become-a-licensed-vendor-";
const VENDOR_KB_URL = "https://helpsgrho1922.freshdesk.com/support/solutions/folders/69000647096";

const tiers = [
  {
    tier: "Tier 3",
    name: "Annual Sales Up to $10,000",
    fee: "$1,200",
    note: "Where new vendors begin",
    items: ["0% royalties", "Annual reporting", "Not eligible for in-person participation"],
  },
  {
    tier: "Tier 2",
    name: "Annual Sales Over $10,000",
    fee: "$2,400",
    featured: true,
    items: ["12% royalties", "Quarterly reporting", "Eligible for participation opportunities"],
  },
  {
    tier: "Tier 1",
    name: "Partners & Collaborators",
    fee: "$1,000",
    note: "Applications considered year-round",
    items: ["0–22% royalties based on project scope", "Quarterly reporting", "Eligible for participation opportunities"],
  },
];

/** Application windows: January 1 – March 30 of the year before each fiscal year. */
const windows = [
  { fy: "FY27", years: "2026–2027", open: "2026-01-01", close: "2026-03-30" },
  { fy: "FY28", years: "2027–2028", open: "2027-01-01", close: "2027-03-30" },
  { fy: "FY29", years: "2028–2029", open: "2028-01-01", close: "2028-03-30" },
  { fy: "FY30", years: "2029–2030", open: "2029-01-01", close: "2029-03-30" },
];
const fmt = (d: string) =>
  new Date(`${d}T12:00:00`).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
const statusAt = (w: (typeof windows)[number], now: Date) => {
  const today = now.toISOString().slice(0, 10);
  return today < w.open ? "Upcoming" : today > w.close ? "Closed" : "Open";
};
const buildDate = new Date();

const responsibilities = [
  { title: "Brand Guidelines & Standards", note: "Logo usage, colors, typography, and visual identity (PDF).", href: GUIDELINES_URL },
  { title: "How to Become a Licensed Vendor", note: "Requirements, artwork review, payment, and proof of insurance.", href: BECOME_URL },
  { title: "Vendor Support Articles", note: "Compliance, visibility, and Boulé vendor guides.", href: VENDOR_KB_URL },
  { title: "Official Vendor Information", note: "HQ's vendor page, with forms and current notices.", href: HQ_VENDORS_URL },
];

const rfps = [
  { title: "Strategic Planning (2025–26)", href: "https://sgrho1922.org/wp-content/uploads/2026/05/SGR-RFP-Strategic-Planning-2025-26.pdf" },
  { title: "Compensation Analysis Services", href: "https://sgrho1922.org/wp-content/uploads/2026/05/SGR-RFP-Compensation-Analysis-Services.pdf" },
  { title: "Records Management", href: "https://sgrho1922.org/wp-content/uploads/2026/05/SGR-RFP-Records-Management.pdf" },
];
---

<Base
  title="Vendor"
  activeTop="Resources"
  description="Sigma Gamma Rho's licensed vendor program: verify a vendor, licensing tiers, application windows, and requests for proposal."
>
  <section class="ven-hero on-dark">
    <div class="container ven-hero__inner">
      <p class="eyebrow">Intellectual Property &amp; Licensing</p>
      <h1>
        Authorized
        <span>Vendor Marketplace</span>
      </h1>
      <p class="ven-hero__lead">
        The licensed vendor program governs authorized use of the Sorority's trademarks, and keeps
        members' purchases in the hands of vendors who meet its standards.
      </p>
      <div class="ven-actions">
        <a class="btn" href="#verify">Verify a Licensed Vendor <span aria-hidden="true">&darr;</span></a>
        <a class="btn btn--outline" href="#licensing">Apply for a License <span aria-hidden="true">&darr;</span></a>
      </div>
    </div>
  </section>

  <section class="ven-verify" id="verify">
    <div class="container">
      <div class="ven-verify__card">
        <div>
          <h2>Verify before you purchase</h2>
          <p>
            The Official Licensed Vendor Directory is the source for confirming whether a business
            may sell products that use Sigma Gamma Rho intellectual property. Look for the business
            name before you buy.
          </p>
        </div>
        <div class="ven-verify__actions">
          <a class="btn" href={DIRECTORY_URL} target="_blank" rel="noopener">
            Open the Licensed Vendor Directory <span aria-hidden="true">&#8599;</span>
          </a>
          <a class="ven-report" href={REPORT_URL} target="_blank" rel="noopener">
            Report infringing merchandise or vendor misconduct <span aria-hidden="true">&#8599;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="ven-tiers" id="licensing">
    <div class="container">
      <div class="ven-heading">
        <h2>Three Licensing Tiers</h2>
        <p>
          New vendors begin in Tier 3 for their first licensing year. Licenses run on a July 1 –
          June 30 fiscal year and are renewed annually.
        </p>
      </div>
      <ul class="ven-tiers__grid">
        {tiers.map((t) => (
          <li class:list={["ven-tier", { "ven-tier--featured": t.featured }]}>
            <p class="ven-tier__label">{t.tier}</p>
            <h3>{t.name}</h3>
            <p class="ven-tier__fee">
              <strong>{t.fee}</strong>
              <span>annual advance fee</span>
            </p>
            {t.note && <p class="ven-tier__note">{t.note}</p>}
            <ul>
              {t.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="ven-windows">
    <div class="container ven-windows__grid">
      <div>
        <h2>New Applications Open Once a Year</h2>
        <p>
          Applications are reviewed only during the posted windows. Tier 1 partner applications may
          be considered throughout the fiscal year.
        </p>
        <a class="btn btn--outline" href={INTEREST_URL} target="_blank" rel="noopener">
          Vendor Interest Form <span aria-hidden="true">&#8599;</span>
        </a>
      </div>
      <div class="ven-table-wrap">
        <table class="ven-table">
          <caption class="visually-hidden">Licensed vendor application windows</caption>
          <thead>
            <tr>
              <th scope="col">Licensing cycle</th>
              <th scope="col">Application window</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            {windows.map((w) => (
              <tr>
                <th scope="row">
                  {w.fy} <span>{w.years}</span>
                </th>
                <td>
                  {fmt(w.open).replace(/, \d{4}$/, "")} – {fmt(w.close)}
                </td>
                <td>
                  <span class="ven-status" data-open={w.open} data-close={w.close} data-state={statusAt(w, buildDate)}>
                    {statusAt(w, buildDate)}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="ven-standards">
    <div class="container ven-standards__grid">
      <div>
        <h2>Authorization Carries Responsibility</h2>
        <p>
          Licensees follow Sigma Gamma Rho's brand guidelines and submit mockups of licensed products
          for artwork review before launch. Upon acceptance, vendors provide the required payment
          and proof of insurance.
        </p>
      </div>
      <ul class="ven-rows">
        {responsibilities.map((r) => (
          <li>
            <a href={r.href} target="_blank" rel="noopener">
              <strong>{r.title}</strong>
              <span>{r.note}</span>
              <b aria-hidden="true">&#8599;</b>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="ven-rfp">
    <div class="container ven-rfp__grid">
      <div>
        <h2>Professional Services Beyond Merchandise</h2>
        <p>
          Sigma Gamma Rho also contracts experienced firms, agencies, and consultants for strategic
          and operational projects. Requests for proposal are published by International Corporate
          Headquarters.
        </p>
        <a class="btn" href={INTEREST_URL} target="_blank" rel="noopener">
          Submit Your Interest for Future Opportunities <span aria-hidden="true">&#8599;</span>
        </a>
      </div>
      <div>
        <h3>Open Requests for Proposal</h3>
        <ul class="ven-rows ven-rows--compact">
          {rfps.map((r) => (
            <li>
              <a href={r.href} target="_blank" rel="noopener">
                <strong>{r.title}</strong>
                <b aria-hidden="true">PDF &#8599;</b>
              </a>
            </li>
          ))}
        </ul>
        <p class="ven-rfp__note">
          See <a href={HQ_VENDORS_URL} target="_blank" rel="noopener">HQ's vendor page</a> for the latest list.
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  // Recompute each window's status for today, in the visitor's time zone.
  const today = new Date();
  const iso = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, "0")}-${String(today.getDate()).padStart(2, "0")}`;
  document.querySelectorAll<HTMLElement>(".ven-status").forEach((el) => {
    const { open = "", close = "" } = el.dataset;
    const state = iso < open ? "Upcoming" : iso > close ? "Closed" : "Open";
    el.dataset.state = state;
    el.textContent = state;
  });
</script>

<style>
  .ven-hero {
    background: var(--grad-royal);
    color: #fff;
  }
  .ven-hero__inner {
    max-width: 48rem;
    padding-block: clamp(3.5rem, 6vw, 5rem);
  }
  .ven-hero h1 {
    margin: var(--space-2) 0 0;
    color: #fff;
  }
  .ven-hero h1 span {
    display: block;
    color: var(--gold);
  }
  .ven-hero__lead {
    margin: var(--space-5) 0 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--text-lg);
  }
  .ven-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  /* ---- verify ---- */
  .ven-verify {
    background: var(--white);
    padding-block: clamp(3rem, 5vw, 4rem) 0;
    scroll-margin-top: 72px;
  }
  .ven-verify__card {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
    padding: var(--space-8);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .ven-verify h2,
  .ven-heading h2,
  .ven-windows h2,
  .ven-standards h2,
  .ven-rfp h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-h3);
  }
  .ven-verify p {
    margin: 0;
    color: var(--muted);
  }
  .ven-verify__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .ven-report {
    color: var(--royal);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  @media (max-width: 860px) {
    .ven-verify__card {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-6);
    }
  }

  /* ---- tiers ---- */
  .ven-tiers {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
    scroll-margin-top: 72px;
  }
  .ven-heading {
    max-width: 44rem;
    margin-bottom: var(--space-8);
  }
  .ven-heading p {
    margin: 0;
    color: var(--muted);
  }
  .ven-tiers__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ven-tier {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
  }
  .ven-tier--featured {
    border-color: var(--gold);
  }
  .ven-tier__label {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ven-tier h3 {
    margin: var(--space-2) 0 var(--space-4);
    font-size: var(--text-lg);
  }
  .ven-tier__fee {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
  }
  .ven-tier__fee strong {
    color: var(--royal);
    font-size: var(--text-h3);
    font-variant-numeric: tabular-nums;
  }
  .ven-tier__fee span {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .ven-tier__note {
    margin: var(--space-2) 0 0;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .ven-tier ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    padding: var(--space-5) 0 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .ven-tier li {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  @media (max-width: 900px) {
    .ven-tiers__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---- windows ---- */
  .ven-windows {
    background: var(--cream);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .ven-windows__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-10);
    align-items: start;
  }
  .ven-windows p {
    color: var(--muted);
  }
  .ven-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
  }
  .ven-table {
    width: 100%;
    border-collapse: collapse;
  }
  .ven-table th,
  .ven-table td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    vertical-align: middle;
  }
  .ven-table thead th {
    background: var(--tint);
    color: var(--royal);
    font-size: var(--text-sm);
  }
  .ven-table tbody tr + tr {
    border-top: 1px solid var(--line);
  }
  .ven-table tbody th {
    color: var(--ink);
    white-space: nowrap;
  }
  .ven-table tbody th span {
    display: block;
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 400;
  }
  .ven-table td {
    color: var(--ink);
    font-size: var(--text-sm);
  }
  .ven-status {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 700;
    white-space: nowrap;
  }
  .ven-status[data-state="Open"] {
    border-color: var(--royal);
    background: var(--royal);
    color: #fff;
  }
  .ven-status[data-state="Upcoming"] {
    border-color: var(--gold);
    color: var(--royal);
  }
  .ven-status[data-state="Closed"] {
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .ven-windows__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---- responsibility rows ---- */
  .ven-standards {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .ven-standards__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-10);
    align-items: start;
  }
  .ven-standards p {
    color: var(--muted);
  }
  .ven-rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .ven-rows a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .ven-rows strong {
    color: var(--royal);
  }
  .ven-rows span {
    grid-column: 1;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .ven-rows b {
    grid-column: 2;
    grid-row: 1;
    color: var(--royal);
    font-size: var(--text-sm);
  }
  .ven-rows a:hover strong {
    color: var(--accent-hover);
    text-decoration: underline;
    text-decoration-color: var(--gold);
  }
  @media (max-width: 900px) {
    .ven-standards__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---- RFP split ---- */
  .ven-rfp {
    background: var(--cream);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .ven-rfp__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-10);
    align-items: start;
  }
  .ven-rfp p {
    color: var(--muted);
  }
  .ven-rfp h3 {
    margin: 0 0 var(--space-3);
    color: var(--ink);
    font-size: var(--text-md);
  }
  .ven-rfp__note {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }
  .ven-rfp__note a {
    color: var(--royal);
    font-weight: 700;
  }
  @media (max-width: 900px) {
    .ven-rfp__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
