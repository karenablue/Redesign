---
/**
 * Help Center — a front door to HQ's Freshdesk support portal.
 *
 * Search submits straight to the Freshdesk knowledge base; the two browse
 * links are its real categories (Events & Conventions, Operations). Support
 * hours are not published anywhere, so none are stated.
 */
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { withBase } from "../../lib/url.js";

const DESK = "https://helpsgrho1922.freshdesk.com";
const NEW_TICKET = `${DESK}/support/tickets/new`;

const pillars = [
  {
    title: "Member Records & Portal Support",
    body: "Poodle Portal logins, dues invoices, name and address changes, and financial standing.",
    href: NEW_TICKET,
    external: true,
    label: "Open a Membership Ticket",
  },
  {
    title: "Reactivation & Transfers",
    body: "Returning to active status or moving to a new chapter. Start with the step-by-step guide.",
    href: "/membership/reactivate/",
    external: false,
    label: "Read the Reactivation Guide",
  },
  {
    title: "Conduct & Reporting",
    body: "Hazing concerns, unauthorized activity, and verifying a member's or chapter's standing.",
    href: "/resources/anti-hazing-policy/#reporting",
    external: false,
    label: "How to Report a Concern",
  },
];

const categories = [
  {
    title: "Events & Conventions",
    note: "Boulé registration, hotels, transportation, and leadership institutes.",
    href: `${DESK}/support/solutions/69000434790`,
  },
  {
    title: "Operations",
    note: "Account updates, the Sigma Store, and vendor support.",
    href: `${DESK}/support/solutions/69000434788`,
  },
];
---

<Base
  title="Help Center"
  activeTop="Resources"
  description="Search Sigma Gamma Rho's support knowledge base or open a ticket with International Corporate Headquarters."
>
  <PageHero
    stack
    crumbs={[{ label: "Home", href: "/" }, { label: "Resources" }, { label: "Help Center" }]}
    eyebrow="Sigma Gamma Rho • Member Support"
    title="How can we"
    highlight="help you?"
    copy="Search the knowledge base for answers, or open a support ticket with International Corporate Headquarters."
  >
    <form class="hc-search" action={`${DESK}/support/search`} method="get" target="_blank" role="search">
      <label class="visually-hidden" for="hc-term">Search the knowledge base</label>
      <input
        id="hc-term"
        name="term"
        type="search"
        placeholder="Search FAQs, policies, and member guidelines"
        required
      />
      <button class="btn" type="submit">Search</button>
    </form>
    <a class="btn btn--outline on-dark" href={NEW_TICKET} target="_blank" rel="noopener">
      Submit a Support Ticket <span aria-hidden="true">&#8599;</span>
    </a>
  </PageHero>

  <section class="hc-main">
    <div class="container">
      <h2 class="hc-title">Common Requests</h2>
      <ul class="hc-pillars">
        {pillars.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
            <a
              href={p.external ? p.href : withBase(p.href)}
              {...(p.external ? { target: "_blank", rel: "noopener" } : {})}
            >
              {p.label} <span aria-hidden="true">{p.external ? "↗" : "→"}</span>
            </a>
          </li>
        ))}
      </ul>

      <h2 class="hc-title">Browse the Knowledge Base</h2>
      <ul class="hc-cats">
        {categories.map((c) => (
          <li>
            <a href={c.href} target="_blank" rel="noopener">
              <strong>
                {c.title} <span aria-hidden="true">&#8599;</span>
              </strong>
              <span>{c.note}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="hc-desk">
        <div>
          <h2>Help Desk</h2>
          <p>
            Tickets submitted through the help desk receive a tracking number, so you can follow up
            on your request.
          </p>
        </div>
        <dl>
          <div>
            <dt>Email</dt>
            <dd>
              <a href="mailto:help@sgrho1922.org">help@sgrho1922.org</a>
            </dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd>
              <a href="tel:+19196789720">(919) 678-9720</a>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  .hc-search {
    display: flex;
    gap: var(--space-2);
    flex: 1 1 100%;
    margin: 0;
    max-width: 36rem;
  }
  .hc-search input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--white);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink);
    font: inherit;
  }
  .hc-search .btn {
    padding-inline: 1.4em;
  }
  @media (max-width: 480px) {
    .hc-search {
      flex-direction: column;
    }
  }

  .hc-main {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .hc-title {
    margin: 0 0 var(--space-6);
    font-size: var(--text-h3);
  }
  .hc-pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0 0 var(--space-14);
    padding: 0;
    list-style: none;
  }
  .hc-pillars li {
    display: flex;
    flex-direction: column;
    padding: var(--space-6) 0;
    border-top: 1px solid var(--line-strong);
  }
  .hc-pillars h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
  }
  .hc-pillars p {
    margin: 0 0 var(--space-5);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .hc-pillars a {
    margin-top: auto;
    color: var(--royal);
    font-size: var(--text-sm);
    font-weight: 700;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .hc-cats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0 0 var(--space-14);
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .hc-cats a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    height: 100%;
    padding: var(--space-5) var(--space-5) var(--space-5) 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .hc-cats strong {
    color: var(--royal);
  }
  .hc-cats a:hover strong {
    color: var(--accent-hover);
    text-decoration: underline;
    text-decoration-color: var(--gold);
  }
  .hc-cats span {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .hc-desk {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6) var(--space-10);
    padding: var(--space-8);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--tint);
  }
  .hc-desk h2 {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-lg);
  }
  .hc-desk p {
    margin: var(--space-2) 0 0;
    max-width: 34rem;
    color: var(--muted);
  }
  .hc-desk dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-10);
    margin: 0;
  }
  .hc-desk dt {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .hc-desk dd {
    margin: var(--space-1) 0 0;
  }
  .hc-desk dd a {
    color: var(--royal);
    font-weight: 700;
  }
  @media (max-width: 860px) {
    .hc-pillars,
    .hc-cats {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
