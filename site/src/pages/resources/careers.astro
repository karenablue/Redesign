---
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/url.js";

const photos = [
  { img: "/images/SGRho Photoshoot.jfif", alt: "Sigma Gamma Rho members together", size: "tall" },
  { img: "/images/boule.jpg", alt: "Sigma Gamma Rho members at Boulé", size: "wide" },
  {
    img: "/images/Congressional Day on the Hill.jpg",
    alt: "Sigma Gamma Rho members at Congressional Day on the Hill",
  },
  { img: "/images/alumnae sorors.jpg", alt: "Sigma Gamma Rho alumnae members together" },
  {
    img: "/images/ug sorors 4.jpg",
    alt: "Sigma Gamma Rho undergraduate members together",
    size: "wide",
  },
];

const opportunities = [
  {
    tag: "Headquarters Staff",
    title: "ICHQ Positions",
    body: "Full-time and contract roles supporting operations, finance, IT, compliance, and communications at International Corporate Headquarters.",
    href: "/contact/",
    label: "Inquire with HR",
  },
  {
    tag: "Volunteer Leadership",
    title: "Regional & Chapter Roles",
    body: "Serve as an advisor, committee member, or regional officer supporting undergraduate and alumnae chapters.",
    href: "/leadership/regional-leadership/",
    label: "Meet Regional Leadership",
  },
  {
    tag: "Vendors & Partners",
    title: "Approved Vendors",
    body: "Photographers, printers, and service providers can apply for approved-vendor status with the Sorority.",
    href: "/resources/vendor/",
    label: "Vendor Information",
  },
];
---

<Base
  title="Careers"
  activeTop="Resources"
  description="Staff, volunteer, and vendor opportunities across Sigma Gamma Rho Sorority, Incorporated."
>
  <section class="ca-hero">
    <div class="container">
      <p class="breadcrumb">
        <a href={withBase("/")}>Home</a> <span>/</span>{" "}
        <a href={withBase("/resources/vendor/")}>Resources</a> <span>/</span> <span>Careers</span>
      </p>
      <p class="eyebrow">Resources • Careers</p>
      <h1>
        Do Work That
        <br />
        <span>Serves Sisterhood.</span>
      </h1>
      <p>
        From International Corporate Headquarters to regional volunteer roles, here's where Sigma
        Gamma Rho's work gets done.
      </p>
    </div>
  </section>

  <section class="ca-wall" aria-label="Sisterhood in action">
    <div class="container ca-wall__grid">
      {photos.map((p) => (
        <figure class:list={["ca-photo", p.size && `ca-photo--${p.size}`]}>
          <img src={withBase(p.img)} alt={p.alt} loading="lazy" />
        </figure>
      ))}
    </div>
  </section>

  <section class="ca-main">
    <div class="container">
      <div class="ca-intro">
        <p class="eyebrow">Why ICHQ</p>
        <h2>
          Staff Work That <span>Moves the Mission.</span>
        </h2>
        <p>
          International Corporate Headquarters is the operational engine behind the Sorority's
          international sisterhood — membership services, finance, technology, compliance,
          marketing, and event planning, all in service of members and chapters worldwide. Meet the
          team on the{" "}
          <a href={withBase("/about/headquarters/")}>International Corporate Headquarters</a> page.
        </p>
      </div>

      <div class="ca-grid">
        {opportunities.map((o) => (
          <article class="ca-card">
            <span class="ca-tag">{o.tag}</span>
            <h3>{o.title}</h3>
            <p>{o.body}</p>
            <a href={withBase(o.href)}>
              {o.label} <span aria-hidden="true">&rarr;</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .ca-hero {
    background: var(--cream);
    padding-block: clamp(3rem, 6vw, 4rem);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    color: var(--muted-2);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .breadcrumb a {
    color: inherit;
  }
  .ca-hero h1 {
    max-width: 600px;
    margin: var(--space-2) 0 0;
  }
  .ca-hero > .container > p:last-child {
    max-width: 540px;
    margin: var(--space-5) 0 0;
    color: var(--muted);
  }

  .ca-wall {
    background: var(--white);
    padding-block: var(--space-8);
  }
  .ca-wall__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 180px;
    gap: var(--space-4);
  }
  .ca-photo {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .ca-photo--tall {
    grid-row: span 2;
  }
  .ca-photo--wide {
    grid-column: span 2;
  }
  .ca-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 900px) {
    .ca-wall__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .ca-photo--tall {
      grid-row: span 1;
    }
  }

  .ca-main {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .ca-intro {
    max-width: 50rem;
    margin: 0 auto var(--space-12);
    text-align: center;
  }
  .ca-intro h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .ca-intro h2 span {
    color: var(--gold-display);
  }
  .ca-intro > p {
    color: var(--muted);
    margin-top: var(--space-4);
  }
  .ca-intro a {
    color: var(--royal);
    font-weight: 700;
  }

  .ca-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: var(--space-8);
  }
  .ca-card {
    background: var(--tint);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }
  .ca-tag {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .ca-card h3 {
    margin: var(--space-2) 0 var(--space-3);
    font-size: var(--text-md);
  }
  .ca-card p {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .ca-card a {
    color: var(--royal);
    font-weight: 700;
    text-decoration: none;
  }
  .ca-card a:hover {
    color: var(--gold-text);
  }
</style>
