---
/**
 * Careers — two employment tracks, then volunteer leadership as a footnote.
 *
 * Track A: staff roles at International Corporate Headquarters, posted on
 * BambooHR. Track B: the Sigma Gamma Rho job board (sgrhojobs.org, powered
 * by TalentAlly); its feature list is taken from that site. Vendor licensing
 * lives on /resources/vendor/, not here.
 */
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { withBase } from "../../lib/url.js";

const ICHQ_URL = "https://sgrho1922.bamboohr.com/careers";
const BOARD_URL = "https://sgrhojobs.org/";

const tracks = [
  {
    kicker: "Work with the Sorority",
    title: "International Corporate Headquarters",
    badge: "Cary, North Carolina",
    body: "Professional staff roles at the operational engine behind the Sorority: membership services, finance, technology, compliance, marketing, and event planning, in service of members and chapters worldwide.",
    points: [
      "Staff positions posted by International Corporate Headquarters",
      "Work that directly supports members and chapters",
      "Meet the team on the Headquarters page",
    ],
    href: ICHQ_URL,
    label: "Browse Openings on BambooHR",
  },
  {
    kicker: "Build your career",
    title: "Sigma Gamma Rho Job Board",
    badge: "All industries",
    body: "The Sorority's job board connects members and alumnae with diversity-focused employers, alongside tools for the search itself.",
    points: [
      "Job search by keyword and location",
      "AI resume enhancement and virtual interview practice",
      "Career fair and workplace resources",
    ],
    href: BOARD_URL,
    label: "Search the Job Board",
  },
];
---

<Base
  title="Careers"
  activeTop="Resources"
  description="Staff careers at Sigma Gamma Rho's International Corporate Headquarters and the Sorority's job board for members."
>
  <PageHero
    stack
    eyebrow="Careers & Talent Network"
    title="Work with"
    highlight="greater purpose."
    copy="Join the team supporting our sisterhood, or take your next professional step through the Sigma Gamma Rho job board."
    image="/optimized/hero-alumnae-professional.webp"
    focal="50% 35%"
  >
    <a class="btn" href={ICHQ_URL} target="_blank" rel="noopener">
      View Open ICHQ Positions <span aria-hidden="true">&#8599;</span>
    </a>
    <a class="btn btn--outline on-dark" href={BOARD_URL} target="_blank" rel="noopener">
      Explore the Job Board <span aria-hidden="true">&#8599;</span>
    </a>
  </PageHero>

  <section class="ca-tracks">
    <div class="container ca-tracks__grid">
      {tracks.map((t) => (
        <article class="ca-track">
          <p class="ca-kicker">{t.kicker}</p>
          <h2>{t.title}</h2>
          <span class="ca-badge">{t.badge}</span>
          <p>{t.body}</p>
          <ul>
            {t.points.map((pt) => (
              <li>{pt}</li>
            ))}
          </ul>
          <a class="btn" href={t.href} target="_blank" rel="noopener">
            {t.label} <span aria-hidden="true">&#8599;</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="ca-service">
    <div class="container ca-service__inner">
      <div>
        <h2>Seeking service leadership roles?</h2>
        <p>
          Committee assignments, regional appointments, and chapter advisor roles are volunteer
          service, coordinated through national and regional leadership.
        </p>
      </div>
      <a class="ca-service__link" href={withBase("/leadership/regional-leadership/")}>
        Explore Regional Leadership <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .ca-tracks {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .ca-tracks__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-12);
  }
  .ca-track {
    display: flex;
    flex-direction: column;
    padding: var(--space-8) 0;
    border-top: 1px solid var(--line-strong);
    border-radius: 0;
  }
  .ca-kicker {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ca-track h2 {
    margin: var(--space-2) 0 var(--space-3);
    font-family: var(--font-editorial);
    font-weight: 400;
    font-size: var(--text-h2);
    color: var(--royal);
  }
  .ca-badge {
    align-self: flex-start;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--gold);
    border-radius: 999px;
    color: var(--royal);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .ca-track > p:not(.ca-kicker) {
    margin: var(--space-5) 0 0;
    color: var(--muted);
  }
  .ca-track ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-5) 0 var(--space-8);
    padding: 0;
    list-style: none;
  }
  .ca-track li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--ink);
    font-size: var(--text-sm);
  }
  .ca-track li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 10px;
    height: 2px;
    background: var(--royal);
  }
  .ca-track .btn {
    margin-top: auto;
    align-self: flex-start;
  }
  @media (max-width: 860px) {
    .ca-tracks__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 480px) {
    .ca-track {
      padding: var(--space-5);
    }
  }

  .ca-service {
    background: var(--cream);
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }
  .ca-service__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5) var(--space-10);
  }
  .ca-service h2 {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--ink);
  }
  .ca-service p {
    margin: var(--space-2) 0 0;
    max-width: 40rem;
    color: var(--muted);
  }
  .ca-service__link {
    color: var(--royal);
    font-weight: 700;
  }
</style>
