---
/**
 * Careers — two employment tracks, then volunteer leadership as a footnote.
 *
 * Track A: staff roles at International Corporate Headquarters, posted on
 * BambooHR. Track B: the Sigma Gamma Rho job board (sgrhojobs.org, powered
 * by TalentAlly); its feature list is taken from that site. Vendor licensing
 * lives on /resources/vendor/, not here.
 */
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/url.js";

const ICHQ_URL = "https://sgrho1922.bamboohr.com/careers";
const BOARD_URL = "https://sgrhojobs.org/";

const photos = [
  { img: "/images/SGRho Photoshoot.jfif", alt: "Sigma Gamma Rho members together" },
  { img: "/images/Congressional Day on the Hill.jpg", alt: "Sigma Gamma Rho members at Congressional Day on the Hill" },
  { img: "/images/alumnae sorors.jpg", alt: "Sigma Gamma Rho alumnae members together" },
];

const tracks = [
  {
    kicker: "Track A • ICHQ Careers",
    title: "International Corporate Headquarters",
    badge: "Cary, North Carolina",
    body: "Professional staff roles at the operational engine behind the Sorority: membership services, finance, technology, compliance, marketing, and event planning, in service of members and chapters worldwide.",
    points: ["Staff positions posted by International Corporate Headquarters", "Work that directly supports members and chapters", "Meet the team on the Headquarters page"],
    href: ICHQ_URL,
    label: "Browse Openings on BambooHR",
  },
  {
    kicker: "Track B • Member Job Board",
    title: "Sigma Gamma Rho Job Board",
    badge: "All industries",
    body: "The Sorority's job board connects members and alumnae with diversity-focused employers, alongside tools for the search itself.",
    points: ["Job search by keyword and location", "AI resume enhancement and virtual interview practice", "Career fair and workplace resources"],
    href: BOARD_URL,
    label: "Search the Job Board",
  },
];
---

<Base
  title="Careers"
  activeTop="Resources"
  description="Staff careers at Sigma Gamma Rho's International Corporate Headquarters and the Sorority's job board for members."
>
  <section class="ca-hero on-dark">
    <div class="container">
      <p class="breadcrumb">
        <a href={withBase("/")}>Home</a> <span>/</span> <span>Resources</span> <span>/</span>{" "}
        <span>Careers</span>
      </p>
      <p class="eyebrow">Careers &amp; Talent Network</p>
      <h1>
        Work With
        <br />
        <span>Greater Purpose.</span>
      </h1>
      <p class="ca-hero__lead">
        Join the team powering international operations in Cary, North Carolina, or tap into the
        professional network of more than 100,000 Sigma Gamma Rho members.
      </p>
      <div class="ca-hero__actions">
        <a class="btn" href={ICHQ_URL} target="_blank" rel="noopener">
          View Open ICHQ Positions <span aria-hidden="true">&#8599;</span>
        </a>
        <a class="btn btn--outline" href={BOARD_URL} target="_blank" rel="noopener">
          Explore the Job Board <span aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="ca-collage" aria-label="Sisterhood in action">
    <div class="container ca-collage__grid">
      {photos.map((p) => (
        <figure>
          <img src={withBase(p.img)} alt={p.alt} width="600" height="400" loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
  </section>

  <section class="ca-tracks">
    <div class="container ca-tracks__grid">
      {tracks.map((t) => (
        <article class="ca-track">
          <p class="ca-kicker">{t.kicker}</p>
          <h2>{t.title}</h2>
          <span class="ca-badge">{t.badge}</span>
          <p>{t.body}</p>
          <ul>
            {t.points.map((pt) => <li>{pt}</li>)}
          </ul>
          <a class="btn" href={t.href} target="_blank" rel="noopener">
            {t.label} <span aria-hidden="true">&#8599;</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="ca-service">
    <div class="container ca-service__inner">
      <div>
        <h2>Seeking service leadership roles?</h2>
        <p>
          Committee assignments, regional appointments, and chapter advisor roles are volunteer
          service, coordinated through national and regional leadership.
        </p>
      </div>
      <a class="ca-service__link" href={withBase("/leadership/regional-leadership/")}>
        Explore Regional Leadership <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .ca-hero {
    background: var(--grad-royal);
    color: #fff;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .breadcrumb a {
    color: inherit;
  }
  .ca-hero h1 {
    margin: var(--space-2) 0 0;
    color: #fff;
  }
  .ca-hero h1 span {
    color: var(--gold);
  }
  .ca-hero__lead {
    max-width: 40rem;
    margin: var(--space-5) 0 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--text-lg);
  }
  .ca-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  /* One row of three photos at the same crop. */
  .ca-collage {
    background: var(--white);
    padding-block: var(--space-10) 0;
  }
  .ca-collage__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .ca-collage figure {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .ca-collage img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  @media (max-width: 640px) {
    .ca-collage__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .ca-collage figure:not(:first-child) {
      display: none;
    }
  }

  .ca-tracks {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .ca-tracks__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .ca-track {
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .ca-kicker {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ca-track h2 {
    margin: var(--space-2) 0 var(--space-3);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-h3);
    color: var(--royal);
  }
  .ca-badge {
    align-self: flex-start;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--gold);
    border-radius: 999px;
    color: var(--royal);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .ca-track > p:not(.ca-kicker) {
    margin: var(--space-5) 0 0;
    color: var(--muted);
  }
  .ca-track ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-5) 0 var(--space-8);
    padding: 0;
    list-style: none;
  }
  .ca-track li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--ink);
    font-size: var(--text-sm);
  }
  .ca-track li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 10px;
    height: 2px;
    background: var(--royal);
  }
  .ca-track .btn {
    margin-top: auto;
    align-self: flex-start;
  }
  @media (max-width: 860px) {
    .ca-tracks__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 480px) {
    .ca-track {
      padding: var(--space-5);
    }
  }

  .ca-service {
    background: var(--cream);
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }
  .ca-service__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5) var(--space-10);
  }
  .ca-service h2 {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--ink);
  }
  .ca-service p {
    margin: var(--space-2) 0 0;
    max-width: 40rem;
    color: var(--muted);
  }
  .ca-service__link {
    color: var(--royal);
    font-weight: 700;
  }
</style>
