---
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/url.js";

const hazingList = [
  "Physical abuse, forced physical activity, or deprivation of sleep, food, or hygiene.",
  "Demeaning, humiliating, or degrading verbal or written treatment.",
  "Coerced consumption of any substance, or pressure to violate the law.",
  "Forced servitude, financial exploitation, or excessive personal-line demands.",
  "Any activity that a reasonable person would recognize as creating a risk of harm.",
];
---

<Base
  title="Anti-Hazing Policy"
  activeTop="Resources"
  description="Sigma Gamma Rho's zero-tolerance anti-hazing policy — definitions, expectations, reporting, and consequences."
>
  <section class="ah-hero">
    <div class="container">
      <p class="breadcrumb">
        <a href={withBase("/")}>Home</a> <span>/</span>{" "}
        <a href={withBase("/resources/vendor/")}>Resources</a> <span>/</span>{" "}
        <span>Anti-Hazing Policy</span>
      </p>
      <p class="eyebrow">Resources • Policy</p>
      <h1>
        Zero Tolerance.
        <br />
        <span>No Exceptions.</span>
      </h1>
      <p>
        Membership in Sigma Gamma Rho Sorority, Incorporated is grounded in dignity, sisterhood, and
        accountability — never in hazing.
      </p>
    </div>
  </section>

  <section class="ah-main">
    <div class="container ah-layout">
      <nav class="ah-toc" aria-label="On this page">
        <p class="ah-toc__label">On This Page</p>
        <a href="#policy-statement">1. Policy Statement</a>
        <a href="#definition">2. What Counts as Hazing</a>
        <a href="#expectations">3. Member Expectations</a>
        <a href="#reporting">4. Reporting a Concern</a>
        <a href="#consequences">5. Consequences</a>
        <div class="ah-toc__cta">
          <p>Need to report something now?</p>
          <a href={withBase("/contact/")}>Contact Headquarters &rarr;</a>
        </div>
      </nav>

      <div class="ah-copy">
        <section class="ah-block" id="policy-statement">
          <span class="ah-index">01</span>
          <h2>Policy Statement</h2>
          <p>
            Sigma Gamma Rho Sorority, Incorporated maintains a strict zero-tolerance policy toward
            hazing in any form, at every level of the organization — undergraduate and alumnae
            chapters, regional activities, and national programming alike. This standard applies
            regardless of a candidate or member's consent, and regardless of tradition, precedent,
            or intent.
          </p>
          <p>
            Every prospective and initiated member is entitled to a process rooted in respect,
            transparency, and safety. Chapters and members found in violation of this policy are
            subject to disciplinary action up to and including suspension, expulsion, and chapter
            charter revocation.
          </p>
        </section>

        <section class="ah-block" id="definition">
          <span class="ah-index">02</span>
          <h2>What Counts as Hazing</h2>
          <p>
            Hazing is any action taken or situation created, intentionally or unintentionally,
            whether on or off Sorority premises, to produce mental or physical discomfort,
            embarrassment, harassment, or ridicule as a condition of affiliation — regardless of the
            individual's willingness to participate. This includes, but is not limited to:
          </p>
          <ul>
            {hazingList.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </section>

        <section class="ah-block" id="expectations">
          <span class="ah-index">03</span>
          <h2>Member Expectations</h2>
          <p>
            Every member — from Basileus to newly initiated Soror — shares responsibility for
            upholding this policy. Members are expected to intervene when safe to do so, decline to
            participate in any activity that resembles hazing, and report concerns promptly and in
            good faith, without fear of retaliation.
          </p>
        </section>

        <section class="ah-block" id="reporting">
          <span class="ah-index">04</span>
          <h2>Reporting a Concern</h2>
          <p>
            Concerns may be reported confidentially to a chapter's advisor, a Regional Director, or
            directly to International Corporate Headquarters. Reports are reviewed promptly by the
            appropriate governance and legal channels of the Sorority.
          </p>
          <div class="ah-callout">
            <strong>To report a concern:</strong>
            <span>
              Contact the Help Center or reach International Corporate Headquarters directly.
            </span>
            <div class="ah-callout__actions">
              <a class="btn" href={withBase("/resources/help-center/")}>
                Visit Help Center
              </a>
              <a class="btn btn--outline" href={withBase("/contact/")}>
                Contact Headquarters
              </a>
            </div>
          </div>
        </section>

        <section class="ah-block" id="consequences">
          <span class="ah-index">05</span>
          <h2>Consequences</h2>
          <p>
            Violations are addressed through the Sorority's established disciplinary process and may
            result in individual or chapter-level sanctions, up to and including expulsion from
            membership or revocation of a chapter's charter. Sigma Gamma Rho cooperates fully with
            applicable campus, local, and state anti-hazing laws and reporting requirements.
          </p>
        </section>
      </div>
    </div>
  </section>
</Base>

<style>
  .ah-hero {
    background: var(--cream);
    padding-block: clamp(3rem, 6vw, 4rem);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    color: var(--muted-2);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .breadcrumb a {
    color: inherit;
  }
  .ah-hero h1 {
    max-width: 600px;
    margin: var(--space-2) 0 0;
  }
  .ah-hero > .container > p:last-child {
    max-width: 540px;
    margin: var(--space-5) 0 0;
    color: var(--muted);
  }

  .ah-main {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .ah-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.35fr) minmax(0, 1fr);
    gap: var(--space-14);
    align-items: start;
  }
  .ah-toc {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .ah-toc__label {
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin: 0;
  }
  .ah-toc a {
    color: var(--royal);
    font-weight: 700;
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .ah-toc a:hover {
    color: var(--gold-dark);
  }
  .ah-toc__cta {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .ah-toc__cta p {
    color: var(--muted);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-2);
  }
  .ah-toc__cta a {
    color: var(--gold-dark);
  }

  .ah-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .ah-block {
    scroll-margin-top: 100px;
  }
  .ah-index {
    display: inline-block;
    font-family: var(--font-label);
    color: var(--gold);
    font-size: var(--text-md);
    margin-bottom: var(--space-2);
  }
  .ah-block h2 {
    margin: 0 0 var(--space-4);
  }
  .ah-block > p {
    color: var(--muted);
  }
  .ah-block ul {
    margin: var(--space-4) 0 0;
    padding-left: 1.2rem;
    color: var(--muted);
    display: grid;
    gap: var(--space-2);
  }

  .ah-callout {
    margin-top: var(--space-8);
    padding: var(--space-6);
    background: var(--tint);
    border-radius: var(--radius-lg);
  }
  .ah-callout strong {
    display: block;
    color: var(--royal);
    margin-bottom: var(--space-2);
  }
  .ah-callout span {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .ah-callout__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  @media (max-width: 860px) {
    .ah-layout {
      grid-template-columns: 1fr;
    }
    .ah-toc {
      position: static;
    }
  }
</style>
