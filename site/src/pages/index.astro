<script
  is:inline
  define:vars={{
    PROGRAMS: programs.map((p) => ({
      title: p.title,
      statement: p.statement,
      href: withBase(p.href),
      img: withBase(p.img),
      imgFit: p.imgFit ?? "cover",
      alt: `${p.title} program photo`,
    })),
  }}
>
  // National-programs spotlight selector. All five programs are equally
  // clickable; this swaps which one is shown large, so the spotlight reads
  // as "currently selected," not "the one that outranks the other four."
  // Falls back to the real anchor links with no JS.
  (function () {
    const nav = document.querySelector("[data-program-index]");
    const spotlight = document.getElementById("program-spotlight");
    if (!nav || !spotlight) return;

    const img = spotlight.querySelector(".program-spotlight__figure img");
    const eyebrow = spotlight.querySelector(".program-spotlight__eyebrow");
    const statement = spotlight.querySelector(".program-spotlight__statement");
    const link = spotlight.querySelector(".arrow-link");
    const rows = Array.prototype.slice.call(nav.querySelectorAll(".program-index__row"));

    rows.forEach(function (row) {
      row.addEventListener("click", function () {
        const i = Number(row.dataset.index);
        const p = PROGRAMS[i];
        if (!p) return;

        rows.forEach(function (r) {
          r.classList.remove("is-active");
          r.removeAttribute("aria-current");
        });
        row.classList.add("is-active");
        row.setAttribute("aria-current", "true");

        img.src = p.img;
        img.alt = p.alt;
        img.style.objectFit = p.imgFit;
        eyebrow.textContent = p.title;
        statement.textContent = p.statement;
        link.href = p.href;
        link.textContent = "";
        link.append("Explore " + p.title + " ");
        const arrow = document.createElement("span");
        arrow.setAttribute("aria-hidden", "true");
        arrow.textContent = "→";
        link.append(arrow);
      });
    });
  })();
</script>

<script>
  // Partner carousel — native scroll does the real work (touch, trackpad,
  // wheel); the buttons just nudge it by roughly one view's width.
  document.querySelectorAll("[data-partner-carousel]").forEach((carousel) => {
    const track = carousel.querySelector(".partner-carousel__track");
    if (!track) return;
    carousel.querySelectorAll(".partner-carousel__btn").forEach((btn) => {
      const dir = btn.classList.contains("partner-carousel__btn--prev") ? -1 : 1;
      btn.addEventListener("click", () => {
        track.scrollBy({ left: dir * track.clientWidth * 0.8, behavior: "smooth" });
      });
    });
  });
</script>

