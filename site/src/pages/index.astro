      ))}
    </div>
  </nav>
</Base>

<script>
  // Partner carousel — native scroll does the real work (touch, trackpad,
  // wheel); the buttons just nudge it by roughly one view's width.
  document.querySelectorAll("[data-partner-carousel]").forEach((carousel) => {
    const track = carousel.querySelector(".partner-carousel__track");
    if (!track) return;
    carousel.querySelectorAll(".partner-carousel__btn").forEach((btn) => {
      const dir = btn.classList.contains("partner-carousel__btn--prev") ? -1 : 1;
      btn.addEventListener("click", () => {
        track.scrollBy({ left: dir * track.clientWidth * 0.8, behavior: "smooth" });
      });
    });
  });
</script>

