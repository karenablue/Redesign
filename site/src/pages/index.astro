    line-height: 1.2;
    color: var(--royal);
  }
  .program-row__name {
    margin: 0 0 var(--space-4);
    color: var(--royal);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .program-row__summary {
    margin: 0 0 var(--space-5);
    color: var(--muted);
    font-size: var(--text-base);
  }
  .program-row__go {
    display: flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--space-4);
    min-height: 44px;
    margin-top: auto;
    color: var(--royal);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
  }
  .program-row__go:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 0.2em;
  }
  .program-row__arrow {
    display: grid;
    flex: none;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--gold);
    border-radius: 50%;
  }
  .program-row__go:hover .program-row__arrow {
    background: var(--gold);
    color: var(--navy);
  }
  @media (max-width: 700px) {
    .program-row h3 {
      min-height: 0;
    }
  }

  /* The legacy spread: the heading beside the story, then two then-and-now
     pairs divided by a gold seam (concept B). */
  .legacy__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-6) var(--space-16);
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .legacy__title {
    font-size: clamp(2.25rem, 1.5rem + 2.4vw, 3.5rem);
    margin-bottom: 0;
  }
  .legacy__intro > p {
    margin: 0;
    color: var(--muted);
    max-width: 36rem;
    font-size: var(--text-base);
  }
  .legacy__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }
  .legacy__links .arrow-link {
    white-space: normal;
  }
  @media (max-width: 900px) {
    .legacy__head {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
  }

  /* The signature 1922: the year as a picture, filled with the seven
     Founders in royal. Sized to the column (cqi), so it spans it exactly. */
  .legacy > .container {
    container-type: inline-size;
  }
  .legacy__signature {
    margin: 0 0 clamp(2rem, 4vw, 3.5rem);
  }
  .legacy__signature figcaption {
    max-width: 46rem;
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--gold);
    color: var(--muted);
    font-size: var(--text-xs);
    line-height: 1.6;
  }
  .legacy__year {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(6rem, 26vw, 22rem);
    font-size: 46cqi;
    line-height: 0.8;
    letter-spacing: -0.03em;
    white-space: nowrap;
    color: var(--royal);
  }
  @supports ((background-clip: text) or (-webkit-background-clip: text)) {
    .legacy__year {
      background: var(--year-fill) center 30% / cover, var(--royal);
      background-blend-mode: multiply;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }

  /* The three aims as a band of display type; the Greek letters in gold,
     which is allowed on navy. */
  .aims {
    overflow: hidden;
    padding-block: clamp(1.25rem, 2.5vw, 2rem);
    background: var(--navy);
    color: #fff;
  }
  .aims__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .aims__set {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-right: clamp(1.25rem, 3vw, 2.5rem);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.2rem + 4.5vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #fff;
  }
  .aims__mark {
    font-family: var(--font-greek);
    font-size: 0.72em;
    color: var(--gold);
  }

  /* At a glance: a data sheet, not cards. Each fact sits under a thin gold
     rule on the cream band, as on Herstory's Key Facts. */
  .glance {
    padding-block: clamp(3rem, 2rem + 3vw, 4.5rem);
  }
  .glance__title {
    margin-bottom: var(--space-8);
  }
  .glance__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-8) clamp(1.5rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .glance__grid li {
    padding-top: var(--space-4);
    border-top: 1px solid var(--gold);
  }
  .glance__label {
    margin: 0 0 var(--space-2);
    color: var(--accent-text);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .glance__fact {
    margin: 0;
    color: var(--royal);
    font-family: var(--font-editorial);
    font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.6rem);
    font-weight: 600;
    line-height: 1.25;
  }
  /* The colours themselves, beside their names. */
  .glance__swatches {
    display: flex;
    margin: var(--space-1) 0 var(--space-3);
  }
  .glance__swatch {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--cream);
  }
  .glance__swatch + .glance__swatch {
    margin-left: -8px;
  }
  .glance__swatch--royal {
    background: var(--royal);
  }
  .glance__swatch--gold {
    background: var(--gold);
  }
  .glance__keep {
    white-space: nowrap;
  }
  .glance__body {
    margin: var(--space-3) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  @media (max-width: 1000px) {
    .glance__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 540px) {
    .glance__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .chapter-callout {
    position: relative;
    overflow: hidden;
    background: var(--navy);
    color: var(--white);
    padding-block: var(--section-y);
  }
  /* The pair photograph from HQ's site sits behind the call-out; the navy
     gradient keeps the words on a solid ground. */
  .chapter-callout__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 30%;
  }
  .chapter-callout::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(8, 22, 51, 0.97) 0%, rgba(8, 22, 51, 0.88) 50%, rgba(8, 22, 51, 0.35) 100%);
  }
  .chapter-callout__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.6fr);
    align-items: end;
    gap: clamp(var(--space-10), 8vw, var(--space-24));
  }
  .chapter-callout__story {
    max-width: 50rem;
  }
  .chapter-callout .eyebrow {
    margin-bottom: var(--space-6);
    color: var(--white);
  }
  .chapter-callout h2 {
    margin: 0 0 var(--space-6);
    color: var(--white);
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 2rem + 3vw, 5rem);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.04em;
  }
  .chapter-callout__story > p:not(.eyebrow) {
    max-width: 38rem;
    margin: 0 0 var(--space-8);
    color: var(--text-on-dark-soft);
    font-size: var(--text-md);
  }
  .chapter-callout__next {
    border-top: 2px solid var(--gold);
    padding-top: var(--space-5);
  }
  .chapter-callout__next > p {
    margin: 0 0 var(--space-5);
    color: var(--white);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .chapter-callout__next a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 72px;
    border-top: 1px solid var(--line-dark);
    color: var(--white);
    font-size: var(--text-base);
    font-weight: 700;
    text-decoration: none;
  }
  /* Gold text on royal is 4.44:1; hover marks the link with a gold rule. */
  .chapter-callout__next a:hover {
    color: var(--white);
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 4px;
  }
  .chapter-callout__next a span:last-child {
    color: var(--gold);
    font-size: var(--text-xl);
  }
  @media (max-width: 900px) {
    .chapter-callout__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-12);
    }
    .chapter-callout__next {
      max-width: 38rem;
    }
  }
  @media (max-width: 600px) {
    .chapter-callout h2 {
      font-size: clamp(2.5rem, 9vw, 3.75rem);
    }
    .chapter-callout__story .btn {
      width: 100%;
      justify-content: center;
      white-space: normal;
    }
  }

  .dispatch__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }
  .dispatch__head > p {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-base);
  }
  .dispatch__title {
    font-size: var(--text-h2);
    margin-bottom: 0;
  }
  .dispatch__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--space-10);
    align-items: start;
  }
  .dispatch__label {
    margin: 0 0 var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--royal);
  }
  /* The lead story opens on a wide photograph, the headline beneath it. */
  .news-lead {
    display: grid;
    gap: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--line);
  }
  .news-lead img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: 50% 40%;
  }
  .news-lead__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .news-tag {
    padding: var(--space-1) var(--space-2);
    background: var(--gold);
    color: var(--navy);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .news-lead h4 {
    margin: 0 0 var(--space-4);
    font-family: var(--font-editorial);
    font-size: clamp(1.5rem, 1.2rem + 0.6vw, 2rem);
    font-weight: 600;
    color: var(--royal);
    line-height: 1.25;
  }
  .news-lead__copy > p:not(.news-lead__meta) {
    font-size: var(--text-sm);
    color: var(--muted);
    margin: 0 0 var(--space-4);
  }
  .news-lead__go {
    display: inline-flex;
    gap: var(--space-4);
    align-items: center;
    min-height: 44px;
    color: var(--royal);
    font-size: var(--text-sm);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }
  .news-rows,
  .event-rows {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
  }
  .news-rows li {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--line);
  }
  .news-rows li > div {
    min-width: 0;
  }
  .news-rows img {
    flex: none;
    width: 96px;
    height: 72px;
    object-fit: cover;
  }
  .news-meta {
    margin: 0 0 var(--space-1);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .news-rows a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--royal);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;
  }
  .news-rows a:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold);
  }
  .events {
    background: var(--navy);
    padding: var(--space-8);
    border-top: 4px solid var(--gold);
  }
  .events .eyebrow {
    margin-bottom: var(--space-3);
  }
  .events .dispatch__label {
    color: var(--white);
    font-family: var(--font-editorial);
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
  }
  .event-rows li {
    border-bottom: 1px solid var(--line-dark);
  }
  .event-rows__link {
    display: flex;
    color: var(--white);
    gap: var(--space-4);
    align-items: center;
    padding-block: var(--space-5);
    text-decoration: none;
  }
  .event-rows__link:hover .event-rows__meta strong {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 0.2em;
  }
  .date-tile {
    flex: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 64px;
    min-height: 72px;
    padding: var(--space-2);
    background: var(--white);
    color: var(--navy);
    text-align: center;
  }
  .date-tile > span {
    color: var(--royal);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.4;
  }
  .date-tile strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: 1.2;
  }
  .event-rows__meta {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .event-rows__meta strong {
    color: var(--white);
    font-size: var(--text-base);
    line-height: 1.4;
  }
  .event-rows__meta > span {
    color: var(--white);
    font-size: var(--text-xs);
  }
  .event-rows__go {
    flex: none;
    color: var(--gold);
  }
  .events > .arrow-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--gold);
    border-bottom-color: var(--gold);
    white-space: normal;
  }
  @media (max-width: 900px) {
    .dispatch__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 420px) {
    .events {
      padding: var(--space-5);
    }
    .event-rows__link {
      gap: var(--space-3);
    }
    .news-rows img {
      width: 72px;
      height: 64px;
    }
  }

  /* Partnership — full-bleed institutional statement, real logos as white
     chips (source assets aren't consistent — e.g. Amazon's PNG has an
     opaque background baked in with no transparency — so a white card
     behind each logo's natural colors is more robust than a forced-white
     filter). */
  /* Strengthened, not shrunk — "Greater Together" reads as brand
     positioning rather than a donation ask, so it earns more room than
     "Invest in Transformational Change" did. */
  .partnership {
    background: var(--navy);
    text-align: center;
    padding-block: var(--section-y);
  }
  .partnership__inner {
    max-width: 820px;
  }
  .partnership__pitch {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-16);
    text-align: left;
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--line-dark);
  }
  .partnership__title {
    margin: 0;
    font-family: var(--font-editorial);
    font-weight: 600;
    color: var(--white);
    font-size: clamp(2.25rem, 1.5rem + 2.5vw, 3.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .partnership__invitation > p {
    color: var(--white);
    font-size: var(--text-base);
    max-width: 34rem;
  }
  .partnership__invitation .btn {
    color: var(--navy);
  }
  .partnership__invitation .btn:hover {
    background: var(--royal);
    color: var(--white);
  }
  .partnership__learn {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    margin-top: var(--space-3);
    color: var(--white);
    font-size: var(--text-sm);
    text-underline-offset: 0.25em;
  }
  .partner-showcase {
    margin-block: var(--space-10) var(--space-12);
    text-align: left;
  }
  .partner-showcase__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .partner-showcase__head > p {
    color: var(--white);
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: var(--text-base);
    margin: 0;
  }
  .partner-showcase__label {
    margin: 0 0 var(--space-5);
    color: var(--white);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .partner-showcase__head .partner-showcase__label {
    margin: 0;
  }
  .partner-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-8);
    list-style: none;
    background: var(--white);
    border-top: 4px solid var(--gold);
  }
  @media (min-width: 1000px) {
    .partner-grid {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }
  }
  .partner-grid a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 148px;
    height: 100%;
    padding: var(--space-5);
    text-decoration: none;
  }
  .partner-grid a:hover {
    background: var(--tint);
  }
  .partner-grid img {
    width: 100%;
    max-width: 160px;
    height: 72px;
    object-fit: contain;
  }
  .partner-name {
    margin-top: var(--space-4);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: 1.4;
    text-align: center;
  }
  @media (max-width: 900px) {
    .partnership__pitch {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }
  }
  .foundation-showcase {
    margin-top: var(--space-12);
    padding-top: var(--space-10);
    border-top: 1px solid var(--line-dark);
  }
  .foundation-showcase__intro {
    margin-bottom: var(--space-8);
  }
  .foundation-showcase__title {
    margin: 0 0 var(--space-3);
    color: var(--white);
    font-family: var(--font-editorial);
    font-weight: 600;
    font-size: var(--text-h2);
    line-height: 1.2;
  }
  .foundation-showcase__intro > p:not(.eyebrow) {
    color: var(--white);
    font-size: var(--text-base);
    margin: 0;
  }
  .foundation-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .foundation-grid a {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-8);
    height: 100%;
    background: var(--white);
    color: var(--royal);
    border-top: 4px solid var(--gold);
    text-decoration: none;
  }
  .foundation-grid a:hover {
    background: var(--bright-white);
  }
  .foundation-grid a:hover .foundation-go {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 0.25em;
  }
  .foundation-logo {
    display: grid;
    place-items: center;
    padding-block: var(--space-5);
  }
  .foundation-logo img {
    width: 100%;
    max-width: 180px;
    height: 150px;
    object-fit: contain;
  }
  .foundation-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .foundation-focus {
    color: var(--royal);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .foundation-name {
    color: var(--royal);
    font-family: var(--font-editorial);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: 1.2;
  }
  .foundation-summary {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.65;
