    </p>
    <p class="impact-since">Since 2020, we have:</p>
    <div class="impact-cards">
      {since2020.map((s) => (
        <div class="impact-card">
          <span class="impact-card__icon" aria-hidden="true">
            <svg viewBox={s.icon.viewBox} fill="currentColor" fill-rule="evenodd">
              <path d={s.icon.path} />
            </svg>
