</Base>

<script>
  // "Our Sisters Speak" carousel — one story at a time, prev/next + dots.
  document.querySelectorAll<HTMLElement>("[data-vspeak]").forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>(".vspeak__slide"));
    const dotsWrap = root.querySelector<HTMLElement>(".vspeak__dots");
    const prev = root.querySelector<HTMLButtonElement>(".vspeak__nav--prev");
    const next = root.querySelector<HTMLButtonElement>(".vspeak__nav--next");
    if (slides.length < 2 || !dotsWrap) return;

    let index = 0;
    const dots = slides.map((_, i) => {
      const dot = document.createElement("button");
      dot.type = "button";
      dot.className = "vspeak__dot";
      dot.setAttribute("aria-label", `Story ${i + 1}`);
      dot.addEventListener("click", () => show(i));
      dotsWrap.appendChild(dot);
      return dot;
    });

    function show(i: number) {
      index = (i + slides.length) % slides.length;
      slides.forEach((s, si) => s.classList.toggle("is-active", si === index));
      dots.forEach((d, di) => d.classList.toggle("is-active", di === index));
    }

    prev?.addEventListener("click", () => show(index - 1));
    next?.addEventListener("click", () => show(index + 1));
    show(0);
  });
</script>

<style>
  /* shared bits used by scoped sections */
  /* h2's base LEMON MILK / royal treatment already comes from global.css;
     this class only adds the zero margin and the gold-highlight span. */
  .feature-title {
    margin: 0;
  }
  .feature-title span {
    color: var(--gold);
  }
  .feature-title--light {
    color: #fff;
  }
  .feature-title--light span {
    color: var(--gold);
  }
  .eyebrow--rule::after {
    content: "";
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--gold);
    margin-top: var(--space-4);
  }
  .center-link {
    margin: clamp(2.5rem, 4vw, 3.5rem) 0 0;
    text-align: center;
  }
  .center-link a,
  .arrow-link {
    color: var(--royal);
    font-weight: 700;
    font-size: var(--text-base);
    text-decoration: none;
    border-bottom: 2px solid rgba(32, 65, 165, 0.25);
    padding-bottom: 4px;
    white-space: nowrap;
  }
  .center-link a:hover,
  .arrow-link:hover {
    border-color: var(--gold);
  }
  .gold {
    color: var(--gold);
  }

  /* 1. HERO — full-bleed video with just the CTA row */
  .home-hero {
    position: relative;
    min-height: clamp(560px, 90vh, 940px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--navy);
    color: #fff;
    text-align: center;
  }
  .home-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
  }
  .home-hero__scrim {
    position: absolute;
    inset: 0;
    /* light dark wash for CTA legibility over a sharp video */
    background: linear-gradient(
      to top,
      rgba(8, 22, 51, 0.62) 0%,
      rgba(8, 22, 51, 0.18) 45%,
      rgba(8, 22, 51, 0) 100%
    );
  }
  .home-hero__inner {
    position: relative;
    z-index: 2;
    margin-inline: auto;
    padding-block: 0 clamp(2.5rem, 7vw, 4rem);
    max-width: 62rem;
  }
  .home-hero__actions {
    display: flex;
    gap: var(--space-5);
    justify-content: center;
    flex-wrap: wrap;
  }
  .home-hero__actions :global(.btn) {
    padding: 1.05em 2.6em;
  }

  /* 2. WHO ARE WE */
  .waw__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .waw__figure {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .waw__figure img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    display: block;
  }
  .waw__figure figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2.5rem 1.25rem 1.1rem;
    display: flex;
    flex-direction: column;
    color: #fff;
    background: linear-gradient(0deg, rgba(8, 22, 51, 0.9), transparent);
  }
  .waw__year {
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1;
  }
  .waw__place {
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }
  .waw__copy > p {
    color: var(--ink);
  }
  .waw__sub {
    color: var(--royal);
    font-weight: 700;
    margin: 0.35rem 0 1rem;
  }
  .waw__pillars {
    display: flex;
    gap: clamp(1rem, 4vw, 3rem);
    justify-content: space-between;
    list-style: none;
    padding: 1.5rem 0 0;
    margin: 1.5rem 0 0;
  }
  .waw__pillars li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--royal);
    position: relative;
    flex: 1;
  }
  /* Rule from this circle's centre to the next one; the circles' solid fill
     masks the overlap so it reads as edge-to-edge. */
  .waw__pillars li:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 18px;
    left: 50%;
    width: calc(100% + clamp(1rem, 4vw, 3rem));
    height: 1px;
    background: var(--gold);
    opacity: 0.55;
    z-index: 0;
  }
  .waw__sigma {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--gold);
    border-radius: 50%;
    background: var(--white);
    color: var(--gold);
    font-size: 1rem;
  }
  @media (max-width: 820px) {
    .waw__grid {
      grid-template-columns: 1fr;
    }
    .waw__figure {
      max-width: 420px;
    }
  }

  /* 3. MOTTO */
  .motto__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  .motto__grid > div:last-child {
    border-left: 1px solid var(--line);
