    margin: 0;
    text-align: right;
    line-height: 1.8;
  }
  .legacy__figure {
    margin: 0;
    padding: var(--space-3);
    border: 1px solid var(--line);
    background: var(--white);
    transform: rotate(-2deg);
  }
  .legacy__figure img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .legacy__figure figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .legacy__figure figcaption span {
    color: var(--royal);
    font-weight: 700;
  }
  .legacy__title {
    font-size: clamp(2.25rem, 1.5rem + 3vw, 4rem);
    max-width: 12ch;
  }
  .legacy__copy > p:not(.eyebrow) {
    color: var(--muted);
    max-width: 36rem;
    font-size: var(--text-base);
  }
  .legacy__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }
  .legacy__links .arrow-link {
    white-space: normal;
  }
  .legacy__pillars {
    grid-column: 1 / -1;
    margin-top: var(--space-6);
    padding-block: var(--space-8);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .legacy__pillars :global(.pillar) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3) var(--space-5);
    align-items: start;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    text-align: left;
  }
  .legacy__pillars :global(.pillar__mark) {
    display: grid;
    grid-row: 1 / span 2;
    width: 48px;
    height: auto;
    margin: 0;
    padding-top: var(--space-2);
    border: 0;
    border-top: 3px solid var(--gold);
    border-radius: 0;
    font-family: var(--font-greek);
    font-weight: 400;
    font-size: 3rem;
    color: var(--royal);
  }
  .legacy__pillars :global(.pillar__label) {
    margin: 0;
    font-size: var(--text-base);
    letter-spacing: 0.08em;
  }
  .legacy__pillars :global(.pillar__body) {
    grid-column: 2;
  }
  @media (max-width: 900px) {
    .legacy__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }
    .legacy__title {
      max-width: 18ch;
    }
  }
  @media (max-width: 600px) {
    .legacy__dateline {
      align-items: start;
      flex-direction: column;
    }
    .legacy__dateline .eyebrow {
      text-align: left;
    }
    .legacy__figure {
      transform: none;
    }
  }

  .chapter-callout {
    position: relative;
    overflow: hidden;
    background: var(--royal);
    color: var(--white);
    padding-block: var(--section-y);
  }
  .chapter-callout__mark {
    position: absolute;
    right: -0.08em;
    bottom: -0.24em;
    color: color-mix(in srgb, var(--white) 8%, transparent);
    font-family: var(--font-greek);
    font-size: clamp(14rem, 32vw, 36rem);
    line-height: 1;
    pointer-events: none;
  }
  .chapter-callout__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.6fr);
    align-items: end;
    gap: clamp(var(--space-10), 8vw, var(--space-24));
  }
  .chapter-callout__story {
    max-width: 50rem;
  }
  .chapter-callout .eyebrow {
    margin-bottom: var(--space-6);
    color: var(--white);
  }
  .chapter-callout h2 {
    margin: 0 0 var(--space-6);
    color: var(--white);
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 2rem + 3vw, 5rem);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.04em;
  }
  .chapter-callout h2 em {
    display: block;
    color: var(--gold);
    font-family: var(--font-editorial);
    font-weight: 400;
    letter-spacing: -0.03em;
  }
  .chapter-callout__story > p:not(.eyebrow) {
    max-width: 38rem;
    margin: 0 0 var(--space-8);
    color: var(--text-on-dark-soft);
    font-size: var(--text-md);
  }
  .chapter-callout__next {
    border-top: 2px solid var(--gold);
    padding-top: var(--space-5);
  }
  .chapter-callout__next > p {
    margin: 0 0 var(--space-5);
    color: var(--white);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .chapter-callout__next a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 72px;
    border-top: 1px solid var(--line-dark);
    color: var(--white);
    font-size: var(--text-base);
    font-weight: 700;
    text-decoration: none;
  }
  /* Gold text on royal is 4.44:1; hover marks the link with a gold rule. */
  .chapter-callout__next a:hover {
    color: var(--white);
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 4px;
  }
  .chapter-callout__next a span:last-child {
    color: var(--gold);
    font-size: var(--text-xl);
  }
  @media (max-width: 900px) {
    .chapter-callout__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-12);
    }
    .chapter-callout__next {
      max-width: 38rem;
    }
  }
  @media (max-width: 600px) {
    .chapter-callout h2 {
      font-size: clamp(2.5rem, 9vw, 3.75rem);
    }
    .chapter-callout__story .btn {
      width: 100%;
      justify-content: center;
      white-space: normal;
    }
  }

  .dispatch__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-6);
    padding-top: var(--space-8);
    margin-bottom: var(--space-10);
    border-top: 1px solid var(--gold);
  }
  .dispatch__head > p {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-base);
  }
  .dispatch__title {
    font-size: var(--text-h2);
    margin-bottom: 0;
  }
  .dispatch__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--space-10);
    align-items: start;
  }
  .dispatch__label {
    margin: 0 0 var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--royal);
  }
  .news-lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--line);
  }
  .news-lead img {
    width: 100%;
    height: 100%;
    min-height: 300px;
    object-fit: cover;
    object-position: center;
  }
  .news-lead__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .news-tag {
    padding: var(--space-1) var(--space-2);
    background: var(--gold);
    color: var(--navy);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .news-lead h4 {
    margin: 0 0 var(--space-4);
    font-family: var(--font-editorial);
    font-size: clamp(1.5rem, 1.2rem + 0.6vw, 2rem);
    font-weight: 600;
    color: var(--royal);
    line-height: 1.25;
  }
  .news-lead__copy > p:not(.news-lead__meta) {
    font-size: var(--text-sm);
    color: var(--muted);
    margin: 0 0 var(--space-4);
  }
  .news-lead__go {
    display: inline-flex;
    gap: var(--space-4);
    align-items: center;
    min-height: 44px;
    color: var(--royal);
    font-size: var(--text-sm);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }
  .news-rows,
  .event-rows {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
  }
  .news-rows li {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--line);
  }
  .news-rows li > div {
    min-width: 0;
  }
  .news-rows img {
    flex: none;
    width: 96px;
    height: 72px;
    object-fit: cover;
  }
  .news-meta {
    margin: 0 0 var(--space-1);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .news-rows a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--royal);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;
  }
  .news-rows a:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold);
  }
  .events {
    background: var(--navy);
    padding: var(--space-8);
    border-top: 4px solid var(--gold);
  }
  .events .eyebrow {
    margin-bottom: var(--space-3);
  }
  .events .dispatch__label {
    color: var(--white);
    font-family: var(--font-editorial);
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
  }
  .event-rows li {
    border-bottom: 1px solid var(--line-dark);
  }
  .event-rows__link {
    display: flex;
    color: var(--white);
    gap: var(--space-4);
    align-items: center;
    padding-block: var(--space-5);
    text-decoration: none;
  }
  .event-rows__link:hover .event-rows__meta strong {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 0.2em;
  }
  .date-tile {
    flex: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 64px;
    min-height: 72px;
    padding: var(--space-2);
    background: var(--white);
    color: var(--navy);
    text-align: center;
  }
  .date-tile > span {
    color: var(--royal);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.4;
  }
  .date-tile strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: 1.2;
  }
  .event-rows__meta {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .event-rows__meta strong {
    color: var(--white);
    font-size: var(--text-base);
    line-height: 1.4;
  }
  .event-rows__meta > span {
    color: var(--white);
    font-size: var(--text-xs);
  }
  .event-rows__go {
    flex: none;
    color: var(--gold);
  }
  .events > .arrow-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--gold);
    border-bottom-color: var(--gold);
    white-space: normal;
  }
  @media (max-width: 1100px) {
    .news-lead {
      grid-template-columns: minmax(0, 1fr);
    }
    .news-lead img {
      aspect-ratio: 16 / 9;
      min-height: 0;
      height: auto;
    }
  }
  @media (max-width: 900px) {
    .dispatch__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 420px) {
    .events {
      padding: var(--space-5);
    }
    .event-rows__link {
      gap: var(--space-3);
    }
    .news-rows img {
      width: 72px;
      height: 64px;
    }
  }

  /* Partnership — full-bleed institutional statement, real logos as white
     chips (source assets aren't consistent — e.g. Amazon's PNG has an
     opaque background baked in with no transparency — so a white card
     behind each logo's natural colors is more robust than a forced-white
     filter). */
  /* Strengthened, not shrunk — "Greater Together" reads as brand
     positioning rather than a donation ask, so it earns more room than
     "Invest in Transformational Change" did. */
  .partnership {
    background: var(--navy);
    text-align: center;
    padding-block: var(--section-y);
  }
  .partnership__inner {
    max-width: 820px;
  }
  .partnership__pitch {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-16);
    text-align: left;
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--line-dark);
  }
  .partnership__title {
    margin: 0;
    font-family: var(--font-editorial);
    font-weight: 600;
    color: var(--white);
    font-size: clamp(2.5rem, 1.5rem + 4vw, 4.75rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }
  .partnership__title em {
    color: var(--gold);
    font-weight: 400;
  }
  .partnership__invitation > p {
    color: var(--white);
    font-size: var(--text-base);
    max-width: 34rem;
  }
  .partnership__invitation .btn {
    color: var(--navy);
  }
  .partnership__invitation .btn:hover {
    background: var(--royal);
    color: var(--white);
  }
  .partnership__learn {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    margin-top: var(--space-3);
    color: var(--white);
    font-size: var(--text-sm);
    text-underline-offset: 0.25em;
  }
  .partner-showcase {
    margin-block: var(--space-10) var(--space-12);
    text-align: left;
  }
  .partner-showcase__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .partner-showcase__head > p {
    color: var(--white);
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: var(--text-base);
    margin: 0;
  }
  .partner-showcase__label {
    margin: 0 0 var(--space-5);
    color: var(--white);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .partner-showcase__head .partner-showcase__label {
    margin: 0;
  }
  .partner-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-8);
    list-style: none;
    background: var(--white);
    border-top: 4px solid var(--gold);
  }
  .partner-grid a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 148px;
    height: 100%;
    padding: var(--space-5);
    text-decoration: none;
  }
  .partner-grid a:hover {
    background: var(--tint);
  }
  .partner-grid img {
    width: 100%;
    max-width: 160px;
    height: 72px;
    object-fit: contain;
  }
  .partner-name {
    margin-top: var(--space-4);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: 1.4;
    text-align: center;
  }
  .collaboration-stories {
    margin-top: var(--space-10);
  }
  .collaboration-story {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-8);
    border-left: 3px solid var(--gold);
    background: var(--deep-blue);
  }
  .collaboration-story h3 {
    color: var(--white);
    font-family: var(--font-editorial);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: 1.25;
  }
  .collaboration-story h3 span {
    color: var(--gold);
  }
  .collaboration-story > p:not(.eyebrow) {
    font-size: var(--text-base);
    color: var(--white);
  }
  .collaboration-story a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    margin-top: auto;
    color: var(--gold);
    font-size: var(--text-sm);
    font-weight: 700;
    text-underline-offset: 0.25em;
  }
  @media (max-width: 900px) {
    .partnership__pitch {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }
  }
  .foundation-showcase {
    margin-top: var(--space-12);
    padding-top: var(--space-10);
    border-top: 1px solid var(--line-dark);
  }
  .foundation-showcase__intro {
    margin-bottom: var(--space-8);
  }
  .foundation-showcase__title {
    margin: 0 0 var(--space-3);
    color: var(--white);
    font-family: var(--font-editorial);
    font-weight: 600;
    font-size: var(--text-h2);
    line-height: 1.2;
  }
  .foundation-showcase__intro > p:not(.eyebrow) {
    color: var(--white);
    font-size: var(--text-base);
    margin: 0;
  }
  .foundation-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .foundation-grid a {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-8);
    height: 100%;
    background: var(--white);
    color: var(--royal);
    border-top: 4px solid var(--gold);
    text-decoration: none;
  }
  .foundation-grid a:hover {
    background: var(--bright-white);
  }
  .foundation-grid a:hover .foundation-go {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 0.25em;
  }
  .foundation-logo {
    display: grid;
    place-items: center;
    padding-block: var(--space-5);
  }
  .foundation-logo img {
    width: 100%;
    max-width: 180px;
    height: 150px;
    object-fit: contain;
  }
  .foundation-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .foundation-focus {
    color: var(--royal);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .foundation-name {
    color: var(--royal);
    font-family: var(--font-editorial);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: 1.2;
  }
  .foundation-summary {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }
  .foundation-go {
    display: inline-flex;
    gap: var(--space-3);
    align-items: center;
    min-height: 44px;
    color: var(--royal);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  @media (max-width: 600px) {
    .foundation-grid a {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-6);
      gap: var(--space-4);
    }
    .foundation-logo {
      justify-items: start;
    }
    .foundation-logo img {
      max-width: 140px;
      height: 120px;
    }
  }
  @media (max-width: 600px) {
    .partner-grid {
      grid-template-columns: repeat(auto-fit, minmax(min(120px, 100%), 1fr));
      padding: var(--space-3);
    }
    .foundation-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .partnership__action {
      white-space: normal;
    }
  }
  .partnership__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-bottom: clamp(3rem, 5vw, 4rem);
  }
  .arrow-link.partnership__action {
    color: var(--accent-text);
    border-bottom-color: var(--line-gold);
    font-size: var(--text-lg);
  }
  .arrow-link.partnership__action:hover {
    border-color: var(--white);
    color: var(--white);
  }
  .partnership__fineprint {
    max-width: 46rem;
    margin: 0 auto;
    color: var(--text-on-dark-muted);
    font-size: var(--text-xs);
  }
  .partnership__fineprint a {
    color: var(--text-on-dark-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .partnership__fineprint a:hover {
    color: var(--white);
  }

  /* A frosted button on the footage, for the secondary hero action. */
  :global(body.page-home .hero-glass) {
    background: var(--hero-glass);
    backdrop-filter: blur(6px);
  }

  .reach-band {
    background: radial-gradient(circle at 15% 0%, var(--hero-glow), transparent 42%), var(--navy);
    padding-block: var(--space-8);
  }
  :global(body.page-home .hero__title span) {
    display: block;
  }
  @media (max-width: 600px) {
    :global(body.page-home .hero__actions .btn) {
      flex: 1 1 100%;
      justify-content: center;
    }
