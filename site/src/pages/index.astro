---
/**
 * Home — composed as four acts, not nine checklist sections. The audience
 * strategy from the previous pass is kept (scale before history, outcomes
 * before program names, one flowing narrative about the women of Sigma,
 * clean routing at the end) — what changed is the composition: wider
 * editorial content, full-bleed photography, no card-grid "SaaS" pattern,
 * and acts that read as one visual thought instead of independent modules.
 *
 *   ACT I    THIS IS SIGMA      hero + scale fused into one opening — no
 *                                white "institutional" section breaking it.
 *   ACT II   THIS IS OUR WORK   a framed photo beside the statement, then
 *                                three signature programs as photo cards.
 *   ACT III  THIS IS WHO WE ARE contemporary sisterhood → 1922 founding →
 *                                the woman leading it now, one continuous
 *                                editorial flow, not three separate modules.
 *   ACT IV   SIGMA RIGHT NOW    a featured story beside the event list,
 *                                partnership, then a thin routing line.
 *
 * One stat ribbon only (Act I), showing scale and geographic reach. The
 * numbers count up when the band scrolls into view.
 */
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import StatBand from "../components/StatBand.astro";
import { withBase } from "../lib/url.js";
import { getCollection } from "astro:content";

// ACT I — organizational scale.
const reachStats = [
  { value: "1922", label: "Founded at Butler University" },
  {
    value: "100,000+",
    label: "Lifetime Members",
    icon: {
      viewBox: "0 0 24 24",
      path: "M12 12.75c1.63 0 3.07.39 4.24.9 1.08.48 1.76 1.56 1.76 2.73V18H6v-1.61c0-1.18.68-2.26 1.76-2.73 1.17-.52 2.61-.91 4.24-.91zM4 13c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm1.13 1.1c-.37-.06-.74-.1-1.13-.1-.99 0-1.93.21-2.78.58C.48 14.9 0 15.62 0 16.43V18h4.5v-1.61c0-.83.23-1.61.63-2.29zM20 13c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm4 3.43c0-.81-.48-1.53-1.22-1.85C21.93 14.21 20.99 14 20 14c-.39 0-.76.04-1.13.1.4.68.63 1.46.63 2.29V18H24v-1.57zM12 6c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3z",
    },
  },
  {
    value: "500+",
    label: "Collegiate & Alumnae Chapters",
    icon: {
      viewBox: "0 0 24 24",
      path: "M6.5 10h-2v7h2v-7zm6 0h-2v7h2v-7zm8.5 9H2v2h19v-2zm-2.5-9h-2v7h2v-7zm-7-6.74L16.71 6H6.29L11.5 3.26zm0-2.26L2 6v2h19V6l-9.5-5z",
    },
  },
  {
    value: "50",
    label: "U.S. States & Territories + 10 Countries",
    icon: {
      viewBox: "0 0 800.685 800.685",
      path: "M800.196,248.076c-0.079-0.108-0.205-0.206-0.318-0.311c-6.391-6.022-50.159-2.275-50.159-2.275s-0.271,0.932-0.969,2.275 c-1.485,2.859-4.936,7.608-11.979,9.373c-10.354,2.586-157.908,5.172-161.791-5.181c-0.653-1.75-1.818-3.104-3.258-4.192 c-7.063-5.335-21.334-3.572-21.334-3.572s-1.106,1.468-2.892,3.572c-4.027,4.749-11.538,12.752-17.817,14.545 c-7.013,2.005-8.585-6.84-7.745-14.545c0.245-2.247,0.688-4.405,1.271-6.16c1.812-5.438-15.428-24.205-29.918-33.632 c-6.192-4.025-11.893-6.361-15.382-5.198c-11.647,3.883-72.487-19.414-72.487-19.414H193.214H28.763c0,0-0.792,8.261-2.147,15.461 c-0.127,0.667-0.257,1.32-0.393,1.963c-0.638,3.021-1.376,5.687-2.207,7.188c-0.54,0.981-1.117,1.474-1.722,1.27 c-0.556-0.184-1.367-0.653-2.327-1.27c-5.751-3.691-17.458-13.335-19.68-7.79c-0.709,1.771-0.035,4.533,1.279,7.79 c3.495,8.65,11.664,20.935,11.664,28.452c0,1.654,0,5.685,0,11.34c0,6.453,0,15.019,0,24.615c0,12.354,0,26.394,0,39.79 c0,8.698,0,17.113,0,24.615c0,13.418,0,23.909,0,27.781c0,5.052,3.265,8.64,7.358,12.009c7.435,6.127,17.61,11.546,15.939,23.768 c-0.039,0.284-0.045,0.564-0.069,0.847c-1.217,14.422,16.472,29.532,28.742,39.79c3.649,3.051,6.822,5.676,8.865,7.719 c3.774,3.775,9.119,10.467,14.632,16.895c7.727,9.014,15.784,17.514,20.315,16.762c7.766-1.295,22.005-6.475,31.065,3.883 c7.56,8.643,42.152,17.273,59.413,19.146h9.94c9.832-1.316,35.456-4.867,50.457,0c5.52,1.793,9.604,4.719,10.919,9.326 c1.528,5.346,4.308,10.566,7.449,15.289c7.509,11.279,17.142,19.658,17.142,19.658s6.475-10.354,10.356-18.121 c0.297-0.596,0.687-1.104,1.138-1.537c2.18-2.104,6.041-2.312,10.43,0c6.632,3.496,14.46,12.76,19.498,30.016 c1.013,3.477,2.396,6.723,4.025,9.773c5.7,10.674,14.598,18.828,22.798,24.613c10.465,7.383,19.773,10.912,19.773,10.912 s0-4.547,0.083-10.912c0.093-7.191,0.291-16.697,0.714-24.613c0.139-2.613,0.302-5.062,0.495-7.188 c1.294-14.234,44.009-27.182,51.773-28.479c7.768-1.293,59.541,22.008,59.541,14.244c0-6.521,8.226-12.139,17.755-18.367 c1.82-1.189,3.681-2.396,5.547-3.641c4.116-2.748,9.204-0.309,14.114,3.641c8.995,7.219,17.404,19.5,18.24,14.484 c1.293-7.771,25.89-3.883,28.476,5.174c1.524,5.344,3.497,12.938,4.599,20.131c0.767,4.998,1.108,9.811,0.583,13.525 c-0.363,2.545,1.315,6.627,4.007,11.086c6.887,11.42,20.383,25.355,23.176,22.562c1.706-1.703,3.664-11.434,4.442-22.562 c0.583-8.346,0.49-17.475-0.86-24.611c-0.944-4.975-2.496-8.982-4.878-11.068c-4.604-4.029-8.18-15.992-9.829-28.721 c-1.108-8.602-1.342-17.529-0.407-24.619c0.791-6.014,2.42-10.693,5.061-12.674c4.068-3.051,18.512-14.281,33.693-27.113 c9.606-8.121,19.513-16.881,27.268-24.613c11.199-11.164,17.926-20.192,12.814-22.051c-8.366-3.045-9.562-8.799-8.615-17.739 c0.664-6.264,2.371-14.078,3.436-23.677c0.039-0.334,0.086-0.623,0.129-0.938c2.915-21.554,18.086,4.392,24.474-24.954 c1.341-6.175,4.817-11,9.393-14.836c17.461-14.656,51.124-14.71,44.966-18.813c-1.896-1.271-3.253-3.322-4.066-5.802 c-2.514-7.642,0.136-19.402,7.949-25.264c4.006-3.001,12.067-8.515,20.148-14.526C790.469,262.837,803.375,252.046,800.196,248.076z",
    },
  },
];

// ACT II — the three signature programs get photo cards; the other two
// national programs are named in a line beneath them.
const signature = [
  {
    title: "Operation BigBookBag®",
    descriptor: "Educational access & resources",
    statement: "Expanding access to educational resources for students and families.",
    href: "/service-impact/national-programs/#bigbookbag",
    img: "/images/operation-bigbookbag-4.jpg",
  },
  {
    title: "SWIM 1922®",
    descriptor: "Water safety & swim education",
    statement: "Every child deserves to feel safe in the water.",
    href: "/service-impact/national-programs/#swim",
    img: "/images/swim-1922-1-768x432.jpg",
  },
  {
    title: "Project CRADLE Care®",
    descriptor: "Maternal & infant health",
    statement: "Maternal and infant health shouldn't depend on your ZIP code.",
    href: "/service-impact/national-programs/#cradle",
    img: "/images/project-cradle-care-3.jpg",
  },
];
const morePrograms = [
  { title: "Annual Youth Symposium", href: "/service-impact/national-programs/#youth" },
  { title: "Women's Wellness Initiative", href: "/service-impact/national-programs/#wellness" },
];

// ACT III — the range of women who call Sigma Gamma Rho home.
const memberJourney = ["Collegiate Women", "Professionals", "Community Leaders", "Lifelong Members"];

// The next five events, read from the same collection the upcoming-events
// page renders, so this column cannot drift from it. It previously showed a
// single hardcoded entry. Four rows balance the featured story beside them.
const upcoming = (await getCollection("events"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4)
  .map((e) => e.data);

// ACT IV — the lead story from Latest News, which has its own page; the
// events beside it come from `upcoming` above.
const featuredStory = {
  tag: "Boulé",
  date: "July 2026",
  img: "/images/boule.jpg",
  title: "Tampa Welcomes Sigma Gamma Rho for the 61st International Biennial Boulé",
  body: "Thousands of members, partners, and guests gathered at the Tampa Convention Center, the first Sigma Gamma Rho international convention in Tampa since 1976.",
  href: "/news-events/latest-news/61st-biennial-boule/",
};

// All fourteen real, already-published corporate/nonprofit partners (from
// service-impact/corporate-partnerships) — not a curated subset. Each links
// out to the organization's own official site (verified via web search,
// not guessed) rather than an internal page.
const partnerLogos = [
  { name: "Alzheimer's Association", logo: "/images/Alzheimer's Association.svg", url: "https://www.alz.org/" },
  { name: "Amazon", logo: "/images/Amazon.png", url: "https://www.amazon.com/" },
  { name: "American Cancer Society", logo: "/images/American Cancer Society.svg", url: "https://www.cancer.org/" },
  { name: "Chase", logo: "/images/Chase.svg", url: "https://www.chase.com/" },
  { name: "Good Health WINs (NCNW)", logo: "/images/Good Health Wins.png", url: "https://legacy.ncnw.org/ncnw/ghwins" },
  { name: "Herff Jones", logo: "/images/Herff Jones.png", url: "https://www.herffjones.com/" },
  { name: "Hip Hop Sisters Network", logo: "/images/Hip Hop Sisters Network.png", url: "https://hiphopsisters.org/" },
  { name: "Kasper", logo: "/images/Kasper.png", url: "https://www.kasper.com/" },
  { name: "Macy's", logo: "/images/partner-logo-macys.png", url: "https://www.macys.com/" },
  { name: "NAACP", logo: "/images/NAACP.svg", url: "https://naacp.org/" },
  { name: "National Alliance on Mental Illness", logo: "/images/National Alliance on Mental Illness.webp", url: "https://www.nami.org/" },
  { name: "St. Jude Children's Research Hospital", logo: "/images/St. Jude Children's Research Hospital.svg", url: "https://www.stjude.org/" },
  { name: "USA Swimming", logo: "/images/USA Swimming.svg", url: "https://www.usaswimming.org/" },
  { name: "Western Governors University", logo: "/images/Western Governors University.svg", url: "https://www.wgu.edu/" },
];

// The closing routing line — no selling, no institutional story, just
// navigation, immediately before the footer.
const nextSteps = [
  { title: "Membership", href: "/membership/become-a-member/" },
  { title: "Find a Chapter", href: "/membership/chapter-locator/" },
  { title: "Our Impact", href: "/service-impact/national-programs/" },
  { title: "Events", href: "/news-events/upcoming-events/" },
];
---

<Base
  title="Home"
  description="Sigma Gamma Rho Sorority, Incorporated — a century of scholarship, sisterhood, leadership, and service. Greater Service, Greater Progress."
  bodyClass="page-home"
>
  <!-- ACT I: THIS IS SIGMA. One navy opener (Karena, 2026-09-17: no video,
       no second header), handing off to the navy StatBand. -->
  <Hero
    eyebrow="1922 — Today"
    title="Greater Service,"
    highlight="Greater Progress®"
    copy="For more than a century, women of Sigma Gamma Rho have led with scholarship, sisterhood, and service."
    size="regular"
  >
    <a class="btn btn--outline" href={withBase("/membership/become-a-member/#collegiate")}>
      Collegiate Intake <span aria-hidden="true">&rarr;</span>
    </a>
    <a class="btn btn--outline" href={withBase("/membership/become-a-member/#alumnae")}>
      Alumnae &amp; Graduate <span aria-hidden="true">&rarr;</span>
    </a>
    <a class="btn btn--outline" href={withBase("/membership/reactivate/")}>
      Reactivate &amp; Reclamation <span aria-hidden="true">&rarr;</span>
    </a>
  </Hero>
  <StatBand stats={reachStats} tone="navy" />

  <!-- ACT II: THIS IS OUR WORK — one visual thought: statement, a photograph
       that takes over the full width of the page, then outcomes as plain
       editorial numerals and columns — no card backgrounds. -->
  <section class="section act-work">
    <div class="container">
      <div class="act-work__intro">
        <div class="act-work__head">
          <p class="eyebrow">Greater Service</p>
          <h2 class="act-work__statement">
            Greater Service isn't just our slogan. <span>It's our work.</span>
          </h2>
          <p>
            Chapters in every region turn the Sorority's national programs into local action:
            books and supplies for students, swim lessons, maternal health outreach, and youth
            leadership.
          </p>
        </div>
        <figure class="act-work__photo">
          <img
            src={withBase("/images/youth-symposium-1-768x432.jpg")}
            alt="Sorors leading programming at the Annual Youth Symposium"
            width="768"
            height="432"
          />
        </figure>
      </div>

      <h3 class="act-work__programs-label">Our Signature Programs</h3>
      <ul class="program-cards">
        {signature.map((p) => (
          <li class="program-card">
            <img src={withBase(p.img)} alt="" width="600" height="400" loading="lazy" decoding="async" />
            <div class="program-card__body">
              <p class="program-card__descriptor">{p.descriptor}</p>
              <h4>
                <a href={withBase(p.href)}>{p.title}</a>
              </h4>
              <p>{p.statement}</p>
              <span class="program-card__go" aria-hidden="true">Learn more &rarr;</span>
            </div>
          </li>
        ))}
      </ul>
      <p class="program-more">
        Also:{" "}
        {morePrograms.map((m, i) => (
          <>
            <a href={withBase(m.href)}>{m.title}</a>
            {i < morePrograms.length - 1 && " · "}
          </>
        ))}
      </p>

      <p class="center-link">
        <a href={withBase("/service-impact/national-programs/")}>
          Explore All National Programs <span aria-hidden="true">&rarr;</span>
        </a>
      </p>
    </div>
  </section>

  <!-- ACT III: THIS IS WHO WE ARE — one continuous editorial flow rather than
       three separate modules: contemporary sisterhood → the 1922 founding →
       the woman leading it forward now. Same tone throughout, thin rules
       between beats instead of full section breaks. -->
  <section class="section act-women">
    <div class="container">
      <!-- Who We Are, immediately followed by a message from the Grand
           Basileus — origin first, then who leads it forward now, then who
           you could become. -->
      <div class="act-women__beat">
        <figure class="act-women__figure act-women__figure--archival" id="our-legacy">
          <img
            src={withBase("/images/sgr-alpha-charter.jpeg")}
            alt="Alpha Chapter charter members, 1922"
          />
          <figcaption>1922 &rarr; Today</figcaption>
        </figure>
        <div class="act-women__copy">
          <p class="eyebrow">Who We Are</p>
          <h2 class="act-women__statement">Seven educators. One radical idea.</h2>
          <p>
            Founded at Butler University in 1922, seven Black educators built a sorority on
            academic excellence, sisterhood, and civic courage — a foundation that still shapes
            every chapter today.
          </p>
          <a class="arrow-link" href={withBase("/about/herstory/")}>
            Discover Our Story <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <div class="act-women__beat act-women__beat--leadership act-women__beat--reverse">
        <figure class="act-women__figure act-women__figure--portrait">
          <img
            src={withBase("/images/international-grand-basileus-marica-harris-704x1024.jpg")}
            alt="International Grand Basileus Marica T. Harris"
          />
        </figure>
        <div class="act-women__copy">
          <p class="eyebrow">Leading Sigma Forward</p>
          <h2 class="act-women__statement">That vision continues today.</h2>
          <p class="act-women__quote">
            "Our founders' vision has been carried forward by women who lead with purpose and
            serve without limits."
          </p>
          <p class="act-women__sign">
            Marica T. Harris <span>&mdash; 26th International Grand Basileus</span>
          </p>
          <div class="act-women__links">
            <a class="arrow-link" href={withBase("/leadership/international-grand-basileus/")}>
              Meet Our Grand Basileus <span aria-hidden="true">&rarr;</span>
            </a>
            <a class="arrow-link" href={withBase("/leadership/international-board/")}>
              National Leadership <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <div class="act-women__beat">
        <figure class="act-women__figure">
          <img src={withBase("/images/ug sorors 6.jpg")} alt="Collegiate sorors of Sigma Gamma Rho" />
        </figure>
        <div class="act-women__copy">
          <p class="eyebrow">The Sigma Experience</p>
          <h2 class="act-women__statement">And it lives through every generation of Sigma women.</h2>
          <p>
            Join a network of women committed to learning, leading, serving, and helping one
            another progress.
          </p>
          <div class="act-women__journey" aria-label="Sigma Gamma Rho members, from collegiate to lifelong">
            {memberJourney.map((step, i) => (
              <>
                <span>{step}</span>
                {i < memberJourney.length - 1 && <span aria-hidden="true">&rarr;</span>}
              </>
            ))}
          </div>
          <div class="act-women__links">
            <a class="arrow-link" href={withBase("/membership/become-a-member/")}>
              Explore Membership <span aria-hidden="true">&rarr;</span>
            </a>
            <a class="arrow-link" href={withBase("/membership/chapter-locator/")}>
              Find a Chapter <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ACT IV: SIGMA RIGHT NOW — current activity, an institutional
       partnership statement, then a thin routing line instead of another
       full section. -->
  <section class="section act-now">
    <div class="container">
      <p class="eyebrow">Stay Connected</p>
      <h2 class="act-now__title">What's Happening</h2>

      <div class="happening">
        <article class="happening-feature">
          <figure class="happening-feature__figure">
            <img src={withBase(featuredStory.img)} alt="" width="1200" height="675" loading="lazy" decoding="async" />
          </figure>
          <p class="happening-feature__meta">
            {featuredStory.tag} &middot; {featuredStory.date}
          </p>
          <h3>
            <a href={withBase(featuredStory.href)}>{featuredStory.title}</a>
          </h3>
          <p>{featuredStory.body}</p>
          <span class="happening-feature__go" aria-hidden="true">Read the full story &rarr;</span>
        </article>

        <div class="happening-events">
          <h3 class="happening-events__label">Upcoming Events</h3>
          <ul class="upcoming-list">
            {upcoming.map((e) => (
              <li>
                <span class="date-tile" aria-hidden="true">
                  <span>{e.month}</span>
                  <strong>{e.day}</strong>
                </span>
                <span class="upcoming-list__text">
                  <a href={withBase("/news-events/upcoming-events/")}>
                    <span class="visually-hidden">{e.month} {e.day}: </span>{e.title}
                  </a>
                  <span>{e.location}</span>
                </span>
              </li>
            ))}
          </ul>
          <a class="arrow-link" href={withBase("/news-events/upcoming-events/")}>
            View the Full Calendar <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
      <p class="center-link">
        <a href={withBase("/news-events/latest-news/")}>
          Read Our Stories <span aria-hidden="true">&rarr;</span>
        </a>
      </p>
    </div>
  </section>

  <section class="section section--navy partnership">
    <div class="container partnership__inner">
      <h2 class="partnership__title">Greater Together.</h2>
      <p class="partnership__lead">
        We partner with organizations that share our commitment to education, health, economic
        opportunity, and stronger communities.
      </p>
    </div>

    <!-- All 14 real partners, each linking out to the org's own site — a
         scroll-snap carousel rather than a static row, so nothing gets
         cropped to fit and it reads as a real roster, not a curated five. -->
    <div class="container partner-carousel" data-partner-carousel>
      <button class="partner-carousel__btn partner-carousel__btn--prev" type="button" aria-label="Previous partners">
        &lsaquo;
      </button>
      <ul class="partner-carousel__track">
        {partnerLogos.map((p) => (
          <li>
            <a href={p.url} target="_blank" rel="noopener" aria-label={`${p.name} (opens in a new tab)`}>
              <img src={withBase(p.logo)} alt={p.name} loading="lazy" />
            </a>
          </li>
        ))}
      </ul>
      <button class="partner-carousel__btn partner-carousel__btn--next" type="button" aria-label="Next partners">
        &rsaquo;
      </button>
    </div>

    <div class="container partnership__inner">
      <div class="partnership__actions">
        <a class="arrow-link partnership__action" href={withBase("/service-impact/corporate-partnerships/")}>
          Partner With Sigma <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="arrow-link partnership__action" href={withBase("/service-impact/partner-foundations/")}>
          Support Our Work <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <p class="partnership__fineprint">
        Sigma Gamma Rho Sorority, Incorporated is a 501(c)(7). Tax-deductible contributions are
        directed through our 501(c)(3) foundation partners — the{" "}
        <a href={withBase("/service-impact/partner-foundations/#nef")}>National Education Fund</a>{" "}
        and <a href="https://www.spearfoundation.org/" target="_blank" rel="noopener">SPEAR Foundation</a>
        {" "}— to the extent allowed by law.
      </p>
    </div>
  </section>

  <!-- A thin routing line, not a full section — the four pathways from the
     previous "Where Will You Go Next?" pass, compressed to a single row. -->
  <nav class="next-line" aria-label="Where to go next">
    <div class="container next-line__inner">
      {nextSteps.map((s) => (
        <a href={withBase(s.href)}>
          {s.title} <span aria-hidden="true">&#8599;</span>
