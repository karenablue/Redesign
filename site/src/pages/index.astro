---
/**
 * Home — rebuilt to match the original index.html section for section, using
 * shared components where they fit and scoped markup for the bespoke bands.
 */
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import StatBand from "../components/StatBand.astro";
import Button from "../components/Button.astro";
import { withBase } from "../lib/url.js";

const stats = [
  { value: "500+", label: "Chapters Worldwide" },
  { value: "100,000+", label: "Members Strong" },
  { value: "103", label: "Years of Service" },
  { value: "50+", label: "States & Territories" },
];

const since2020 = [
  { icon: "clock", value: "2,145,830", label: "Hours of service performed globally" },
  { icon: "heart", value: "$7,450,200", label: "Donated to philanthropic initiatives" },
  { icon: "cap", value: "$3,125,500", label: "Awarded in academic scholarships" },
];

// The five national flagship programs — mirrors service-impact/national-programs.astro
// so the homepage and that page never drift. Each links to its section anchor.
const programs = [
  {
    title: "Project CRADLE Care®",
    body: "Advancing healthier maternal and infant outcomes through education, advocacy, and outreach.",
    href: "/service-impact/national-programs/#cradle",
  },
  {
    title: "SWIM 1922®",
    body: "Water safety, swimming access, and confidence in communities historically excluded from aquatic participation.",
    href: "/service-impact/national-programs/#swim",
  },
  {
    title: "Operation BigBookBag®",
    body: "Removing educational barriers by placing the tools students need directly into their hands.",
    href: "/service-impact/national-programs/#bigbookbag",
  },
  {
    title: "Annual Youth Symposium",
    body: "A nationwide day of hands-on programming designed to empower young people and strengthen their futures.",
    href: "/service-impact/national-programs/#youth",
  },
  {
    title: "Women's Wellness Initiative",
    body: "Supporting informed, empowered decisions about physical, mental, and emotional health.",
    href: "/service-impact/national-programs/#wellness",
  },
];

// "Find Your Home" — routes each audience straight to its intake path.
const findHome = [
  {
    label: "Collegiate",
    title: "Undergraduate Membership",
    body: "Campus leadership, academic excellence, and intake for enrolled students.",
    href: "/membership/become-a-member/",
  },
  {
    label: "Alumnae & Professional",
    title: "Graduate Membership",
    body: "Graduate intake, professional networking, and civic leadership for degree-holders.",
    href: "/membership/become-a-member/",
  },
  {
    label: "Reclamation",
    title: "Come Home to Sigma",
    body: "A direct, low-friction path for inactive Sorors to reactivate their membership.",
    href: "/membership/reactivate/",
  },
  {
    label: "Affiliates",
    title: "Rhoer Club & Philos",
    body: "Entry points for teen (Rhoer) and non-collegiate professional (Philo) affiliates.",
    href: "/membership/affiliates/",
  },
];

const motion = [
  {
    img: "/images/Beta Alpha.jpg",
    year: "2026",
    title: "National Convention",
    sub: "Boule Conference",
  },
  {
    img: "/images/project-cradle-care-3.jpg",
    year: "2026",
    title: "National Advocacy",
    sub: "Project Cradle Care",
  },
];

const voices = [
  {
    initials: "AJ",
    name: "Dr. Alicia K. Jackson",
    role: "Alumna, Educator & Civic Leader",
    quote:
      "Sigma Gamma Rho is not just an organization I joined in college; it is a lifelong commitment to sisterhood, scholarship, and service that continues to shape my personal and professional journey every single day.",
  },
  {
    initials: "MV",
    name: "Michelle R. Vance",
    role: "Life Member & Entrepreneur",
    quote:
      "The leadership training and mentorship I've received through our national programs gave me the confidence to excel in corporate spaces where Black women are often underrepresented. My sisters are my strongest network.",
  },
  {
    initials: "LB",
    name: "Lauren T. Banks",
    role: "Collegiate Member, Beta Chapter",
    quote:
      "From Operation BigBookBag to Swim 1922, seeing the direct, tangible impact we have on our communities fills me with immense pride. We are women of action, rooted in a century-long legacy of true progress.",
  },
];

const events = [
  {
    m: "AUG",
    d: "28",
    cat: "Leadership",
    title: "Fall Cluster Conferences Begin",
    loc: "Various Regional Locations",
  },
  {
    m: "SEP",
    d: "15",
    cat: "Community Service",
    title: "Annual Youth Symposium",
    loc: "National Virtual Event",
  },
  {
    m: "OCT",
    d: "04",
    cat: "Health & Wellness",
    title: "Project Reassurance: Swim 1922 Clinic",
    loc: "Atlanta, GA",
  },
];

const news = [
  {
    cat: "Membership",
    date: "July 31, 2026",
    title: "Sigma Gamma Rho Inducts 21 Honorary Members at 61st Biennial Boule",
    body: "The sorority proudly welcomed a historic class of 21 honorary members during its 61st Biennial Boule, celebrating visionary leaders in sports, entertainment, public service, and global advocacy.",
  },
  {
    cat: "Community Impact",
    date: "July 2026",
    title: "Sigma Gamma Rho Brings Service & Multi-Million Dollar Impact to Tampa",
    body: "The 61st Biennial Boule in Tampa left a lasting legacy through extensive community service initiatives, youth empowerment programs, and a significant economic impact on the local area.",
  },
];
---

<Base
  title="Home"
  description="Sigma Gamma Rho Sorority, Incorporated — a century of scholarship, sisterhood, leadership, and service. Greater Service, Greater Progress."
>
  <!-- 1. HERO — video, headline, two pill buttons (verified against the live Figma Make Hero.tsx) -->
  <section class="home-hero">
    <video
      class="home-hero__video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={withBase("/images/sgr-alpha-charter.jpeg")}
    >
      <source src={withBase("/images/sgrho video.mp4")} type="video/mp4" />
    </video>
    <div class="home-hero__scrim"></div>
    <div class="container home-hero__inner">
      {/* headline kept for SEO / a11y (one h1 per page) but not shown */}
      <h1 class="visually-hidden">
        Sigma Gamma Rho Sorority, Incorporated — Greater Service, Greater Progress
      </h1>
      <div class="home-hero__actions">
        <Button href="/membership/become-a-member/">Join Our Sisterhood</Button>
        <Button href="/service-impact/corporate-partnerships/" variant="ghost-light">
          Partner With Us
        </Button>
      </div>
    </div>
  </section>

  <!-- 2. WHO ARE WE -->
  <section class="section section--white waw">
    <div class="container waw__grid">
      <figure class="waw__figure">
        <img
          src={withBase("/images/sgr-alpha-charter.jpeg")}
          alt="Alpha Chapter charter members, 1922"
        />
        <figcaption>
          <span class="waw__year">1922</span>
          <span class="waw__place">Founded at Butler University · Indianapolis, Indiana</span>
        </figcaption>
      </figure>
      <div class="waw__copy">
        <p class="eyebrow eyebrow--rule">About Us</p>
        <h2 class="feature-title">
          Who <span>Are We?</span>
        </h2>
        <p class="waw__sub">A Legacy of Leadership &amp; Service</p>
        <p>
          On November 12, 1922, seven young Black educators founded{" "}
          <strong>Sigma Gamma Rho Sorority, Incorporated</strong> at Butler University in
          Indianapolis, Indiana.
        </p>
        <p>
          Establishing a sorority for Black women on a predominantly white campus during the height
          of racial segregation was a profound act of courage and vision. Our founders forged a
          sanctuary of intellectual rigor and mutual support, determined to advance educational
          opportunities and civil rights. That foundational commitment to{" "}
          <strong>academic excellence and community uplift</strong> remains the bedrock of our
          sisterhood today.
        </p>
        <p>
          Today, Sigma Gamma Rho&reg; advances that legacy through rigorous leadership development,
          targeted community investment, and global civic engagement — a shared responsibility to
          lead and create concrete change.
        </p>
        <ul class="waw__pillars">
          <li>
            <span class="waw__sigma">&Sigma;</span>Sisterhood
          </li>
          <li>
            <span class="waw__sigma">&Sigma;</span>Scholarship
          </li>
          <li>
            <span class="waw__sigma">&Sigma;</span>Service
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 2a. MESSAGE FROM THE GRAND BASILEUS -->
  <section class="section section--white basileus">
    <div class="container basileus__grid">
      <figure class="basileus__portrait">
        <img
          src={withBase("/images/international-grand-basileus-marica-harris-704x1024.jpg")}
          alt="International Grand Basileus Marica T. Harris"
          width="704"
          height="1024"
        />
      </figure>
      <div class="basileus__body">
        <p class="eyebrow">A Message From the Grand Basileus</p>
        <blockquote class="basileus__quote">
          <p>
            Welcome to the digital home of Sigma Gamma Rho Sorority, Incorporated. For more than a
            century, our founders' vision has been carried forward by women who lead with purpose
            and serve without limits.
          </p>
          <p>
            Whether you are exploring membership, partnering with us, or reconnecting with your
            chapter, I invite you to see the work our sisterhood does every day — and to join us in
            it.
          </p>
        </blockquote>
        <p class="basileus__sign">Marica T. Harris</p>
        <p class="basileus__role">26th International Grand Basileus</p>
        <p class="center-link basileus__link">
          <a href={withBase("/leadership/international-grand-basileus/")}>
            Read her full message <span aria-hidden="true">&rarr;</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- 2b. FIND YOUR HOME — audience routing engine -->
  <section class="section section--cream find-home">
    <div class="container">
      <div class="find-home__head">
        <p class="eyebrow">Find Your Home</p>
        <h2 class="feature-title">
          Four Ways to <span>Belong</span>
        </h2>
        <p>
          Whether you're on campus, established in your career, returning to the Sorority, or
          joining an affiliate, there's a direct path in.
        </p>
      </div>
      <div class="find-home__grid">
        {findHome.map((c) => (
          <a class="find-home__card" href={withBase(c.href)}>
            <span class="find-home__label">{c.label}</span>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
            <span class="find-home__go" aria-hidden="true">
              &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. MOTTO CALLOUT -->
  <section class="section section--white section--pad-tight motto">
    <div class="container motto__grid">
      <div>
        <p class="eyebrow">Our Motto Since 1925</p>
        <p class="motto__main">"Greater Service, Greater Progress"</p>
      </div>
      <div class="motto__aka">
        <p class="eyebrow">Also Known As</p>
        <p class="motto__main">"Greater Women, Greater World"</p>
      </div>
    </div>
  </section>

  <!-- 4. STAT BAND -->
  <StatBand stats={stats} tone="navy" />

  <!-- 5. NATIONAL PROGRAMS & IMPACT -->
  <Section tone="white" eyebrow="National Programs" title="Our" highlight="Global Impact">
    <p class="impact-lead">
      Our commitment to <strong>Greater Service, Greater Progress</strong> translates into direct,
      tangible action — five national programs addressing specific, critical needs in the
      communities we serve.
    </p>
    <p class="impact-since">Since 2020, we have:</p>
    <div class="impact-cards">
      {since2020.map((s) => (
        <div class="impact-card">
          <span class="impact-card__icon" aria-hidden="true"></span>
          <span class="impact-card__value">{s.value}</span>
          <span class="impact-card__label">{s.label}</span>
        </div>
      ))}
    </div>
    <div class="prog-grid">
      {programs.map((p) => (
        <a class="prog-card" href={withBase(p.href)}>
          <span class="prog-card__icon" aria-hidden="true"></span>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
          <span class="prog-card__go" aria-hidden="true">
            View program &rarr;
          </span>
        </a>
      ))}
    </div>
    <p class="center-link">
      <a href={withBase("/service-impact/national-programs/")}>
        Explore all National Programs <span aria-hidden="true">&rarr;</span>
      </a>
    </p>
  </Section>

  <!-- 7. FIND A CHAPTER -->
  <section class="section section--navy find">
    <div class="container find__inner">
      <span class="find__icon" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z" />
          <circle cx="12" cy="10" r="2.6" />
        </svg>
      </span>
      <h2 class="feature-title feature-title--light">
        Find a Chapter Near <span>You</span>
      </h2>
      <p>
        With over 500 chapters across the globe, there is a community of Sigma women waiting to
        welcome you. Enter your zip code or state to connect locally.
      </p>
      <form class="find__bar" role="search" onsubmit="return false">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="11" cy="11" r="7" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input
          type="search"
          placeholder="Search by Zip Code, City, or University&hellip;"
          aria-label="Search chapters"
        />
        <a class="btn find__btn" href={withBase("/membership/chapter-locator/")}>
          Browse Directory
        </a>
      </form>
    </div>
  </section>

  <!-- 8. BECOMING A MEMBER -->
  <section class="section section--navy section--round-b becoming">
    <div class="container becoming__grid">
      <div class="becoming__copy">
        <p class="eyebrow">✦ &nbsp; Join Our Sisterhood &nbsp; ✦</p>
        <h2 class="feature-title feature-title--light">
          Becoming a Member of Sigma Gamma Rho Sorority, Incorporated&reg; Is a Commitment
        </h2>
        <div class="gold-rule"></div>
        <p>
          A commitment to scholarship, uncompromising sisterhood, and the profound responsibility to
          advance our communities. We seek women who understand that our legacy—forged by seven
          Black educators in 1922—demands action, integrity, and lifelong dedication.
        </p>
        <p>
          We invite candidates who are prepared to invest their time, intellectual rigor, and
          leadership into tangible public service, with the academic standing and personal
          accountability that sustain it.
        </p>
        <p>
          Membership in Sigma Gamma Rho is an active pursuit of our founding mandate:{" "}
          <strong class="gold">Greater Service, Greater Progress.</strong>
        </p>
        <Button href="/membership/become-a-member/">Explore Membership</Button>
      </div>
      <figure class="becoming__figure">
        <span class="becoming__badge">Scholarship</span>
        <img src={withBase("/images/rho alpha sorors.jfif")} alt="Sigma Gamma Rho members" />
      </figure>
    </div>
  </section>

  <!-- 10. SISTERHOOD IN MOTION -->
  <Section
    tone="white"
    heading="feature"
    centered={false}
    eyebrow="Our Impact"
    title="Sisterhood in"
    highlight="Motion"
  >
    <div class="motion__head">
      <a class="btn btn--navy" href={withBase("/news-events/upcoming-events/")}>
        + Submit Chapter Event
      </a>
    </div>
    <div class="motion__grid">
      {motion.map((m) => (
        <figure class="motion__card">
          <span class="motion__year">{m.year}</span>
          <img src={withBase(m.img)} alt={m.title} />
          <figcaption>
            <strong>{m.title}</strong>
            <span>{m.sub}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </Section>

  <!-- 11. OUR SISTERS SPEAK -->
  <Section tone="white" eyebrow="Member Voices" title="Our Sisters" highlight="Speak">
    <div class="voices">
      {voices.map((v) => (
        <blockquote class="voice">
          <span class="voice__mark" aria-hidden="true">
            &ldquo;
          </span>
          <p class="voice__quote">{v.quote}</p>
          <footer>
            <span class="voice__avatar" aria-hidden="true">
              {v.initials}
            </span>
            <span class="voice__who">
              <strong>{v.name}</strong>
              <span>{v.role}</span>
            </span>
          </footer>
        </blockquote>
      ))}
    </div>
  </Section>

  <!-- 12. UPCOMING EVENTS -->
  <section class="section section--mist events">
    <div class="container">
      <div class="events__head">
        <div>
          <p class="eyebrow">Calendar</p>
          <h2 class="feature-title">
            Upcoming <span>Events</span>
          </h2>
        </div>
        <a class="arrow-link" href={withBase("/news-events/upcoming-events/")}>
          View full calendar <span aria-hidden="true">&rsaquo;</span>
        </a>
      </div>
      <div class="events__grid">
        {events.map((e) => (
          <article class="event">
            <span class="event__date">
              <span>{e.m}</span>
              <strong>{e.d}</strong>
            </span>
            <div class="event__body">
              <p class="event__cat">{e.cat}</p>
              <h3>{e.title}</h3>
              <p class="event__loc">
                <svg
                  viewBox="0 0 24 24"
                  width="13"
                  height="13"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z" />
                  <circle cx="12" cy="10" r="2.4" />
                </svg>
                {e.loc}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 13. LATEST NEWS -->
  <Section
    tone="white"
    heading="plain"
    centered={false}
    eyebrow="Updates & Events"
    title="Latest"
    highlight="News & Events"
  >
    <div class="news__head-link">
      <a class="arrow-link" href={withBase("/news-events/latest-news/")}>
        View all news <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
    <div class="news__grid">
      {news.map((n) => (
        <article class="news">
          <div class="news__img" aria-hidden="true"></div>
          <div class="news__body">
            <p class="news__meta">
              <span class="news__cat">{n.cat}</span> &bull; {n.date}
            </p>
            <h3>{n.title}</h3>
            <p>{n.body}</p>
            <a class="arrow-link" href={withBase("/news-events/latest-news/")}>
              Read the story <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
    <p class="center-link">
      <a href={withBase("/news-events/latest-news/")}>
        View all news &amp; events <span aria-hidden="true">&rsaquo;</span>
      </a>
    </p>
  </Section>

  <!-- 13b. FOUNDATION ARM — tax-deductible giving channel -->
  <section class="section section--navy foundation">
    <div class="container foundation__inner">
      <div class="foundation__copy">
        <p class="eyebrow">The Giving Channel</p>
        <h2 class="feature-title feature-title--light">
          Invest in <span>Transformational Change</span>
        </h2>
        <p>
          Sigma Gamma Rho Sorority, Incorporated is a 501(c)(7) organization and cannot receive
          tax-deductible public contributions directly. Charitable giving flows through the
          Sorority's 501(c)(3) foundation partners — the National Education Fund and the SPEAR
          Foundation — which fund scholarships, program delivery, and community grants.
        </p>
        <p class="foundation__note">
          Gifts to a 501(c)(3) foundation partner are tax-deductible to the extent allowed by law.
        </p>
        <div class="foundation__actions">
          <a class="btn" href={withBase("/service-impact/partner-foundations/")}>
            Give Through the Foundation
          </a>
          <a class="btn btn--outline" href={withBase("/service-impact/corporate-partnerships/")}>
            Corporate Grants & DAFs
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* shared bits used by scoped sections */
  /* h2's base LEMON MILK / royal treatment already comes from global.css;
     this class only adds the zero margin and the gold-highlight span. */
  .feature-title {
    margin: 0;
  }
  .feature-title span {
    color: var(--gold);
  }
  .feature-title--light {
    color: #fff;
  }
  .feature-title--light span {
    color: var(--gold);
  }
  .eyebrow--rule::after {
    content: "";
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--gold);
    margin-top: var(--space-4);
  }
  .center-link {
    margin: clamp(2.5rem, 4vw, 3.5rem) 0 0;
    text-align: center;
  }
  .center-link a,
  .arrow-link {
    color: var(--royal);
    font-weight: 700;
    font-size: var(--text-base);
    text-decoration: none;
    border-bottom: 2px solid rgba(32, 65, 165, 0.25);
    padding-bottom: 4px;
    white-space: nowrap;
  }
  .center-link a:hover,
  .arrow-link:hover {
    border-color: var(--gold);
  }
  .gold {
    color: var(--gold);
  }

  /* 1. HERO — full-bleed video with just the CTA row */
  .home-hero {
    position: relative;
    min-height: clamp(420px, 58vh, 620px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--navy);
    color: #fff;
    text-align: center;
  }
  .home-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
    /* PLACEHOLDER: the current /images/sgrho video.mp4 has an animated title
       sequence baked in. Blur is only here to keep that text from reading.
       When the text-free replacement clip lands: set filter: none, transform:
       none, and bump opacity toward 0.7. */
    filter: blur(5px) saturate(1.15);
    transform: scale(1.08);
  }
  .home-hero__scrim {
    position: absolute;
    inset: 0;
    /* dark lower band so the CTAs read; top stays video-visible */
    background: linear-gradient(
      to top,
      rgba(8, 22, 51, 0.85) 0%,
      rgba(8, 22, 51, 0.35) 45%,
      rgba(8, 22, 51, 0.08) 100%
    );
  }
  .home-hero__inner {
    position: relative;
    z-index: 2;
    margin-inline: auto;
    padding-block: 0 clamp(2.5rem, 7vw, 4rem);
    max-width: 62rem;
  }
  .home-hero__actions {
    display: flex;
    gap: var(--space-5);
    justify-content: center;
    flex-wrap: wrap;
  }
  .home-hero__actions :global(.btn) {
    padding: 1.05em 2.6em;
  }

  /* 2. WHO ARE WE */
  .waw__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .waw__figure {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .waw__figure img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    display: block;
  }
  .waw__figure figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2.5rem 1.25rem 1.1rem;
    display: flex;
    flex-direction: column;
    color: #fff;
    background: linear-gradient(0deg, rgba(8, 22, 51, 0.9), transparent);
  }
  .waw__year {
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1;
  }
  .waw__place {
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
