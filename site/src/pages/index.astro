---
/**
 * Home — mission, reach, heritage, programs, leadership, local connection,
 * news, partnerships, and member access. The hero carries the mission over
 * archival imagery; the closing navy section presents the partner network.
 * Between them, a Bright White canvas lets photography and type set the
 * rhythm (Karena, 2026-09-17).
 *
 * Copy is drawn from the site's own pages (Grand Basileus bio, National
 * Programs, Herstory, Latest News). The administration theme, "One Sigma",
 * leads the page (Karena, 2026-09-26); its wording and the quote come from
 * the Grand Basileus's Watch The Yard Q&A (2024). Replace both when the
 * next administration's theme is announced.
 *
 * Order speaks to members and the public first: the One Sigma message and
 * What's Happening come before heritage, programs and partnerships.
 */
import membersIcon from "../assets/stat-icons/members.svg?raw";
import chaptersIcon from "../assets/stat-icons/chapters.svg?raw";
import statesIcon from "../assets/stat-icons/states.svg?raw";
import countriesIcon from "../assets/stat-icons/countries.svg?raw";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import StatBand from "../components/StatBand.astro";
import PillarRail from "../components/PillarRail.astro";
import CardGrid from "../components/CardGrid.astro";
import ProgramLogo from "../components/ProgramLogo.astro";
import { withBase } from "../lib/url.js";
import { getCollection } from "astro:content";
import { storyMailto, formatStoryDate } from "../lib/stories";

const PORTAL_URL = "https://portal.sgrho1922.org/";

// Large two-tone icons over each figure, the peer pattern Karena asked for
// (AKA's stat cards): Phosphor duotone, royal line with a gold fill, no
// container. The cap for chapters nods to the founding educators.
const reachStats = [
  { value: "100,000+", label: "Lifetime Members", icon: { svg: membersIcon } },
  { value: "700+", label: "Collegiate & Alumnae Chapters", icon: { svg: chaptersIcon } },
  { value: "50+", label: "U.S. States & Territories", icon: { svg: statesIcon } },
  { value: "10", label: "Countries", icon: { svg: countriesIcon } },
];

// Signature programs. Scope lines restate National Programs.
const signature = [
  {
    tag: "Maternal Health",
    title: "Project CRADLE Care®",
    purpose: "Supporting Black maternal health",
    linkLabel: "Explore CRADLE Care",
    scope: "Connects families with maternal and infant health education, advocacy, and support.",
    href: "/service-impact/national-programs/#cradle",
    img: "/images/project-cradle-care-3.jpg",
  },
  {
    tag: "Aquatic Safety",
    title: "SWIM 1922®",
    purpose: "Teaching water safety",
    linkLabel: "Explore SWIM 1922",
    scope: "Brings water safety and swim instruction into local communities through USA Swimming.",
    href: "/service-impact/national-programs/#swim",
    img: "/images/swim-1922-1-768x432.jpg",
  },
  {
    tag: "Educational Equity",
    title: "Operation BigBookBag®",
    purpose: "Equipping students to learn",
    linkLabel: "Explore BigBookBag",
    scope:
      "Provides students with school supplies, books, and support through tutoring and mentoring.",
    href: "/service-impact/national-programs/#bigbookbag",
    img: "/images/operation-bigbookbag-4.jpg",
  },
  {
    tag: "Women's Health",
    title: "Women's Wellness Initiative",
    purpose: "Supporting women's well-being",
    linkLabel: "Explore Women's Wellness",
    scope: "Encourages informed decisions about physical, mental, and emotional health.",
    href: "/service-impact/national-programs/#wellness",
    isMark: true,
  },
  {
    tag: "Youth Empowerment",
    title: "Annual Youth Symposium",
    purpose: "Strengthening young futures",
    linkLabel: "Explore Youth Symposium",
    scope: "Engages young people in hands-on education, leadership development, and life skills.",
    href: "/service-impact/national-programs/#youth",
    img: "/images/youth-symposium-1-768x432.jpg",
  },
];

// Newsroom: the lead story (it has its own page) and the two latest
// items from the news collection; events from the events collection.
const featuredStory = {
  tag: "Convention",
  date: "July 2026",
  img: "/images/boule.jpg",
  title: "Tampa Welcomes Sigma Gamma Rho for the 61st International Biennial Boulé",
  body: "Thousands of members, partners, and guests gathered at the Tampa Convention Center, the first Sigma Gamma Rho international convention in Tampa since 1976.",
  href: "/news-events/latest-news/61st-biennial-boule/",
};
const recentNews = (await getCollection("news"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2)
  .map((e) => e.data)
  .map((d) => ({
    ...d,
    link: d.href
      ? {
          href: d.href.startsWith("http") ? d.href : withBase(d.href),
          ...(d.external ? { target: "_blank", rel: "noopener" } : {}),
        }
      : { href: withBase("/news-events/latest-news/") },
  }));
const upcoming = (await getCollection("events"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4)
  .map((e) => e.data);

// Partners: the fourteen on Corporate Partnerships plus the allied
// foundations. External logos open the partner's own site.
const partnerLogos = [
  {
    name: "Alzheimer's Association",
    logo: "/images/Alzheimer's Association.svg",
    url: "https://www.alz.org/",
  },
  { name: "Amazon", logo: "/images/Amazon.png", url: "https://www.amazon.com/" },
  {
    name: "American Cancer Society",
    logo: "/images/American Cancer Society.svg",
    url: "https://www.cancer.org/",
  },
  { name: "Chase", logo: "/images/Chase.svg", url: "https://www.chase.com/" },
  {
    name: "Good Health WINs (NCNW)",
    logo: "/images/Good Health Wins.png",
    url: "https://legacy.ncnw.org/ncnw/ghwins",
  },
  { name: "Herff Jones", logo: "/images/Herff Jones.png", url: "https://www.herffjones.com/" },
  {
    name: "Hip Hop Sisters Network",
    logo: "/images/Hip Hop Sisters Network.png",
    url: "https://hiphopsisters.org/",
  },
  { name: "Kasper", logo: "/images/Kasper.png", url: "https://www.kasper.com/" },
  { name: "Macy's", logo: "/images/partner-logo-macys.png", url: "https://www.macys.com/" },
  { name: "NAACP", logo: "/images/NAACP-dark.svg", url: "https://naacp.org/" },
  {
    name: "National Alliance on Mental Illness",
    logo: "/partners/nami.svg",
    url: "https://www.nami.org/",
  },
  {
    name: "St. Jude Children's Research Hospital",
    logo: "/images/St. Jude Children's Research Hospital.svg",
    url: "https://www.stjude.org/",
  },
  { name: "USA Swimming", logo: "/images/USA Swimming.svg", url: "https://www.usaswimming.org/" },
  {
    name: "Western Governors University",
    logo: "/images/Western Governors University.svg",
    url: "https://www.wgu.edu/",
  },
  {
    name: "National Education Fund",
    logo: "/images/foundations/nef.png",
    url: "/service-impact/partner-foundations/#nef",
    internal: true,
  },
  {
    name: "SPEAR Foundation",
    logo: "/images/foundations/spear.png",
    url: "/service-impact/partner-foundations/#spear",
    internal: true,
  },
];

// Chapter stories and member voices: only what HQ has published from
// submissions. With none yet, the section invites chapters to send one.
const chapterStories = (await getCollection("stories"))
  .map((s) => s.data)
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);
const memberVoice = (await getCollection("voices"))
  .map((v) => v.data)
  .sort((a, b) => (a.order ?? 999) - (b.order ?? 999) || b.consentDate.localeCompare(a.consentDate))[0];

// Summaries restate the foundation profiles already published on this site.
const foundationDetails: Record<string, { focus: string; summary: string }> = {
  "National Education Fund": {
    focus: "Education & Opportunity",
    summary:
      "Expanding educational opportunity through scholarships, leadership development, and community education.",
  },
  "SPEAR Foundation": {
    focus: "Research & Community Support",
    summary:
      "Advancing community progress through public education, advocacy, research, and support for vulnerable families.",
  },
};
---

<Base
  title="Home"
  description="Sigma Gamma Rho Sorority, Incorporated — a century of scholarship, sisterhood, leadership, and service. Greater Service, Greater Progress."
  bodyClass="page-home"
  preloadImage="/optimized/sgr-alpha-charter.webp"
>
  <!-- The hero carries the message directly over the moving image. -->
  <Hero
    cinematic
    video="/images/sgrho-hero.mp4"
    image="/optimized/sgr-alpha-charter.webp"
    eyebrow="One Sigma · Since 1922"
    title="Seven founders."
    highlight="A century of greater service."
    copy="From maternal health and water safety to educational opportunity, Sigma Gamma Rho puts sisterhood to work in communities across the country and beyond."
    size="tall"
    align="left"
    watermark="ΣΓΡ"
  >
    <a class="btn" href={withBase("/service-impact/national-programs/")}>
      Explore Our Impact <span aria-hidden="true">&rarr;</span>
    </a>
    <a class="btn btn--outline" href={PORTAL_URL} target="_blank" rel="noopener">
      Member Login <span aria-hidden="true">&#8599;</span>
      <span class="visually-hidden"> (opens the Poodle Portal in a new tab)</span>
    </a>
  </Hero>

  <section class="reach-band on-dark">
    <StatBand stats={reachStats} tone="navy" />
  </section>

  <!-- The administration theme leads: One Sigma, in the Grand Basileus's words. -->
  <section class="section vision" id="grand-basileus" aria-labelledby="vision-title">
    <div class="container vision__grid">
      <figure class="vision__portrait">
        <span class="vision__edition" aria-hidden="true">
          XXVI
        </span>
        <img
          src={withBase("/images/international-grand-basileus-marica-harris-704x1024.jpg")}
          alt="International Grand Basileus Marica T. Harris"
          width="704"
          height="1024"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          Marica T. Harris <span>26th International Grand Basileus</span>
        </figcaption>
      </figure>
      <div class="vision__copy">
        <p class="eyebrow">Office of the Grand Basileus</p>
        <h2 class="vision__title" id="vision-title">
          One Sigma.
          <br />
          <em>Into the Next Century of Service</em>
        </h2>
        <blockquote class="vision__intro">
          <p>
            &ldquo;I will focus on strengthening our sisterhood in the spirit of &lsquo;One
            Sigma&rsquo;, the theme of unity across the board through the Sorority&rsquo;s
            administration.&rdquo;
          </p>
        </blockquote>
        <p>
          A life member elected at the 60th Biennial Boulé, Marica T. Harris brings more than 25
          years of nonprofit experience and a legacy of leadership across Sigma.
        </p>
        <div class="vision__signature">
          <strong>Marica T. Harris</strong>
          <span>26th International Grand Basileus</span>
        </div>
        <div class="vision__actions">
          <a class="btn" href={withBase("/leadership/international-grand-basileus/")}>
            Meet the Grand Basileus <span aria-hidden="true">&rarr;</span>
          </a>
          <a class="vision__link" href={withBase("/leadership/international-board/")}>
            International Board <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Members and the public first: news and the events agenda lead the page. -->
  <section class="section dispatch" id="whats-happening" aria-labelledby="dispatch-title">
    <div class="container">
      <div class="dispatch__head">
        <div>
          <p class="eyebrow">Stay Connected</p>
          <h2 class="dispatch__title" id="dispatch-title">
            What's Happening
          </h2>
        </div>
        <p>
          Stories from across Sigma.
          <br />
          Opportunities to come together.
        </p>
      </div>
      <div class="dispatch__grid">
        <div class="newsroom">
          <h3 class="dispatch__label">Official Newsroom</h3>
          <article class="news-lead">
            <img
              src={withBase(featuredStory.img)}
              alt=""
              width="1200"
              height="675"
              loading="lazy"
              decoding="async"
            />
            <div class="news-lead__copy">
              <p class="news-lead__meta">
                <span class="news-tag">{featuredStory.tag}</span>
                {featuredStory.date}
              </p>
              <h4>{featuredStory.title}</h4>
              <p>{featuredStory.body}</p>
              <a class="news-lead__go" href={withBase(featuredStory.href)}>
                Read the story <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
          <ul class="news-rows">
            {recentNews.map((n) => (
              <li>
                {n.image && (
                  <img
                    src={withBase(n.image)}
                    alt=""
                    width="120"
                    height="90"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div>
                  <p class="news-meta">{n.tag}</p>
                  <a {...n.link}>{n.title}</a>
                </div>
              </li>
            ))}
          </ul>
          <a class="arrow-link" href={withBase("/news-events/latest-news/")}>
            Visit the Newsroom <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="events on-dark">
          <p class="eyebrow">On the Calendar</p>
          <h3 class="dispatch__label">Events &amp; Gatherings</h3>
          <ul class="event-rows">
            {upcoming.map((e) => (
              <li>
                <a class="event-rows__link" href={withBase("/news-events/upcoming-events/")}>
                  <span class="date-tile" aria-hidden="true">
                    <span>{e.month}</span>
                    <strong>{e.day}</strong>
                  </span>
                  <span class="event-rows__meta">
                    <strong>{e.title}</strong>
                    <span>
                      <span class="visually-hidden">
                        {e.month} {e.day},{" "}
                      </span>
                      {e.location}
                    </span>
                  </span>
                  <span class="event-rows__go" aria-hidden="true">
                    &rarr;
                  </span>
                  <span class="visually-hidden"> — view event calendar</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="arrow-link" href={withBase("/news-events/upcoming-events/")}>
            Explore the Calendar <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Chapter stories and member voices: the national mission, close to home. -->
  <section class="section across" aria-labelledby="across-title">
    <div class="container">
      <div class="across__head">
        <div>
          <p class="eyebrow">One Sigma, Every Region</p>
          <h2 class="across__title" id="across-title">Chapter Stories</h2>
        </div>
        <a class="arrow-link" href={withBase("/news-events/chapter-stories/")}>
          All chapter stories <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      {chapterStories.length > 0 ? (
        <div class="across__grid">
          <ul class="across__stories">
            {chapterStories.map((s) => (
              <li>
                <p class="across__meta">{s.region}{s.program && <> &middot; {s.program}</>}</p>
                <h3>{s.title}</h3>
                <p class="across__byline">
                  {s.chapter} &middot; <time datetime={s.date}>{formatStoryDate(s.date)}</time>
                </p>
              </li>
            ))}
          </ul>
          {memberVoice && (
            <figure class="across__voice">
              <blockquote><p>&ldquo;{memberVoice.quote}&rdquo;</p></blockquote>
              <figcaption>
                <strong>{memberVoice.name}</strong>
                <span>{memberVoice.chapter} &middot; {memberVoice.region}</span>
              </figcaption>
            </figure>
          )}
        </div>
      ) : (
        <div class="across__invite">
          <p class="across__invite-lead">
            Your chapter&rsquo;s service belongs here.
          </p>
          <p>
            Book drives, swim lessons, health screenings, scholarships: tell headquarters what your
            chapter did, and it can be featured for sorors and neighbors across the country.
          </p>
          <div class="across__actions">
            <a class="btn" href={storyMailto}>Share a Chapter Story</a>
            <a class="arrow-link" href={withBase("/news-events/chapter-stories/#share")}>
              What to send <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Origin: where the work comes from. -->
  <section class="section legacy">
    <div class="container legacy__grid">
      <div class="legacy__dateline">
        <span class="legacy__year" aria-hidden="true">
          1924
        </span>
        <p class="eyebrow">
          Indianapolis, Indiana
          <br />
          1924
        </p>
      </div>
      <figure class="legacy__figure" id="our-legacy">
        <img
          src={withBase("/optimized/sgr-alpha-charter.webp")}
          alt="Alpha Chapter charter members, 1924"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <span>From the beginning</span> Alpha Chapter charter members, 1924
        </figcaption>
      </figure>
      <div class="legacy__copy">
        <p class="eyebrow">Living Legacy</p>
        <h2 class="legacy__title">Seven Educators. One Radical Idea.</h2>
        <p>
          In 1922, seven Black educators founded Sigma Gamma Rho at Butler University in
          Indianapolis, Indiana. They built a sorority on academic excellence, sisterhood, and
          civic courage, a foundation that still shapes every chapter today.
        </p>
        <div class="legacy__links">
          <a class="arrow-link" href={withBase("/about/herstory/")}>
            Discover Our Herstory <span aria-hidden="true">&rarr;</span>
          </a>
          <a class="arrow-link" href={withBase("/about/our-founders/")}>
            Meet the Founders <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <div class="legacy__pillars">
        <PillarRail />
      </div>
    </div>
  </section>

  <!-- The mission in motion. -->
  <section class="section work" id="national-programs" aria-labelledby="work-title">
    <div class="container">
      <div class="work__head on-dark">
        <p class="work__count">
          <strong>05</strong>
          <span>
            National
            <br />
            Programs
          </span>
        </p>
        <div class="work__intro">
          <p class="eyebrow">Our Work in Action</p>
          <h2 class="work__label" id="work-title">
            Greater Service,
            <em>Greater Progress®</em>
          </h2>
          <p>
            Five national programs, bringing the Sorority's mission into classrooms, clinics, and
            pools.
          </p>
          <a class="work__support" href={withBase("/service-impact/partner-foundations/")}>
            Explore Ways to Support <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
      <CardGrid as="ul" min="320px" cols={3}>
        {signature.map((x) => (
          <li class="program-row">
            <figure
              class:list={[
                "program-row__media",
                { "program-row__media--mark": "isMark" in x && x.isMark },
              ]}
            >
              {"isMark" in x && x.isMark ? (
                <ProgramLogo name="wellness" maxWidth={420} />
              ) : (
                <img
                  src={withBase(x.img)}
                  alt=""
                  width="960"
                  height="540"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <figcaption class="program-row__badge">{x.tag}</figcaption>
            </figure>
            <div class="program-row__copy">
              <h3>{x.purpose}</h3>
              <p class="program-row__name">{x.title}</p>
              <p class="program-row__summary">{x.scope}</p>
              <a class="program-row__go" href={withBase(x.href)}>
                {x.linkLabel}
                <span class="program-row__arrow" aria-hidden="true">
                  &rarr;
                </span>
              </a>
            </div>
          </li>
        ))}
      </CardGrid>

      <div class="work__invitation">
        <div>
          <p class="eyebrow">Carry the Work Forward</p>
          <h3>More opportunity.<br /><span class="editorial-accent">With your support.</span></h3>
          <p>Explore the foundations supporting education, leadership, and community service.</p>
        </div>
        <div class="work__actions">
          <a class="btn" href={withBase("/service-impact/partner-foundations/")}>Choose a Foundation to Support <span aria-hidden="true">&rarr;</span></a>
          <a href={withBase("/service-impact/national-programs/")}>Explore All National Programs <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- The chapter network is the bridge from national mission to local action. -->
  <section class="chapter-callout on-dark" aria-labelledby="chapter-callout-title">
    <span class="chapter-callout__mark" aria-hidden="true">
      ΣΓΡ
    </span>
    <div class="container chapter-callout__inner">
      <div class="chapter-callout__story">
        <p class="eyebrow">Across Five Regions and Beyond</p>
        <h2 id="chapter-callout-title">
          Find your chapter.
          <em>Carry the legacy forward.</em>
        </h2>
        <p>
          Connect with collegiate and alumnae chapters across our five regions and internationally.
        </p>
        <a class="btn" href={withBase("/membership/chapter-locator/")}>
          Open the Chapter Locator <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <div class="chapter-callout__next">
        <p>More Ways to Engage</p>
        <a href={withBase("/membership/become-a-member/")}>
          <span>Join the Sisterhood</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href={withBase("/membership/reactivate/")}>
          <span>Reactivate Membership</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Greater Together. -->
  <section
    class="section section--navy partnership on-dark"
    id="partnerships"
    aria-labelledby="partnership-title"
  >
    <div class="container partnership__pitch">
      <div>
        <p class="eyebrow">Partnerships with Purpose</p>
        <h2 class="partnership__title" id="partnership-title">
          Greater Together.
          <br />
          <em>Further, with you.</em>
        </h2>
      </div>
      <div class="partnership__invitation">
        <p>
          Bring your organization's expertise and resources together with Sigma's chapter-led
          service. Let's build a partnership that moves communities forward.
        </p>
        <a class="btn" href="https://forms.office.com/r/ruwe5VFBgr" target="_blank" rel="noopener">
          Start a Partnership <span aria-hidden="true">&#8599;</span>
          <span class="visually-hidden"> (opens in a new tab)</span>
        </a>
        <a class="partnership__learn" href={withBase("/service-impact/corporate-partnerships/")}>
          Explore collaboration opportunities <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <div class="container partner-showcase">
      <div class="partner-showcase__head">
        <h3 class="partner-showcase__label">Corporate &amp; Community Partners</h3>
        <p>Shared purpose. Meaningful connections.</p>
      </div>
      <ul class="partner-grid">
        {partnerLogos
          .filter((x) => !x.internal)
          .map((x) => (
            <li>
              <a
                href={x.url}
                target="_blank"
                rel="noopener"
                aria-label={`${x.name} (opens in a new tab)`}
              >
                <img src={withBase(x.logo)} alt={x.name} loading="lazy" />
                <span class="partner-name">{x.name}</span>
              </a>
            </li>
          ))}
      </ul>
      <div class="collaboration-stories">
        <CardGrid min="300px" cols={2}>
          <article class="collaboration-story">
            <p class="eyebrow">Water Safety &amp; Access</p>
            <h3>
              USA Swimming <span aria-hidden="true">&times;</span> SWIM 1922
            </h3>
            <p>
              Swimming professionals and Sigma chapters bring water safety education and
              learn-to-swim opportunities into local communities.
            </p>
            <a href={withBase("/service-impact/national-programs/#swim")}>
              See the program in action <span aria-hidden="true">&rarr;</span>
            </a>
          </article>
          <article class="collaboration-story">
            <p class="eyebrow">Financial Empowerment</p>
            <h3>
              Chase <span aria-hidden="true">&times;</span> Community Education
