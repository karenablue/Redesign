---
/**
 * Home — six sections (Karena's outline, 2026-09-17):
 *
 * A narrative arc, not a dashboard: identity, origin, impact, leadership,
 * then the ways in.
 *
 *   1  Hero: the slogan and mission over the full-bleed clip, with the reach
 *      ribbon docked on its bottom edge.
 *   2  Origin: the 1922 charter photograph and founding story.
 *   3  Our work in action: three signature program cards.
 *   4  Into the next century: the Grand Basileus, steward of that legacy.
 *   5  Ways in: chapters and intake, then newsroom beside upcoming events.
 *   6  Greater Together partner ribbon, then the Poodle Portal strip.
 *
 * Copy is drawn from the site's own pages (Grand Basileus bio, National
 * Programs, Herstory, Latest News); no administration theme is published,
 * so none is named.
 */
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import StatBand from "../components/StatBand.astro";
import { withBase } from "../lib/url.js";
import { getCollection } from "astro:content";

const PORTAL_URL = "https://portal.sgrho1922.org/";

// 1 — organizational scale and reach. Counts up on scroll.
const reachStats = [
  { value: "1922", label: "Founded at Butler University" },
  {
    value: "100,000+",
    label: "Lifetime Members",
    icon: {
      viewBox: "0 0 24 24",
      path: "M12 12.75c1.63 0 3.07.39 4.24.9 1.08.48 1.76 1.56 1.76 2.73V18H6v-1.61c0-1.18.68-2.26 1.76-2.73 1.17-.52 2.61-.91 4.24-.91zM4 13c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm1.13 1.1c-.37-.06-.74-.1-1.13-.1-.99 0-1.93.21-2.78.58C.48 14.9 0 15.62 0 16.43V18h4.5v-1.61c0-.83.23-1.61.63-2.29zM20 13c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm4 3.43c0-.81-.48-1.53-1.22-1.85C21.93 14.21 20.99 14 20 14c-.39 0-.76.04-1.13.1.4.68.63 1.46.63 2.29V18H24v-1.57zM12 6c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3z",
    },
  },
  {
    value: "500+",
    label: "Collegiate & Alumnae Chapters",
    icon: {
      viewBox: "0 0 24 24",
      path: "M6.5 10h-2v7h2v-7zm6 0h-2v7h2v-7zm8.5 9H2v2h19v-2zm-2.5-9h-2v7h2v-7zm-7-6.74L16.71 6H6.29L11.5 3.26zm0-2.26L2 6v2h19V6l-9.5-5z",
    },
  },
  {
    value: "50",
    label: "U.S. States & Territories + 10 Countries",
    icon: {
      viewBox: "0 0 800.685 800.685",
      path: "M800.196,248.076c-0.079-0.108-0.205-0.206-0.318-0.311c-6.391-6.022-50.159-2.275-50.159-2.275s-0.271,0.932-0.969,2.275 c-1.485,2.859-4.936,7.608-11.979,9.373c-10.354,2.586-157.908,5.172-161.791-5.181c-0.653-1.75-1.818-3.104-3.258-4.192 c-7.063-5.335-21.334-3.572-21.334-3.572s-1.106,1.468-2.892,3.572c-4.027,4.749-11.538,12.752-17.817,14.545 c-7.013,2.005-8.585-6.84-7.745-14.545c0.245-2.247,0.688-4.405,1.271-6.16c1.812-5.438-15.428-24.205-29.918-33.632 c-6.192-4.025-11.893-6.361-15.382-5.198c-11.647,3.883-72.487-19.414-72.487-19.414H193.214H28.763c0,0-0.792,8.261-2.147,15.461 c-0.127,0.667-0.257,1.32-0.393,1.963c-0.638,3.021-1.376,5.687-2.207,7.188c-0.54,0.981-1.117,1.474-1.722,1.27 c-0.556-0.184-1.367-0.653-2.327-1.27c-5.751-3.691-17.458-13.335-19.68-7.79c-0.709,1.771-0.035,4.533,1.279,7.79 c3.495,8.65,11.664,20.935,11.664,28.452c0,1.654,0,5.685,0,11.34c0,6.453,0,15.019,0,24.615c0,12.354,0,26.394,0,39.79 c0,8.698,0,17.113,0,24.615c0,13.418,0,23.909,0,27.781c0,5.052,3.265,8.64,7.358,12.009c7.435,6.127,17.61,11.546,15.939,23.768 c-0.039,0.284-0.045,0.564-0.069,0.847c-1.217,14.422,16.472,29.532,28.742,39.79c3.649,3.051,6.822,5.676,8.865,7.719 c3.774,3.775,9.119,10.467,14.632,16.895c7.727,9.014,15.784,17.514,20.315,16.762c7.766-1.295,22.005-6.475,31.065,3.883 c7.56,8.643,42.152,17.273,59.413,19.146h9.94c9.832-1.316,35.456-4.867,50.457,0c5.52,1.793,9.604,4.719,10.919,9.326 c1.528,5.346,4.308,10.566,7.449,15.289c7.509,11.279,17.142,19.658,17.142,19.658s6.475-10.354,10.356-18.121 c0.297-0.596,0.687-1.104,1.138-1.537c2.18-2.104,6.041-2.312,10.43,0c6.632,3.496,14.46,12.76,19.498,30.016 c1.013,3.477,2.396,6.723,4.025,9.773c5.7,10.674,14.598,18.828,22.798,24.613c10.465,7.383,19.773,10.912,19.773,10.912 s0-4.547,0.083-10.912c0.093-7.191,0.291-16.697,0.714-24.613c0.139-2.613,0.302-5.062,0.495-7.188 c1.294-14.234,44.009-27.182,51.773-28.479c7.768-1.293,59.541,22.008,59.541,14.244c0-6.521,8.226-12.139,17.755-18.367 c1.82-1.189,3.681-2.396,5.547-3.641c4.116-2.748,9.204-0.309,14.114,3.641c8.995,7.219,17.404,19.5,18.24,14.484 c1.293-7.771,25.89-3.883,28.476,5.174c1.524,5.344,3.497,12.938,4.599,20.131c0.767,4.998,1.108,9.811,0.583,13.525 c-0.363,2.545,1.315,6.627,4.007,11.086c6.887,11.42,20.383,25.355,23.176,22.562c1.706-1.703,3.664-11.434,4.442-22.562 c0.583-8.346,0.49-17.475-0.86-24.611c-0.944-4.975-2.496-8.982-4.878-11.068c-4.604-4.029-8.18-15.992-9.829-28.721 c-1.108-8.602-1.342-17.529-0.407-24.619c0.791-6.014,2.42-10.693,5.061-12.674c4.068-3.051,18.512-14.281,33.693-27.113 c9.606-8.121,19.513-16.881,27.268-24.613c11.199-11.164,17.926-20.192,12.814-22.051c-8.366-3.045-9.562-8.799-8.615-17.739 c0.664-6.264,2.371-14.078,3.436-23.677c0.039-0.334,0.086-0.623,0.129-0.938c2.915-21.554,18.086,4.392,24.474-24.954 c1.341-6.175,4.817-11,9.393-14.836c17.461-14.656,51.124-14.71,44.966-18.813c-1.896-1.271-3.253-3.322-4.066-5.802 c-2.514-7.642,0.136-19.402,7.949-25.264c4.006-3.001,12.067-8.515,20.148-14.526C790.469,262.837,803.375,252.046,800.196,248.076z",
    },
  },
];

// 3 — signature programs. Scope lines restate National Programs.
const signature = [
  {
    tag: "Maternal Health",
    title: "Project CRADLE Care®",
    scope: "Raises awareness of inequitable maternal and infant health outcomes affecting Black women. Outreach, education, and advocacy connect families with information and support.",
    href: "/service-impact/national-programs/#cradle",
    img: "/images/project-cradle-care-3.jpg",
  },
  {
    tag: "Aquatic Safety",
    title: "SWIM 1922®",
    scope: "Addresses racial disparities in swimming and drowning by teaching water safety and swim skills. Through the partnership with USA Swimming, instruction comes directly into local communities.",
    href: "/service-impact/national-programs/#swim",
    img: "/images/swim-1922-1-768x432.jpg",
  },
  {
    tag: "Educational Equity",
    title: "Operation BigBookBag®",
    scope: "Puts school supplies, books, and study aids in the hands of students who are educationally at risk. Since 1996 it has grown to include STEM exposure, tutoring, and mentoring.",
    href: "/service-impact/national-programs/#bigbookbag",
    img: "/images/operation-bigbookbag-4.jpg",
  },
];

// 5 — newsroom: the lead story (it has its own page) and the two latest
// items from the news collection; events from the events collection.
const featuredStory = {
  tag: "Convention",
  date: "July 2026",
  img: "/images/boule.jpg",
  title: "Tampa Welcomes Sigma Gamma Rho for the 61st International Biennial Boulé",
  body: "Thousands of members, partners, and guests gathered at the Tampa Convention Center, the first Sigma Gamma Rho international convention in Tampa since 1976.",
  href: "/news-events/latest-news/61st-biennial-boule/",
};
const recentNews = (await getCollection("news"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2)
  .map((e) => e.data)
  .map((d) => ({
    ...d,
    link: d.href
      ? { href: d.href.startsWith("http") ? d.href : withBase(d.href), ...(d.external ? { target: "_blank", rel: "noopener" } : {}) }
      : { href: withBase("/news-events/latest-news/") },
  }));
const upcoming = (await getCollection("events"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4)
  .map((e) => e.data);

// 6 — partners: the fourteen on Corporate Partnerships plus the allied
// foundations. External logos open the partner's own site.
const partnerLogos = [
  { name: "Alzheimer's Association", logo: "/images/Alzheimer's Association.svg", url: "https://www.alz.org/" },
  { name: "Amazon", logo: "/images/Amazon.png", url: "https://www.amazon.com/" },
  { name: "American Cancer Society", logo: "/images/American Cancer Society.svg", url: "https://www.cancer.org/" },
  { name: "Chase", logo: "/images/Chase.svg", url: "https://www.chase.com/" },
  { name: "Good Health WINs (NCNW)", logo: "/images/Good Health Wins.png", url: "https://legacy.ncnw.org/ncnw/ghwins" },
  { name: "Herff Jones", logo: "/images/Herff Jones.png", url: "https://www.herffjones.com/" },
  { name: "Hip Hop Sisters Network", logo: "/images/Hip Hop Sisters Network.png", url: "https://hiphopsisters.org/" },
  { name: "Kasper", logo: "/images/Kasper.png", url: "https://www.kasper.com/" },
  { name: "Macy's", logo: "/images/partner-logo-macys.png", url: "https://www.macys.com/" },
  { name: "NAACP", logo: "/images/NAACP.svg", url: "https://naacp.org/" },
  { name: "National Alliance on Mental Illness", logo: "/images/National Alliance on Mental Illness.webp", url: "https://www.nami.org/" },
  { name: "St. Jude Children's Research Hospital", logo: "/images/St. Jude Children's Research Hospital.svg", url: "https://www.stjude.org/" },
  { name: "USA Swimming", logo: "/images/USA Swimming.svg", url: "https://www.usaswimming.org/" },
  { name: "Western Governors University", logo: "/images/Western Governors University.svg", url: "https://www.wgu.edu/" },
  { name: "National Education Fund", logo: "/images/foundations/nef.png", url: "/service-impact/partner-foundations/#nef", internal: true },
  { name: "SPEAR Foundation", logo: "/images/foundations/spear.png", url: "/service-impact/partner-foundations/#spear", internal: true },
  { name: "Seven Pearls Foundation", logo: "/images/foundations/seven-pearls.png", url: "/service-impact/partner-foundations/#seven-pearls", internal: true },
];
---

<Base
  title="Home"
  description="Sigma Gamma Rho Sorority, Incorporated — a century of scholarship, sisterhood, leadership, and service. Greater Service, Greater Progress."
  bodyClass="page-home"
>
  <!-- 1 — cinematic opener: the clip runs full-bleed at full colour, with a
       navy fade carrying the type on the left (Karena, 2026-09-17). -->
  <Hero
    cinematic
    align="left"
    video="/images/sgrho-hero.mp4"
    image="/images/sgr-alpha-charter.jpeg"
    eyebrow="1922 — Today"
    title="Greater Service,"
    highlight="Greater Progress®"
    copy="A global sisterhood working to enhance the quality of life for women and their families through community service, civil and social action."
    size="tall"
  >
    <a class="btn" href={withBase("/membership/become-a-member/")}>
      Explore Sisterhood &amp; Intake <span aria-hidden="true">&rarr;</span>
    </a>
    <a class="btn btn--outline hero-glass" href={PORTAL_URL} target="_blank" rel="noopener">
      Member Portal &amp; Reclamation <span aria-hidden="true">&#8599;</span>
    </a>
  </Hero>
  <StatBand stats={reachStats} tone="navy" />

  <!-- 2 — origin: where the work comes from. -->
  <section class="section legacy">
    <div class="container legacy__grid">
      <figure class="legacy__figure" id="our-legacy">
        <img
          src={withBase("/images/sgr-alpha-charter.jpeg")}
          alt="Alpha Chapter charter members, 1922"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Alpha Chapter charter members, 1922</figcaption>
      </figure>
      <div class="legacy__copy">
        <p class="eyebrow">Living Legacy</p>
        <h2 class="legacy__title">Seven Educators. One Radical Idea.</h2>
        <p>
          On November 12, 1922, seven Black educators founded Sigma Gamma Rho at Butler University
          in Indianapolis, Indiana. They built a sorority on academic excellence, sisterhood, and
          civic courage, a foundation that still shapes every chapter today.
        </p>
        <div class="legacy__links">
          <a class="arrow-link" href={withBase("/about/herstory/")}>
            Discover Our Herstory <span aria-hidden="true">&rarr;</span>
          </a>
          <a class="arrow-link" href={withBase("/about/our-founders/")}>
            Meet the Founders <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 — the mission in motion. -->
  <section class="section work">
    <div class="container">
      <h2 class="work__label">Our Work in Action</h2>
      <ul class="program-cards">
        {signature.map((p) => (
          <li class="program-card">
            <div class="program-card__media">
              <img src={withBase(p.img)} alt="" width="640" height="360" loading="lazy" decoding="async" />
              <span class="program-card__badge">{p.tag}</span>
            </div>
            <div class="program-card__body">
              <h3>
                <a href={withBase(p.href)}>{p.title}</a>
              </h3>
              <p>{p.scope}</p>
              <span class="program-card__go" aria-hidden="true">Explore Program &rarr;</span>
            </div>
          </li>
        ))}
      </ul>
      <p class="center-link">
        <a href={withBase("/service-impact/national-programs/")}>
          All National Programs <span aria-hidden="true">&rarr;</span>
        </a>
      </p>
    </div>
  </section>

  <!-- 4 — into the next century: leadership, after the legacy it carries. -->
  <section class="section vision on-dark">
    <div class="container vision__grid">
      <div class="vision__copy">
        <p class="eyebrow">Leading Sigma Forward</p>
        <h2 class="vision__title">Into the Next Century of Service</h2>
        <p>
          Marica T. Harris was elected the 26th International Grand Basileus of Sigma Gamma Rho
          Sorority, Inc. at the 60th Biennial Boulé, a life member poised to guide the organization
          as it embarks on its next century of service.
        </p>
        <blockquote class="vision__quote">
          <p>
            Our founders' vision has been carried forward by women who lead with purpose and serve
            without limits.
          </p>
          <footer>
            <strong>Marica T. Harris</strong>
            <span>26th International Grand Basileus</span>
          </footer>
        </blockquote>
        <div class="vision__actions">
          <a class="btn" href={withBase("/leadership/international-board/")}>
            Meet the International Board <span aria-hidden="true">&rarr;</span>
          </a>
          <a class="vision__link" href={withBase("/leadership/international-grand-basileus/")}>
            Read her biography <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
      <figure class="vision__portrait">
        <img
          src={withBase("/images/international-grand-basileus-marica-harris-704x1024.jpg")}
          alt="International Grand Basileus Marica T. Harris"
          width="704"
          height="1024"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- 5a — ways in: the three paths a visitor is most likely to want. -->
  <section class="section ways">
    <div class="container">
      <div class="ways__head">
        <p class="eyebrow">Find Your Place</p>
        <h2 class="ways__title">Ways In</h2>
      </div>
      <ul class="ways__grid">
        <li class="way">
          <h3>Find a Chapter</h3>
          <p>
            Sigma Gamma Rho is organized across five regions, with undergraduate and alumnae
            chapters throughout the United States and internationally.
          </p>
          <a class="arrow-link" href={withBase("/membership/chapter-locator/")}>
            Open the Chapter Locator <span aria-hidden="true">&rarr;</span>
          </a>
        </li>
        <li class="way">
          <h3>Prepare for Intake</h3>
          <p>
            Review the collegiate and alumnae requirements, what the Sorority looks for, and how to
            verify that a membership activity is official.
          </p>
          <a class="arrow-link" href={withBase("/membership/become-a-member/")}>
            Review Membership Standards <span aria-hidden="true">&rarr;</span>
          </a>
        </li>
        <li class="way">
          <h3>Return to Active Status</h3>
          <p>
            Members who have been financially inactive for a year or more can reactivate online,
            and chapter transfers start from the member profile.
          </p>
          <a class="arrow-link" href={withBase("/membership/reactivate/")}>
            Reactivate or Transfer <span aria-hidden="true">&rarr;</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- 5b — dispatch: newsroom and events, 50/50. -->
  <section class="section dispatch">
    <div class="container">
      <p class="eyebrow">Stay Connected</p>
      <h2 class="dispatch__title">What's Happening</h2>
      <div class="dispatch__grid">
        <div class="newsroom">
          <h3 class="dispatch__label">Official Newsroom</h3>
          <article class="news-lead">
            <img src={withBase(featuredStory.img)} alt="" width="1200" height="675" loading="lazy" decoding="async" />
            <p class="news-lead__meta">
              <span class="news-tag">{featuredStory.tag}</span>
              {featuredStory.date}
            </p>
            <h4>
              <a href={withBase(featuredStory.href)}>{featuredStory.title}</a>
            </h4>
            <p>{featuredStory.body}</p>
          </article>
          <ul class="news-rows">
            {recentNews.map((n) => (
              <li>
                {n.image && <img src={withBase(n.image)} alt="" width="120" height="90" loading="lazy" decoding="async" />}
                <div>
                  <p class="news-meta">{n.tag}</p>
                  <a {...n.link}>{n.title}</a>
                </div>
              </li>
            ))}
          </ul>
          <a class="arrow-link" href={withBase("/news-events/latest-news/")}>
            All News <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="events">
          <h3 class="dispatch__label">Upcoming Events</h3>
          <ul class="event-rows">
            {upcoming.map((e) => (
              <li>
                <span class="date-tile" aria-hidden="true">
                  <span>{e.month}</span>
                  <strong>{e.day}</strong>
                </span>
                <div class="event-rows__meta">
                  <strong>{e.title}</strong>
                  <span>
                    <span class="visually-hidden">{e.month} {e.day}, </span>
                    {e.location}
                  </span>
                </div>
                <a class="event-rows__go" href={withBase("/news-events/upcoming-events/")}>
                  Details<span class="visually-hidden">: {e.title}</span> <span aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="arrow-link" href={withBase("/news-events/upcoming-events/")}>
            Full Calendar <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 — Greater Together. -->
  <section class="section section--navy partnership">
    <div class="container partnership__inner">
      <h2 class="partnership__title">Greater Together.</h2>
      <p class="partnership__lead">
        We partner with organizations that share our commitment to education, health, economic
        opportunity, and stronger communities.
      </p>
    </div>

    <div class="container partner-carousel" data-partner-carousel>
      <button class="partner-carousel__btn partner-carousel__btn--prev" type="button" aria-label="Previous partners">
        &lsaquo;
      </button>
      <ul class="partner-carousel__track">
        {partnerLogos.map((x) => (
          <li>
            {x.internal ? (
              <a href={withBase(x.url)} aria-label={x.name}>
                <img src={withBase(x.logo)} alt={x.name} loading="lazy" />
              </a>
            ) : (
              <a href={x.url} target="_blank" rel="noopener" aria-label={`${x.name} (opens in a new tab)`}>
                <img src={withBase(x.logo)} alt={x.name} loading="lazy" />
              </a>
            )}
          </li>
        ))}
      </ul>
      <button class="partner-carousel__btn partner-carousel__btn--next" type="button" aria-label="Next partners">
        &rsaquo;
      </button>
    </div>

    <div class="container partnership__inner">
      <div class="partnership__actions">
        <a class="arrow-link partnership__action" href={withBase("/service-impact/corporate-partnerships/")}>
          Partner With Sigma <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="arrow-link partnership__action" href={withBase("/service-impact/partner-foundations/")}>
          Support Our Work <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <p class="partnership__fineprint">
        Sigma Gamma Rho Sorority, Incorporated is a 501(c)(7). Tax-deductible contributions are
        directed through our 501(c)(3) foundation partners — the{" "}
        <a href={withBase("/service-impact/partner-foundations/#nef")}>National Education Fund</a>{" "}
        and <a href="https://www.spearfoundation.org/" target="_blank" rel="noopener">SPEAR Foundation</a>
        {" "}— to the extent allowed by law.
      </p>
    </div>
  </section>

  <!-- Pre-footer member strip. -->
  <aside class="portal-strip" aria-label="Member login">
    <div class="container portal-strip__inner">
      <p>
        <strong>Active Soror?</strong> Access resources, dues, and member records inside the Poodle
        Portal.
      </p>
      <a class="btn btn--navy" href={PORTAL_URL} target="_blank" rel="noopener">
