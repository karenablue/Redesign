---
/**
 * Home — rebuilt to match the original index.html section for section, using
 * shared components where they fit and scoped markup for the bespoke bands.
 */
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import StatBand from "../components/StatBand.astro";
import CardGrid from "../components/CardGrid.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
import { withBase } from "../lib/url.js";

const stats = [
  { value: "500+", label: "Chapters Worldwide" },
  { value: "100,000+", label: "Members Strong" },
  { value: "103", label: "Years of Service" },
  { value: "50+", label: "States & Territories" },
];

const since2020 = [
  { icon: "clock", value: "2,145,830", label: "Hours of service performed globally" },
  { icon: "heart", value: "$7,450,200", label: "Donated to philanthropic initiatives" },
  { icon: "cap", value: "$3,125,500", label: "Awarded in academic scholarships" },
];

const programs = [
  { title: "Youth Empowerment", body: "Preparing the next generation to lead with confidence, courage, and character." },
  { title: "Educational Access", body: "Expanding pathways to learning and closing the digital divide." },
  { title: "Scholarship & Opportunity", body: "Removing financial barriers and investing in academic excellence." },
  { title: "Socioeconomic Justice", body: "Advocating for systemic change and equity in our communities." },
  { title: "Financial Literacy", body: "Building the foundation for generational wealth and long-term stability." },
  { title: "Women's Wellness", body: "Championing holistic physical, emotional, and maternal well-being." },
];

const faqs = [
  { q: "What does the membership process entail?", a: "The membership intake process, known as the T.O.R.C.H. process, is a rigorous educational experience designed to ensure prospective members comprehend the profound history, governing policies, and high expectations of Sigma Gamma Rho Sorority, Inc. It demands leadership development, intellectual discipline, and a proven readiness for community service." },
  { q: "Do I need to be invited or know a current member to join?", a: "No. Attending a public event or knowing a member does not guarantee an invitation. Membership opportunities come through a chartered chapter's official intake process." },
  { q: "What are the financial obligations of membership?", a: "Members pay national, regional, and local dues, plus one-time intake costs. Amounts vary by chapter and are shared during the official process." },
  { q: "I am no longer in college. Can I still join?", a: "Yes. Women who hold a bachelor's degree from an accredited institution may pursue membership through a chartered alumnae chapter." },
];

const motion = [
  { img: "/images/Beta Alpha.jpg", year: "2026", title: "National Convention", sub: "Boule Conference" },
  { img: "/images/project-cradle-care-3.jpg", year: "2026", title: "National Advocacy", sub: "Project Cradle Care" },
];

const voices = [
  { initials: "AJ", name: "Dr. Alicia K. Jackson", role: "Alumna, Educator & Civic Leader", quote: "Sigma Gamma Rho is not just an organization I joined in college; it is a lifelong commitment to sisterhood, scholarship, and service that continues to shape my personal and professional journey every single day." },
  { initials: "MV", name: "Michelle R. Vance", role: "Life Member & Entrepreneur", quote: "The leadership training and mentorship I've received through our national programs gave me the confidence to excel in corporate spaces where Black women are often underrepresented. My sisters are my strongest network." },
  { initials: "LB", name: "Lauren T. Banks", role: "Collegiate Member, Beta Chapter", quote: "From Operation BigBookBag to Swim 1922, seeing the direct, tangible impact we have on our communities fills me with immense pride. We are women of action, rooted in a century-long legacy of true progress." },
];

const events = [
  { m: "AUG", d: "28", cat: "Leadership", title: "Fall Cluster Conferences Begin", loc: "Various Regional Locations" },
  { m: "SEP", d: "15", cat: "Community Service", title: "Annual Youth Symposium", loc: "National Virtual Event" },
  { m: "OCT", d: "04", cat: "Health & Wellness", title: "Project Reassurance: Swim 1922 Clinic", loc: "Atlanta, GA" },
];

const news = [
  { cat: "Membership", date: "July 31, 2026", title: "Sigma Gamma Rho Inducts 21 Honorary Members at 61st Biennial Boule", body: "The sorority proudly welcomed a historic class of 21 honorary members during its 61st Biennial Boule, celebrating visionary leaders in sports, entertainment, public service, and global advocacy." },
  { cat: "Community Impact", date: "July 2026", title: "Sigma Gamma Rho Brings Service & Multi-Million Dollar Impact to Tampa", body: "The 61st Biennial Boule in Tampa left a lasting legacy through extensive community service initiatives, youth empowerment programs, and a significant economic impact on the local area." },
];

const partners = [
  { i: "NEF", name: "Sigma Gamma Rho National Education Fund, Inc." },
  { i: "SPEAR", name: "SPEAR Foundation" },
  { i: "SJCRH", name: "St. Jude Children's Research Hospital" },
  { i: "AA", name: "Alzheimer's Association" },
  { i: "ACS", name: "American Cancer Society" },
  { i: "NAMI", name: "National Alliance on Mental Illness" },
];
---
<Base
  title="Home"
  description="Sigma Gamma Rho Sorority, Incorporated — a century of scholarship, sisterhood, leadership, and service. Greater Service, Greater Progress."
>
  <!-- 1. HERO — video, headline, two pill buttons -->
  <section class="home-hero">
    <video class="home-hero__video" autoplay muted loop playsinline preload="auto" poster={withBase("/images/sgr-alpha-charter.jpeg")}>
      <source src={withBase("/images/sgrho video.mp4")} type="video/mp4" />
    </video>
    <div class="home-hero__scrim"></div>
    <div class="container home-hero__inner">
      <h1 class="home-hero__title">Greater Service, <span>Greater Progress</span></h1>
      <p class="home-hero__copy">
        Founded in 1922 by seven young Black educators at Butler University, Sigma Gamma Rho
        Sorority, Incorporated is built on a century-long legacy of academic excellence,
        uncompromising sisterhood, and concrete action in our communities.
      </p>
      <div class="home-hero__actions">
        <Button href="/membership/become-a-member/">Join Our Sisterhood <span aria-hidden="true">&rarr;</span></Button>
        <Button href="/membership/reactivate/" variant="ghost-light">Reactivate <span aria-hidden="true">&rarr;</span></Button>
      </div>
    </div>
  </section>

  <!-- 2. WHO ARE WE -->
  <section class="section section--white waw">
    <div class="container waw__grid">
      <figure class="waw__figure">
        <img src={withBase("/images/sgr-alpha-charter.jpeg")} alt="Alpha Chapter charter members, 1922" />
        <figcaption>
          <span class="waw__year">1922</span>
          <span class="waw__place">Founded at Butler University · Indianapolis, Indiana</span>
        </figcaption>
      </figure>
      <div class="waw__copy">
        <p class="eyebrow eyebrow--rule">About Us</p>
        <h2 class="feature-title">Who <span>Are We?</span></h2>
        <p class="waw__sub">A Legacy of Leadership &amp; Service</p>
        <p>On November 12, 1922, seven young Black educators founded <strong>Sigma Gamma Rho Sorority, Incorporated</strong> at Butler University in Indianapolis, Indiana.</p>
        <p>Establishing a sorority for Black women on a predominantly white campus during the height of racial segregation was a profound act of courage and vision. Our founders forged a sanctuary of intellectual rigor and mutual support, determined to advance educational opportunities and civil rights. That foundational commitment to <strong>academic excellence and community uplift</strong> remains the bedrock of our sisterhood today.</p>
        <blockquote class="waw__quote">
          <p>"We don't just join an organization. We carry forward a legacy of leadership, service, and progress."</p>
          <cite><strong>Marica T. Harris</strong><span>International Grand Basileus</span></cite>
        </blockquote>
        <p>Today, Sigma Gamma Rho&reg; advances that legacy through rigorous leadership development, targeted community investment, and global civic engagement — a shared responsibility to lead and create concrete change.</p>
        <ul class="waw__pillars">
          <li><span class="waw__sigma">&Sigma;</span>Sisterhood</li>
          <li><span class="waw__sigma">&Sigma;</span>Scholarship</li>
          <li><span class="waw__sigma">&Sigma;</span>Service</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 3. MOTTO CALLOUT -->
  <section class="section section--white section--pad-tight motto">
    <div class="container motto__grid">
      <div>
        <p class="eyebrow">Our Motto Since 1925</p>
        <p class="motto__main">"Greater Service, Greater Progress"</p>
      </div>
      <div class="motto__aka">
        <p class="eyebrow">Also Known As</p>
        <p class="motto__script">greater women, greater world.</p>
      </div>
    </div>
  </section>

  <!-- 4. STAT BAND -->
  <StatBand stats={stats} tone="navy" />

  <!-- 5. OUR GLOBAL IMPACT -->
  <Section
    tone="white"
    eyebrow="National Programs"
    title="Our"
    highlight="Global Impact"
  >
    <p class="impact-lead">
      Our commitment to <strong>Greater Service, Greater Progress</strong> translates into direct, tangible action. From teaching water safety through Swim 1922, to funding undergraduate education, promoting maternal health via Project Cradle Care, and preparing youth for leadership, our chapters address specific, critical needs in the communities we serve.
    </p>
    <p class="impact-since">Since 2020, we have:</p>
    <div class="impact-cards">
      {since2020.map((s) => (
        <div class="impact-card">
          <span class="impact-card__icon" aria-hidden="true"></span>
          <span class="impact-card__value">{s.value}</span>
          <span class="impact-card__label">{s.label}</span>
        </div>
      ))}
    </div>
  </Section>

  <!-- 6. WHERE OUR WORK MAKES A DIFFERENCE -->
  <Section tone="white" pad="tight" heading="plain" centered title="Where Our Work Makes a Difference">
    <div class="prog-grid">
      {programs.map((p) => (
        <article class="prog-card">
          <span class="prog-card__icon" aria-hidden="true"></span>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </article>
      ))}
    </div>
    <p class="center-link"><a href={withBase("/service-impact/national-programs/")}>Explore our National Programs <span aria-hidden="true">&rarr;</span></a></p>
  </Section>

  <!-- 7. FIND A CHAPTER -->
  <section class="section section--navy find">
    <div class="container find__inner">
      <span class="find__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
      </span>
      <h2 class="feature-title feature-title--light">Find a Chapter Near <span>You</span></h2>
      <p>With over 500 chapters across the globe, there is a community of Sigma women waiting to welcome you. Enter your zip code or state to connect locally.</p>
      <form class="find__bar" role="search" onsubmit="return false">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" placeholder="Search by Zip Code, City, or University&hellip;" aria-label="Search chapters" />
        <a class="btn find__btn" href={withBase("/membership/chapter-locator/")}>Browse Directory</a>
      </form>
    </div>
  </section>

  <!-- 8. BECOMING A MEMBER -->
  <section class="section section--navy section--round-b becoming">
    <div class="container becoming__grid">
      <div class="becoming__copy">
        <p class="eyebrow">Join Our Sisterhood</p>
        <h2 class="feature-title feature-title--light">Membership Is a <span>Commitment</span></h2>
        <div class="gold-rule"></div>
        <p>A commitment to scholarship, uncompromising sisterhood, and the profound responsibility to advance our communities. We seek women who understand that our legacy—forged by seven Black educators in 1922—demands action, integrity, and lifelong dedication.</p>
        <p>We invite candidates who are prepared to invest their time, intellectual rigor, and leadership into tangible public service, with the academic standing and personal accountability that sustain it.</p>
        <p>Membership in Sigma Gamma Rho is an active pursuit of our founding mandate: <strong class="gold">Greater Service, Greater Progress.</strong></p>
        <Button href="/membership/become-a-member/">Explore Membership</Button>
      </div>
      <figure class="becoming__figure">
        <span class="becoming__badge">Scholarship</span>
        <img src={withBase("/images/rho alpha sorors.jfif")} alt="Sigma Gamma Rho members" />
      </figure>
    </div>
  </section>

  <!-- 9. FAQ -->
  <Section tone="white" eyebrow="Frequently Asked Questions" title="Thinking About" highlight="Joining?">
    <div class="faq container--narrow">
      {faqs.map((f, i) => (
        <details class="faq__item" open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </Section>

  <!-- 10. SISTERHOOD IN MOTION -->
  <Section tone="white" heading="feature" centered={false} eyebrow="Our Impact" title="Sisterhood in" highlight="Motion">
    <div class="motion__head">
      <a class="btn btn--navy" href={withBase("/news-events/upcoming-events/")}>+ Submit Chapter Event</a>
    </div>
    <div class="motion__grid">
      {motion.map((m) => (
        <figure class="motion__card">
          <span class="motion__year">{m.year}</span>
          <img src={withBase(m.img)} alt={m.title} />
          <figcaption><strong>{m.title}</strong><span>{m.sub}</span></figcaption>
        </figure>
      ))}
    </div>
  </Section>

  <!-- 11. OUR SISTERS SPEAK -->
  <Section tone="white" eyebrow="Member Voices" title="Our Sisters" highlight="Speak">
    <div class="voices">
      {voices.map((v) => (
        <blockquote class="voice">
          <span class="voice__mark" aria-hidden="true">&ldquo;</span>
          <p class="voice__quote">{v.quote}</p>
          <footer>
            <span class="voice__avatar" aria-hidden="true">{v.initials}</span>
            <span class="voice__who"><strong>{v.name}</strong><span>{v.role}</span></span>
          </footer>
        </blockquote>
      ))}
    </div>
  </Section>

  <!-- 12. UPCOMING EVENTS -->
  <section class="section section--mist events">
    <div class="container">
      <div class="events__head">
        <div>
          <p class="eyebrow">Calendar</p>
          <h2 class="feature-title">Upcoming <span>Events</span></h2>
        </div>
        <a class="arrow-link" href={withBase("/news-events/upcoming-events/")}>View full calendar <span aria-hidden="true">&rsaquo;</span></a>
      </div>
      <div class="events__grid">
        {events.map((e) => (
          <article class="event">
            <span class="event__date"><span>{e.m}</span><strong>{e.d}</strong></span>
            <div class="event__body">
              <p class="event__cat">{e.cat}</p>
              <h3>{e.title}</h3>
              <p class="event__loc"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z"/><circle cx="12" cy="10" r="2.4"/></svg>{e.loc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 13. LATEST NEWS -->
  <Section tone="white" heading="plain" centered={false} eyebrow="Updates & Events" title="Latest" highlight="News & Events">
    <div class="news__head-link">
      <a class="arrow-link" href={withBase("/news-events/latest-news/")}>View all news <span aria-hidden="true">&rarr;</span></a>
    </div>
    <div class="news__grid">
      {news.map((n) => (
        <article class="news">
          <div class="news__img" aria-hidden="true"></div>
          <div class="news__body">
            <p class="news__meta"><span class="news__cat">{n.cat}</span> &bull; {n.date}</p>
            <h3>{n.title}</h3>
            <p>{n.body}</p>
            <a class="arrow-link" href={withBase("/news-events/latest-news/")}>Read the story <span aria-hidden="true">&rarr;</span></a>
          </div>
        </article>
      ))}
    </div>
    <p class="center-link"><a href={withBase("/news-events/latest-news/")}>View all news &amp; events <span aria-hidden="true">&rsaquo;</span></a></p>
  </Section>

  <!-- 14. PARTNERS -->
  <Section tone="white" heading="plain" centered={false} eyebrow="Partnerships" title="Working Together for Greater Impact"
    lead="Organizations aligned with our mission of Greater Service, Greater Progress.">
    <div class="partners__tabs" role="tablist">
      <span class="is-active">Foundations</span><span>Corporate</span><span>Community</span>
    </div>
    <div class="partners__grid">
      {partners.map((p) => (
        <article class="partner">
          <span class="partner__badge" aria-hidden="true">{p.i}</span>
          <h3>{p.name}</h3>
        </article>
      ))}
    </div>
    <p class="center-link"><a href={withBase("/service-impact/corporate-partnerships/")}>Partner with Sigma Gamma Rho <span aria-hidden="true">&rarr;</span></a></p>
  </Section>
</Base>

<style>
  /* shared bits used by scoped sections */
  .feature-title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: var(--text-h2);
    line-height: 1.14;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--royal);
  }
  .feature-title span { color: var(--gold); }
  .feature-title--light { color: #fff; }
  .feature-title--light span { color: var(--gold); }
  .eyebrow--rule::after {
    content: ""; display: block; width: 2rem; height: 1px;
    background: var(--gold); margin-top: var(--space-4);
  }
  .center-link { margin: clamp(2.5rem, 4vw, 3.5rem) 0 0; text-align: center; }
  .center-link a, .arrow-link {
    color: var(--royal); font-weight: 600; font-size: var(--text-base);
    text-decoration: none; border-bottom: 2px solid rgba(32,65,165,0.25);
    padding-bottom: 4px; white-space: nowrap;
  }
  .center-link a:hover, .arrow-link:hover { border-color: var(--gold); }
  .gold { color: var(--gold); }
  .gold-rule { width: 4rem; height: 2px; background: var(--gold); margin: 1.5rem 0; border-radius: 2px; }
  .section--mist { background: #f4f6fb; }

  /* 1. HERO — video + headline + buttons */
  .home-hero { position: relative; min-height: clamp(560px, 78vh, 800px); display: flex; align-items: center; overflow: hidden; background: var(--navy); color: #fff; text-align: center; }
  .home-hero__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.4; mix-blend-mode: luminosity; }
  .home-hero__scrim { position: absolute; inset: 0; background: linear-gradient(to top, var(--navy) 0%, rgba(32,65,165,0.6) 55%, transparent 100%); }
  .home-hero__inner { position: relative; z-index: 2; margin-inline: auto; padding-block: clamp(5rem, 12vw, 8rem); max-width: 62rem; }
  .home-hero__title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: var(--text-hero);
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 4px 24px rgba(0,0,0,0.5);
  }
  .home-hero__title span { color: var(--gold); }
  .home-hero__copy {
    margin: var(--space-6) auto 0;
    max-width: 44rem;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-lg);
    line-height: 1.7;
    color: rgba(255,255,255,0.9);
  }
  .home-hero__actions { margin-top: var(--space-10); display: flex; gap: var(--space-5); justify-content: center; flex-wrap: wrap; }
  .home-hero__actions :global(.btn) { padding: 1.05em 2.6em; }

  /* 2. WHO ARE WE */
  .waw__grid { display: grid; grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .waw__figure { position: relative; margin: 0; border-radius: var(--radius-lg); overflow: hidden; }
  .waw__figure img { width: 100%; aspect-ratio: 3/4; object-fit: cover; display: block; }
  .waw__figure figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 2.5rem 1.25rem 1.1rem; display: flex; flex-direction: column; color: #fff; background: linear-gradient(0deg, rgba(8,22,51,.9), transparent); }
  .waw__year { font-size: 2.4rem; font-weight: 800; line-height: 1; }
  .waw__place { font-size: var(--text-xs); letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.85); }
  .waw__copy > p { color: var(--ink); }
  .waw__sub { color: var(--royal); font-weight: 700; margin: .35rem 0 1rem; }
  .waw__quote { margin: 1.5rem 0; padding-left: 1.1rem; border-left: 3px solid var(--gold); }
  .waw__quote p { color: var(--royal); font-weight: 700; }
  .waw__quote cite { display: flex; flex-direction: column; font-style: normal; font-size: var(--text-xs); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
  .waw__quote cite strong { color: var(--royal); }
  .waw__pillars { display: flex; gap: clamp(1rem, 4vw, 3rem); justify-content: space-between; list-style: none; padding: 1.5rem 0 0; margin: 1.5rem 0 0; }
  .waw__pillars li { display: flex; flex-direction: column; align-items: center; gap: .5rem; font-size: var(--text-xs); font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--royal); position: relative; flex: 1; }
  .waw__pillars li:not(:last-child)::after { content: ""; position: absolute; top: 18px; left: 60%; width: 80%; height: 1px; background: var(--gold); }
  .waw__sigma { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid var(--gold); border-radius: 50%; color: var(--gold); font-size: 1rem; }
  @media (max-width: 820px) { .waw__grid { grid-template-columns: 1fr; } .waw__figure { max-width: 420px; } }

  /* 3. MOTTO */
  .motto__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .motto__grid > div:last-child { border-left: 1px solid var(--line); padding-left: 2rem; }
  .motto__main { color: var(--royal); font-weight: 800; font-size: var(--text-lg); margin: .35rem 0 0; }
  .motto__aka { text-align: right; }
  .motto__script { font-family: Georgia, "Times New Roman", serif; font-style: italic; color: var(--navy); font-size: var(--text-lg); margin: .35rem 0 0; }
  @media (max-width: 640px) { .motto__grid { grid-template-columns: 1fr; } .motto__grid > div:last-child { border-left: 0; padding-left: 0; } .motto__aka { text-align: left; } }

  /* 5. GLOBAL IMPACT */
  .impact-lead { max-width: 62ch; margin-inline: auto; text-align: center; color: var(--muted); }
  .impact-lead strong { color: var(--gold); }
  .impact-since { text-align: center; color: var(--royal); font-weight: 800; margin-top: 2.5rem; }
  .impact-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-6); margin-top: var(--space-6); }
  .impact-card { display: flex; flex-direction: column; align-items: center; text-align: center; gap: .5rem; padding: 2rem 1.5rem; background: #fff; border: 1px solid var(--gold); border-radius: var(--radius-lg); }
  .impact-card__icon { width: 44px; height: 44px; border-radius: 50%; background: var(--gold); }
  .impact-card__value { font-size: clamp(1.8rem, 3.4vw, 2.4rem); font-weight: 800; color: var(--royal); }
  .impact-card__label { font-size: var(--text-sm); color: var(--muted); }

  /* 6. PROGRAM CARDS */
  .prog-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-6); }
  @media (min-width: 900px) { .prog-grid { grid-template-columns: repeat(3, 1fr); } }
  .prog-card { text-align: center; padding: 2.25rem 1.75rem; background: var(--cream-2); border-radius: var(--radius-lg); }
  .prog-card__icon { display: inline-grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 8px rgba(223,177,54,.15); margin-bottom: 1rem; }
  .prog-card h3 { color: var(--royal); font-size: var(--text-lg); margin: 0 0 .5rem; }
  .prog-card p { color: var(--ink); margin: 0; }

  /* 7. FIND A CHAPTER */
  .find__inner { text-align: center; max-width: 720px; margin-inline: auto; }
