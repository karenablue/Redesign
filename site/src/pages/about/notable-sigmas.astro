---
/**
 * Notable Sigmas.
 *
 * The roster lives in the `notableSigmas` content collection rather than in
 * arrays here, because it is now ~112 people and because `honorary` is a
 * factual claim about a real woman that HQ must be able to correct without
 * touching code. See src/content.config.ts for why the schema is strict.
 *
 * Portraits: 54 of the entries carry a freely-licensed photograph sourced
 * from Wikimedia Commons; the rest render an initials monogram. Any entry
 * with an image also carries `license` and `credit`, enforced by the schema,
 * because CC BY and CC BY-SA require attribution — rendered in the
 * Photography credits section at the foot of this page. Portraits are NOT
 * hotlinked: they are copied into images/notable/, so the site's
 * `img-src 'self'` policy holds and Commons is not serving our traffic.
 */
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import CtaBand from "../../components/CtaBand.astro";
import { withBase } from "../../lib/url.js";
import { getCollection } from "astro:content";

const filters = [
  { key: "all", label: "All" },
  { key: "arts", label: "Arts & Entertainment" },
  { key: "education", label: "Education" },
  { key: "law", label: "Law" },
  { key: "business", label: "Business" },
  { key: "public", label: "Public Service" },
  { key: "advocacy", label: "Advocacy" },
  { key: "literature", label: "Literature & Journalism" },
  { key: "medicine", label: "Medicine" },
  { key: "religion", label: "Religion" },
  { key: "athletics", label: "Athletics" },
];

/**
 * Alphabetical sort key.
 *
 * Honorifics are stripped, or the four "Dr." entries would all cluster under
 * D instead of sorting on their own names. Quoted nicknames are stripped too,
 * so Maritza "Ritz" Correia sorts on Maritza and Sharon "MC Sha-Rock" Jackson
 * on Sharon. Stage names that are the whole name — MC Lyte, DJ Spinderella,
 * Ezinma — are left alone, because that IS the name.
 */
function sortKey(name: string) {
  return name
    .replace(/[“”‘’"']/g, "")
    .replace(/^(Dr|Dame|Mrs|Ms|Mr|Hon)\.?\s+/i, "")
    .trim()
    .toLowerCase();
}

const roster = (await getCollection("notableSigmas"))
  .map((e) => e.data)
  .sort((a, b) => sortKey(a.name).localeCompare(sortKey(b.name)));

// The page's organising principle: Sorors who crossed, kept apart from women
// inducted as honorary members.
const famousSorors = roster.filter((p) => !p.honorary);
const honoraryMembers = roster.filter((p) => p.honorary);

/** Monogram fallback for entries that predate the `initials` field. */
function monogram(name: string) {
  return name
    .replace(/[“”’"']/g, "")
    .split(/\s+/)
    .filter((w) => /^[A-Za-z]/.test(w) && !/^(of|the|and|de|von)$/i.test(w))
    .map((w) => w[0].toUpperCase())
    .slice(0, 3)
    .join("");
}

// Public-domain images carry no attribution obligation; Creative Commons ones
// do. Only the latter are listed, so the credits are a real legal notice
// rather than a decorative wall of names.
const credits = roster
  .filter((p) => p.image && p.license && !/public domain|no restrictions/i.test(p.license))
  // Same key as the roster above. Sorting on the raw name here put "Dame Lisa
  // Simone" under D and sorted "Ta'Rhonda Jones" on its curly apostrophe,
  // so the credits ran in a different order from the cards they credit.
  .sort((a, b) => sortKey(a.name).localeCompare(sortKey(b.name)));

/**
 * Member Spotlight stays hand-curated here rather than moving into the
 * collection: it is an editorial selection of three, rewritten per rotation,
 * not a record of who is a member.
 */
const spotlight = [
  {
    n: "01",
    field: "Civic Leadership",
    name: "Dr. Rosa Slade Gragg",
    note: "A Detroit institution-builder whose work connected education, civil rights, and national public service.",
  },
  {
    n: "02",
    field: "Law",
    name: "Ruth Whitehead Whaley",
    note: "A legal trailblazer whose career reflected both professional excellence and long-term service to Sigma Gamma Rho.",
  },
  {
    n: "03",
    field: "Literature",
    name: "Joyce Carol Thomas",
    note: "An award-winning author whose books gave Black children and families a central place in American literature.",
  },
];
---

<Base
  title="Notable Sigmas"
  activeTop="About"
  description="Sigma Gamma Rho's famous Sorors, honorary members, and member spotlights across law, government, entertainment, education, athletics, and business."
>
  <Hero
    eyebrow="Notable Sigmas"
    title="Women Who"
    highlight="Moved the World."
    copy="From firsts in law, government, entertainment, education, athletics, and business to women whose service reshaped entire communities, Sigma Gamma Rho's story is also the story of women whose work reached far beyond themselves."
    variant="plain"
    accent="navy"
    align="left"
  >
    <a href="#famous-sorors" class="btn btn--outline on-dark"> Famous Sorors </a>
    <a href="#honorary-members" class="btn btn--outline on-dark"> Honorary Members </a>
    <a href="#member-spotlight" class="btn btn--outline on-dark"> Member Spotlight </a>
  </Hero>

  <section class="ns-intro">
    <div class="container ns-intro__grid">
      <div>
        <p class="eyebrow">A Living Record of Achievement</p>
        <h2>
          Not fame for fame's sake. <span>Impact with substance.</span>
        </h2>
      </div>
      <p class="ns-intro__copy">
        This page separates well-known Sorors from honorary members and uses Member Spotlight to
        feature women whose impact deserves deeper attention. Chapter information appears only when
        it is known and documented; it is not used as a separate public-facing category.
      </p>
    </div>
  </section>

  <section class="ns-section" id="famous-sorors">
    <div class="container">
      <div class="ns-heading">
        <p class="eyebrow">Famous Sorors</p>
        <h2>
          Recognized names. <span>Documented legacy.</span>
        </h2>
        <p>
          Sorors whose work became nationally or internationally visible across culture, public
          service, education, law, business, journalism, advocacy, medicine, religion, and sport.
          These are initiated members — women who crossed into Sigma Gamma Rho.
        </p>
        <p class="ns-count">{famousSorors.length} Sorors</p>
      </div>

      <div class="ns-filters" role="group" aria-label="Filter Famous Sorors">
        {
          filters.map((f) => (
            <button
              class:list={["filter", { "is-active": f.key === "all" }]}
              type="button"
              data-filter={f.key}
            >
              {f.label}
            </button>
          ))
        }
      </div>

      <div class="ns-mosaic" id="soror-mosaic">
        {
          famousSorors.map((p) => (
            <article class="ns-card" data-category={p.cat}>
              {p.image ? (
                <img
                  class="ns-avatar ns-avatar--photo"
                  src={withBase(p.image)}
                  alt={p.name}
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="ns-avatar">{p.initials || monogram(p.name)}</span>
              )}
              <p class="ns-field">{p.field}</p>
              <h3>{p.name}</h3>
              <p class="ns-note">{p.note}</p>
              {p.chapter && <span class="ns-chapter">{p.chapter}</span>}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ns-section ns-section--dark on-dark" id="honorary-members">
    <div class="container">
      <div class="ns-heading">
        <p class="eyebrow eyebrow--light">Honorary Members</p>
        <h2>
          Women welcomed into <span>the sisterhood by honor.</span>
        </h2>
        <p>
          Honorary membership is presented separately from Soror profiles so the distinction remains
          clear and historically accurate. These women were inducted rather than initiated.
        </p>
        <p class="ns-count ns-count--light">{honoraryMembers.length} honorary members</p>
      </div>
      <div class="ns-mosaic ns-mosaic--honorary">
        {
          honoraryMembers.map((p) => (
            <article class="ns-card ns-card--dark">
              {p.image ? (
                <img
                  class="ns-avatar ns-avatar--photo"
                  src={withBase(p.image)}
                  alt={p.name}
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="ns-avatar">{p.initials || monogram(p.name)}</span>
              )}
              <p class="ns-field">{p.field}</p>
              <h3>{p.name}</h3>
              <p class="ns-note">{p.note}</p>
              {p.chapter && <span class="ns-chapter ns-chapter--light">{p.chapter}</span>}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ns-section" id="member-spotlight">
    <div class="container">
      <div class="ns-heading">
        <p class="eyebrow">Member Spotlight</p>
        <h2>
          Stories worth <span>stopping for.</span>
        </h2>
        <p>
          A rotating editorial feature for Sorors whose accomplishments, service, or historical
          significance deserve more than a single line in a gallery.
        </p>
      </div>
      <ol class="ns-spotlight">
        {
          spotlight.map((s) => (
            <li>
              <span class="ns-spotlight__num">{s.n}</span>
              <span class="ns-avatar">{monogram(s.name)}</span>
              <div>
                <p class="ns-field">{s.field}</p>
                <h3>{s.name}</h3>
                <p>{s.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    credits.length > 0 && (
      <section class="ns-section ns-credits" id="photography-credits">
        <div class="container">
          <h2 class="ns-credits__title">Photography credits</h2>
          <p class="ns-credits__intro">
            Portraits are reproduced under Creative Commons licences, which require attribution.
            Photographs not listed here are in the public domain. Where no freely licensed
            photograph exists, a monogram is shown rather than an unlicensed image.
          </p>
          <ul class="ns-credits__list">
            {credits.map((p) => (
              <li>
                <strong>{p.name}</strong> — {p.credit},{" "}
                {p.licenseUrl ? (
                  <a href={p.licenseUrl} rel="license noopener" target="_blank">
                    {p.license}
                  </a>
                ) : (
                  p.license
                )}
                , via Wikimedia Commons
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand
    eyebrow="Greater Service, Greater Progress"
    title="Achievement is visible. "
    highlight="Service remains the standard."
    copy="The women featured here represent only a portion of Sigma Gamma Rho's broader story. Across every generation, members have carried the Sorority's ideals into classrooms, courtrooms, boardrooms, studios, legislatures, communities, and fields of competition."
    actions={[{ label: "Explore Our Herstory", href: "/about/herstory/" }]}
  />
</Base>

<style>
  .ns-intro {
    background: var(--white);
    padding-block: clamp(3rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
  }
  .ns-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-12);
    align-items: start;
  }
  .ns-intro__grid h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .ns-intro__grid h2 span {
    color: var(--gold-text);
  }
  .ns-intro__copy {
    color: var(--muted);
  }
  @media (max-width: 780px) {
    .ns-intro__grid {
      grid-template-columns: 1fr;
    }
  }

  .ns-section {
    padding-block: clamp(3rem, 6vw, 4.5rem);
    background: var(--white);
  }
  .ns-section--dark {
    background: var(--grad-royal);
    color: #fff;
  }
  .ns-section--dark p:not(.eyebrow) {
    color: rgba(255, 255, 255, 0.85);
  }
  .ns-heading {
    max-width: 46rem;
    margin-bottom: var(--space-8);
  }
  .ns-heading h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .ns-heading h2 span {
    color: var(--gold-text);
  }
  .ns-heading > p:not(.eyebrow) {
    color: var(--muted);
    margin-top: var(--space-4);
  }
  .ns-section--dark .ns-heading > p:not(.eyebrow) {
    color: rgba(255, 255, 255, 0.8);
  }
  .eyebrow--light {
    color: var(--gold-bright);
  }
  /* Roster size, stated plainly. A page that claims to be a record should say
     how large the record is. */
  .ns-count {
    font-family: var(--font-label);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--royal);
    margin-top: var(--space-4);
  }
  .ns-count--light {
    color: var(--gold-bright);
  }

  .ns-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }
  .filter {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
  }
  .filter:hover {
    border-color: var(--royal);
    color: var(--royal);
  }
  .filter.is-active {
    background: var(--royal);
    border-color: var(--royal);
    color: #fff;
  }

  .ns-mosaic {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
    gap: var(--space-6);
  }
  .ns-card {
    background: var(--tint);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  /* .ns-card's own `display: flex` above otherwise beats the browser's
     `[hidden] { display: none }` UA rule (equal specificity, author wins) —
     the filter script's `el.hidden = true` would do nothing without this. */
  .ns-card[hidden] {
    display: none;
  }
  .ns-card--dark {
    background: rgba(255, 255, 255, 0.08);
  }
  /* 64px, not 48px: at 48 a cropped portrait reads as a smudge. Monograms and
     photographs must be the same size or the grid loses its baseline. */
  .ns-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--royal);
    color: #fff;
    font-family: var(--font-label);
    font-size: var(--text-sm);
    margin-bottom: var(--space-2);
    flex: none;
  }
  .ns-avatar--photo {
    object-fit: cover;
    /* Faces sit high in a portrait, so bias the crop upward. */
    object-position: 50% 20%;
    background: var(--tint);
  }
  .ns-card--dark .ns-avatar {
    background: var(--gold);
    color: var(--navy);
  }
  .ns-card--dark .ns-avatar--photo {
    background: rgba(255, 255, 255, 0.12);
  }
  .ns-field {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold-text);
    margin: 0;
  }
  .ns-card--dark .ns-field {
    color: var(--gold-bright);
  }
  .ns-card h3 {
    margin: 0;
    font-size: var(--text-md);
  }
  .ns-card--dark h3 {
    color: #fff;
  }
  .ns-note {
    color: var(--muted);
    font-size: var(--text-sm);
    margin: 0;
    flex: 1;
  }
  .ns-card--dark .ns-note {
    color: rgba(255, 255, 255, 0.8);
  }
  .ns-chapter {
    font-size: var(--text-xs);
    color: var(--royal);
    font-weight: 700;
  }
  .ns-chapter--light {
    color: var(--gold-bright);
  }

  .ns-spotlight {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }
  .ns-spotlight li {
    display: grid;
    grid-template-columns: 40px 64px 1fr;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-6);
    background: var(--tint);
    border-radius: var(--radius-lg);
  }
  .ns-spotlight__num {
    font-family: var(--font-label);
    color: var(--gold-text);
    font-size: var(--text-lg);
  }
  .ns-spotlight h3 {
    margin: var(--space-1) 0;
    font-size: var(--text-md);
  }
  .ns-spotlight p:not(.ns-field) {
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 600px) {
    .ns-spotlight li {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .ns-spotlight .ns-avatar {
      margin-inline: auto;
    }
  }

  /* Attribution is a licence condition, so it is legible body copy on the
     page, not a hidden comment or a tooltip. */
  .ns-credits {
    border-top: 1px solid var(--line);
    background: var(--tint);
  }
  .ns-credits__title {
    font-size: var(--text-h3);
    margin: 0;
  }
  .ns-credits__intro {
    color: var(--muted);
    max-width: 46rem;
    margin: var(--space-4) 0 var(--space-6);
  }
  .ns-credits__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: var(--space-3) var(--space-8);
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .ns-credits__list strong {
    color: var(--ink);
  }
</style>

<script>
  const buttons = document.querySelectorAll(".filter");
  const cards = document.querySelectorAll("#soror-mosaic .ns-card");
  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      buttons.forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      const filter = (btn as HTMLElement).dataset.filter;
      cards.forEach((card) => {
        const el = card as HTMLElement;
        el.hidden = filter !== "all" && el.dataset.category !== filter;
      });
    });
  });
</script>
