---
/**
 * Notable Sigmas — ported from about/notable-sigmas/notablesigmas.html.
 *
 * None of the referenced notable-*.jpg source images exist in images/ (the
 * original page relies entirely on its onerror->initials fallback), so this
 * page uses initials avatars as the primary treatment rather than pointing
 * at photos that would just 404.
 */
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import CtaBand from "../../components/CtaBand.astro";

const filters = [
  { key: "all", label: "All" },
  { key: "arts", label: "Arts & Entertainment" },
  { key: "education", label: "Education" },
  { key: "law", label: "Law" },
  { key: "business", label: "Business" },
  { key: "public", label: "Public Service" },
  { key: "advocacy", label: "Advocacy" },
  { key: "literature", label: "Literature & Journalism" },
  { key: "athletics", label: "Athletics" },
];

const famousSorors = [
  {
    initials: "HM",
    field: "Arts & Entertainment",
    cat: "arts",
    name: "Hattie McDaniel",
    note: "First African American to win an Academy Award; charter member of Sigma Sigma Chapter in Los Angeles.",
    chapter: "Sigma Sigma Chapter",
  },
  {
    initials: "AMH",
    field: "Arts & Entertainment",
    cat: "arts",
    name: "Anna Maria Horsford",
    note: "Veteran actress known for Amen, The Wayans Bros., Friday, Set It Off, and The Bold and the Beautiful.",
  },
  {
    initials: "MR",
    field: "Arts & Entertainment",
    cat: "arts",
    name: "Martha Reeves",
    note: "Legendary Motown singer and lead vocalist of Martha and the Vandellas.",
  },
  {
    initials: "VR",
    field: "Arts & Entertainment",
    cat: "arts",
    name: "Vickilyn Reynolds",
    note: "Actress, singer, and stage performer known for Friday and an extensive career in theater.",
  },
  {
    initials: "SB",
    field: "Advocacy",
    cat: "advocacy",
    name: "Sandra Bland",
    note: "Civil-rights activist whose life and death became central to national conversations about policing, racial justice, and Black women's safety.",
  },
  {
    initials: "DRS",
    field: "Education & Civic Leadership",
    cat: "education",
    name: "Dr. Rosa Slade Gragg",
    note: "Educator and civil-rights leader who built Detroit's 'Tuskegee of the North' and advised three U.S. presidents.",
    chapter: "Rho Sigma Alumnae Chapter",
  },
  {
    initials: "SSB",
    field: "Education",
    cat: "education",
    name: "Selena Sloan Butler",
    note: "Founder of the first Black parent-teacher association and a major force in the national parent-teacher movement.",
  },
  {
    initials: "RWW",
    field: "Law",
    cat: "law",
    name: "Ruth Whitehead Whaley",
    note: "First Black woman admitted to the North Carolina Bar and a former Legal Advisor to Sigma Gamma Rho.",
  },
  {
    initials: "MTW",
    field: "Business",
    cat: "business",
    name: "Mary T. Washington Wylie",
    note: "First Black woman in the United States to earn a Certified Public Accountant license.",
  },
  {
    initials: "GC",
    field: "Public Service",
    cat: "public",
    name: "Gwen Cherry",
    note: "First African American woman elected to the Florida House of Representatives.",
  },
  {
    initials: "MEC",
    field: "Public Service",
    cat: "public",
    name: "Mary Eugenia Charles",
    note: "First woman to serve as Prime Minister of Dominica.",
  },
  {
    initials: "GDP",
    field: "Advocacy & Public Service",
    cat: "advocacy",
    name: "Georgia Davis Powers",
    note: "Civil-rights leader and the first Black woman elected to the Kentucky Senate.",
  },
  {
    initials: "AAD",
    field: "Literature & Journalism",
    cat: "literature",
    name: "Alice Allison Dunnigan",
    note: "First African American woman credentialed to cover the White House.",
  },
  {
    initials: "JCT",
    field: "Literature & Journalism",
    cat: "literature",
    name: "Joyce Carol Thomas",
    note: "Award-winning children's and young-adult author whose work centered Black life, history, family, and imagination.",
  },
  {
    initials: "MRC",
    field: "Athletics",
    cat: "athletics",
    name: "Maritza “Ritz” Correia",
    note: "First African American woman to make the U.S. Olympic swim team and win an Olympic medal.",
  },
  {
    initials: "CJ",
    field: "Athletics",
    cat: "athletics",
    name: "Carmelita Jeter",
    note: "Olympic medalist and world-class sprinter.",
  },
  {
    initials: "RP",
    field: "Athletics",
    cat: "athletics",
    name: "Renee Powell",
    note: "PGA Hall of Fame golfer and second Black woman to compete on the LPGA Tour.",
  },
  {
    initials: "YMM",
    field: "Athletics",
    cat: "athletics",
    name: "Yolett McPhee-McCuin",
    note: "Head coach of Ole Miss women's basketball and a national leader in collegiate athletics.",
  },
  {
    initials: "BJ",
    field: "Literature & Journalism",
    cat: "literature",
    name: "Beverly Jenkins",
    note: "Acclaimed author of historical and contemporary romance novels centered on Black life and history.",
  },
  {
    initials: "TMC",
    field: "Education & Writing",
    cat: "education",
    name: "Tressie McMillan Cottom",
    note: "Writer, sociologist, professor, and public intellectual.",
  },
];

const honoraryMembers = [
  {
    initials: "ML",
    field: "Arts & Entertainment",
    name: "MC Lyte",
    note: "Pioneering rapper, actress, entrepreneur, and influential figure in hip-hop and entertainment.",
  },
  {
    initials: "FB",
    field: "Arts & Entertainment",
    name: "Fantasia Barrino",
    note: "Grammy-winning singer and actress.",
  },
  {
    initials: "MA",
    field: "Arts & Entertainment",
    name: "Marsha Ambrosius",
    note: "Grammy-nominated singer, songwriter, and producer.",
  },
  {
    initials: "WRR",
    field: "Arts & Entertainment",
    name: "Wendy Raquel Robinson",
    note: "Actress, producer, and co-founder of Amazing Grace Conservatory.",
  },
  {
    initials: "BL",
    field: "Public Service",
    name: "Barbara Lee",
    note: "Former U.S. Representative and elected Mayor of Oakland, California.",
  },
  {
    initials: "SS",
    field: "Athletics",
    name: "Sheryl Swoopes",
    note: "Basketball icon, three-time WNBA MVP, and first player signed by the WNBA.",
  },
  {
    initials: "KR",
    field: "Business",
    name: "Kim Roxie",
    note: "Founder of LAMIK Beauty and breast-cancer advocate.",
  },
];

const spotlight = [
  {
    n: "01",
    field: "Civic Leadership",
    name: "Dr. Rosa Slade Gragg",
    note: "A Detroit institution-builder whose work connected education, civil rights, and national public service.",
  },
  {
    n: "02",
    field: "Law",
    name: "Ruth Whitehead Whaley",
    note: "A legal trailblazer whose career reflected both professional excellence and long-term service to Sigma Gamma Rho.",
  },
  {
    n: "03",
    field: "Literature",
    name: "Joyce Carol Thomas",
    note: "An award-winning author whose books gave Black children and families a central place in American literature.",
  },
];
---

<Base
  title="Notable Sigmas"
  activeTop="About"
  description="Sigma Gamma Rho's famous Sorors, honorary members, and member spotlights across law, government, entertainment, education, athletics, and business."
>
  <Hero
    eyebrow="Notable Sigmas"
    title="Women Who"
    highlight="Moved the World."
    copy="From firsts in law, government, entertainment, education, athletics, and business to women whose service reshaped entire communities, Sigma Gamma Rho's story is also the story of women whose work reached far beyond themselves."
    variant="plain"
    accent="navy"
    align="left"
  >
    <a href="#famous-sorors" class="btn btn--outline on-dark">
      Famous Sorors
    </a>
    <a href="#honorary-members" class="btn btn--outline on-dark">
      Honorary Members
    </a>
    <a href="#member-spotlight" class="btn btn--outline on-dark">
      Member Spotlight
    </a>
  </Hero>

  <section class="ns-intro">
    <div class="container ns-intro__grid">
      <div>
        <p class="eyebrow">A Living Record of Achievement</p>
        <h2>
          Not fame for fame's sake. <span>Impact with substance.</span>
        </h2>
      </div>
      <p class="ns-intro__copy">
        This page separates well-known Sorors from honorary members and uses Member Spotlight to
        feature women whose impact deserves deeper attention. Chapter information appears only when
        it is known and documented; it is not used as a separate public-facing category.
      </p>
    </div>
  </section>

  <section class="ns-section" id="famous-sorors">
    <div class="container">
      <div class="ns-heading">
        <p class="eyebrow">Famous Sorors</p>
        <h2>
          Recognized names. <span>Documented legacy.</span>
        </h2>
        <p>
          Sorors whose work became nationally or internationally visible across culture, public
          service, education, law, business, journalism, advocacy, and sport.
        </p>
      </div>

      <div class="ns-filters" role="group" aria-label="Filter Famous Sorors">
        {filters.map((f) => (
          <button
            class:list={["filter", { "is-active": f.key === "all" }]}
            type="button"
            data-filter={f.key}
          >
            {f.label}
          </button>
        ))}
      </div>

      <div class="ns-mosaic" id="soror-mosaic">
        {famousSorors.map((s) => (
          <article class="ns-card" data-category={s.cat}>
            <span class="ns-avatar">{s.initials}</span>
            <p class="ns-field">{s.field}</p>
            <h3>{s.name}</h3>
            <p class="ns-note">{s.note}</p>
            {s.chapter && <span class="ns-chapter">{s.chapter}</span>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ns-section ns-section--dark" id="honorary-members">
    <div class="container">
      <div class="ns-heading">
        <p class="eyebrow eyebrow--light">Honorary Members</p>
        <h2>
          Women welcomed into <span>the sisterhood by honor.</span>
        </h2>
        <p>
          Honorary membership is presented separately from Soror profiles so the distinction remains
          clear and historically accurate.
        </p>
      </div>
      <div class="ns-mosaic ns-mosaic--honorary">
        {honoraryMembers.map((h) => (
          <article class="ns-card ns-card--dark">
            <span class="ns-avatar">{h.initials}</span>
            <p class="ns-field">{h.field}</p>
            <h3>{h.name}</h3>
            <p class="ns-note">{h.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ns-section" id="member-spotlight">
    <div class="container">
      <div class="ns-heading">
        <p class="eyebrow">Member Spotlight</p>
        <h2>
          Stories worth <span>stopping for.</span>
        </h2>
        <p>
          A rotating editorial feature for Sorors whose accomplishments, service, or historical
          significance deserve more than a single line in a gallery.
        </p>
      </div>
      <ol class="ns-spotlight">
        {spotlight.map((s) => (
          <li>
            <span class="ns-spotlight__num">{s.n}</span>
            <span class="ns-avatar">
              {s.name
                .split(" ")
                .map((w) => w[0])
                .slice(0, 3)
                .join("")}
            </span>
            <div>
              <p class="ns-field">{s.field}</p>
              <h3>{s.name}</h3>
              <p>{s.note}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand
    eyebrow="Greater Service, Greater Progress"
    title="Achievement is visible. "
    highlight="Service remains the standard."
    copy="The women featured here represent only a portion of Sigma Gamma Rho's broader story. Across every generation, members have carried the Sorority's ideals into classrooms, courtrooms, boardrooms, studios, legislatures, communities, and fields of competition."
    actions={[{ label: "Explore Our Herstory", href: "/about/herstory/" }]}
  />
</Base>

<style>
  .ns-intro {
    background: var(--white);
    padding-block: clamp(3rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
  }
  .ns-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-12);
    align-items: start;
  }
  .ns-intro__grid h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .ns-intro__grid h2 span {
    color: var(--gold);
  }
  .ns-intro__copy {
    color: var(--muted);
  }
  @media (max-width: 780px) {
    .ns-intro__grid {
      grid-template-columns: 1fr;
    }
  }

  .ns-section {
    padding-block: clamp(3rem, 6vw, 4.5rem);
    background: var(--white);
  }
  .ns-section--dark {
    background: var(--grad-royal);
    color: #fff;
  }
  .ns-section--dark p:not(.eyebrow) {
    color: rgba(255, 255, 255, 0.85);
  }
  .ns-heading {
    max-width: 46rem;
    margin-bottom: var(--space-8);
  }
  .ns-heading h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .ns-heading h2 span {
    color: var(--gold);
  }
  .ns-heading > p:not(.eyebrow) {
    color: var(--muted);
    margin-top: var(--space-4);
  }
  .ns-section--dark .ns-heading > p:not(.eyebrow) {
    color: rgba(255, 255, 255, 0.8);
  }
  .eyebrow--light {
    color: var(--gold-bright);
  }

  .ns-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }
  .filter {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
  }
  .filter:hover {
    border-color: var(--royal);
    color: var(--royal);
  }
  .filter.is-active {
    background: var(--royal);
    border-color: var(--royal);
    color: #fff;
  }

  .ns-mosaic {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-6);
  }
  .ns-card {
    background: var(--tint);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .ns-card--dark {
    background: rgba(255, 255, 255, 0.08);
  }
  .ns-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--royal);
    color: #fff;
    font-family: var(--font-label);
    font-size: var(--text-sm);
    margin-bottom: var(--space-2);
  }
  .ns-card--dark .ns-avatar {
    background: var(--gold);
    color: var(--navy);
  }
  .ns-field {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold-dark);
    margin: 0;
  }
  .ns-card--dark .ns-field {
    color: var(--gold-bright);
  }
  .ns-card h3 {
    margin: 0;
    font-size: var(--text-md);
  }
  .ns-card--dark h3 {
    color: #fff;
  }
  .ns-note {
    color: var(--muted);
    font-size: var(--text-sm);
    margin: 0;
    flex: 1;
  }
  .ns-card--dark .ns-note {
    color: rgba(255, 255, 255, 0.8);
  }
  .ns-chapter {
    font-size: var(--text-xs);
    color: var(--royal);
    font-weight: 700;
  }

  .ns-spotlight {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }
  .ns-spotlight li {
    display: grid;
    grid-template-columns: 40px 56px 1fr;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-6);
    background: var(--tint);
    border-radius: var(--radius-lg);
  }
  .ns-spotlight__num {
    font-family: var(--font-label);
    color: var(--gold);
    font-size: var(--text-lg);
  }
  .ns-spotlight h3 {
    margin: var(--space-1) 0;
    font-size: var(--text-md);
  }
  .ns-spotlight p:not(.ns-field) {
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 600px) {
    .ns-spotlight li {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll(".filter");
  const cards = document.querySelectorAll("#soror-mosaic .ns-card");
  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      buttons.forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      const filter = (btn as HTMLElement).dataset.filter;
      cards.forEach((card) => {
        const el = card as HTMLElement;
        el.hidden = filter !== "all" && el.dataset.category !== filter;
      });
    });
  });
</script>
