---
/**
 * Our Founders — ported from the original about/our-founders/founders.html.
 *
 * Treatment: full-bleed grayscale archival hero (matching Herstory's pattern,
 * "PEARLS" watermark), a Genesis narrative split, one equal-size tile grid
 * for all seven founders (Mary Lou's "Primary Founder" distinction is a text
 * eyebrow, not a bigger card) linking to seven full anchor-linked biography
 * profiles below, and a closing legacy CTA. The tile-grid -> anchor-profile
 * pattern IS the page's "interactive exploration" — clicking a founder jumps
 * to her full story rather than just swapping a caption.
 */
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import ThenNow from "../../components/ThenNow.astro";
import Section from "../../components/Section.astro";
import CardGrid from "../../components/CardGrid.astro";
import Card from "../../components/Card.astro";
import CtaBand from "../../components/CtaBand.astro";
import Button from "../../components/Button.astro";
import PearlStrand from "../../components/PearlStrand.astro";
import DriftBand from "../../components/DriftBand.astro";
import { withBase } from "../../lib/url.js";

const founders = [
  {
    id: "mary-lou",
    name: "Mary Lou Allison Gardner Little",
    role: "Educator • Founder",
    eyebrow: "Primary Founder",
    img: "/images/our-founders-mary-lou-allison.jpg",
  },
  {
    id: "dorothy",
    name: "Dorothy Hanley Whiteside",
    role: "Educator • Founder",
    eyebrow: "Founder",
    img: "/images/our-founders-dorothy-hanley-whiteside.jpg",
  },
  {
    id: "vivian",
    name: "Vivian Irene White Marbury",
    role: "Educator • Principal • Founder",
    eyebrow: "Founder",
    img: "/images/our-founders-vivian-irene-white.jpg",
  },
  {
    id: "nannie",
    name: "Nannie Mae Gahn Johnson",
    role: "Educator • Principal • Founder",
    eyebrow: "Founder",
    img: "/images/our-founders-nannie-mae-gahn-johnson-300x300.jpg",
  },
  {
    id: "hattie",
    name: "Hattie Mae Annette Dulin Redford",
    role: "Educator • Founder",
    eyebrow: "Founder",
    img: "/images/our-founders-hattie-mae-redford-300x300.jpg",
  },
  {
    id: "bessie",
    name: "Bessie Mae Downey Rhoades Martin",
    role: "Educator • Founder",
    eyebrow: "Founder",
    img: "/images/our-founders-bessie-mae-downey-rhoades-300x300.jpg",
  },
  {
    id: "cubena",
    name: "Cubena McClure",
    role: "Educator • Artist • Founder",
    eyebrow: "Founder",
    img: "/images/our-founders-cubena-mcclure-300x300.jpg",
  },
];

const profiles = [
  {
    id: "mary-lou",
    label: "Primary Founder",
    name: "Mary Lou Allison",
    highlight: "Gardner Little",
    role: "Educator • Founder",
    img: "/images/our-founders-mary-lou-allison.jpg",
    bio: "At the young age of three, Little suffered the tragic loss of both her parents and was then raised by a family friend. She graduated from Shortridge High School in 1915 and received a diploma from the Indianapolis Normal School in 1918 when she began teaching. In 1928, Little moved to Los Angeles with her husband and finished her undergraduate training at UCLA. She taught in the Los Angeles school system until her retirement in 1967. In her honor, the Mary Lou Allison Loving Cup Award is presented at each Boulé to the chapter reporting the most successful program.",
  },
  {
    id: "dorothy",
    label: "Founder",
    name: "Dorothy Hanley",
    highlight: "Whiteside",
    role: "Educator • Founder",
    img: "/images/our-founders-dorothy-hanley-whiteside.jpg",
    bio: "Whiteside graduated from Shortridge High School and entered the Indianapolis Normal School in 1922. During her training as a cadet teacher, she met the teachers who became her best friends and fellow founders of the sorority. In 1951, she retired from teaching and later assisted her husband in developing a business. She also started her own millinery business and worked with her church and various organizations. After the death of her husband, she ran their business from 1955–1957, subsequently returning to teaching in 1959 before retiring again in 1970.",
  },
  {
    id: "vivian",
    label: "Founder",
    name: "Vivian Irene White",
    highlight: "Marbury",
    role: "Educator • Principal • Founder",
    img: "/images/our-founders-vivian-irene-white.jpg",
    bio: "Marbury attended Shortridge High School and the Indianapolis Normal School. She received a B.S. from Butler University and a Master's from Columbia University in New York City. Her professional career included teaching at Morehouse College in Atlanta, Indianapolis University, Indianapolis State University and serving as Director of Practice Training of teachers from Butler University. She served as Principal of Indianapolis Public School #87 for 39 years. She was an active member and leader in her church and several local organizations.",
  },
  {
    id: "nannie",
    label: "Founder",
    name: "Nannie Mae Gahn",
    highlight: "Johnson",
    role: "Educator • Principal • Founder",
    img: "/images/our-founders-nannie-mae-gahn-johnson-300x300.jpg",
    bio: "Johnson was a product of the Indianapolis Public School System and received both B.S. and M.S. degrees from Butler University. In 1923, she received her first teaching assignment and over the years she was promoted to principal of one of the largest elementary schools in Indianapolis. She was also very involved with many clubs and organizations dedicated to community service and retired in 1966.",
  },
  {
    id: "hattie",
    label: "Founder",
    name: "Hattie Mae Annette Dulin",
    highlight: "Redford",
    role: "Educator • Sorority Leader • Founder",
    img: "/images/our-founders-hattie-mae-redford-300x300.jpg",
    bio: "Redford graduated from South Bend Central High School cum laude, from Indiana State Teachers College with a B.S., and studied at Western Reserve in Cleveland and Indiana University extension. She taught one year in Terre Haute, and thirty-seven years in Indianapolis, Indiana. She was Grand Epistoleus, Grand Tamiochus, Financial Consultant and received various awards and honors for her sorority service. Plaques are awarded in Redford's name at each Boulé for exhibits of chapter achievements.",
  },
  {
    id: "bessie",
    label: "Founder",
    name: "Bessie Mae Downey Rhoades",
    highlight: "Martin",
    role: "Educator • Founder",
    img: "/images/our-founders-bessie-mae-downey-rhoades-300x300.jpg",
    bio: "Martin was the youngest of six children and attended grade school in Indianapolis. She graduated from the Manual Training High School and the City Teachers Normal School. Martin taught school for over 25 years. She married twice and was a devoted wife, educator, and engaged founder.",
  },
  {
    id: "cubena",
    label: "Founder",
    name: "Cubena",
    highlight: "McClure",
    role: "Educator • Artist • Founder",
    img: "/images/our-founders-cubena-mcclure-300x300.jpg",
    bio: "Cubena McClure graduated from Shortridge High School, the Indianapolis City Normal School and attended Western Reserve University in Cleveland, Ohio. She won the Gregg Scholarship, which she planned to use to attend Columbia University; unfortunately, illness prevented her from accepting the scholarship. McClure was talented in art and she helped to design the Sorority pin. She died very young on August 24, 1924.",
  },
];
---

<Base
  title="Our Founders"
  activeTop="About Us"
  description="Meet the seven Black educators who founded Sigma Gamma Rho Sorority, Incorporated at Butler University in 1922."
  preloadImage="/optimized/sgr-alpha-charter.webp"
>
  <PageHero
    editorial
    stack
    eyebrow="Our Founders · The Seven Pearls"
    title="Seven educators."
    highlight="A lasting purpose."
    copy="Seven Black educators. One shared conviction. A sisterhood created in Indianapolis in 1922 and carried forward for generations."
    image="/optimized/hero-founders.webp"
    focal="50% 50%"
    archival
    badge={{ label: "Founded", value: "1922" }}
    size="tall"
  >
    <Button href="#seven-pearls">Meet the Seven Pearls</Button>
    <Button href="/about/herstory/" variant="outline" onDark>
      Explore Our Herstory
    </Button>
  </PageHero>

  <!-- GENESIS -->
  <Section
    tone="white"
    eyebrow="Indianapolis • November 12, 1922"
    title="The Genesis at Butler University"
    align="left"
  >
    <div class="split">
      <div class="split__copy">
        <p>
          On November 12, 1922, seven young Black educators came together in Indianapolis, Indiana,
          while pursuing further education at Butler University. They did so during an era defined
          by segregation, restricted opportunity, and intense racial hostility. In 1920s Indiana,
          the Ku Klux Klan wielded significant political and social influence, shaping the
          environment in which these women lived, studied, and worked.
        </p>
        <p>
          Against that backdrop, they established Sigma Gamma Rho Sorority, Incorporated. As the
          only sorority of the National Pan-Hellenic Council founded at a predominantly white
          institution, Sigma Gamma Rho occupies a distinct place in the history of Black
          Greek-letter organizations.
        </p>
        <p>
          The Founders created more than a sisterhood. They built an institution rooted in
          education, mutual support, professional advancement, and service to the Black community.
          Their work reflected a conviction that Black women could create their own structures of
          opportunity, cultivate future generations of leaders, and use education as an instrument
          of progress.
        </p>
        <p class="split__emphasis">
          What began with seven educators in Indianapolis became a legacy carried forward by
          generations of Sigma women.
        </p>
      </div>
      <figure class="split__figure">
        <img
          src={withBase("/images/College Avenue Campus.jpg")}
          alt="Historic Butler University campus"
        />
        <figcaption>
          <span>Butler University</span>
          <small>Indianapolis, Indiana</small>
        </figcaption>
      </figure>
    </div>
  </Section>

  <section class="founders-pair" aria-label="The Founders and the Sorority today">
    <div class="container">
      <ThenNow
        then={{
          img: "/optimized/hero-founders.webp",
          alt: "Portraits of the seven Founders",
          caption: "The seven Founders",
          year: "1922",
        }}
        now={{
          img: "/optimized/home-boule-stage.webp",
          alt: "The 2026–2028 International Board of Directors on stage at the 61st Boulé",
          caption: "The International Board of Directors at the 61st Boulé, Tampa, 2026",
          year: "Today",
        }}
      />
    </div>
  </section>

  <!-- The seven names as the portraits' prelude (hidden from screen
       readers: each name follows below). -->
  <DriftBand
    words={[
      "Mary Lou Allison Gardner Little",
      "Dorothy Hanley Whiteside",
      "Vivian Irene White Marbury",
      "Nannie Mae Gahn Johnson",
      "Hattie Mae Annette Dulin Redford",
      "Bessie Mae Downey Rhoades Martin",
      "Cubena McClure",
    ]}
  />

  <!-- SEVEN PORTRAITS -->
  <Section
    id="seven-pearls"
    tone="cream"
    align="left"
    eyebrow="The Women Who Began It"
    title="Meet the"
    highlight="7 Pearls"
    lead="Seven individual lives. One shared purpose. Select a portrait to explore the educator behind the legacy."
  >
    <div class="founder-pearls"><PearlStrand /></div>
    <div class="founder-grid">
      <CardGrid min="200px" cols={4}>
        {founders.map((f) => (
          <Card
            href={`#${f.id}`}
            image={f.img}
            imageAlt={f.name}
            eyebrow={f.eyebrow}
            title={f.name}
          >
            <p class="tile-role">{f.role}</p>
            <span class="tile-action">
              Read her story <span aria-hidden="true">↗</span>
            </span>
          </Card>
        ))}
      </CardGrid>
    </div>
  </Section>

  <!-- FOUNDER PROFILES -->
  <section class="profiles">
    {profiles.map((p, i) => (
      <article id={p.id} class:list={["profile", { "profile--flip": i % 2 === 1 }]}>
        <div class="container profile__inner">
          <figure class="profile__figure">
            <img
              src={withBase(p.img)}
              alt={`${p.name} ${p.highlight}`}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="profile__copy">
            <p class="profile__label">
              <span aria-hidden="true">{String(i + 1).padStart(2, "0")} / 07</span> {p.label}
            </p>
            <h2>
              {p.name} <span>{p.highlight}</span>
            </h2>
            <p class="profile__role">{p.role}</p>
            <div class="profile__rule"></div>
            <p>{p.bio}</p>
            <a class="profile__return" href="#seven-pearls">
              Meet all seven founders <span aria-hidden="true">↑</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </section>

  <CtaBand
    image="/optimized/cta-cultured-pearls.webp"
    focal="60% 30%"
    eyebrow="Their Legacy, Our Responsibility"
    title="Seven Women Began the Work. "
    highlight="Generations Carry It Forward."
    copy="The Founders did not create Sigma Gamma Rho simply for their own time. They established a structure capable of educating, serving, supporting, and developing Black women across generations. Greater Service. Greater Progress."
    actions={[
      { label: "Explore Membership", href: "/membership/become-a-member/" },
      {
        label: "Their Legacy in Service",
        href: "/service-impact/national-programs/",
        variant: "outline",
      },
    ]}
  />
</Base>

<style>
  .founders-pair {
    padding-block: 0 clamp(3rem, 6vw, 4.5rem);
    background: var(--white);
  }
  .tile-role {
    font-size: var(--text-xs);
    color: var(--muted);
    margin: 0;
  }
  .founder-grid :global(.card__img) {
    aspect-ratio: 4 / 5;
    object-position: top center;
  }
  .founder-grid :global(.card) {
    border: 0;
    border-radius: 0;
    background: transparent;
  }
  .founder-grid :global(.card__body) {
    padding: var(--space-5) 0 var(--space-2);
    border-top: 3px solid var(--gold);
  }
  .founder-grid :global(.card__eyebrow) {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .tile-action {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--royal);
  }
  :global(#seven-pearls) {
    scroll-margin-top: var(--space-24);
  }
  /* Seven pearls over the seven portraits (PearlStrand). */
  .founder-pearls {
    margin-bottom: var(--space-8);
  }

  /* ---- GENESIS split (matches herstory's "Beginning" pattern) ---- */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: var(--space-16);
    align-items: center;
  }
  .split__emphasis {
    font-family: var(--font-editorial);
    font-size: var(--text-h3);
    line-height: 1.4;
    color: var(--royal);
  }
  .split__figure {
    margin: 0;
    border-bottom: 4px solid var(--gold);
    overflow: hidden;
  }
  .split__figure img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .split__figure figcaption {
    display: flex;
    flex-direction: column;
    padding: var(--space-4) var(--space-6);
    background: var(--royal);
    color: var(--white);
  }
  .split__figure figcaption small {
    color: var(--text-on-dark-soft);
  }
  @media (max-width: 820px) {
    .split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  /* ---- FOUNDER PROFILES ---- */
  .profile {
    padding-block: var(--section-y);
    scroll-margin-top: var(--space-24);
  }
  .profile:nth-child(odd) {
    background: var(--white);
  }
  .profile:nth-child(even) {
    background: var(--cream);
  }
  .profile__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }
  .profile--flip .profile__inner {
    direction: rtl;
  }
  .profile--flip .profile__inner > * {
    direction: ltr;
  }
  .profile__figure {
    margin: 0;
    padding: var(--space-3);
    border: 1px solid var(--line-strong);
    overflow: hidden;
  }
  .profile__figure img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top center;
  }
  .profile__label {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    color: var(--accent-text);
    font-weight: 700;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 var(--space-2);
  }
  .profile__copy h2 {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: var(--text-h2);
    font-weight: 500;
    line-height: 1.15;
  }
  .profile__copy h2 span {
    display: block;
    color: var(--accent-text);
    font-style: italic;
  }
  .profile__role {
    color: var(--muted);
    font-weight: 700;
    margin: var(--space-1) 0 0;
  }
  .profile__rule {
    width: 3rem;
    height: 2px;
    background: var(--gold);
    margin: var(--space-4) 0;
    border-radius: 2px;
  }
  .profile__copy > p:not([class]) {
    color: var(--ink);
    margin: 0;
  }
  .profile__return {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
    font-weight: 700;
    font-size: var(--text-sm);
    text-underline-offset: 0.3em;
  }
  @media (max-width: 820px) {
    .profile__inner {
      grid-template-columns: 1fr;
      direction: ltr !important;
    }
    .profile__figure {
      max-width: 320px;
    }
  }
</style>
