---
/**
 * Herstory — rebuilt as bespoke markup matching about/herstory/herstory.css
 * exactly, rather than the shared Hero/Section/Card components, because this
 * page's structure is one-of-a-kind: a bordered "table" fact grid, a
 * two-column Firsts layout, and a 3-column timeline with per-chapter aside
 * cards — quote / stat / impact-list / plain — matching the original.
 * (Headings are still LEMON MILK, per AGENTS.md §6.)
 */
import Base from "../../layouts/Base.astro";
import Button from "../../components/Button.astro";
import CtaBand from "../../components/CtaBand.astro";
import { withBase } from "../../lib/url.js";

/** `link.external` decides the arrow: ↗ leaves the site, → stays on it. */
type Fact = {
  n: string;
  label: string;
  title: string;
  body: string;
  link?: { label: string; href: string; external: boolean; srSuffix?: string };
};

const facts: Fact[] = [
  { n: "01", label: "Founded", title: "November 12, 1922", body: "Indianapolis, Indiana" },
  {
    n: "02",
    label: "Founding Institution",
    title: "Butler University",
    body: "The only NPHC sorority founded at a predominantly white institution.",
  },
  {
    n: "03",
    label: "Founders",
    title: "Seven Educators",
    body: "Women whose professional lives were already rooted in education and service.",
  },
  {
    n: "04",
    label: "National Incorporation",
    title: "December 30, 1929",
    body: "Sigma Gamma Rho became an incorporated national collegiate sorority.",
  },
  {
    n: "05",
    label: "Motto",
    title: "Greater Service, Greater Progress",
    body: "A century-long standard for service and institutional responsibility.",
  },
  {
    n: "06",
    label: "Official Colors",
    title: "Royal Blue & Gold",
    body: "Reflecting a glorious wealth of values, truth, and purity. An enduring hallmark of regal character and unwavering commitment to sisterhood.",
  },
  {
    n: "07",
    label: "Official Flower",
    title: "Yellow Tea Rose",
    body: "Symbolic of beauty, resilience, and radiance. Delicate yet enduring through life’s trials, it mirrors the Sigma woman’s lasting fragrance of charm, dignity, and concern.",
  },
  {
    n: "08",
    label: "Headquarters",
    title: "Cary, North Carolina",
    body: "Home of the International Corporate Headquarters.",
    link: { label: "Visit International HQ", href: "/about/headquarters/", external: false },
  },
  {
    n: "09",
    label: "Official Mascot",
    title: "The Poodle",
    body: "Introduced by 8th Southwestern Region Syntaktes Quindonell S. Robertson. Selected for its sophisticated bearing, beauty, and keen intellect, standing as an enduring symbol of poise and grace.",
  },
  {
    n: "10",
    label: "Official Publication",
    title: "The Aurora",
    // 1927, not 1930: The Aurora's own Issuu profile and the PALNI Butler
    // centennial archive both date its launch to 1927 (first editor-in-chief
    // Gertrude Murchison).
    body: "Established in 1927 to document national achievements, voice, and chapter progress.",
    link: {
      label: "Read Latest Issue",
      href: "https://issuu.com/sgrho.theauroramagazine",
      external: true,
      srSuffix: " of The Aurora on Issuu (opens in a new tab)",
    },
  },
];

const firsts = [
  {
    n: "01",
    title: "Founded at a PWI",
    body: "The only NPHC sorority established at a predominantly white institution — Butler University in Indianapolis, Indiana — in 1922.",
  },
  {
    n: "02",
    title: "Educator-Led Origins",
    body: "The only NPHC sorority founded solely by working educators, beginning as a professional society centered on scholarship, training, and service.",
  },
  {
    n: "03",
    title: "Beyond Howard University",
    body: "The only historically Black sorority within the NPHC founded outside of Howard University, establishing an autonomous Midwest lineage.",
  },
  {
    n: "04",
    title: "1928 Pan-Hellenic Precursor",
    body: "Shaped the pivotal 1928 Indianapolis roundtables that laid the Midwestern groundwork for the National Pan-Hellenic Council before full membership in 1937.",
  },
  {
    n: "05",
    title: "First Official Youth Affiliate",
    body: "Pioneered the Rhoer Club in 1939, becoming the first NPHC organization to establish a chartered national leadership auxiliary for teenage girls.",
  },
  {
    n: "06",
    title: "Non-Degreed Women’s Pipeline",
    body: "Pioneered the Philo Affiliate (originating in 1943), breaking traditional collegiate elitism to provide non-degreed women official national service status.",
  },
];

/**
 * The century timeline. Rows alternate sides (`side`) and each closes with a
 * typed note. The note's `style` varies on purpose — plain card, gold card,
 * stat block, quote — because a repeating aside is what would make ten rows
 * read as one long scroll (see the herstory benchmark in DESIGN notes).
 */
const timeline = [
  {
    n: "01",
    side: "left",
    year: "1922",
    label: "The Bold Inception",
    head: "Seven Educators Defy the Odds",
    body: "Founded on November 12, 1922, at Butler University in Indianapolis, Indiana, by seven trailblazing schoolteachers. In an era of intense midwestern racial hostility, they built an autonomous, educator-led sisterhood.",
    note: {
      style: "plain",
      kind: "Key Distinction",
      text: "The only NPHC sorority founded at a predominantly white institution (PWI).",
    },
  },
  {
    n: "02",
    side: "right",
    year: "1925",
    label: "Codifying the Vision",
    head: "The First National Boulé",
    body: "Convening its first national convention, the Sorority established its democratic governance, national officers, and cultural traditions, officially adopting the motto: “Greater Service, Greater Progress.”",
    note: {
      style: "gold",
      kind: "Milestone",
      text: "Formal adoption of national leadership and organizational constitution.",
    },
  },
  {
    n: "03",
    side: "left",
    year: "1928–1937",
    label: "Expanding the Reach",
    head: "Collegiate Charter & NPHC Unity",
    body: "After shaping the 1928 Indianapolis roundtables that laid the groundwork for the National Pan-Hellenic Council, the Sorority incorporated as a national collegiate body with Alpha Chapter (1929) and joined the NPHC as a full member in 1937.",
    note: {
      style: "stat",
      number: "1937",
      kind: "Milestone",
      text: "Transition from professional society to chartered national collegiate body.",
    },
  },
  {
    n: "04",
    side: "right",
    year: "1930s",
    label: "Depression-Era Economic Aid & Global Literacy",
    head: "Vocational Defense and Cross-Border Support",
    body: "Confronting economic collapse, the Sorority created an internal Employment Aid Bureau to secure teaching placements for Black women, mandated permanent chapter scholarship funds, and launched the African Book Shower Project to send educational supplies to the Wilberforce Institute in South Africa.",
    note: {
      style: "plain",
      kind: "Impact",
      text: "Economic resilience, educational defense, and early international educational diplomacy.",
    },
  },
  {
    n: "05",
    side: "left",
    year: "1939–1943",
    label: "Multigenerational Pipelines",
    head: "Pioneering Youth & Community Affiliates",
    body: "Redefining Greek auxiliaries, Sigma Gamma Rho established the Rhoer Club (1939) as the first national NPHC youth affiliate for teens, followed by the Philo Affiliate (originating in 1943) to welcome non-degreed community women into active civic leadership.",
    note: {
      style: "gold",
      kind: "Firsts",
      text: "First national teen auxiliary and inclusive non-degreed women’s affiliate.",
    },
  },
  {
    n: "06",
    side: "right",
    year: "1940s",
    label: "“Teen Towns” & Wartime Youth Welfare",
    head: "Safe Havens for the Next Generation",
    body: "In response to World War II community disruption and rapid migration, chapters pioneered “Teen Towns” — dedicated recreational and vocational centers providing wholesome mentorship, creative arts, and social development to protect Black youth from delinquency and neglect.",
    note: {
      style: "plain",
      kind: "Milestone",
      text: "Grassroots civic innovation in urban youth welfare.",
    },
  },
  {
    n: "07",
    side: "left",
    year: "1950s–1960s",
    label: "Civil Rights & Literacy Action",
    head: "Direct Action and Desegregation Advocacy",
    body: "Sorors mobilized across the South and urban centers, funding civil rights legal defense campaigns, organizing voter registration drives, and running regional book drives and mobile bookmobiles to supply underfunded, segregated schools and libraries.",
    note: {
      style: "gold",
      kind: "Impact",
      text: "Active participation in voter defense, legal relief, and literacy access.",
    },
  },
  {
    n: "08",
    side: "right",
    year: "1972",
    label: "Public Health Leadership",
    head: "Project Reassurance with March of Dimes",
    // Conservative wording until HQ confirms the "first" claim. Original copy,
    // to restore once verified: "Sigma Gamma Rho became the first Black
    // Greek-letter organization to enter an official nationwide partnership
    // with a major national public health foundation…" / note: "First NPHC
    // nationwide partnership with a national health foundation."
    body: "In 1972, Sigma Gamma Rho established Project Reassurance in partnership with the March of Dimes, launching a groundbreaking nationwide campaign targeting maternal health disparities, prenatal care, and infant mortality prevention in vulnerable communities.",
    note: {
      style: "quote",
      kind: "Milestone",
      line: "A Landmark",
      text: "Health Alliance.",
    },
  },
  {
    n: "09",
    side: "left",
    year: "1990s–2000s",
    label: "Global Footprint & Swim 1922",
    head: "Global Charters & Aquatic Safety",
    // Conservative wording until HQ confirms the "first" claim. Original note,
    // to restore once verified: "…and first African American national partner
    // of USA Swimming." Also unresolved: Swim 1922 launched in 2012, outside
    // this row's 1990s–2000s range.
    body: "The Sorority expanded internationally across the Caribbean, Europe, and Africa. Through the historic Swim 1922 campaign, it formed a pioneering nationwide alliance with USA Swimming, breaking cultural barriers and generational trauma to bring essential water safety and swim clinics to minority youth across the country.",
    note: {
      style: "plain",
      kind: "Impact",
      text: "Worldwide charter expansion and a pioneering national alliance with USA Swimming.",
    },
  },
  {
    n: "10",
    side: "right",
    year: "Today",
    label: "The Centenary & Beyond",
    head: "Unbroken Legacy, Boundless Future",
    body: "With over 100 years of documented leadership, thousands of members across hundreds of chapters carry the founders’ standard forward — advancing social justice, women’s health, education, and community self-reliance.",
    note: {
      style: "quote",
      kind: "Movement",
      line: "A century of sisterhood.",
      text: "Greater Service. Greater Progress. Still in motion.",
    },
  },
];

const regions = [
  {
    n: "01",
    meta: "Established 1925 • Organized 1940",
    name: "Central",
    lead: "The first region to form — and the region in which Sigma Gamma Rho itself was born.",
    body: "Sorors here originated many of the Sorority's defining elements: the Pledge, National Hymn, Slogan, Badge, Coat of Arms, Flower, and Colors.",
  },
  {
    n: "02",
    meta: "December 29, 1939",
    name: "Northeastern",
    lead: "Organized at the 14th Boulé when the Sorority expanded from two regions to four.",
    body: "Soror Edna F. Browne, “The Mother of the Northeastern Region,” became its first Syntaktes.",
  },
  {
    n: "03",
    meta: "Established 1939",
    name: "Southeastern",
    lead: "Created during the Sorority's 1939 regional restructuring.",
    body: "Soror Elizabeth Lemon served as the first Syntaktes as the Sorority strengthened its leadership structure throughout the Southeast.",
  },
  {
    n: "04",
    meta: "Voted 1939 • Organized 1940",
    name: "Southwestern",
    lead: "Organized under first Syntaktes Soror Mary Scales Greenwood of Houston.",
    body: "Contributed enduring traditions including the Poodle as official mascot and the development of the Philo Affiliate.",
  },
  {
    n: "05",
    meta: "December 1952",
    name: "Western",
    lead: "The fifth and most recently established of today's regions.",
    body: "Formerly part of Southwestern Region, organized under first Syntaktes Soror Lessie B. Crossland; first conference in 1953.",
  },
];
---

<Base
  title="Herstory"
  activeTop="About"
  description="Explore the history, milestones, regional development, and enduring legacy of Sigma Gamma Rho Sorority, Incorporated."
>
  <!-- HERO -->
  {/* on-dark: this hero's ground is navy, so global.css needs to know to use
      full-chroma gold for the eyebrow rather than the dark type-safe gold. */}
  <section class="hs-hero on-dark">
    <div class="hs-hero__image"></div>
    <div class="hs-hero__overlay"></div>
    <div class="container hs-hero__content">
      <p class="eyebrow">Our History. Our Legacy. Our Future.</p>
      <h1 class="hs-hero__title">
        Her<span>story</span>
      </h1>
      <div class="gold-rule"></div>
      <p class="hs-hero__copy">
        Founded by seven educators in 1922, Sigma Gamma Rho has spent more than a century turning
        scholarship, sisterhood, leadership, and service into sustained progress.
      </p>
    </div>
    <div class="hs-hero__date" aria-hidden="true">
      1922
    </div>
  </section>

  <!-- THE BEGINNING -->
  <section class="hs-section">
    <div class="container hs-split">
      <div class="hs-story-copy">
        <p class="eyebrow eyebrow--rule">The Beginning</p>
        <h2>
          A Vision Born in <span>1922</span>
        </h2>
        <p>
          On November 12, 1922, seven young educators in Indianapolis established Sigma Gamma Rho
          Sorority at Butler University.
        </p>
        <p>
          Their decision was deliberate. They built an organization grounded in scholarship, mutual
          responsibility, leadership, and public service at a time when Black women faced sharply
          limited access to institutional power.
        </p>
        <p>
          What began with seven educators became a national institution and, eventually, an
          international sisterhood.
        </p>
        <p class="hs-emphasis">Seven educators. One purpose. A legacy still in motion.</p>
        <Button href="/about/our-founders/" variant="outline">
          Meet Our Seven Founders <span aria-hidden="true">→</span>
        </Button>
      </div>
      <figure class="hs-historical-card">
        <img
          src={withBase("/images/College Avenue Campus.jpg")}
          alt="Historic Butler University campus"
        />
        <figcaption>
          <span>Butler University</span>
          <small>Indianapolis, Indiana</small>
        </figcaption>
        <div class="hs-year-badge">
          <small>Founded</small>
          <strong>1922</strong>
        </div>
      </figure>
    </div>
  </section>

  <!-- KEY FACTS -->
  <section class="hs-section hs-key-facts">
    <div class="container">
      <div class="hs-heading hs-heading--centered">
        <p class="eyebrow eyebrow--rule">At a Glance</p>
        <h2>
          Key <span>Facts</span>
        </h2>
        <p>The essential facts behind more than a century of Sigma Gamma Rho history.</p>
      </div>
      <div class="hs-facts-grid">
        {facts.map((f) => (
          <article class="hs-fact-card">
            <span class="hs-fact-number">{f.n}</span>
            <p class="hs-fact-label">{f.label}</p>
            <h3>{f.title}</h3>
            <p class="hs-fact-body">{f.body}</p>
            {f.link && (
              <a
                class="hs-fact-link"
                href={f.link.external ? f.link.href : withBase(f.link.href)}
                target={f.link.external ? "_blank" : undefined}
                rel={f.link.external ? "noopener" : undefined}
              >
                {f.link.label}
                {f.link.srSuffix && <span class="visually-hidden">{f.link.srSuffix}</span>}
                <span aria-hidden="true">{f.link.external ? " ↗" : " →"}</span>
              </a>
            )}
          </article>
        ))}
      </div>
      <p class="hs-facts-utility">
        <a href={withBase("/membership/chapter-locator/")}>
          Locate Your Region &amp; Chapters <span aria-hidden="true">&rarr;</span>
        </a>
      </p>
    </div>
  </section>

  <!-- FIRSTS & DISTINCTIONS -->
  <section class="hs-section hs-firsts">
    <div class="container hs-firsts__inner">
      <div class="hs-firsts__heading">
        <p class="eyebrow eyebrow--rule">Distinct by History</p>
        <h2>
          Firsts &amp; <span>distinctions</span>
        </h2>
        <p>
          Milestones and traditions that distinguish Sigma Gamma Rho within the history of Black
          Greek-letter organizations.
        </p>
      </div>
      <div class="hs-firsts-list">
        {firsts.map((f) => (
          <article>
            <span class="hs-firsts-num">{f.n}</span>
            <div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- MISSION & VISION -->
  <section class="hs-mv">
    <div class="container hs-mv__inner">
      <article>
        <h2>Mission</h2>
        <p>
          It is the mission of Sigma Gamma Rho Sorority, Inc. to enhance the quality of life for
          women and their families in the U.S. and globally through community service, civil, and
          social action — achieving greater progress in education, health awareness, and leadership
          development.
        </p>
      </article>
      <div class="hs-mv__divider"></div>
      <article>
        <h2>Vision</h2>
        <p>
          We visualize a world in which all women and their families reach their full potential in
          all aspects of life and are able to create unlimited opportunities for future generations.
        </p>
      </article>
    </div>
  </section>

  <!-- CENTURY IN MOTION -->
  <section class="hs-century on-dark">
    <div class="container hs-century__inner">
      <div class="hs-heading hs-heading--centered hs-heading--dark">
        <p class="eyebrow">Our Journey</p>
        <h2>
          More than a century <span>in motion</span>
        </h2>
        <p>
          From seven educators in Indianapolis to a national institution shaped by education, civic
          action, service, and organizational growth.
        </p>
      </div>
      <div class="hs-century__story">
        {timeline.map((t) => (
          <div class:list={["hs-chapter", t.side === "right" && "hs-chapter--right"]}>
            <div class="hs-chapter__year">
              {/* Ranges break after the dash so "1950s–1960s" fits the rail. */}
              {t.year.split("–").map((part, i, all) => (
                <span>
                  {/* LEMON MILK has no lowercase, so "1930s" would read
                      "1930S". The decade's s is set in Montserrat instead. */}
                  {part.endsWith("s") ? (
                    <>
                      {part.slice(0, -1)}
                      <span class="hs-chapter__decade">s</span>
                    </>
                  ) : (
                    part
                  )}
                  {i < all.length - 1 && "–"}
                </span>
              ))}
            </div>
            <div class="hs-chapter__copy">
              <p class="hs-chapter__label">
                {t.n} &middot; {t.label}
              </p>
              <h3>{t.head}</h3>
              <p>{t.body}</p>
            </div>
            {t.note.style === "plain" && (
              <div class="hs-chapter__aside">
                <p class="hs-chapter__kind">{t.note.kind}</p>
                <p class="hs-chapter__note">{t.note.text}</p>
              </div>
            )}
            {t.note.style === "gold" && (
              <div class="hs-chapter__aside hs-chapter__aside--gold">
                <p class="hs-chapter__kind">{t.note.kind}</p>
                <p class="hs-chapter__note">{t.note.text}</p>
              </div>
            )}
            {t.note.style === "stat" && (
              <div class="hs-chapter__stat">
                <span class="hs-stat-number">{t.note.number}</span>
                <span class="hs-stat-label">{t.note.kind}</span>
                <p class="hs-stat-note">{t.note.text}</p>
              </div>
            )}
            {t.note.style === "quote" && (
              <div class="hs-chapter__quote">
                <p class="hs-chapter__kind">{t.note.kind}</p>
                <span>{t.note.line}</span>
                <strong>{t.note.text}</strong>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- REGIONS -->
  <section class="hs-section hs-regions">
    <div class="container">
      <div class="hs-heading">
        <p class="eyebrow eyebrow--rule">National Structure</p>
        <h2>
          A national sisterhood. <span>Five regions.</span>
        </h2>
        <p>
          The regional system connected a growing Sorority across chapters, campuses, communities,
          and generations of leadership.
        </p>
      </div>
      <div class="hs-region-grid">
        {regions.map((r) => (
          <article class="hs-region-card">
            <div class="hs-region-top">
              <div>
                <p class="hs-region-eyebrow">{r.meta}</p>
                <h3>{r.name}</h3>
              </div>
              <span class="hs-region-index">{r.n}</span>
            </div>
            <p class="hs-region-lead">{r.lead}</p>
            <p>{r.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- LEGACY -->
  <section class="hs-legacy">
    <figure class="hs-legacy__image">
      <img
        src={withBase("/images/Sigma Gamma Rho 75th Anniversary Stained Glass Window.jpg")}
        alt="Sigma Gamma Rho commemorative stained glass"
      />
    </figure>
    <div class="hs-legacy__copy">
      <p class="eyebrow eyebrow--rule">A Living Legacy</p>
      <h2>
        History That Still <span>Requires Something of Us</span>
      </h2>
      <p>
        Sigma Gamma Rho's history is not preserved merely to be admired. It establishes a standard.
      </p>
      <p>
        Each generation inherits the responsibility to strengthen the institution, serve communities
        with purpose, and leave the sisterhood more capable than it found it.
      </p>
      <blockquote>
        "Our story did not start with a moment. It started with a decision. And it continues with
        each of us."
      </blockquote>
      <p class="hs-motto">Greater Service, Greater Progress.</p>
      <div class="hs-button-row">
        <Button href="/about/our-founders/">Meet Our Founders</Button>
        <a class="hs-text-button" href={withBase("/service-impact/national-programs/")}>
          Explore Service &amp; Impact <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <CtaBand
    title="The story is still"
    highlight="in motion"
    copy="More than a century later, the responsibility remains — and each generation inherits the work."
    actions={[{ label: "Become a Member", href: "/membership/become-a-member/" }]}
  />
</Base>

<style>
  .container {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }
  .gold-rule {
    width: 84px;
    height: 2px;
    margin: 34px 0 24px;
    background: var(--gold);
  }
  .eyebrow--rule {
    position: relative;
  }
  .eyebrow--rule::after {
    content: "";
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--gold);
    margin-top: var(--space-4);
  }

  /* ---- HERO ---- */
  .hs-hero {
    position: relative;
    overflow: hidden;
    min-height: 560px;
    display: flex;
    align-items: center;
    color: #fff;
    background: var(--navy);
  }
  .hs-hero__image {
    position: absolute;
    inset: 0;
    background-image: url("/images/sgr-alpha-charter.jpeg");
    background-size: cover;
    background-position: 66% 42%;
    filter: grayscale(100%);
  }
  .hs-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(8, 22, 51, 0.98) 0%,
      rgba(14, 37, 88, 0.93) 38%,
      rgba(21, 52, 122, 0.62) 70%,
      rgba(8, 22, 51, 0.4) 100%
    );
  }
  .hs-hero__content {
    position: relative;
    z-index: 2;
    padding-block: clamp(4.5rem, 10vw, 6rem);
  }
  .hs-hero__title {
    margin: 0;
    font-family: var(--font-label);
    font-weight: 400;
    font-size: clamp(3.2rem, 9vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: #fff;
  }
  .hs-hero__title span {
    color: var(--gold-display);
  }
  .hs-hero__copy {
    max-width: 42rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--text-md);
    line-height: 1.75;
    font-weight: 400;
  }
  .hs-hero__date {
    position: absolute;
    left: 0;
    bottom: -2.5rem;
    z-index: 1;
    color: rgba(255, 255, 255, 0.035);
    font-family: var(--font-label);
    font-size: clamp(6rem, 14vw, 13rem);
    letter-spacing: -0.05em;
  }

  /* ---- shared heading pattern ---- */
  .hs-section {
    padding-block: clamp(3.5rem, 6vw, 4.5rem);
    background: var(--white);
  }
