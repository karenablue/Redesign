---
/**
 * Herstory — rebuilt as bespoke markup matching about/herstory/herstory.css
 * exactly, rather than the shared Hero/Section/Card components (which use
 * Playfair italic + rounded-card defaults that don't match this page's real
 * CSS: LEMON MILK headings throughout, a bordered "table" fact grid, a
 * two-column Firsts layout, and a 3-column timeline with per-chapter aside
 * cards — quote / stat / impact-list / plain — matching the original.
 */
import Base from "../../layouts/Base.astro";
import Button from "../../components/Button.astro";
import CtaBand from "../../components/CtaBand.astro";
import { withBase } from "../../lib/url.js";

const facts = [
  { n: "01", label: "Founded", title: "November 12, 1922", body: "Indianapolis, Indiana" },
  { n: "02", label: "Founding Institution", title: "Butler University", body: "The only NPHC sorority founded at a predominantly white institution." },
  { n: "03", label: "Founders", title: "Seven Educators", body: "Women whose professional lives were already rooted in education and service." },
  { n: "04", label: "National Incorporation", title: "December 30, 1929", body: "Sigma Gamma Rho became an incorporated national collegiate sorority." },
  { n: "05", label: "Motto", title: "Greater Service, Greater Progress", body: "A century-long standard for service and institutional responsibility." },
  { n: "06", label: "Official Colors", title: "Royal Blue & Gold", body: "Colors carried across generations of the sisterhood." },
  { n: "07", label: "Official Flower", title: "Yellow Tea Rose", body: "A longstanding symbol within the Sorority's visual identity." },
  { n: "08", label: "Headquarters", title: "Cary, North Carolina", body: "Home of the International Corporate Headquarters." },
];

const firsts = [
  { n: "01", title: "Founded at a Predominantly White Institution", body: "Sigma Gamma Rho is the only NPHC sorority founded at a predominantly white institution — Butler University in Indianapolis." },
  { n: "02", title: "Professional-Educator Roots", body: "The Sorority began as a professional organization created by Black women educators whose work centered education, advancement, and service." },
  { n: "03", title: "Early NPHC Organizing Participation", body: "Sigma Gamma Rho participated in the 1928 Indianapolis discussions that preceded the permanent National Pan-Hellenic Council and became a full NPHC member in 1937." },
  { n: "04", title: "Affiliate Tradition", body: "One of few NPHC sororities to sustain a multi-tier affiliate system — Rhosebuds, Rhoers, and Philos — across generations." },
  { n: "05", title: "Philo Affiliate", body: "Established a national affiliate for professional, non-collegiate women who support the Sorority's mission without full membership." },
  { n: "06", title: "Rhoer Club", body: "Sponsored one of the longest-running Black Greek youth-development programs, active since 1939." },
];

// Timeline chapters, each paired with an aside variant matching the original
// page's mix of quote / stat / impact-list / plain callouts.
const timeline = [
  {
    year: "1922", label: "Founding", head: "Seven educators build an institution.",
    body: "Sigma Gamma Rho Sorority, Inc. was founded on November 12, 1922, in Indianapolis, Indiana, by seven African American educators.",
    aside: { type: "plain", title: "Butler University", body: "The only NPHC sorority founded at a predominantly white institution." },
  },
  {
    year: "1925", label: "Structure & Identity", head: "The first Boulé establishes a national rhythm.",
    body: "The Sorority's first national conference — the Boulé — established the governing rhythm and traditions the organization still follows today, including the motto Greater Service, Greater Progress.",
    aside: { type: "quote", line: "GREATER SERVICE,", strong: "GREATER PROGRESS." },
  },
  {
    year: "1929", label: "National Expansion", head: "A broader mission takes shape.",
    body: "On December 30, 1929, Sigma Gamma Rho became an incorporated national collegiate sorority, when a charter was granted to the Alpha chapter at Butler University, formalizing its structure and reach.",
    aside: { type: "impact", title: "Institutional Roots", items: ["Professional-educator founders", "Employment support"] },
  },
  {
    year: "1928–37", label: "National Pan-Hellenic Council", head: "Part of the early effort to coordinate Black Greek-letter organizations.",
    body: "Sigma Gamma Rho participated in the 1928 Indianapolis discussions that preceded the permanent National Pan-Hellenic Council, and became a full NPHC member in 1937.",
    aside: { type: "stat", number: "1937", label: "Full NPHC Membership" },
  },
  {
    year: "1930s", label: "The Great Depression", head: "Service responds to the realities of the moment.",
    body: "Even through the Great Depression, chapters continued to organize around education, mutual aid, and community service, adapting the founders' original commitments to a harder economic reality.",
    aside: { type: "plain", title: "Educational Access", body: "Chapters prioritized keeping members and neighbors in school and employed." },
  },
  {
    year: "1940s", label: "World War II & Youth Development", head: "Service expands from wartime support to youth development.",
    body: "During World War II, Sigma Gamma Rho supported service members and their families while laying the groundwork for the youth affiliate programs — the Rhoer Club and, later, Rhosebuds — that continue today.",
    aside: { type: "plain", title: "National Purpose", body: "Local adaptation of national priorities across every region." },
  },
  {
    year: "Today", label: "The Work Continues", head: "A century later, the responsibility remains.",
    body: "Each generation inherits that work — to organize, advocate, educate, serve, and expand without abandoning the founding principles.",
    aside: { type: "quote", line: "THE STORY IS", strong: "STILL IN MOTION." },
  },
];

const regions = [
  { n: "01", meta: "Established 1925 • Organized 1940", name: "Central", lead: "The first region to form — and the region in which Sigma Gamma Rho itself was born.", body: "Sorors here originated many of the Sorority's defining elements: the Pledge, National Hymn, Slogan, Badge, Coat of Arms, Flower, and Colors." },
  { n: "02", meta: "December 29, 1939", name: "Northeastern", lead: "Organized at the 14th Boulé when the Sorority expanded from two regions to four.", body: "Soror Edna F. Browne, “The Mother of the Northeastern Region,” became its first Syntaktes." },
  { n: "03", meta: "Established 1939", name: "Southeastern", lead: "Created during the Sorority's 1939 regional restructuring.", body: "Soror Elizabeth Lemon served as the first Syntaktes as the Sorority strengthened its leadership structure throughout the Southeast." },
  { n: "04", meta: "Voted 1939 • Organized 1940", name: "Southwestern", lead: "Organized under first Syntaktes Soror Mary Scales Greenwood of Houston.", body: "Contributed enduring traditions including the Poodle as official mascot and the development of the Philo Affiliate." },
  { n: "05", meta: "December 1952", name: "Western", lead: "The fifth and most recently established of today's regions.", body: "Formerly part of Southwestern Region, organized under first Syntaktes Soror Lessie B. Crossland; first conference in 1953." },
];
---
<Base
  title="Herstory"
  activeTop="About"
  description="Explore the history, milestones, regional development, and enduring legacy of Sigma Gamma Rho Sorority, Incorporated."
>
  <!-- HERO -->
  <section class="hs-hero">
    <div class="hs-hero__image"></div>
    <div class="hs-hero__overlay"></div>
    <div class="container hs-hero__content">
      <p class="eyebrow">Our History. Our Legacy. Our Future.</p>
      <h1 class="hs-hero__title">Her<span>story</span></h1>
      <div class="gold-rule"></div>
      <p class="hs-hero__copy">Founded by seven educators in 1922, Sigma Gamma Rho has spent more than a century turning scholarship, sisterhood, leadership, and service into sustained progress.</p>
    </div>
    <div class="hs-hero__date" aria-hidden="true">1922</div>
  </section>

  <!-- THE BEGINNING -->
  <section class="hs-section">
    <div class="container hs-split">
      <div class="hs-story-copy">
        <p class="eyebrow eyebrow--rule">The Beginning</p>
        <h2>A Vision Born in <span>1922</span></h2>
        <p>On November 12, 1922, seven young educators in Indianapolis established Sigma Gamma Rho Sorority at Butler University.</p>
        <p>Their decision was deliberate. They built an organization grounded in scholarship, mutual responsibility, leadership, and public service at a time when Black women faced sharply limited access to institutional power.</p>
        <p>What began with seven educators became a national institution and, eventually, an international sisterhood.</p>
        <p class="hs-emphasis">Seven educators. One purpose. A legacy still in motion.</p>
        <Button href="/about/our-founders/" variant="outline">Meet Our Seven Founders <span aria-hidden="true">→</span></Button>
      </div>
      <figure class="hs-historical-card">
        <img src={withBase("/images/College Avenue Campus.jpg")} alt="Historic Butler University campus" />
        <figcaption><span>Butler University</span><small>Indianapolis, Indiana</small></figcaption>
        <div class="hs-year-badge"><small>Founded</small><strong>1922</strong></div>
      </figure>
    </div>
  </section>

  <!-- KEY FACTS -->
  <section class="hs-section hs-key-facts">
    <div class="container">
      <div class="hs-heading hs-heading--centered">
        <p class="eyebrow eyebrow--rule">At a Glance</p>
        <h2>Key <span>Facts</span></h2>
        <p>The essential facts behind more than a century of Sigma Gamma Rho history.</p>
      </div>
      <div class="hs-facts-grid">
        {facts.map((f) => (
          <article class="hs-fact-card">
            <span class="hs-fact-number">{f.n}</span>
            <p class="hs-fact-label">{f.label}</p>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FIRSTS & DISTINCTIONS -->
  <section class="hs-section hs-firsts">
    <div class="container hs-firsts__inner">
      <div class="hs-firsts__heading">
        <p class="eyebrow eyebrow--rule">Distinct by History</p>
        <h2>Firsts &amp; <span>distinctions</span></h2>
        <p>Milestones and traditions that distinguish Sigma Gamma Rho within the history of Black Greek-letter organizations.</p>
      </div>
      <div class="hs-firsts-list">
        {firsts.map((f) => (
          <article>
            <span class="hs-firsts-num">{f.n}</span>
            <div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- MISSION & VISION -->
  <section class="hs-mv">
    <div class="container hs-mv__inner">
      <article>
        <h2>Mission</h2>
        <p>It is the mission of Sigma Gamma Rho Sorority, Inc. to enhance the quality of life for women and their families in the U.S. and globally through community service, civil, and social action — achieving greater progress in education, health awareness, and leadership development.</p>
      </article>
      <div class="hs-mv__divider"></div>
      <article>
        <h2>Vision</h2>
        <p>We visualize a world in which all women and their families reach their full potential in all aspects of life and are able to create unlimited opportunities for future generations.</p>
      </article>
    </div>
  </section>

  <!-- CENTURY IN MOTION -->
  <section class="hs-century">
    <div class="container hs-century__inner">
      <div class="hs-heading hs-heading--centered hs-heading--dark">
        <p class="eyebrow">Our Journey</p>
        <h2>More than a century <span>in motion</span></h2>
        <p>From seven educators in Indianapolis to a national institution shaped by education, civic action, service, and organizational growth.</p>
      </div>
      <div class="hs-century__story">
        {timeline.map((t) => (
          <div class="hs-chapter">
            <div class="hs-chapter__year">{t.year}</div>
            <div class="hs-chapter__copy">
              <p class="hs-chapter__label">{t.label}</p>
              <h3>{t.head}</h3>
              <p>{t.body}</p>
            </div>
            {t.aside.type === "plain" && (
              <div class="hs-chapter__aside">
                <h4>{t.aside.title}</h4>
                <p>{t.aside.body}</p>
              </div>
            )}
            {t.aside.type === "quote" && (
              <div class="hs-chapter__quote">
                <span>{t.aside.line}</span>
                <strong>{t.aside.strong}</strong>
              </div>
            )}
            {t.aside.type === "stat" && (
              <div class="hs-chapter__stat">
                <span class="hs-stat-number">{t.aside.number}</span>
                <span class="hs-stat-label">{t.aside.label}</span>
              </div>
            )}
            {t.aside.type === "impact" && (
              <div class="hs-chapter__aside hs-chapter__aside--gold">
                <h4>{t.aside.title}</h4>
                <div class="hs-impact-list">
                  {t.aside.items.map((it) => <div>{it}</div>)}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- REGIONS -->
  <section class="hs-section hs-regions">
    <div class="container">
      <div class="hs-heading">
        <p class="eyebrow eyebrow--rule">National Structure</p>
        <h2>A national sisterhood. <span>Five regions.</span></h2>
        <p>The regional system connected a growing Sorority across chapters, campuses, communities, and generations of leadership.</p>
      </div>
      <div class="hs-region-grid">
        {regions.map((r) => (
          <article class="hs-region-card">
            <div class="hs-region-top">
              <div>
                <p class="hs-region-eyebrow">{r.meta}</p>
                <h3>{r.name}</h3>
              </div>
              <span class="hs-region-index">{r.n}</span>
            </div>
            <p class="hs-region-lead">{r.lead}</p>
            <p>{r.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- LEGACY -->
  <section class="hs-legacy">
    <figure class="hs-legacy__image">
      <img src={withBase("/images/Sigma Gamma Rho 75th Anniversary Stained Glass Window.jpg")} alt="Sigma Gamma Rho commemorative stained glass" />
    </figure>
    <div class="hs-legacy__copy">
      <p class="eyebrow eyebrow--rule">A Living Legacy</p>
      <h2>History That Still <span>Requires Something of Us</span></h2>
      <p>Sigma Gamma Rho's history is not preserved merely to be admired. It establishes a standard.</p>
      <p>Each generation inherits the responsibility to strengthen the institution, serve communities with purpose, and leave the sisterhood more capable than it found it.</p>
      <blockquote>"Our story did not start with a moment. It started with a decision. And it continues with each of us."</blockquote>
      <p class="hs-motto">Greater Service, Greater Progress.</p>
      <div class="hs-button-row">
        <Button href="/about/our-founders/">Meet Our Founders</Button>
        <a class="hs-text-button" href={withBase("/service-impact/national-programs/")}>Explore Service &amp; Impact <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <CtaBand
    title="The story is still"
    highlight="in motion"
    copy="More than a century later, the responsibility remains — and each generation inherits the work."
    actions={[{ label: "Become a Member", href: "/membership/become-a-member/" }]}
  />
</Base>

<style>
  .container { width: min(1180px, calc(100% - 48px)); margin-inline: auto; }
  .gold-rule { width: 84px; height: 2px; margin: 34px 0 24px; background: var(--gold); }
  .eyebrow--rule { position: relative; }
  .eyebrow--rule::after { content: ""; display: block; width: 2rem; height: 1px; background: var(--gold); margin-top: var(--space-4); }

  /* ---- HERO ---- */
  .hs-hero { position: relative; overflow: hidden; min-height: 560px; display: flex; align-items: center; color: #fff; background: var(--navy); }
  .hs-hero__image {
    position: absolute; inset: 0;
    background-image: url("/images/sgr-alpha-charter.jpeg");
    background-size: cover; background-position: 66% 42%;
    filter: grayscale(100%);
  }
  .hs-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(8,22,51,.98) 0%, rgba(14,37,88,.93) 38%, rgba(21,52,122,.62) 70%, rgba(8,22,51,.40) 100%);
  }
  .hs-hero__content { position: relative; z-index: 2; padding-block: clamp(4.5rem, 10vw, 6rem); }
  .hs-hero__title { margin: 0; font-family: var(--font-label); font-weight: 400; font-size: clamp(3.2rem, 9vw, 8rem); line-height: 0.9; letter-spacing: -0.04em; color: #fff; }
  .hs-hero__title span { color: var(--gold); }
  .hs-hero__copy { max-width: 42rem; margin: 0; color: rgba(255,255,255,.88); font-size: var(--text-md); line-height: 1.75; font-weight: 500; }
  .hs-hero__date { position: absolute; left: 0; bottom: -2.5rem; z-index: 1; color: rgba(255,255,255,.035); font-family: var(--font-label); font-size: clamp(6rem, 14vw, 13rem); letter-spacing: -0.05em; }

  /* ---- shared heading pattern ---- */
  .hs-section { padding-block: clamp(3.5rem, 6vw, 4.5rem); background: var(--white); }
  .hs-heading h2 { margin: 0; color: var(--royal); font-family: var(--font-label); font-weight: 400; font-size: clamp(1.75rem, 3.4vw, 2.6rem); line-height: 1.12; }
  .hs-heading h2 span { color: var(--gold); }
  .hs-heading > p:not(.eyebrow) { margin-top: var(--space-4); color: var(--muted); max-width: 46rem; }
  .hs-heading--centered { text-align: center; max-width: 48rem; margin: 0 auto var(--space-12); }
  .hs-heading--centered.hs-heading--dark p:not(.eyebrow) { color: rgba(255,255,255,.82); }
  .hs-heading--centered.hs-heading--dark h2 { color: #fff; }

  /* ---- THE BEGINNING split ---- */
  .hs-split { display: grid; grid-template-columns: minmax(0,1fr) minmax(380px,0.9fr); gap: clamp(2.5rem, 6vw, 4.75rem); align-items: center; }
  .hs-story-copy h2 { margin: 0 0 var(--space-4); color: var(--royal); font-family: var(--font-label); font-weight: 400; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.12; }
  .hs-story-copy h2 span { color: var(--gold); }
  .hs-story-copy p { color: #4c5565; font-size: var(--text-base); line-height: 1.9; }
  .hs-emphasis { color: var(--royal) !important; font-weight: 800; }
  .hs-historical-card { margin: 0; position: relative; padding: 14px; background: #fff; box-shadow: 0 16px 40px rgba(8,22,51,.16); }
  .hs-historical-card img { width: 100%; height: clamp(300px, 34vw, 390px); display: block; object-fit: cover; filter: grayscale(100%); }
  .hs-historical-card figcaption { display: flex; flex-direction: column; align-items: center; padding: 15px 10px 2px; text-align: center; }
  .hs-historical-card figcaption span { color: var(--royal); font-size: 11px; font-weight: 800; letter-spacing: 2.6px; text-transform: uppercase; }
  .hs-historical-card figcaption small { margin-top: 3px; color: var(--muted); }
  .hs-year-badge { width: 90px; height: 90px; position: absolute; right: -20px; top: -22px; display: grid; place-content: center; text-align: center; border-radius: 50%; color: var(--navy); background: var(--gold); box-shadow: 0 12px 26px rgba(8,22,51,.18); }
  .hs-year-badge small { font-size: 8px; letter-spacing: 2px; text-transform: uppercase; }
  .hs-year-badge strong { margin-top: 3px; font-family: var(--font-label); font-size: 24px; }
  @media (max-width: 820px) { .hs-split { grid-template-columns: 1fr; } .hs-historical-card { max-width: 420px; margin-inline: auto; } }

  /* ---- KEY FACTS: bordered table grid, not rounded cards ---- */
  .hs-key-facts { background: var(--cream); }
  .hs-facts-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .hs-fact-card { position: relative; padding: clamp(1.25rem, 2.5vw, 1.875rem); border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: #fff; min-height: 190px; }
  .hs-fact-number { position: absolute; top: 12px; right: 16px; color: rgba(32,65,165,.08); font-family: var(--font-label); font-size: 2.4rem; }
  .hs-fact-label { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-dark); margin: 0 0 var(--space-2); }
  .hs-fact-card h3 { margin: 0; color: var(--royal); font-size: 1.1rem; line-height: 1.35; }
  .hs-fact-card > p:last-child { margin: var(--space-3) 0 0; color: var(--muted); font-size: var(--text-sm); line-height: 1.65; }
  @media (max-width: 900px) { .hs-facts-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .hs-facts-grid { grid-template-columns: 1fr; } }

  /* ---- FIRSTS: heading beside a bordered 3-col grid ---- */
  .hs-firsts__inner { display: grid; grid-template-columns: 0.62fr 1.38fr; gap: clamp(2rem, 5vw, 3.5rem); align-items: start; }
  .hs-firsts__heading h2 { margin: 0 0 var(--space-4); color: var(--royal); font-family: var(--font-label); font-weight: 400; font-size: clamp(1.5rem, 3vw, 2rem); }
  .hs-firsts__heading h2 span { color: var(--gold); }
  .hs-firsts__heading p:not(.eyebrow) { color: var(--muted); font-size: var(--text-sm); }
  .hs-firsts-list { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); border-top: 1px solid rgba(32,65,165,.13); border-left: 1px solid rgba(32,65,165,.13); }
  .hs-firsts-list article { display: grid; grid-template-columns: 34px 1fr; gap: var(--space-3); padding: var(--space-5); border-right: 1px solid rgba(32,65,165,.13); border-bottom: 1px solid rgba(32,65,165,.13); background: rgba(255,255,255,.62); min-height: 175px; }
  .hs-firsts-num { font-family: var(--font-label); color: var(--gold); font-size: var(--text-lg); line-height: 1; }
  .hs-firsts-list h3 { margin: 0 0 var(--space-2); color: var(--royal); font-size: var(--text-sm); line-height: 1.4; }
  .hs-firsts-list p { margin: 0; color: #5d6675; font-size: var(--text-xs); line-height: 1.7; }
  @media (max-width: 820px) { .hs-firsts__inner { grid-template-columns: 1fr; } }
  @media (max-width: 720px) { .hs-firsts-list { grid-template-columns: 1fr; } }

  /* ---- MISSION / VISION ---- */
  .hs-mv { background: #fff; }
  .hs-mv__inner { padding-block: clamp(2.5rem, 5vw, 3.875rem); display: grid; grid-template-columns: 1fr 1px 1fr; gap: clamp(1.75rem, 4vw, 2.75rem); align-items: start; }
  .hs-mv__inner h2 { margin: 0 0 var(--space-3); color: var(--royal); font-family: var(--font-label); font-weight: 400; font-size: clamp(1.6rem, 3vw, 2.375rem); }
  .hs-mv__inner article:last-child h2 { color: var(--gold); }
  .hs-mv__inner p { margin: 0; color: #596273; font-size: var(--text-sm); line-height: 1.78; max-width: 68ch; }
  .hs-mv__divider { width: 1px; min-height: 150px; background: linear-gradient(180deg, transparent, var(--line), transparent); }
  @media (max-width: 820px) { .hs-mv__inner { grid-template-columns: 1fr; } .hs-mv__divider { width: 100%; height: 1px; min-height: 1px; } }

  /* ---- CENTURY TIMELINE ---- */
  .hs-century { position: relative; overflow: hidden; padding-block: clamp(4rem, 8vw, 6.5rem); color: #fff;
    background: radial-gradient(circle at 84% 14%, rgba(63,99,191,.28), transparent 26%), linear-gradient(145deg, #081633 0%, #10265c 45%, #17377f 100%);
    border-block: 4px solid var(--gold);
  }
  .hs-century::before { content: "1922"; position: absolute; top: 4rem; left: -1.5rem; color: rgba(255,255,255,.025); font-family: var(--font-label); font-size: clamp(8rem, 16vw, 17.5rem); line-height: 1; pointer-events: none; }
  .hs-century__inner { position: relative; z-index: 1; }
  .hs-century__story { margin-top: clamp(2.5rem, 5vw, 4.5rem); }
  .hs-chapter { position: relative; display: grid; grid-template-columns: 150px minmax(0,1fr) 260px; gap: clamp(1.5rem, 3vw, 2.75rem); padding-block: clamp(2rem, 4vw, 3.5rem); border-bottom: 1px solid rgba(255,255,255,.1); }
  .hs-chapter:last-child { border-bottom: 0; }
  .hs-chapter__year { position: relative; z-index: 2; align-self: start; color: var(--gold); font-family: var(--font-label); font-size: clamp(1.5rem, 2.4vw, 2.375rem); line-height: 1; text-align: right; padding-right: 2.25rem; }
  .hs-chapter__year::after { content: ""; width: 13px; height: 13px; position: absolute; top: 8px; right: -6px; border: 3px solid #10265c; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 1px rgba(223,177,54,.5); }
