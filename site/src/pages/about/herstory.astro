---
/**
 * Herstory — rebuilt as bespoke markup matching about/herstory/herstory.css
 * exactly, rather than the shared Hero/Section/Card components, because this
 * page's structure is one-of-a-kind: a bordered "table" fact grid, a
 * two-column Firsts layout, and a 3-column timeline with per-chapter aside
 * cards — quote / stat / impact-list / plain — matching the original.
 * (Headings are still LEMON MILK, per AGENTS.md §6.)
 */
import Base from "../../layouts/Base.astro";
import Button from "../../components/Button.astro";
import CtaBand from "../../components/CtaBand.astro";
import { withBase } from "../../lib/url.js";
import { reg } from "../../lib/reg.js";

/** `link.external` decides the arrow: ↗ leaves the site, → stays on it. */
type Fact = {
  label: string;
  title: string;
  /** Optional: some facts are complete in their title alone. */
  body?: string;
  link?: { label: string; href: string; external: boolean; srSuffix?: string };
};

const facts: Fact[] = [
  {
    label: "Founded",
    title: "November 12, 1922",
    body: "Butler University, Indianapolis, Indiana — the only NPHC sorority founded at a predominantly white institution.",
  },
  {
    label: "Official Wordmark & Identity",
    // SGRHO is the registered form (FY2027 word-mark register).
    title: "SGRHO® • Sigma",
    body: "Historically recognized and embraced by sisterhood and community as SGRho and Sigma.",
  },
  {
    label: "National Council",
    title: "National Pan-Hellenic Council",
    body: "Admitted in 1937 to the national governing council uniting the Divine Nine historically Black Greek-letter organizations.",
  },
  {
    label: "National Incorporation",
    title: "December 30, 1929",
    body: "Sigma Gamma Rho became an incorporated national collegiate sorority.",
  },
  {
    label: "Motto",
    title: "Greater Service, Greater Progress®",
    body: "A century-long standard for service and institutional responsibility.",
  },
  {
    label: "Official Colors",
    title: "Royal Blue & Gold",
    body: "Reflecting a glorious wealth of values, truth, and purity. An enduring hallmark of regal character and unwavering commitment to sisterhood.",
  },
  {
    label: "Official Flower",
    title: "Yellow Tea Rose",
    body: "Symbolic of beauty, resilience, and radiance. Delicate yet enduring through life’s trials, it mirrors the Sigma woman’s lasting fragrance of charm, dignity, and concern.",
  },
  {
    label: "Official Call",
    title: "EE-YIP®",
    body: "A distinctive, high-spirited greeting echoing the elegance and alertness of the mascot. Shared across generations as an immediate acoustic hallmark of sisterhood and pride.",
  },
  {
    label: "Official Mascot",
    title: "The Poodle",
    body: "Introduced by 8th Southwestern Region Syntaktes Quindonell S. Robertson. Selected for its sophisticated bearing, beauty, and keen intellect, standing as an enduring symbol of poise and grace.",
  },
  {
    label: "Official Publication",
    // Registered: THE AURORA, USPTO Reg. No. 4692203 (live, renewed).
    title: "The Aurora®",
    // 1927, not 1930: The Aurora's own Issuu profile and the PALNI Butler
    // centennial archive both date its launch to 1927 (first editor-in-chief
    // Gertrude Murchison).
    body: "Established in 1927 to document national achievements, voice, and chapter progress.",
    link: {
      label: "Read Latest Issue",
      href: "https://sgrho1922.store/collections/aurora",
      external: true,
      srSuffix: " of The Aurora on the Sigma Gamma Rho store (opens in a new tab)",
    },
  },
];

const firsts = [
  {
    title: "Founded at a PWI",
    body: "The only NPHC sorority established at a predominantly white institution — Butler University in Indianapolis, Indiana — in 1922.",
  },
  {
    title: "Educator-Led Origins",
    body: "The only NPHC sorority founded solely by working educators, beginning as a professional society centered on scholarship, training, and service.",
  },
  {
    title: "Beyond Howard University",
    body: "The only historically Black sorority within the NPHC founded outside of Howard University, establishing an autonomous Midwest lineage.",
  },
  {
    title: "1928 Pan-Hellenic Precursor",
    body: "Shaped the pivotal 1928 Indianapolis roundtables that laid the Midwestern groundwork for the National Pan-Hellenic Council before full membership in 1937.",
  },
  {
    title: "First Official Youth Affiliate",
    body: "Pioneered the Rhoer Club® in 1939, becoming the first NPHC organization to establish a chartered national leadership auxiliary for teenage girls.",
  },
  {
    title: "Non-Degreed Women’s Pipeline",
    body: "Pioneered the Philo Affiliate® (originating in 1943), breaking traditional collegiate elitism to provide non-degreed women official national service status.",
  },
];

/**
 * The century timeline. Rows alternate sides (`side`) and each closes with a
 * typed note. The note's `style` varies on purpose — plain card, gold card,
 * stat block, quote — because a repeating aside is what would make ten rows
 * read as one long scroll (see the herstory benchmark in DESIGN notes).
 */
const timeline = [
  {
    side: "left",
    year: "1922",
    label: "The Bold Inception",
    head: "Seven Educators Defy the Odds",
    body: "Founded on November 12, 1922, at Butler University in Indianapolis, Indiana, by seven trailblazing schoolteachers. In an era of intense midwestern racial hostility, they built an autonomous, educator-led sisterhood.",
    note: {
      style: "plain",
      kind: "Key Distinction",
      text: "The only NPHC sorority founded at a predominantly white institution (PWI).",
    },
  },
  {
    side: "right",
    year: "1925",
    label: "Codifying the Vision",
    head: "The First National Boulé",
    body: "Convening its first national convention, the Sorority established its democratic governance, national officers, and cultural traditions, officially adopting the motto: “Greater Service, Greater Progress.”",
    note: {
      style: "gold",
      kind: "Milestone",
      text: "Formal adoption of national leadership and organizational constitution.",
    },
  },
  {
    side: "left",
    year: "1928–1937",
    label: "Expanding the Reach",
    head: "Collegiate Charter & NPHC Unity",
    body: "After shaping the 1928 Indianapolis roundtables that laid the groundwork for the National Pan-Hellenic Council, the Sorority incorporated as a national collegiate body with Alpha Chapter (1929) and joined the NPHC as a full member in 1937.",
    note: {
      style: "stat",
      number: "1937",
      kind: "Milestone",
      text: "Transition from professional society to chartered national collegiate body.",
    },
  },
  {
    side: "right",
    year: "1930s",
    label: "Depression-Era Economic Aid",
    head: "Vocational Defense & Global Literacy",
    body: "Confronting economic collapse, the Sorority created an internal Employment Aid Bureau to secure teaching placements for Black women, mandated permanent chapter scholarship funds, and launched the African Book Shower Project to send educational supplies to the Wilberforce Institute in South Africa.",
    note: {
      style: "plain",
      kind: "Impact",
      text: "Economic resilience, educational defense, and early international educational diplomacy.",
    },
  },
  {
    side: "left",
    year: "1939–1943",
    label: "Multigenerational Pipelines",
    head: "Pioneering Youth & Community Affiliates",
    body: "Redefining Greek auxiliaries, Sigma Gamma Rho established the Rhoer Club (1939) as the first national NPHC youth auxiliary for teens, followed by the Philo Affiliate (originating in 1943) to welcome non-degreed community women into active civic leadership.",
    note: {
      style: "gold",
      kind: "Firsts",
      text: "First national teen auxiliary and inclusive non-degreed women’s affiliate.",
    },
  },
  {
    side: "right",
    year: "1940s",
    label: "“Teen Towns” & Wartime Youth Welfare",
    head: "Safe Havens for the Next Generation",
    body: "In response to World War II community disruption and rapid migration, chapters pioneered “Teen Towns” — dedicated recreational and vocational centers providing wholesome mentorship, creative arts, and social development to protect Black youth from delinquency and neglect.",
    note: {
      style: "plain",
      kind: "Milestone",
      text: "Grassroots civic innovation in urban youth welfare.",
    },
  },
  {
    side: "left",
    year: "1950s–1960s",
    label: "Civil Rights & Literacy Action",
    head: "Direct Action and Desegregation Advocacy",
    body: "Sorors mobilized across the South and urban centers, funding civil rights legal defense campaigns, organizing voter registration drives, and running regional book drives and mobile bookmobiles to supply underfunded, segregated schools and libraries.",
    note: {
      style: "gold",
      kind: "Impact",
      text: "Active participation in voter defense, legal relief, and literacy access.",
    },
  },
  {
    side: "right",
    year: "1972",
    label: "Public Health Leadership",
    head: "Project Reassurance & Maternal Health",
    // HQ VERIFICATION FLAG (blueprint): confirm the nationwide March of Dimes
    // partnership details. Earlier unverified "first" wording, for reference:
    // "the first Black Greek-letter organization to enter an official
    // nationwide partnership with a major national public health foundation".
    body: "In 1972, Sigma Gamma Rho established Project Reassurance in nationwide partnership with the March of Dimes, mobilizing chapters across the country to combat infant mortality and address systemic maternal health disparities in underserved communities.",
    note: {
      style: "quote",
      kind: "Milestone",
      line: "A Landmark",
      text: "Health Alliance.",
    },
  },
  {
    side: "left",
    year: "1990s–2010s",
    label: "Global Footprint & Swim 1922",
    head: "Global Charters & Aquatic Safety",
    // HQ VERIFICATION FLAG (blueprint): confirm the 2012 USA Swimming
    // alliance. Earlier unverified note, for reference: "first African
    // American national partner of USA Swimming."
    body: "The Sorority expanded internationally across the Caribbean, Europe, and Africa. In 2012, it forged a landmark national alliance with USA Swimming to launch Swim 1922, directly combating generational drowning disparities and water access barriers in minority communities.",
    note: {
      style: "plain",
      kind: "Impact",
      text: "Worldwide charter expansion and a pioneering national alliance with USA Swimming.",
    },
  },
  {
    side: "right",
    year: "Today",
    label: "The Centenary & Beyond",
    head: "Unbroken Legacy, Boundless Future",
    body: "With over 100 years of documented leadership, thousands of members across hundreds of chapters carry the founders’ standard forward — advancing social justice, women’s health, education, and community self-reliance under the banner: “Greater Women, Greater World”®.",
    note: {
      style: "quote",
      kind: "Movement",
      line: "A century of sisterhood.",
      text: "Greater Service. Greater Progress. Still in motion.",
    },
  },
];

const regions = [
  {
    meta: "Established 1925 • Organized 1940",
    name: "Central",
    site: "https://www.sgrhocentral.com/",
    lead: "The birthplace of Sigma Gamma Rho, where seven educators established the sorority in Indianapolis. Formally organized under Sorors Homer Woods and Ruth Armstrong.",
    body: "Originated the sorority’s core identity—authoring the Pledge, National Hymn, Slogan, Badge, Coat of Arms, Yellow Tea Rose, and Official Colors.",
  },
  {
    meta: "Established December 29, 1939",
    name: "Northeastern",
    site: "https://www.sgrhoneregion.org/",
    lead: "Organized in New York City at the 14th International Boulé when national leadership restructured the Sorority into four distinct regions.",
    body: "Led by first Syntaktes Soror Edna F. Browne, “The Mother of the Northeastern Region,” who grew chapters along the Eastern Seaboard.",
  },
  {
    meta: "Established 1939 • Organized 1940",
    name: "Southeastern",
    site: "https://www.seregionsgrho.org/",
    lead: "Created during the landmark 1939 regional restructuring at the 14th Boulé, establishing a dedicated governing body to anchor growth across the Southeast.",
    body: "Organized under first Syntaktes Soror Elizabeth Lemon, mobilizing Southern educators for civil rights and youth welfare.",
  },
  {
    meta: "Established 1939 • Organized 1940",
    name: "Southwestern",
    site: "https://www.sigmaswregion.com/",
    lead: "Formally established during the 1939 restructuring and organized under its first Syntaktes, Soror Mary Scales Greenwood of Houston, Texas.",
    body: "Gave the sorority its Poodle mascot, through 8th Syntaktes Quindonell S. Robertson, and the Galveston roots of the Philo Affiliate.",
  },
  {
    meta: "Established December 1952 • Organized 1953",
    name: "Western",
    site: "https://www.westernsgrho.org/",
    lead: "The fifth and most recently established region, created to unite chapters spanning the Pacific Coast and Mountain West following post-war expansion.",
    body: "Formed from the Southwestern Region under first Syntaktes Soror Lessie B. Crossland; held its first regional conference in 1953.",
  },
];
---

<Base
  title="Herstory"
  activeTop="About"
  description="Explore the history, milestones, regional development, and enduring legacy of Sigma Gamma Rho Sorority, Incorporated."
>
  <!-- HERO -->
  {/* on-dark: this hero's ground is navy, so global.css needs to know to use
      full-chroma gold for the eyebrow rather than the dark type-safe gold. */}
  <section class="hs-hero on-dark">
    <div class="hs-hero__image"></div>
    <div class="hs-hero__overlay"></div>
    <div class="container hs-hero__content">
      <p class="eyebrow">MCMXXII<sup class="reg">&reg;</sup></p>
      <h1 class="hs-hero__title">
        Her<span>story</span>
      </h1>
      <div class="gold-rule"></div>
      <p class="hs-hero__copy">
        Seven educators in Indianapolis. Over a century of scholarship, civic action, and unbroken
        sisterhood.
      </p>
    </div>
    <div class="hs-hero__date" aria-hidden="true">
      1922
    </div>
  </section>

  <!-- THE BEGINNING -->
  <section class="hs-section">
    <div class="container hs-split">
      <div class="hs-story-copy">
        <p class="eyebrow eyebrow--rule">The Beginning</p>
        <h2>
          A Vision Born in <span>1922</span>
        </h2>
        <p>
          On November 12, 1922, seven young educators in Indianapolis established Sigma Gamma Rho
          Sorority at Butler University.
        </p>
        <p>
          Their decision was deliberate. They built an organization grounded in scholarship, mutual
          responsibility, leadership, and public service at a time when Black women faced sharply
          limited access to institutional power.
        </p>
        <p>
          What began with seven educators became a national institution and, eventually, an
          international sisterhood.
        </p>
        <p class="hs-emphasis">Seven educators. One purpose. A legacy still in motion.</p>
        <Button href="/about/our-founders/" variant="outline">
          Meet Our Seven Founders <span aria-hidden="true">→</span>
        </Button>
      </div>
      <figure class="hs-historical-card">
        <img
          src={withBase("/images/College Avenue Campus.jpg")}
          alt="Historic Butler University campus"
        />
        <figcaption>
          <span>Butler University</span>
          <small>Indianapolis, Indiana</small>
        </figcaption>
        <div class="hs-year-badge">
          <small>Founded</small>
          <strong>1922</strong>
        </div>
      </figure>
    </div>
  </section>

  <!-- KEY FACTS -->
  <section class="hs-section hs-key-facts">
    <div class="container">
      <div class="hs-heading hs-heading--centered">
        <p class="eyebrow eyebrow--rule">At a Glance</p>
        <h2>
          Key <span>Facts</span>
        </h2>
        <p>The essential facts behind more than a century of Sigma Gamma Rho history.</p>
      </div>
      <div class="hs-facts-grid">
        {facts.map((f) => (
          <article class="hs-fact-card">
            <p class="hs-fact-label">{f.label}</p>
            <h3 set:html={reg(f.title)} />
            {f.body && <p class="hs-fact-body">{f.body}</p>}
            {f.link && (
              <a
                class="hs-fact-link"
                href={f.link.external ? f.link.href : withBase(f.link.href)}
                target={f.link.external ? "_blank" : undefined}
                rel={f.link.external ? "noopener" : undefined}
              >
                {f.link.label}
                {f.link.srSuffix && <span class="visually-hidden">{f.link.srSuffix}</span>}
                <span aria-hidden="true">{f.link.external ? " ↗" : " →"}</span>
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FIRSTS & DISTINCTIONS -->
  <section class="hs-section hs-firsts">
    <div class="container hs-firsts__inner">
      <div class="hs-firsts__heading">
        <p class="eyebrow eyebrow--rule">Distinct by History</p>
        <h2>
          Firsts &amp; <span>distinctions</span>
        </h2>
        <p>
          Milestones and traditions that distinguish Sigma Gamma Rho within the history of Black
          Greek-letter organizations.
        </p>
      </div>
      <div class="hs-firsts-list">
        {firsts.map((f) => (
          <article>
            <div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- MISSION & VISION -->
  <section class="hs-mv">
    <div class="container hs-mv__inner">
      <article>
        <h2>Mission</h2>
        <p>
          It is the mission of Sigma Gamma Rho Sorority, Inc. to enhance the quality of life for
          women and their families in the U.S. and globally through community service, civil, and
          social action. Our goal is to achieve greater progress in the areas of education, health
          awareness, and leadership development. Our members, affiliates, staff, and community
          partners work to create and support initiatives that align with our vision.
        </p>
      </article>
      <div class="hs-mv__divider"></div>
      <article>
        <h2>Vision</h2>
        <p>
          We visualize a world in which all women and their families reach their full potential in
          all aspects of life and are able to create unlimited opportunities for future generations.
        </p>
      </article>
    </div>
  </section>

  <!-- CENTURY IN MOTION -->
  <section class="hs-century">
    <div class="container hs-century__inner">
      <div class="hs-heading hs-heading--centered">
        <p class="eyebrow">Our Journey</p>
        <h2>
          More than a century <span>in motion</span>
        </h2>
        <p>
          From seven educators in Indianapolis to a national institution shaped by education, civic
          action, service, and organizational growth.
        </p>
      </div>
      <div class="hs-century__story">
        {timeline.map((t) => (
          <div class:list={["hs-chapter", t.side === "right" && "hs-chapter--right"]}>
            <div class="hs-chapter__year">
              <span class="hs-chapter__pill">
              {/* Ranges break after the dash so "1950s–1960s" fits the rail. */}
              {t.year.split("–").map((part, i, all) => (
                <span>
                  {/* LEMON MILK has no lowercase, so "1930s" would read
                      "1930S". The decade's s is set in Montserrat instead. */}
                  {part.endsWith("s") ? (
                    <>
                      {part.slice(0, -1)}
                      <span class="hs-chapter__decade">s</span>
                    </>
                  ) : (
                    part
                  )}
                  {i < all.length - 1 && "–"}
                </span>
              ))}
              </span>
            </div>
            <div class="hs-chapter__copy">
              <p class="hs-chapter__label">
                {t.label}
              </p>
              <h3>{t.head}</h3>
              <p>{t.body}</p>
            </div>
            {t.note.style === "plain" && (
              <div class="hs-chapter__aside">
                <p class="hs-chapter__kind">{t.note.kind}</p>
                <p class="hs-chapter__note">{t.note.text}</p>
              </div>
            )}
            {t.note.style === "gold" && (
              <div class="hs-chapter__aside hs-chapter__aside--gold">
                <p class="hs-chapter__kind">{t.note.kind}</p>
                <p class="hs-chapter__note">{t.note.text}</p>
              </div>
            )}
            {t.note.style === "stat" && (
              <div class="hs-chapter__stat">
                <span class="hs-stat-number">{t.note.number}</span>
                <span class="hs-stat-label">{t.note.kind}</span>
                <p class="hs-stat-note">{t.note.text}</p>
              </div>
            )}
            {t.note.style === "quote" && (
              <div class="hs-chapter__quote">
                <p class="hs-chapter__kind">{t.note.kind}</p>
                <span>{t.note.line}</span>
                <strong>{t.note.text}</strong>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- REGIONS -->
  <section class="hs-section hs-regions">
    <div class="container">
      <div class="hs-heading">
        <p class="eyebrow eyebrow--rule">National Structure</p>
        <h2>
          A national sisterhood. <span>Five regions.</span>
        </h2>
        <p>
          The regional system connected a growing Sorority across chapters, campuses, communities,
          and generations of leadership.
        </p>
      </div>
      <div class="hs-region-grid">
        {regions.map((r) => (
          <article class="hs-region-card">
            <div class="hs-region-top">
              <div>
                <p class="hs-region-eyebrow">
                  {r.meta.split(" • ").map((line) => (
                    <span>{line}</span>
                  ))}
                </p>
                <h3>{r.name}</h3>
              </div>
            </div>
            <p class="hs-region-lead">{r.lead}</p>
            <p class="hs-region-body">{r.body}</p>
            <a class="hs-region-link" href={r.site} target="_blank" rel="noopener">
              Visit the {r.name} Region
              <span class="visually-hidden"> website (opens in a new tab)</span>
              <span aria-hidden="true"> ↗</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- LEGACY -->
  <section class="hs-legacy">
    <figure class="hs-legacy__image">
      <img
        src={withBase("/images/Sigma Gamma Rho 75th Anniversary Stained Glass Window.jpg")}
        alt="Sigma Gamma Rho commemorative stained glass"
      />
    </figure>
    <div class="hs-legacy__copy">
      <p class="eyebrow eyebrow--rule">A Living Legacy</p>
      <h2>
        History That Still <span>Requires Something of Us</span>
      </h2>
      <p class="hs-motto">Greater Service, Greater Progress.</p>
      <p>
        From a small gathering of educators at Butler University to an international sisterhood
        spanning generations, the story is still in motion.
      </p>
      <div class="hs-button-row">
        <Button href="/service-impact/national-programs/">
          Explore National Programs <span aria-hidden="true">&rarr;</span>
        </Button>
        <a class="hs-text-button" href={withBase("/service-impact/partner-foundations/#nef")}>
          Support the Legacy <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <CtaBand
    title="The story is still"
    highlight="in motion"
    copy="More than a century later, the responsibility remains — and each generation inherits the work."
    actions={[{ label: "Become a Member", href: "/membership/become-a-member/" }]}
  />
</Base>

<style>
  .container {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }
  .gold-rule {
    width: 84px;
    height: 2px;
    margin: 34px 0 24px;
    background: var(--gold);
  }
  .eyebrow--rule {
    position: relative;
  }
  .eyebrow--rule::after {
    content: "";
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--gold);
    margin-top: var(--space-4);
  }

  /* ---- HERO ---- */
  .hs-hero {
    position: relative;
    overflow: hidden;
    min-height: 560px;
    display: flex;
    align-items: center;
    color: #fff;
    background: var(--navy);
  }
  .hs-hero__image {
    position: absolute;
    inset: 0;
    background-image: url("/images/sgr-alpha-charter.jpeg");
    background-size: cover;
    background-position: 66% 42%;
    filter: grayscale(100%);
  }
  .hs-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(8, 22, 51, 0.98) 0%,
      rgba(14, 37, 88, 0.93) 38%,
      rgba(21, 52, 122, 0.62) 70%,
      rgba(8, 22, 51, 0.4) 100%
    );
  }
  .hs-hero__content {
    position: relative;
    z-index: 2;
    padding-block: clamp(4.5rem, 10vw, 6rem);
  }
  .hs-hero__title {
    margin: 0;
    font-family: var(--font-label);
    font-weight: 400;
    font-size: clamp(3.2rem, 9vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: #fff;
  }
  .hs-hero__title span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .hs-hero__copy {
    max-width: 42rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--text-md);
    line-height: 1.75;
    font-weight: 400;
  }
  .hs-hero__date {
    position: absolute;
    left: 0;
    bottom: -2.5rem;
    z-index: 1;
    color: rgba(255, 255, 255, 0.035);
    font-family: var(--font-label);
    font-size: clamp(6rem, 14vw, 13rem);
    letter-spacing: -0.05em;
  }

  /* ---- shared heading pattern ---- */
  .hs-section {
    padding-block: clamp(3.5rem, 6vw, 4.5rem);
    background: var(--white);
  }
  .hs-heading h2 {
    margin: 0;
    color: var(--royal);
    font-family: var(--font-label);
    font-weight: 400;
    font-size: clamp(1.75rem, 3.4vw, 2.6rem);
    line-height: 1.12;
  }
  .hs-heading h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .hs-heading > p:not(.eyebrow) {
    margin-top: var(--space-4);
    color: var(--muted);
    max-width: 46rem;
  }
  .hs-heading--centered {
    text-align: center;
    max-width: 48rem;
    margin: 0 auto var(--space-12);
  }

  /* ---- THE BEGINNING split ---- */
  .hs-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(min(380px, 100%), 0.9fr);
    gap: clamp(2.5rem, 6vw, 4.75rem);
    align-items: center;
  }
  .hs-story-copy h2 {
    margin: 0 0 var(--space-4);
    color: var(--royal);
    font-family: var(--font-label);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.12;
  }
  .hs-story-copy h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .hs-story-copy p {
    color: #4c5565;
    font-size: var(--text-base);
    line-height: 1.9;
  }
  .hs-emphasis {
    color: var(--royal) !important;
    font-weight: 700;
  }
  .hs-historical-card {
    margin: 0;
    position: relative;
    padding: 14px;
    background: #fff;
  }
  .hs-historical-card img {
    width: 100%;
    height: clamp(300px, 34vw, 390px);
    display: block;
    object-fit: cover;
    filter: grayscale(100%);
  }
  .hs-historical-card figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 15px 10px 2px;
    text-align: center;
  }
  .hs-historical-card figcaption span {
    color: var(--royal);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.6px;
    text-transform: uppercase;
  }
  .hs-historical-card figcaption small {
    margin-top: 3px;
    color: var(--muted);
  }
  .hs-year-badge {
    width: 90px;
    height: 90px;
    position: absolute;
    right: -20px;
    top: -22px;
    display: grid;
    place-content: center;
    text-align: center;
    border-radius: 50%;
    color: var(--navy);
    background: var(--gold);
    box-shadow: 0 12px 26px rgba(8, 22, 51, 0.18);
  }
  .hs-year-badge small {
    font-size: 8px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .hs-year-badge strong {
    margin-top: 3px;
    font-family: var(--font-label);
    font-size: 24px;
  }
  @media (max-width: 820px) {
    .hs-split {
      grid-template-columns: 1fr;
    }
    .hs-historical-card {
      max-width: 420px;
      margin-inline: auto;
    }
  }

  /* ---- KEY FACTS: bordered table grid, not rounded cards ---- */
  .hs-key-facts {
    background: var(--cream);
  }
  /* Ten facts: 5 x 2 wide, 2 x 5 below. Only 5 and 2 divide ten evenly, so
     there is deliberately no 3- or 4-column step — either would strand a card
     alone on the last row. */
  .hs-facts-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  /* Data sheet, not boxes (Karena, Sept 2026): each fact is set off by a
     thin gold rule above it and sits directly on the cream band. */
  .hs-fact-card {
    position: relative;
    padding-top: var(--space-4);
    border-top: 1px solid var(--gold);
    /* Column flow so a card's link row sits on the card's bottom edge, level
       with its neighbours' link rows. */
    display: flex;
    flex-direction: column;
  }
  .hs-fact-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0 0 var(--space-2);
  }
  .hs-fact-card h3 {
    margin: 0;
    color: var(--royal);
    font-size: 1.1rem;
    line-height: 1.35;
  }
  .hs-fact-body {
    margin: var(--space-3) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }
  .hs-fact-link {
    align-self: flex-start;
    margin-top: auto;
    padding-top: var(--space-4);
    padding-bottom: 2px;
    color: var(--royal);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .hs-fact-link:hover {
    color: var(--accent-hover);
    border-bottom-color: currentColor;
  }
  @media (max-width: 1080px) {
    .hs-facts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 540px) {
    .hs-facts-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- FIRSTS: heading beside a bordered 3-col grid ---- */
  .hs-firsts__inner {
    display: grid;
    grid-template-columns: 0.62fr 1.38fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  .hs-firsts__heading h2 {
    margin: 0 0 var(--space-4);
    color: var(--royal);
    font-family: var(--font-label);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .hs-firsts__heading h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .hs-firsts__heading p:not(.eyebrow) {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .hs-firsts-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(32, 65, 165, 0.13);
    border-left: 1px solid rgba(32, 65, 165, 0.13);
  }
  .hs-firsts-list article {
    padding: var(--space-5);
    border-right: 1px solid rgba(32, 65, 165, 0.13);
    border-bottom: 1px solid rgba(32, 65, 165, 0.13);
    background: rgba(255, 255, 255, 0.62);
    min-height: 175px;
  }
  .hs-firsts-list h3 {
    margin: 0 0 var(--space-2);
    color: var(--royal);
    font-size: var(--text-sm);
    line-height: 1.4;
  }
  .hs-firsts-list p {
    margin: 0;
    color: #5d6675;
    font-size: var(--text-xs);
    line-height: 1.7;
  }
  @media (max-width: 820px) {
    .hs-firsts__inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .hs-firsts-list {
      grid-template-columns: 1fr;
    }
  }

  /* ---- MISSION / VISION ---- */
  .hs-mv {
    background: #fff;
  }
  .hs-mv__inner {
    padding-block: clamp(2.5rem, 5vw, 3.875rem);
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    gap: clamp(1.75rem, 4vw, 2.75rem);
    align-items: start;
  }
  .hs-mv__inner h2 {
    margin: 0 0 var(--space-3);
    color: var(--royal);
    font-family: var(--font-label);
    font-weight: 400;
    font-size: clamp(1.6rem, 3vw, 2.375rem);
  }
  .hs-mv__inner article:last-child h2 {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .hs-mv__inner p {
    margin: 0;
    color: #596273;
    font-size: var(--text-sm);
    line-height: 1.78;
    max-width: 68ch;
  }
  .hs-mv__divider {
    width: 1px;
    min-height: 150px;
    background: linear-gradient(180deg, transparent, var(--line), transparent);
  }
  @media (max-width: 820px) {
    .hs-mv__inner {
      grid-template-columns: 1fr;
    }
    .hs-mv__divider {
      width: 100%;
      height: 1px;
      min-height: 1px;
    }
  }

  /* ---- CENTURY TIMELINE ---- */
  .hs-century {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 8vw, 6.5rem);
    /* Light timeline (Karena, Sept 2026): white ground, royal type, gold
       for the rails, dots and year pills. Gold never carries small text
       here — pills are gold fills with navy text, since gold on white fails
       the FY2027 guidelines' own WCAG AA requirement. */
    color: var(--ink);
    background: var(--white);
    border-block: 2px solid var(--gold);
  }
  .hs-century::before {
    content: "1922";
    position: absolute;
    top: 4rem;
    left: -1.5rem;
    color: rgba(32, 65, 165, 0.04);
    font-family: var(--font-label);
    font-size: clamp(8rem, 16vw, 17.5rem);
    line-height: 1;
    pointer-events: none;
  }
  .hs-century__inner {
    position: relative;
    z-index: 1;
  }
  .hs-century__story {
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }
  .hs-chapter {
    position: relative;
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr) 260px;
    gap: clamp(1.5rem, 3vw, 2.75rem);
    padding-block: clamp(2rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }
  .hs-chapter:last-child {
    border-bottom: 0;
  }
  /* Right-hand rows mirror the grid: note | copy | year. Only the visual order
     changes — the DOM stays year, copy, note, so screen readers and the
     mobile stack read the same sequence on every row. */
  .hs-chapter--right {
    grid-template-columns: 260px minmax(0, 1fr) 170px;
  }
  .hs-chapter--right .hs-chapter__year {
    order: 3;
    text-align: left;
    padding-right: 0;
    padding-left: 2.25rem;
  }
  .hs-chapter--right .hs-chapter__year::after {
    right: auto;
    left: -6px;
  }
  .hs-chapter--right .hs-chapter__copy {
    order: 2;
    text-align: right;
  }
  .hs-chapter--right > :last-child {
    order: 1;
  }
  /* Range lines stack inside the pill; the pill itself stays inline so it
     hugs the year instead of filling the column. */
  .hs-chapter__pill > span {
    display: block;
  }
  .hs-chapter__decade {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.82em;
    text-transform: none;
  }
  .hs-chapter__year {
    position: relative;
    z-index: 2;
    align-self: start;
    font-family: var(--font-label);
    font-size: clamp(1.2rem, 1.8vw, 1.6rem);
    line-height: 1.1;
    text-align: right;
    padding-right: 2.25rem;
  }
  /* The year pill: a gold fill carrying navy type (8.9:1). */
  .hs-chapter__pill {
    display: inline-block;
    padding: 0.5em 0.8em 0.45em;
    border-radius: var(--radius-lg);
    background: var(--gold);
    color: var(--navy);
    text-align: center;
  }
  .hs-chapter__year::after {
    content: "";
    width: 13px;
    height: 13px;
    position: absolute;
    top: 14px;
    right: -6px;
    border: 3px solid var(--white);
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 1px rgba(223, 177, 54, 0.5);
  }
  /* Scoped under __copy: the generic `.hs-chapter__copy p` rule (0,1,1)
     otherwise overrides this label's colour and turns it grey. */
  .hs-chapter__copy .hs-chapter__label {
    margin: 0 0 var(--space-2);
    color: var(--accent-text);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .hs-chapter__copy h3 {
    margin: 0 0 var(--space-4);
    color: var(--royal);
    font-family: var(--font-label);
    font-weight: 400;
    font-size: clamp(1.15rem, 2vw, 1.7rem);
    line-height: 1.2;
  }
  .hs-chapter__copy p {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.85;
  }
  .hs-chapter__aside {
    align-self: start;
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--white);
  }
  .hs-chapter__aside--gold {
    border-color: rgba(223, 177, 54, 0.5);
    background: #fcf6e6;
  }
  .hs-chapter__kind {
    margin: 0 0 var(--space-2);
    color: var(--accent-text);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .hs-chapter__note {
    margin: 0;
    color: var(--navy);
    font-size: var(--text-md);
    line-height: 1.45;
  }
  .hs-stat-note {
    margin: var(--space-3) 0 0;
    color: var(--navy);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .hs-chapter__quote {
    align-self: center;
    padding: clamp(1rem, 3vw, 1.8rem);
    border-left: 3px solid var(--gold);
  }
  .hs-chapter__quote span {
    display: block;
    color: var(--royal);
    font-family: var(--font-label);
    font-size: var(--text-md);
  }
  .hs-chapter__quote strong {
    display: block;
    margin-top: 5px;
    /* Display gold passes only as large text, so this never drops below
       24px. */
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
    font-family: var(--font-label);
    font-weight: 400;
    font-size: clamp(1.5rem, 2.5vw, 1.75rem);
  }
  .hs-chapter__stat {
    align-self: center;
    min-height: 140px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-5);
    border-radius: 14px;
    background: var(--gold);
    color: var(--navy);
  }
  .hs-stat-number {
    font-family: var(--font-label);
    font-size: clamp(2rem, 4vw, 3.1rem);
    font-weight: 400;
  }
  .hs-stat-label {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  @media (max-width: 900px) {
    .hs-chapter {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .hs-chapter__year {
      text-align: left;
    }
    .hs-chapter--right .hs-chapter__year,
    .hs-chapter--right .hs-chapter__copy,
    .hs-chapter--right > :last-child {
      order: 0;
      text-align: left;
    }
    .hs-chapter--right .hs-chapter__year {
      padding-left: 0;
      padding-right: 2.25rem;
    }
    .hs-chapter--right .hs-chapter__year::after {
      left: auto;
      right: -6px;
    }
  }

  /* ---- REGIONS ---- */
  .hs-regions {
    background: var(--white);
  }
  .hs-region-grid {
    margin-top: var(--space-10);
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-3);
  }
  .hs-region-card {
    position: relative;
    overflow: hidden;
    padding: var(--space-6);
    border: 1px solid rgba(32, 65, 165, 0.1);
    /* No gold top-bar: a thick accent border on a rounded card is the
       template tell DESIGN.md's Hairline Rule rejects. Gold still reads here
       through the eyebrow. Radius aligned to
       --radius-lg; 13px was off the two-step scale. */
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, #fffdf8, #fff);
    min-height: 280px;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  /* The whole card is the link (via .hs-region-link::after), so it shows
     that it is actionable. No thick accent bar: see the Hairline note above. */
  .hs-region-card:hover,
  .hs-region-card:focus-within {
    border-color: rgba(32, 65, 165, 0.45);
    transform: translateY(-3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .hs-region-card,
    .hs-region-card:hover,
    .hs-region-card:focus-within {
      transition: none;
      transform: none;
    }
  }
  .hs-region-top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
  }
  /* Two date lines ("Established …" / "Organized …"), broken at the bullet
     rather than wherever the column runs out. The reserved two-line height
     keeps every region name on the same baseline, including Northeastern,
     which has a single date. */
  .hs-region-eyebrow {
    min-height: 3.2em;
    line-height: 1.6;
    margin: 0 0 var(--space-1);
    color: var(--accent-text);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hs-region-eyebrow span {
    display: block;
  }
  .hs-region-card h3 {
    margin: 0;
    color: var(--royal);
    font-family: var(--font-label);
    font-weight: 400;
    font-size: 1.4rem;
  }
  .hs-region-lead {
    margin: var(--space-5) 0 var(--space-3);
    color: var(--navy);
    font-size: var(--text-sm);
    line-height: 1.55;
  }
  .hs-region-body {
    margin: 0;
    color: #606979;
    font-size: var(--text-xs);
    line-height: 1.72;
  }
  /* Short, specific link text for screen readers; the ::after stretches its
     hit area over the whole card so any click on the card follows it. */
  .hs-region-link {
    align-self: flex-start;
    margin-top: auto;
    padding-top: var(--space-5);
    padding-bottom: 2px;
    color: var(--royal);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .hs-region-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .hs-region-card:hover .hs-region-link {
    color: var(--accent-hover);
    border-bottom-color: currentColor;
  }
  @media (max-width: 1050px) {
    .hs-region-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    /* Five regions in two columns leave the fifth alone; let it span the
       row instead of sitting beside an empty cell. */
    .hs-region-card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .hs-region-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- LEGACY ---- */
  .hs-legacy {
    min-height: 500px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--cream);
  }
  /* The window depicts the coat of arms, and the FY2027 guidelines forbid a
     cropped Shield. So it is shown whole (contain, not cover), centred with
     clear space around it rather than bled to the edges. */
  .hs-legacy__image {
    margin: 0;
    padding: clamp(2rem, 5vw, 4rem);
    display: grid;
    place-items: center;
  }
  .hs-legacy__image img {
    width: 100%;
    height: auto;
    max-height: 620px;
    display: block;
    object-fit: contain;
  }
  .hs-legacy__copy {
    padding: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 7vw, 6.9rem);
    align-self: center;
  }
  .hs-legacy__copy h2 {
    margin: var(--space-2) 0 var(--space-4);
    color: var(--royal);
    font-family: var(--font-label);
    font-weight: 400;
    font-size: clamp(1.75rem, 3.4vw, 2.6rem);
  }
  .hs-legacy__copy h2 span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  /* Body paragraphs only: this used to catch the eyebrow too, turning
     "A Living Legacy" grey and body-sized. */
  .hs-legacy__copy > p:not(.eyebrow):not(.hs-motto) {
    color: #4c5565;
    font-size: var(--text-base);
    line-height: 1.9;
  }
  /* The One Signature Rule (DESIGN.md): Pinyon Script, once per page, on the
     page's highest-emotion phrase. This is that one use on this site — the
     registered motto closing the legacy section.

     It was previously an 11px uppercase tracked label, which is the exact
     treatment AGENTS.md §6 forbids for this face ("never uppercased or
     letter-spaced"). So the rule is rebuilt rather than reskinned: no
     uppercase, no tracking, and sized well past the 30px floor because
     Pinyon's x-height is tiny. The two !important flags are gone with it —
     they were fighting `.hs-legacy__copy > p`, which this now outranks on
     specificity alone. */
  .hs-legacy__copy .hs-motto {
    margin: var(--space-2) 0 var(--space-4);
    font-family: var(--font-kicker);
    font-size: clamp(2.25rem, 1.6rem + 2vw, 3rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: normal;
    text-transform: none;
    color: var(--accent-text);
  }
  .hs-button-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-5);
