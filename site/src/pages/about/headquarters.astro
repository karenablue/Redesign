---
/**
 * International Corporate Headquarters — merges the static export's editorial
 * structure (breadcrumb hero, zigzag intro, executive spotlight, location
 * zigzag, help-center CTA) with the real staff photos and bios pulled
 * directly from the live Figma Make source (InternationalCorporateHeadquarters.tsx),
 * which hosts real headshots at sgrho1922.org.
 */
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import FactSheet from "../../components/FactSheet.astro";
import LinkGrid from "../../components/LinkGrid.astro";
import Button from "../../components/Button.astro";
import CtaBand from "../../components/CtaBand.astro";
import { withBase } from "../../lib/url.js";

const staff = [
  {
    name: "Aminata Mbaye",
    title: "Chief of Staff",
    img: "/images/ichq/amy-headshot-2024.webp",
    note: "Nonprofit management, strategic event planning, community relations, and organizational delivery.",
  },
  {
    name: "Gwendolyn Goins",
    title: "Operations Director",
    img: "/images/ichq/gwen-headshot-2024.jpg",
    note: "Customer service, membership services, vendor services, communications, and operational oversight.",
  },
  {
    name: "Asha Singh",
    title: "Finance Manager",
    img: "/images/ichq/asha-headshot-2024.jpg",
    note: "Finance leadership, audits, tax filing, and financial foundation.",
  },
  {
    name: "Karya Evans",
    title: "Membership Services Manager",
    img: "/images/ichq/karya-headshot-2024.jpg",
    note: "Membership and customer service operations, reactivation, transfers, charters, and member support.",
  },
  {
    name: "Nicole Rhone",
    title: "HR Business Partner",
    img: "/images/ichq/nicole-headshot-2024.jpg",
    note: "Human resources leadership, organizational capacity, coaching, and culture.",
  },
  {
    name: "Juneann George",
    title: "Project Manager",
    img: "/images/ichq/juneann-headshot-2024.jpg",
    note: "Strategic projects, operations, compliance, and project delivery.",
  },
  {
    name: "Joshua Gabrielson",
    title: "IT Manager",
    img: "/images/ichq/joshua-headshot-2025.jpg",
    note: "Technology modernization, cybersecurity, database administration, cloud platforms, and systems integration.",
  },
  {
    name: "Tahesha LeFevre",
    title: "Compliance Specialist",
    img: "/images/ichq/tahesha-headshot-2024.jpg",
    note: "Compliance support, legal coordination, chapter filings, and governance administration.",
  },
  {
    name: "Jamila Walker",
    title: "Marketing & Comms Manager",
    img: "/images/ichq/jamila-headshot-2025.jpg",
    note: "Marketing strategy, media relations, digital communications, web content, and brand communications.",
  },
  {
    name: "Patrice Rullo",
    title: "Conference & Event Planning Manager",
    img: "/images/ichq/patrice-headshot-2025.jpg",
    note: "Global event planning, conference logistics, attendee engagement, and mission-driven execution.",
  },
];
---

<Base
  title="International Corporate Headquarters"
  activeTop="About Us"
  description="International Corporate Headquarters keeps the international sisterhood running — every day, in every region."
>
  <PageHero
    eyebrow="International Corporate Headquarters"
    title="Here for the"
    highlight="work of sisterhood."
    copy="The people and services behind Sigma Gamma Rho’s daily work. Supporting members, chapters, and regions from our home in Cary, North Carolina."
    image="/optimized/hero-ichq.webp"
    focal="50% 25%"
  >
    <Button href="/resources/help-center/">Get Member Support</Button>
    <Button href="/contact/" variant="outline" onDark>Contact Headquarters</Button>
  </PageHero>

  <section class="hq-services" aria-labelledby="hq-services-title">
    <div class="container hq-services__inner">
      <div class="hq-services__heading">
        <p class="eyebrow">Start Here</p>
        <h2 id="hq-services-title">How can we help?</h2>
      </div>
      <LinkGrid
        items={[
          {
            label: "Member & Chapter Support",
            note: "Find guidance on membership, chapter services, and common questions.",
            href: "/resources/help-center/",
          },
          {
            label: "Media & Brand Inquiries",
            note: "Connect with the Sorority’s media resources and communications team.",
            href: "/news-events/media-relations/",
          },
          {
            label: "Reach Headquarters",
            note: "Find our office and mailing addresses, telephone number, and email.",
            href: "#hq-location",
          },
        ]}
      />
    </div>
  </section>

  <section class="hq-zigzag">
    <div class="container hq-zigzag__row">
      <div>
        <p class="eyebrow">What ICHQ Does</p>
        <h2>
          Every chapter. <span>Every member.</span>
        </h2>
        <p>
          International Corporate Headquarters supports the systems, services, and people that keep
          the Sorority running &mdash; membership services, finance, technology, compliance,
          marketing, and event planning for chapters and members worldwide.
        </p>
        <a class="hq-text-link" href="#hq-team">Meet the headquarters team <span aria-hidden="true">↓</span></a>
        {/* HQ's certification, as published on sgrho1922.org. It runs
            November 2025 to November 2026: replace the badge with the
            renewal, or remove this block, when it lapses. */}
        <div class="hq-gptw">
          <img
            src={withBase("/images/live-2026/great-place-to-work-certified.svg")}
            alt="Great Place To Work Certified, November 2025 to November 2026, USA"
            width="66"
            height="112"
            loading="lazy"
          />
          <p>
            <strong>Great Place To Work<sup>&reg;</sup> Certified</strong>
            Our employees have spoken: International Corporate Headquarters is certified for
            November 2025 to November 2026.
          </p>
        </div>
      </div>
      <figure class="hq-artifact">
        <img
          src={withBase("/images/Sigma Gamma Rho Sorority Mosaic Crest.jpg")}
          alt="Sigma Gamma Rho Sorority crest mosaic"
        />
        <figcaption>Sigma Gamma Rho Sorority crest mosaic</figcaption>
      </figure>
    </div>
  </section>

  <section class="hq-exec on-dark">
    <div class="container hq-exec__inner">
      <figure class="hq-exec__photo">
        <img
          src={withBase("/images/ichq/karen-w-headshot-2024.jpg")}
          alt="Dr. Karen Y. Williams, Executive Director"
        />
        <figcaption>
          <span>Executive Leadership</span>
          <strong>ICHQ</strong>
        </figcaption>
      </figure>
      <div class="hq-exec__copy">
        <p class="eyebrow">Executive Director</p>
        <h2>
          Dr. Karen Y. <span>Williams</span>
        </h2>
        <p>
          As Executive Director, Dr. Karen Y. Williams champions innovation, member engagement,
          operational efficiency, and organizational excellence across Sigma Gamma Rho's
          international sisterhood. A certified Lean Six Sigma practitioner and retired government
          executive, she brings a background in business transformation, leadership development,
          financial literacy, and process improvement.
        </p>
      </div>
    </div>
  </section>

  <section class="hq-staff" id="hq-team">
    <div class="container">
      <div class="hq-heading">
        <p class="eyebrow">Headquarters Team</p>
        <h2>
          People behind <span>the progress.</span>
        </h2>
        <p>
          The ICHQ staff supports the work that members, chapters, regions, leaders, partners, and
          communities depend on every day.
        </p>
      </div>
      <ul class="hq-team">
        {staff.map((s) => (
          <li class="hq-person">
            <img
              class="hq-person__img"
              src={withBase(s.img)}
              alt={s.name}
              width="320"
              height="400"
              loading="lazy"
            />
            <h3 class="hq-person__name">{s.name}</h3>
            <p class="hq-person__title">{s.title}</p>
            <p class="hq-person__note">{s.note}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="hq-zigzag hq-location" id="hq-location">
    <div class="container hq-zigzag__row hq-zigzag__row--flip">
      <div>
        <p class="eyebrow">Where We're Located</p>
        <h2>
          Serving Members <span>Worldwide.</span>
        </h2>
        <p>
          International Corporate Headquarters is based in Cary, North Carolina, and supports
          chapters and regions around the world.
        </p>
        {/* Cary matches the site footer and Herstory. The Raleigh P.O. box is
            kept as the mailing address; HQ should confirm it is current. */}
        <div class="hq-facts">
          <FactSheet
            cols={2}
            items={[
              { label: "Office", lines: ["1000 Southhill Dr", "STE 200", "Cary, NC 27513"] },
              { label: "Mailing", lines: ["P.O. Box 27688", "Raleigh, NC 27611"] },
              { label: "Phone", lines: ["(919) 678-9720"], href: "tel:+19196789720" },
              { label: "Email", lines: ["help@sgrho1922.org"], href: "mailto:help@sgrho1922.org" },
            ]}
          />
        </div>
      </div>
      <figure class="hq-zigzag__art">
        <img
          src={withBase("/images/alumnae sorors 2.jfif")}
          alt="Sigma Gamma Rho alumnae members together"
        />
      </figure>
    </div>
  </section>

  <CtaBand
    eyebrow="Need Assistance?"
    title="We're Here to "
    highlight="Help."
    copy="Visit the Help Center or contact Headquarters directly with your question."
    actions={[
      { label: "Visit Help Center", href: "/resources/help-center/" },
      { label: "Contact the Team", href: "/contact/", variant: "outline" },
    ]}
  />
</Base>

<style>
  .hq-services {
    background: var(--cream);
    padding-block: var(--space-12);
    border-bottom: 1px solid var(--line);
  }
  /* Herstory's "Firsts" layout: the heading beside a ruled grid. */
  .hq-services__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  .hq-services__heading h2 {
    margin: 0;
    font-family: var(--font-editorial);
    font-weight: 500;
    font-size: var(--text-h3);
  }
  .hq-facts {
    margin-top: var(--space-6);
  }
  .hq-gptw {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    max-width: 30rem;
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .hq-gptw img {
    flex: none;
    width: 66px;
    height: auto;
  }
  .hq-gptw p {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .hq-gptw strong {
    display: block;
    color: var(--navy);
    font-size: var(--text-base);
  }
  .hq-text-link {
    display: inline-block;
    margin-top: var(--space-4);
    font-weight: 700;
    text-underline-offset: 0.3em;
  }
  #hq-team,
  #hq-location {
    scroll-margin-top: var(--space-24);
  }

  .hq-zigzag {
    background: var(--white);
    padding-block: var(--section-y);
  }
  .hq-zigzag__row {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--space-14);
    align-items: center;
  }
  .hq-zigzag__row h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h2);
  }
  .hq-zigzag__row h2 span {
    display: block;
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 500;
    color: var(--accent-text);
  }
  .hq-zigzag__row p:not(.eyebrow) {
    color: var(--muted);
  }
  .hq-zigzag__art {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .hq-zigzag__art img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
  }
  /* Photo-left variant, so the page reads as a true zigzag. */
  .hq-zigzag__row--flip {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
  }
  .hq-zigzag__row--flip > figure {
    order: -1;
  }
  /* The crest mosaic is shown whole: it carries the Shield, which the
     guidelines say is never cropped. Framed and captioned. */
  .hq-artifact {
    margin: 0;
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-bottom: 4px solid var(--gold);
    background: var(--cream);
  }
  .hq-artifact img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: contain;
  }
  .hq-artifact figcaption {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--text-sm);
    text-align: center;
  }
  @media (max-width: 780px) {
    .hq-services__inner {
      grid-template-columns: 1fr;
    }
    .hq-zigzag__row,
    .hq-zigzag__row--flip {
      grid-template-columns: 1fr;
    }
    .hq-zigzag__row--flip > figure {
      order: 0;
    }
  }

  .hq-exec {
    background: var(--navy);
    padding-block: var(--section-y);
    color: var(--white);
  }
  .hq-exec__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1fr);
    gap: var(--space-14);
    align-items: center;
  }
  .hq-exec__photo {
    position: relative;
    margin: 0;
    border-bottom: 4px solid var(--gold);
    overflow: hidden;
  }
  .hq-exec__photo img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
  }
  .hq-exec__photo figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-4);
    background: var(--navy);
    color: var(--white);
    display: flex;
    flex-direction: column;
  }
  .hq-exec__photo figcaption span {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-on-dark-soft);
  }
  .hq-exec__copy h2 {
    margin: var(--space-2) 0 0;
    color: var(--white);
    font-size: var(--text-h2);
  }
  .hq-exec__copy h2 span {
    display: block;
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 500;
    color: var(--accent-text);
  }
  .hq-exec__copy p:not(.eyebrow) {
    color: var(--text-on-dark-soft);
  }
  @media (max-width: 780px) {
    .hq-exec__inner {
      grid-template-columns: 1fr;
    }
    .hq-exec__photo {
      max-width: 320px;
    }
  }

  .hq-staff {
    background: var(--white);
    padding-block: var(--section-y);
  }
  .hq-heading {
    max-width: 46rem;
    margin: 0 0 var(--space-12);
  }
  .hq-heading h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h2);
  }
  .hq-heading h2 span {
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 500;
    color: var(--accent-text);
  }
  .hq-heading p:not(.eyebrow) {
    color: var(--muted);
    margin-top: var(--space-4);
  }
  /* Uniform profile cards: same portrait crop, same padding, left-aligned
     name / title / focus. Flex with centred wrapping keeps the short last
     row in the middle. */
  .hq-team {
    --hq-gap: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: var(--hq-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hq-person {
    flex: 0 1 calc((100% - 3 * var(--hq-gap)) / 4);
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
    background: var(--white);
  }
  .hq-person__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 15%;
    border-bottom: 3px solid var(--gold);
    margin-bottom: var(--space-4);
  }
  .hq-person__name {
    margin: 0;
    color: var(--royal);
    font-size: var(--text-md);
    font-weight: 700;
    line-height: 1.3;
  }
  .hq-person__title {
    margin: var(--space-1) 0 0;
    color: var(--accent-text);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .hq-person__note {
    margin: var(--space-3) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .hq-location {
    background: var(--cream);
  }
  @media (max-width: 1000px) {
    .hq-person {
      flex-basis: calc((100% - 2 * var(--hq-gap)) / 3);
    }
  }
  @media (max-width: 680px) {
    .hq-team {
      --hq-gap: var(--space-4);
    }
    .hq-person {
      flex-basis: calc((100% - var(--hq-gap)) / 2);
      padding: var(--space-3);
    }
  }
</style>
