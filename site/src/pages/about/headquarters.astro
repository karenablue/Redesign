---
/**
 * International Corporate Headquarters — merges the static export's editorial
 * structure (breadcrumb hero, zigzag intro, executive spotlight, location
 * zigzag, help-center CTA) with the real staff photos and bios pulled
 * directly from the live Figma Make source (InternationalCorporateHeadquarters.tsx),
 * which hosts real headshots at sgrho1922.org.
 */
import Base from "../../layouts/Base.astro";
import SigmaRule from "../../components/SigmaRule.astro";
import CardGrid from "../../components/CardGrid.astro";
import Card from "../../components/Card.astro";
import CtaBand from "../../components/CtaBand.astro";
import { withBase } from "../../lib/url.js";

const staff = [
  {
    name: "Aminata Mbaye",
    title: "Chief of Staff",
    img: "https://sgrho1922.org/wp-content/uploads/2026/06/Amy-headshot-2024.webp",
    note: "Nonprofit management, strategic event planning, community relations, and organizational delivery.",
  },
  {
    name: "Gwendolyn Goins",
    title: "Operations Director",
    img: "https://sgrho1922.org/wp-content/uploads/2026/04/Gwen-headshot-2024.jpg",
    note: "Customer service, membership services, vendor services, communications, and operational oversight.",
  },
  {
    name: "Asha Singh",
    title: "Finance Manager",
    img: "https://sgrho1922.org/wp-content/uploads/2026/04/Asha-headshot-2024.jpg",
    note: "Finance leadership, audits, tax filing, and financial foundation.",
  },
  {
    name: "Karya Evans",
    title: "Membership Services Manager",
    img: "https://sgrho1922.org/wp-content/uploads/2026/04/Karya-headshot-2024.jpg",
    note: "Membership and customer service operations, reactivation, transfers, charters, and member support.",
  },
  {
    name: "Nicole Rhone",
    title: "HR Business Partner",
    img: "https://sgrho1922.org/wp-content/uploads/2026/04/Nicole-headshot-2024.jpg",
    note: "Human resources leadership, organizational capacity, coaching, and culture.",
  },
  {
    name: "Juneann George",
    title: "Project Manager",
    img: "https://sgrho1922.org/wp-content/uploads/2026/04/Juneann-headshot-2024.jpg",
    note: "Strategic projects, operations, compliance, and project delivery.",
  },
  {
    name: "Joshua Gabrielson",
    title: "IT Manager",
    img: "https://sgrho1922.org/wp-content/uploads/2026/04/Joshua-headshot-2025.jpg",
    note: "Technology modernization, cybersecurity, database administration, cloud platforms, and systems integration.",
  },
  {
    name: "Tahesha LeFevre",
    title: "Compliance Specialist",
    img: "https://sgrho1922.org/wp-content/uploads/2026/04/Tahesha-headshot-2024.jpg",
    note: "Compliance support, legal coordination, chapter filings, and governance administration.",
  },
  {
    name: "Jamila Walker",
    title: "Marketing & Comms Manager",
    img: "https://sgrho1922.org/wp-content/uploads/2026/04/Jamila-headshot-2025.jpg",
    note: "Marketing strategy, media relations, digital communications, web content, and brand communications.",
  },
  {
    name: "Patrice Rullo",
    title: "Conference & Event Planning Manager",
    img: "https://sgrho1922.org/wp-content/uploads/2026/04/Patrice-headshot-2025.jpg",
    note: "Global event planning, conference logistics, attendee engagement, and mission-driven execution.",
  },
];
---

<Base
  title="International Corporate Headquarters"
  activeTop="About"
  description="International Corporate Headquarters keeps the international sisterhood running — every day, in every region."
>
  <section class="hq-hero">
    <div class="container hq-hero__inner">
      <p class="breadcrumb">
        <a href={withBase("/")}>Home</a> <span>/</span> <span>About</span> <span>/</span>{" "}
        <span>International Corporate Headquarters</span>
      </p>
      <p class="eyebrow">About</p>
      <h1>
        The Administrative
        <br />
        <span>Home of the Sorority.</span>
      </h1>
      <p class="hq-hero__lead">
        International Corporate Headquarters keeps the international sisterhood running &mdash;
        every day, in every region.
      </p>
    </div>
  </section>

  <section class="hq-zigzag">
    <div class="container hq-zigzag__row">
      <div>
        <p class="eyebrow">What ICHQ Does</p>
        <h2>
          The Operational Engine <span>Behind the Mission.</span>
        </h2>
        <p>
          International Corporate Headquarters supports the systems, services, and people that keep
          the Sorority running &mdash; membership services, finance, technology, compliance,
          marketing, and event planning for chapters and members worldwide.
        </p>
      </div>
      <figure class="hq-zigzag__art">
        <img
          src={withBase("/images/Sigma Gamma Rho Sorority Mosaic Crest.jpg")}
          alt="Sigma Gamma Rho Sorority crest mosaic"
        />
      </figure>
    </div>
  </section>

  <SigmaRule />

  <section class="hq-exec">
    <div class="container hq-exec__inner">
      <figure class="hq-exec__photo">
        <img
          src="https://sgrho1922.org/wp-content/uploads/2026/04/Karen-W-headshot-2024.jpg"
          alt="Dr. Karen Y. Williams, Executive Director"
        />
        <figcaption>
          <span>Executive Leadership</span>
          <strong>ICHQ</strong>
        </figcaption>
      </figure>
      <div class="hq-exec__copy">
        <p class="eyebrow">Executive Director</p>
        <h2>
          Dr. Karen Y. <span>Williams</span>
        </h2>
        <p>
          As Executive Director, Dr. Karen Y. Williams champions innovation, member engagement,
          operational efficiency, and organizational excellence across Sigma Gamma Rho's
          international sisterhood. A certified Lean Six Sigma practitioner and retired government
          executive, she brings a background in business transformation, leadership development,
          financial literacy, and process improvement.
        </p>
      </div>
    </div>
  </section>

  <section class="hq-staff">
    <div class="container">
      <div class="hq-heading">
        <p class="eyebrow">Headquarters Team</p>
        <h2>
          Operational leadership. <span>Institutional continuity.</span>
        </h2>
        <p>
          The ICHQ staff supports the work that members, chapters, regions, leaders, partners, and
          communities depend on every day.
        </p>
      </div>
      <CardGrid min="260px" cols={3}>
        {staff.map((s) => (
          <Card image={s.img} imageAlt={s.name} title={s.name}>
            <p class="hq-staff__title">{s.title}</p>
            <p>{s.note}</p>
          </Card>
        ))}
      </CardGrid>
    </div>
  </section>

  <section class="hq-zigzag">
    <div class="container hq-zigzag__row">
      <div>
        <p class="eyebrow">Where We're Located</p>
        <h2>
          Serving Members <span>Worldwide.</span>
        </h2>
        <p>
          International Corporate Headquarters is based in Raleigh, North Carolina, and supports
          chapters and regions around the world.
        </p>
        <ul class="hq-facts">
          <li>P.O. Box 27688 &bull; Raleigh, NC 27611</li>
          <li>Office: (919) 678-9720</li>
          <li>
            <a href="mailto:help@sgrho1922.org">help@sgrho1922.org</a>
          </li>
        </ul>
      </div>
      <figure class="hq-zigzag__art">
        <img
          src={withBase("/images/alumnae sorors 2.jfif")}
          alt="Sigma Gamma Rho alumnae members together"
        />
      </figure>
    </div>
  </section>

  <CtaBand
    eyebrow="Need Assistance?"
    title="We're Here to "
    highlight="Help."
    copy="Visit the Help Center or contact Headquarters directly with your question."
    actions={[{ label: "Visit Help Center", href: "/resources/help-center/" }]}
  />
</Base>

<style>
  .hq-hero {
    background: var(--cream);
  }
  .hq-hero__inner {
    padding-block: clamp(3rem, 6vw, 4rem);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    color: var(--muted-2);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .breadcrumb a {
    color: inherit;
  }
  .hq-hero h1 {
    max-width: 600px;
    margin: var(--space-2) 0 0;
  }
  .hq-hero__lead {
    max-width: 540px;
    margin: var(--space-5) 0 0;
    color: var(--muted);
  }

  .hq-zigzag {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .hq-zigzag__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-14);
    align-items: center;
  }
  .hq-zigzag__row h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .hq-zigzag__row h2 span {
    color: var(--gold-text);
  }
  .hq-zigzag__row p:not(.eyebrow) {
    color: var(--muted);
  }
  .hq-zigzag__art {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  .hq-zigzag__art img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
  }
  .hq-facts {
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }
  .hq-facts li {
    padding: var(--space-3) 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .hq-facts a {
    color: var(--royal);
    font-weight: 700;
    text-decoration: none;
  }
  @media (max-width: 780px) {
    .hq-zigzag__row {
      grid-template-columns: 1fr;
    }
  }

  .hq-exec {
    background: var(--cream);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .hq-exec__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1fr);
    gap: var(--space-14);
    align-items: center;
  }
  .hq-exec__photo {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  .hq-exec__photo img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
  }
  .hq-exec__photo figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-4);
    background: linear-gradient(0deg, rgba(8, 22, 51, 0.85), transparent);
    color: #fff;
    display: flex;
    flex-direction: column;
  }
  .hq-exec__photo figcaption span {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.7);
  }
  .hq-exec__copy h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .hq-exec__copy h2 span {
    color: var(--gold-text);
  }
  .hq-exec__copy p:not(.eyebrow) {
    color: var(--muted);
  }
  @media (max-width: 780px) {
    .hq-exec__inner {
      grid-template-columns: 1fr;
    }
    .hq-exec__photo {
      max-width: 320px;
    }
  }

  .hq-staff {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .hq-heading {
    max-width: 46rem;
    margin: 0 auto var(--space-10);
    text-align: center;
  }
  .hq-heading h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h3);
  }
  .hq-heading h2 span {
    color: var(--gold-text);
  }
  .hq-heading p:not(.eyebrow) {
    color: var(--muted);
    margin-top: var(--space-4);
  }
  .hq-staff__title {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
</style>
