---
/**
 * HomeCover — the homepage opening. The founding educators and public mission
 * now lead for prospective members and first-time visitors (Karena,
 * 2026-09-30). The administration's One Sigma message has its own section
 * below. The photograph and film remain the visual cover.
 *
 * props:
 *   video  play the cover film: eight shots from HQ's own 61st Boulé recaps
 *          (images/boule-2026/SOURCES.md), with no words in the footage.
 *          The chapter photograph stays underneath as the first paint, and
 *          is all that shows on phones, with reduced motion, or on
 *          Save-Data.
 */
import { withBase } from "../lib/url.js";

interface Props {
  video?: boolean;
}
const { video = false } = Astro.props;

const still = {
  src: withBase("/optimized/home-cover.webp"),
  srcset: `${withBase("/optimized/home-cover-640.webp")} 640w, ${withBase("/optimized/home-cover-900.webp")} 900w, ${withBase("/optimized/home-cover.webp")} 1920w`,
};
---

<section class:list={["cover", "on-dark", { "cover--video": video }]} aria-labelledby="cover-title">
  <img
    class="cover__media"
    src={still.src}
    srcset={still.srcset}
    sizes="100vw"
    alt="Chapter members in yellow dresses, standing in a line on a lawn"
    fetchpriority="high"
  />
  {video && (
    <video
      class="cover__media cover__film"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      data-cover-video
    >
      <source src={withBase("/images/boule-2026/boule-2026-film.mp4")} type="video/mp4" />
    </video>
  )}
  <div class="cover__shade" aria-hidden="true"></div>
  <div class="container cover__grid">
    <div class="cover__masthead">
      <p class="cover__issue">
        Sigma Gamma Rho Sorority, Inc.<sup>&reg;</sup> &middot;{" "}
        <span class="cover__since">Since 1922</span>
      </p>
      <h1 id="cover-title" class="cover__title">
        Seven educators. <span>A century of service.</span>
      </h1>
      <p class="cover__tagline">
        Since 1922, Sigma Gamma Rho has brought women together through scholarship, sisterhood, and
        service in their communities.
      </p>
      <div class="cover__actions">
        <a class="btn" href={withBase("/membership/become-a-member/")}>
          Explore Membership <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="btn btn--outline on-dark" href={withBase("/service-impact/national-programs/")}>
          See Our Work <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
    {video && (
      <button class="cover__motion" type="button" data-cover-toggle aria-pressed="false">
        Pause background video
      </button>
    )}
  </div>
</section>

{video && <script>
  // The film plays only where it helps: a wide screen, no reduced-motion
  // request, no data saving. The button stops it (WCAG 2.2.2).
  const film = document.querySelector<HTMLVideoElement>("[data-cover-video]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-cover-toggle]");
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const allowed =
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
    window.matchMedia("(min-width: 900px)").matches &&
    !conn?.saveData;
  if (film && toggle) {
    const cover = film.closest(".cover");
    const sync = () => {
      const paused = film.paused;
      film.classList.toggle("is-playing", !paused);
      cover?.classList.toggle("is-film", !paused);
      toggle.setAttribute("aria-pressed", String(paused));
      toggle.textContent = paused ? "Play background video" : "Pause background video";
    };
    if (allowed) film.play().catch(() => {});
    film.addEventListener("play", sync);
    film.addEventListener("pause", sync);
    toggle.addEventListener("click", () => (film.paused ? film.play() : film.pause()));
    sync();
  }
</script>}

<style>
  .cover {
    position: relative;
    display: grid;
    min-height: min(calc(100svh - 6.75rem), 880px);
    overflow: hidden;
    color: #fff;
    background: var(--navy);
  }
  .cover__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
  }
  .cover__media:not(.cover__film) {
    animation: sgr-settle 12s var(--ease-out-strong) both;
  }
  /* The film fades in over the still once it is actually playing. */
  .cover__film {
    object-position: 50% 45%;
    opacity: 0;
    transition: opacity 900ms var(--ease-out-strong);
  }
  .cover__film.is-playing {
    opacity: 1;
  }
  /* Words sit on the lower third only: a navy floor under the masthead, a
     light veil at the top where the header meets the picture. */
  .cover__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(8, 22, 51, 0.55) 0%, rgba(8, 22, 51, 0) 22%),
      linear-gradient(
        0deg,
        rgba(8, 22, 51, 0.97) 0%,
        rgba(8, 22, 51, 0.88) 34%,
        rgba(8, 22, 51, 0) 68%
      );
  }
  .cover--video.is-film .cover__shade {
    background:
      linear-gradient(180deg, rgba(8, 22, 51, 0.55) 0%, rgba(8, 22, 51, 0) 22%),
      linear-gradient(
        0deg,
        rgba(8, 22, 51, 0.97) 0%,
        rgba(8, 22, 51, 0.88) 34%,
        rgba(8, 22, 51, 0.15) 68%
      );
  }

  .cover__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-8);
    padding-block: var(--space-12) clamp(var(--space-10), 5vw, var(--space-16));
  }
  .cover__issue {
    margin: 0 0 var(--space-4);
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .cover__issue sup {
    letter-spacing: 0;
  }
  .cover__since {
    white-space: nowrap;
  }
  .cover__title {
    margin: 0;
    font-family: var(--font-label);
    font-weight: 400;
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 0.96;
    letter-spacing: -0.045em;
    color: var(--white);
  }
  .cover__title span {
    display: block;
    color: var(--gold);
  }
  .cover__tagline {
    margin: var(--space-5) 0 0;
    max-width: 55ch;
    color: var(--white);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    font-weight: 600;
    line-height: 1.5;
  }
  .cover__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  /* A quiet control in the corner, level with the buttons. */
  .cover__motion {
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: var(--radius);
    background: rgba(8, 22, 51, 0.45);
    color: rgba(255, 255, 255, 0.92);
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
  }
  .cover__motion:hover {
    border-color: var(--gold);
    color: #fff;
  }
  @media (prefers-reduced-motion: reduce) {
    .cover__media {
      animation: none !important;
    }
  }

  /* Phones and tablets: the photograph sits at the top with the faces in
     view, and the masthead starts where it fades into navy — no empty band
     between. The film does not start here unasked; the control, in the
     photograph's top corner, lets a visitor opt in. */
  @media (max-width: 899px) {
    .cover {
      min-height: 0;
    }
    .cover__media {
      height: 22rem;
      object-position: 45% 40%;
    }
    .cover__shade,
    .cover--video.is-film .cover__shade {
      height: 22rem;
      background: linear-gradient(
        180deg,
        rgba(8, 22, 51, 0.45) 0,
        rgba(8, 22, 51, 0) 5rem,
        rgba(8, 22, 51, 0) 13rem,
        #081633 22rem
      );
    }
    .cover__grid {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 17.5rem var(--space-12);
    }
    .cover__motion {
      position: absolute;
      top: var(--space-4);
      right: 0;
    }
  }
  @media (max-width: 600px) {
    .cover__title {
      font-size: clamp(2.25rem, 9vw, 3rem);
    }
    .cover__actions .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
