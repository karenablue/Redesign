---
/**
 * HomeCover — the homepage opening, set as a magazine cover (Karena chose
 * concept A's cover, 2026-09-26): one full-bleed photograph of a chapter,
 * "One Sigma" as the masthead across the top over the trees (two-tone, with
 * the tagline, after the administration's One Sigma mark), the deck and
 * the two actions at the foot, and three cover lines that open real
 * stories. The faces stay clear between the masthead and the words.
 *
 * props:
 *   video  play the hero film behind the cover (Karena, 2026-09-26). The
 *          still stays underneath as the first paint, and is all that
 *          shows on phones, with reduced motion, or on Save-Data. The
 *          film has words set into it ("Envision ..."), so it runs under a
 *          heavier navy wash; ask HQ for the footage without titles.
 */
import { withBase } from "../lib/url.js";

interface Props {
  video?: boolean;
}
const { video = false } = Astro.props;

const PORTAL_URL = "https://portal.sgrho1922.org/";
const coverLines = [
  {
    title: "Boulé by the Bay",
    text: "Thousands of members, partners and guests gathered in Tampa for the 61st International Biennial Boulé.",
    href: "/news-events/latest-news/61st-biennial-boule/",
  },
  {
    title: "Water safety, one pool at a time",
    text: "SWIM 1922® brings water safety and swim instruction into local communities through USA Swimming.",
    href: "/service-impact/national-programs/#swim",
  },
  {
    title: "Meet the 2026–2028 board",
    text: "The International Board of Directors, chaired by the 26th International Grand Basileus.",
    href: "/leadership/international-board/",
  },
];
const still = {
  src: withBase("/optimized/home-cover.webp"),
  srcset: `${withBase("/optimized/home-cover-640.webp")} 640w, ${withBase("/optimized/home-cover-900.webp")} 900w, ${withBase("/optimized/home-cover.webp")} 1920w`,
};
---

<section class:list={["cover", "on-dark", { "cover--video": video }]} aria-labelledby="cover-title">
  <img
    class="cover__media"
    src={still.src}
    srcset={still.srcset}
    sizes="100vw"
    alt="Chapter members in yellow dresses, standing in a line on a lawn"
    fetchpriority="high"
  />
  {video && (
    <video
      class="cover__media cover__film"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      data-cover-video
    >
      <source src={withBase("/images/sgrho-hero.mp4")} type="video/mp4" />
    </video>
  )}
  <div class="cover__shade" aria-hidden="true"></div>
  <div class="container cover__grid">
    <div class="cover__masthead">
      <p class="cover__issue">Sigma Gamma Rho Sorority, Inc.<sup>&reg;</sup> Since 1922</p>
      <h1 id="cover-title" class="cover__title">One <span>Sigma</span></h1>
      <p class="cover__tagline">One mission. One vision. One sisterhood.</p>
    </div>
    <div class="cover__foot">
      <div class="cover__intro">
        <p class="cover__deck">Seven founders. A century of greater service.</p>
        <p class="cover__copy">
          From maternal health and water safety to educational opportunity, Sigma Gamma Rho puts
          sisterhood to work in communities across the country and beyond.
        </p>
        <div class="cover__actions">
          <a class="btn" href={withBase("/service-impact/national-programs/")}>
            Explore Our Impact <span aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn btn--outline on-dark" href={PORTAL_URL} target="_blank" rel="noopener">
            Member Login <span aria-hidden="true">&#8599;</span>
            <span class="visually-hidden"> (opens the Poodle Portal in a new tab)</span>
          </a>
        </div>
      </div>
      <ul class="cover__lines" aria-label="Featured stories">
        {coverLines.map((c) => (
          <li>
            <a href={withBase(c.href)}>
              <strong>{c.title}</strong>
              <span>{c.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  {video && (
    <button class="cover__motion" type="button" data-cover-toggle aria-pressed="false">
      Pause background video
    </button>
  )}
</section>

{video && (
  <script>
    // The film plays only where it helps: a wide screen, no reduced-motion
    // request, no data saving. The button stops it (WCAG 2.2.2).
    const film = document.querySelector<HTMLVideoElement>("[data-cover-video]");
    const toggle = document.querySelector<HTMLButtonElement>("[data-cover-toggle]");
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    const allowed =
      !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
      window.matchMedia("(min-width: 900px)").matches &&
      !conn?.saveData;
    if (film && toggle) {
      const cover = film.closest(".cover");
      const sync = () => {
        const paused = film.paused;
        film.classList.toggle("is-playing", !paused);
        cover?.classList.toggle("is-film", !paused);
        toggle.setAttribute("aria-pressed", String(paused));
        toggle.textContent = paused ? "Play background video" : "Pause background video";
      };
      if (allowed) film.play().catch(() => {});
      film.addEventListener("play", sync);
      film.addEventListener("pause", sync);
      toggle.addEventListener("click", () => (film.paused ? film.play() : film.pause()));
      sync();
    }
  </script>
)}

<style>
  .cover {
    position: relative;
    display: grid;
    min-height: min(calc(100svh - 6.75rem), 900px);
    overflow: hidden;
    color: #fff;
    background: var(--navy);
  }
  .cover__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 58%;
  }
  .cover__media:not(.cover__film) {
    animation: sgr-settle 12s var(--ease-out-strong) both;
  }
  /* The film fades in over the still once it is actually playing. */
  .cover__film {
    opacity: 0;
    transition: opacity 900ms var(--ease-out-strong);
  }
  .cover__film.is-playing {
    opacity: 1;
  }
  .cover__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(8, 22, 51, 0.7) 0%, rgba(8, 22, 51, 0) 34%),
      linear-gradient(0deg, rgba(8, 22, 51, 0.94) 0%, rgba(8, 22, 51, 0.6) 38%, rgba(8, 22, 51, 0) 70%);
  }
  .cover--video.is-film .cover__shade {
    background:
      linear-gradient(180deg, rgba(8, 22, 51, 0.88) 0%, rgba(8, 22, 51, 0.62) 45%),
      linear-gradient(0deg, rgba(8, 22, 51, 0.97) 0%, rgba(8, 22, 51, 0.78) 45%, rgba(8, 22, 51, 0.45) 80%);
  }

  /* A magazine cover: the masthead across the top, over the trees; the
     deck and the cover lines at the foot; the faces clear between. */
  .cover__grid {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding-block: var(--space-8) var(--space-12);
  }
  .cover__issue {
    margin: 0 0 var(--space-3);
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .cover__title {
    margin: 0;
    font-family: var(--font-label);
    font-weight: 400;
    font-size: clamp(2.9rem, 11.5vw, 10.5rem);
    line-height: 0.85;
    letter-spacing: -0.045em;
    white-space: nowrap;
    color: #fff;
  }
  /* Two-tone, after the administration's One Sigma mark: ONE in white,
     SIGMA in gold, with the mark's tagline beneath. */
  .cover__title span {
    color: var(--gold);
  }
  .cover__tagline {
    margin: var(--space-4) 0 0;
    color: #fff;
    font-size: clamp(0.95rem, 1.4vw, 1.2rem);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .cover__foot {
    grid-row: 3;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--space-10);
    align-items: end;
  }
  .cover__deck {
    max-width: 30rem;
    margin: 0;
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    line-height: 1.3;
    color: #fff;
  }
  .cover__copy {
    max-width: 34rem;
    margin: var(--space-3) 0 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--text-base);
    line-height: 1.65;
  }
  .cover__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .cover__lines {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--gold);
  }
  .cover__lines a {
    display: block;
    padding: var(--space-4) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
    color: #fff;
    text-decoration: none;
  }
  .cover__lines strong {
    display: block;
    font-family: var(--font-editorial);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--gold);
  }
  .cover__lines span {
    display: block;
    margin-top: var(--space-1);
    color: rgba(255, 255, 255, 0.86);
    font-size: var(--text-sm);
    line-height: 1.55;
  }
  .cover__lines a:hover strong {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  /* The cover's one moment: the cover lines arrive once, after the page. */
  .cover__lines li {
    animation: cover-line 700ms var(--ease-out-strong) both;
  }
  .cover__lines li:nth-child(1) {
    animation-delay: 350ms;
  }
  .cover__lines li:nth-child(2) {
    animation-delay: 450ms;
  }
  .cover__lines li:nth-child(3) {
    animation-delay: 550ms;
  }
  @keyframes cover-line {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  .cover__motion {
    position: absolute;
    right: var(--gutter);
    top: var(--space-4);
    z-index: 2;
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: var(--radius);
    background: rgba(8, 22, 51, 0.6);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
  }
  @media (prefers-reduced-motion: reduce) {
    .cover__media,
    .cover__lines li {
      animation: none !important;
    }
  }

  @media (max-width: 900px) {
    .cover__foot {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    /* On a phone the photograph sits under the masthead as a block, faces
       in view, and the words follow on navy. */
    .cover__media {
      height: 26rem;
      object-position: 42% 62%;
    }
    .cover__shade,
    .cover--video.is-film .cover__shade {
      background: linear-gradient(
        180deg,
        rgba(8, 22, 51, 0.7) 0,
        rgba(8, 22, 51, 0) 8rem,
        rgba(8, 22, 51, 0) 18rem,
        #081633 26rem
      );
    }
    .cover__grid {
      row-gap: 13rem;
    }
  }
</style>
