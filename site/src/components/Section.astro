---
/**
 * Section — a vertical band with an optional heading, styled to match the
 * original SGRho site.
 *
 * Heading treatments (prop `heading`):
 *   "feature" (default) centered gold eyebrow + Montserrat 800 italic UPPERCASE
 *             title, one word in gold. The site's signature section header.
 *   "plain"   Title Case, upright (not italic). For content-list sections
 *             (news, partners). Left-aligned unless `centered`.
 *
 * props:
 *   tone       "white" (default) | "cream" | "navy"
 *   heading    "feature" | "plain"
 *   eyebrow    kicker text
 *   title      heading text
 *   highlight  gold fragment appended to the title
 *   lead       paragraph under the heading
 *   centered   center the heading block (feature is centered by default)
 *   bordered   gold hairline top+bottom
 *   width      "default" (1180) | "narrow" (820)
 *   pad        "default" | "tight"
 *   roundBottom  round the lower corners (navy CTA blocks)
 *   id         anchor id
 */
const {
  tone = "white",
  heading = "feature",
  eyebrow,
  title,
  highlight,
  lead,
  centered,
  bordered = false,
  width = "default",
  pad = "default",
  roundBottom = false,
  id,
} = Astro.props;

const hasHeading = Boolean(eyebrow || title || lead);
const isCentered = centered ?? heading === "feature";
const headingOnly = hasHeading && !Astro.slots.has("default");
---
<section
  id={id}
  class:list={[
    "section",
    `section--${tone}`,
    { "section--pad-tight": pad === "tight", "section--heading-only": headingOnly, "section--bordered": bordered, "section--round-b": roundBottom, "on-dark": tone === "navy" },
  ]}
>
  <div class:list={["container", { "container--narrow": width === "narrow" }]}>
    {hasHeading && (
      <div class:list={["s-head", `s-head--${heading}`, { "s-head--centered": isCentered, "s-head--bare": headingOnly }]}>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {title && <h2 class="s-head__title">{title}{highlight && <span> {highlight}</span>}</h2>}
        {lead && <p class="s-head__lead">{lead}</p>}
      </div>
    )}
    <slot />
  </div>
</section>

<style>
  /* section band + container primitives live in global.css so raw <section>
     elements in pages get them too; only heading styles are scoped here. */
  .s-head { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .s-head--bare { margin-bottom: 0; }
  .s-head__title { margin: 0.5rem 0 0; }
  .s-head__title span { color: var(--gold); }
  .s-head__lead { margin: var(--space-4) 0 0; color: var(--muted); font-size: var(--text-md); max-width: 60ch; }

  /* feature (default): italic uppercase, one gold word */
  .s-head--feature .s-head__title {
    font-weight: 800;
    font-style: italic;
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    letter-spacing: 0.005em;
    text-transform: uppercase;
    color: var(--royal);
    line-height: 1.08;
  }

  /* plain: Title Case, upright */
  .s-head--plain .s-head__title {
    font-weight: 800;
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    color: var(--royal);
    line-height: 1.12;
  }

  .s-head--centered { text-align: center; }
  .s-head--centered .s-head__lead { margin-inline: auto; }

  /* on navy */
  .section--navy .s-head__title { color: #fff; }
  .section--navy .s-head__title span { color: var(--gold); }
  .section--navy .s-head__lead { color: rgba(255, 255, 255, 0.88); }
  .section--navy .eyebrow { color: var(--gold); }
</style>
