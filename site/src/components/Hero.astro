---
/**
 * Hero — page opener. Matches the Make source's treatment.
 *
 *   variant="image"  (default) full-bleed photo OR video, desaturated on navy,
 *                    with a bottom-up navy gradient. Centered LEMON MILK title.
 *   variant="split"  cream band, portrait/photo panel beside the text.
 *   variant="plain"  solid royal (or gold) band, no media. Compact.
 *
 * props:
 *   variant, eyebrow, title, highlight, copy, image, video, imageAlt,
 *   focal (image position), accent ("navy"|"gold" for plain), align,
 *   size ("tall"|"regular"|"compact"), as ("h1"|"h2"),
 *   watermark (giant faint decorative word/numeral in the corner)
 * default slot: action buttons (rendered under the copy)
 */
import { withBase } from "../lib/url.js";
import { reg } from "../lib/reg.js";

const {
  variant = "image",
  eyebrow,
  title,
  highlight,
  copy,
  image,
  video,
  imageAlt = "",
  focal = "50% 45%",
  accent = "navy",
  align = "center",
  size = "regular",
  as = "h1",
  watermark,
} = Astro.props;

const Heading = as;
const cls = [
  "hero",
  `hero--${variant}`,
  `hero--${size}`,
  align === "left" && "hero--left",
  variant === "plain" && `hero--${accent}`,
  variant !== "split" && "on-dark",
]
  .filter(Boolean)
  .join(" ");
const hasActions = Astro.slots.has("default");
---

<section class={cls}>
  {watermark && (
    <span class="hero__watermark" aria-hidden="true">
      {watermark}
    </span>
  )}
  {/* The <video> below carries no `autoplay` attribute and uses
      preload="none" on purpose: the clip is large, and whether it is worth
      streaming depends on the visitor (reduced motion, Save-Data, a 2G
      connection, a phone). The script at the bottom of this file decides and
      starts playback itself; until then the poster carries the hero. */}
  {variant === "image" && (video || image) && (
    <div class="hero__media">
      {video ? (
        <video
          class="hero__video"
          muted
          loop
          playsinline
          preload="none"
          poster={image ? withBase(image) : undefined}
          aria-hidden="true"
          data-hero-video
        >
          <source src={withBase(video)} type="video/mp4" />
        </video>
      ) : (
        <img class="hero__img" src={withBase(image)} alt="" style={`object-position:${focal}`} />
      )}
      <div class="hero__scrim"></div>
    </div>
  )}

  <div class="container hero__content">
    <div class="hero__text">
      {eyebrow && <p class="eyebrow" set:html={reg(eyebrow)} />}
      <Heading class="hero__title">
        <Fragment set:html={reg(title)} />
        {highlight && (
          <>
            {" "}
            <span set:html={reg(highlight)} />
          </>
        )}
      </Heading>
      {copy && <p class="hero__copy">{copy}</p>}
      {hasActions && (
        <div class="hero__actions">
          <slot />
        </div>
      )}
    </div>

    {variant === "split" && (video || image) && (
      <figure class="hero__figure">
        {video ? (
          <video
            muted
            loop
            playsinline
            preload="none"
            poster={image ? withBase(image) : undefined}
            aria-hidden="true"
            data-hero-video
          >
            <source src={withBase(video)} type="video/mp4" />
          </video>
        ) : (
          <img src={withBase(image)} alt={imageAlt} />
        )}
      </figure>
    )}
  </div>

  {/* WCAG 2.2.2 (Pause, Stop, Hide): motion lasting more than five seconds
      needs a user-operable way to stop it. The clip loops indefinitely, so
      without this control there is no escape from it. */}
  {video && (
    <button class="hero__motion-toggle" type="button" data-hero-motion aria-pressed="false">
      <span class="hero__motion-icon" aria-hidden="true"></span>
      <span class="hero__motion-label">Pause background video</span>
    </button>
  )}
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }
  .hero__content {
    position: relative;
    z-index: 2;
  }
  .hero__watermark {
    position: absolute;
    left: 0;
    bottom: -0.35em;
    z-index: 1;
    color: rgba(255, 255, 255, 0.035);
    font-size: clamp(6rem, 15vw, 13rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    pointer-events: none;
  }
  .hero__title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--royal);
  }
  .hero__title span {
    color: var(--gold);
  }
  .hero__copy {
    margin: var(--space-6) 0 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-lg);
    line-height: 1.7;
  }
  .hero__actions {
    margin-top: var(--space-10);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }
  .hero--left .hero__text {
    text-align: left;
  }
  .hero:not(.hero--left):not(.hero--split) .hero__text {
    text-align: center;
    margin-inline: auto;
  }
  .hero:not(.hero--left):not(.hero--split) .hero__actions {
    justify-content: center;
  }
  .hero:not(.hero--left) .eyebrow {
  }

  /* ---------- size ---------- */
  .hero--tall .hero__content {
    padding-block: clamp(6rem, 14vw, 10rem);
  }
  .hero--regular .hero__content {
    padding-block: clamp(4rem, 10vw, 7rem);
  }
  .hero--compact .hero__content {
    padding-block: clamp(3rem, 7vw, 4.5rem);
  }

  /* ---------- variant: image / video ---------- */
  .hero--image {
    display: flex;
    align-items: center;
    min-height: clamp(520px, 72vh, 800px);
    color: #fff;
    background: var(--navy);
  }
  .hero--image .hero__text {
    max-width: 1000px;
  }
  .hero--image .hero__title {
    color: #fff;
    font-size: var(--text-hero);
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
  }
  .hero--image .hero__copy {
    color: rgba(255, 255, 255, 0.9);
    max-width: 46rem;
    margin-inline: auto;
  }
  .hero__media {
    position: absolute;
    inset: 0;
  }
  .hero__video,
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.4;
    mix-blend-mode: luminosity;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--navy) 0%,
      rgba(32, 65, 165, 0.6) 55%,
      transparent 100%
    );
  }

  /* ---------- variant: split ---------- */
  .hero--split {
    background: var(--cream);
    color: var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .hero--split .hero__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(min(280px, 100%), 340px);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: center;
  }
  .hero--split .hero__title {
    font-size: var(--text-h2);
  }
  .hero--split .hero__copy {
    color: var(--muted);
  }
  .hero--split .hero__figure {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .hero--split .hero__figure img,
  .hero--split .hero__figure video {
    width: 100%;
    aspect-ratio: 4/5;
    max-height: 440px;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 820px) {
    .hero--split .hero__content {
      grid-template-columns: 1fr;
    }
    .hero--split .hero__figure {
      order: -1;
      max-width: 320px;
    }
  }

  /* ---------- variant: plain ---------- */
  .hero--plain {
    color: #fff;
  }
  .hero--plain.hero--navy {
    background: var(--grad-royal);
    border-bottom: 4px solid var(--gold);
  }
  .hero--plain.hero--gold {
    background: var(--gold);
    color: var(--navy);
    border-bottom: 4px solid var(--navy);
  }
  .hero--plain .hero__title {
    color: #fff;
    font-size: var(--text-h2);
  }
  .hero--plain.hero--gold .hero__title {
    color: var(--navy);
  }
  .hero--plain.hero--gold .hero__title span,
  .hero--plain.hero--gold .eyebrow {
    color: var(--navy);
  }
  .hero--plain .hero__text {
    max-width: 800px;
  }

  /* ---------- motion toggle (WCAG 2.2.2) ---------- */
  .hero__motion-toggle {
    position: absolute;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 999px;
    background: rgba(8, 22, 51, 0.55);
    color: #fff;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease;
  }
  .hero__motion-toggle:hover {
    background: rgba(8, 22, 51, 0.8);
    border-color: #fff;
  }
  /* Pause glyph (two bars) while playing, play triangle once paused —
     drawn in CSS so it needs no icon asset. */
  .hero__motion-icon {
    width: 10px;
    height: 12px;
    border-left: 3px solid currentColor;
    border-right: 3px solid currentColor;
  }
  .hero__motion-toggle[aria-pressed="true"] .hero__motion-icon {
    width: 0;
    height: 0;
    border-left: 9px solid currentColor;
    border-right: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
  }
  @media (max-width: 560px) {
    /* keep the control, drop the words */
    .hero__motion-label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }
    .hero__motion-toggle {
      min-width: 44px;
      justify-content: center;
    }
  }
</style>

<script>
  // Background video is decoration, but it still moves — so it needs a stop
  // mechanism (WCAG 2.2.2), and it must not move at all for anyone who has
  // asked the OS for reduced motion.
  document.querySelectorAll("[data-hero-video]").forEach((el) => {
    const video = el as HTMLVideoElement;
    const hero = video.closest(".hero");
    const toggle = hero?.querySelector("[data-hero-motion]");
    const label = toggle?.querySelector(".hero__motion-label");

    function paint(paused: boolean) {
      if (!toggle || !label) return;
      toggle.setAttribute("aria-pressed", String(paused));
      label.textContent = paused ? "Play background video" : "Pause background video";
    }

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

    // Set once the visitor asks for motion via the toggle, which overrides
    // every check below for the rest of the visit.
    let optedIn = false;

    /**
     * Is this visit worth streaming the clip for? The file is measured in tens
     * of megabytes, and most of this site's traffic is on a phone. Anyone the
     * answer is "no" for still gets the poster frame and a control to start it
     * deliberately, so nothing is hidden — it is just not downloaded unasked.
     */
    function worthStreaming() {
      if (reduce.matches) return false;
      const conn = (navigator as any).connection;
      if (conn?.saveData) return false;
      if (conn?.effectiveType && /2g$/.test(conn.effectiveType)) return false;
      if (window.matchMedia("(max-width: 900px)").matches) return false;
      return true;
    }

    // A late autoplay cannot be cancelled by touching attributes, so guard the
    // event itself: anything that starts playing without an explicit opt-in,
    // while we have decided not to stream, gets stopped.
    video.addEventListener("play", () => {
      if (!optedIn && !worthStreaming()) {
        video.pause();
        video.currentTime = 0;
        paint(true);
      }
    });

    if (worthStreaming()) {
      video.preload = "auto";
      paint(false);
      void video.play().catch(() => paint(true));
    } else {
      // Poster stays; the control reads "Play", so the motion is opt-in.
      paint(true);
    }

    toggle?.addEventListener("click", () => {
      if (video.paused) {
        optedIn = true;
        video.preload = "auto";
        paint(false);
        void video.play().catch(() => paint(true));
      } else {
        optedIn = false;
        video.pause();
        paint(true);
      }
    });
  });
</script>
