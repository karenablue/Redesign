---
/**
 * Hero — the page opener. Three variants so pages don't all start the same way:
 *
 *   variant="image"  (default) full-bleed photo, dark gradient overlay, light
 *                    text. Tall. Best for narrative / impact pages.
 *   variant="split"  light band: a portrait/photo panel beside the text, no
 *                    overlay. Shorter. Best for profile and "meet the people"
 *                    pages.
 *   variant="plain"  no photo at all — a solid navy or gold band with large
 *                    type. Compact. Best for utility pages (membership steps,
 *                    forms, policy).
 *
 * props:
 *   variant    "image" | "split" | "plain"
 *   eyebrow    uppercase kicker
 *   title      heading text; accent fragment goes in `highlight`
 *   highlight  gold-accented trailing fragment of the title
 *   copy       lead paragraph (optional; also accepts a default slot)
 *   image      photo path, root-absolute (image + split variants). For the
 *              image variant with `video`, this is the poster/fallback frame.
 *   video      video path, root-absolute — image variant only. Renders an
 *              autoplay/muted/loop background video (the homepage hero).
 *   imageAlt   alt text for the split variant's <img> (required there)
 *   focal      object-position for image/video variant (default "50% 40%")
 *   grayscale  desaturate the image variant (default true; ignored for video)
 *   watermark  faint oversized text, image variant only (e.g. a year)
 *   accent     plain variant only: "navy" (default) | "gold"
 *   align      "left" (default) | "center"  — image/plain variants
 *   size       "tall" | "regular" (default) | "compact"
 *   as         "h1" (default) | "h2"
 */
import { withBase } from "../lib/url.js";

const {
  variant = "image",
  eyebrow,
  title,
  highlight,
  copy,
  image,
  video,
  imageAlt = "",
  focal = "50% 40%",
  grayscale = true,
  watermark,
  accent = "navy",
  align = "left",
  size = "regular",
  as = "h1",
} = Astro.props;

const Heading = as;
const cls = [
  "hero",
  `hero--${variant}`,
  `hero--${size}`,
  align === "center" && "hero--center",
  variant === "plain" && `hero--${accent}`,
  variant !== "split" && "on-dark",
].filter(Boolean).join(" ");
---
<section class={cls}>
  {variant === "image" && video && (
    <>
      <video
        class="hero__video"
        style={`object-position:${focal}`}
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster={image ? withBase(image) : undefined}
      >
        <source src={withBase(video)} type="video/mp4" />
      </video>
      <div class="hero__overlay" />
    </>
  )}
  {variant === "image" && !video && image && (
    <>
      <div
        class:list={["hero__image", { "is-gray": grayscale }]}
        style={`background-image:url('${withBase(image)}');background-position:${focal}`}
      />
      <div class="hero__overlay" />
    </>
  )}

  <div class="container hero__content">
    <div class="hero__text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <Heading class="hero__title">{title}{highlight && <span>{highlight}</span>}</Heading>
      <div class="hero__rule" />
      {copy && <p class="hero__copy"><slot>{copy}</slot></p>}
    </div>

    {variant === "split" && image && (
      <figure class="hero__figure">
        <img src={withBase(image)} alt={imageAlt} />
      </figure>
    )}
  </div>

  {variant === "image" && watermark && (
    <div class="hero__watermark" aria-hidden="true">{watermark}</div>
  )}
</section>

<style>
  .hero { position: relative; overflow: hidden; }
  .hero__content { position: relative; z-index: 2; }
  .hero__title { margin: 0; font-weight: 800; font-style: italic; text-transform: uppercase; line-height: 1.05; letter-spacing: 0.005em; color: var(--royal); }
  /* contrast: title colour has to beat global h1{color:royal} */
  .hero--image .hero__title,
  .hero--plain.hero--navy .hero__title { color: #fff; }
  .hero--plain.hero--gold .hero__title { color: var(--navy); }
  .hero__title span { color: var(--gold); }
  .hero__rule { width: 84px; height: 3px; margin: 1.75rem 0 1.5rem; background: var(--gold); }
  .hero__copy { margin: 0; font-size: var(--text-md); line-height: 1.7; }
  .hero--center .hero__text { margin-inline: auto; text-align: center; }
  .hero--center .hero__rule { margin-inline: auto; }
  .hero--center .hero__copy { margin-inline: auto; }

  /* ---------- size ---------- */
  .hero--tall .hero__content { padding-block: clamp(5rem, 12vw, 9rem); }
  .hero--regular .hero__content { padding-block: clamp(3.5rem, 9vw, 6rem); }
  .hero--compact .hero__content { padding-block: clamp(2.5rem, 6vw, 4rem); }

  /* ---------- variant: image ---------- */
  .hero--image { display: flex; align-items: center; min-height: clamp(380px, 56vh, 580px); color: #fff; background: var(--navy); }
  .hero--image.hero--tall { min-height: clamp(460px, 70vh, 680px); }
  .hero--image .hero__text { max-width: 680px; }
  .hero--image .hero__title { font-size: var(--text-hero); }
  .hero--image .hero__copy { color: rgba(255,255,255,.88); max-width: 620px; }
  .hero__image { position: absolute; inset: 0; background-size: cover; background-repeat: no-repeat; }
  .hero__image.is-gray { filter: grayscale(100%); }
  .hero__video {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(8,22,51,.97) 0%, rgba(14,37,88,.92) 38%, rgba(21,52,122,.6) 72%, rgba(8,22,51,.38) 100%);
  }
  .hero--center.hero--image .hero__overlay {
    background: linear-gradient(180deg, rgba(8,22,51,.7) 0%, rgba(8,22,51,.82) 100%);
  }
  .hero__watermark {
    position: absolute; left: 0; bottom: -.15em; z-index: 1;
    font-family: var(--font-display); font-size: clamp(120px, 22vw, 220px);
    font-weight: 700; letter-spacing: -.04em; color: rgba(255,255,255,.05); pointer-events: none;
  }

  /* ---------- variant: split ---------- */
  .hero--split { background: var(--cream); color: var(--ink); border-bottom: 1px solid var(--line); }
  .hero--split .hero__content {
    display: grid; grid-template-columns: minmax(0,1fr) minmax(280px,340px);
    gap: clamp(2rem, 6vw, 4.5rem); align-items: center;
  }
  .hero--split .hero__title { font-size: var(--text-2xl); color: var(--royal); }
  .hero--split .hero__copy { color: var(--muted); }
  .hero--split .hero__figure {
    margin: 0; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md);
  }
  .hero--split .hero__figure img { width: 100%; aspect-ratio: 4/5; max-height: 440px; object-fit: cover; display: block; }
  @media (max-width: 820px) {
    .hero--split .hero__content { grid-template-columns: 1fr; justify-items: start; }
    .hero--split .hero__figure { order: -1; max-width: 320px; }
  }

  /* ---------- variant: plain ---------- */
  .hero--plain { color: #fff; }
  .hero--plain.hero--navy {
    background: radial-gradient(circle at 82% 16%, rgba(63,99,191,.3), transparent 34%), linear-gradient(145deg, var(--navy), var(--deep-blue) 55%, var(--royal-dark));
    border-bottom: 4px solid var(--gold);
  }
  .hero--plain.hero--gold {
    background: linear-gradient(135deg, var(--gold) 0%, #c9981c 100%);
    color: var(--navy);
    border-bottom: 4px solid var(--navy);
  }
  .hero--plain.hero--gold .hero__title span,
  .hero--plain.hero--gold .eyebrow { color: var(--navy); }
  .hero--plain.hero--gold .hero__rule { background: var(--navy); }
  .hero--plain .hero__text { max-width: 760px; }
  .hero--plain .hero__title { font-size: var(--text-2xl); }
</style>
