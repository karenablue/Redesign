---
/**
 * Hero — page opener. Matches the Make source's treatment.
 *
 *   variant="image"  (default) full-bleed photo OR video, desaturated on navy,
 *                    with a bottom-up navy gradient. Centered Newsreader title.
 *   variant="split"  cream band, portrait/photo panel beside the text.
 *   variant="plain"  solid royal (or gold) band, no media. Compact.
 *
 * props:
 *   variant, eyebrow, title, highlight, copy, image, video, imageAlt,
 *   focal (image position), accent ("navy"|"gold" for plain), align,
 *   size ("tall"|"regular"|"compact"), as ("h1"|"h2")
 * default slot: action buttons (rendered under the copy)
 */
import { withBase } from "../lib/url.js";

const {
  variant = "image",
  eyebrow,
  title,
  highlight,
  copy,
  image,
  video,
  imageAlt = "",
  focal = "50% 45%",
  accent = "navy",
  align = "center",
  size = "regular",
  as = "h1",
} = Astro.props;

const Heading = as;
const cls = [
  "hero", `hero--${variant}`, `hero--${size}`,
  align === "left" && "hero--left",
  variant === "plain" && `hero--${accent}`,
  variant !== "split" && "on-dark",
].filter(Boolean).join(" ");
const hasActions = Astro.slots.has("default");
---
<section class={cls}>
  {variant === "image" && (video || image) && (
    <div class="hero__media">
      {video ? (
        <video class="hero__video" autoplay muted loop playsinline preload="auto"
          poster={image ? withBase(image) : undefined}>
          <source src={withBase(video)} type="video/mp4" />
        </video>
      ) : (
        <img class="hero__img" src={withBase(image)} alt="" style={`object-position:${focal}`} />
      )}
      <div class="hero__scrim"></div>
    </div>
  )}

  <div class="container hero__content">
    <div class="hero__text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <Heading class="hero__title">{title}{highlight && <> <span>{highlight}</span></>}</Heading>
      {copy && <p class="hero__copy">{copy}</p>}
      {hasActions && <div class="hero__actions"><slot /></div>}
    </div>

    {variant === "split" && image && (
      <figure class="hero__figure">
        <img src={withBase(image)} alt={imageAlt} />
      </figure>
    )}
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; }
  .hero__content { position: relative; z-index: 2; }
  .hero__title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--royal);
  }
  .hero__title span { color: var(--gold); }
  .hero__copy {
    margin: var(--space-6) 0 0;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-lg);
    line-height: 1.7;
  }
  .hero__actions { margin-top: var(--space-10); display: flex; flex-wrap: wrap; gap: var(--space-5); }
  .hero--left .hero__text { text-align: left; }
  .hero:not(.hero--left):not(.hero--split) .hero__text { text-align: center; margin-inline: auto; }
  .hero:not(.hero--left):not(.hero--split) .hero__actions { justify-content: center; }
  .hero:not(.hero--left) .eyebrow { }

  /* ---------- size ---------- */
  .hero--tall .hero__content { padding-block: clamp(6rem, 14vw, 10rem); }
  .hero--regular .hero__content { padding-block: clamp(4rem, 10vw, 7rem); }
  .hero--compact .hero__content { padding-block: clamp(3rem, 7vw, 4.5rem); }

  /* ---------- variant: image / video ---------- */
  .hero--image { display: flex; align-items: center; min-height: clamp(520px, 72vh, 800px); color: #fff; background: var(--navy); }
  .hero--image .hero__text { max-width: 1000px; }
  .hero--image .hero__title { color: #fff; font-size: var(--text-hero); text-shadow: 0 4px 24px rgba(0,0,0,0.5); }
  .hero--image .hero__copy { color: rgba(255,255,255,0.9); max-width: 46rem; margin-inline: auto; }
  .hero__media { position: absolute; inset: 0; }
  .hero__video, .hero__img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; opacity: 0.4; mix-blend-mode: luminosity;
  }
  .hero__scrim {
    position: absolute; inset: 0;
    background: linear-gradient(to top, var(--navy) 0%, rgba(32,65,165,0.6) 55%, transparent 100%);
  }

  /* ---------- variant: split ---------- */
  .hero--split { background: var(--cream); color: var(--ink); border-bottom: 1px solid var(--line); }
  .hero--split .hero__content {
    display: grid; grid-template-columns: minmax(0,1fr) minmax(280px,340px);
    gap: clamp(2rem,6vw,4.5rem); align-items: center;
  }
  .hero--split .hero__title { font-size: var(--text-h2); }
  .hero--split .hero__copy { color: var(--muted); }
  .hero--split .hero__figure { margin: 0; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md); }
  .hero--split .hero__figure img { width: 100%; aspect-ratio: 4/5; max-height: 440px; object-fit: cover; display: block; }
  @media (max-width: 820px) {
    .hero--split .hero__content { grid-template-columns: 1fr; }
    .hero--split .hero__figure { order: -1; max-width: 320px; }
  }

  /* ---------- variant: plain ---------- */
  .hero--plain { color: #fff; }
  .hero--plain.hero--navy { background: var(--grad-royal); border-bottom: 4px solid var(--gold); }
  .hero--plain.hero--gold { background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%); color: var(--navy); border-bottom: 4px solid var(--navy); }
  .hero--plain .hero__title { color: #fff; font-size: var(--text-h2); }
  .hero--plain.hero--gold .hero__title { color: var(--navy); }
  .hero--plain.hero--gold .hero__title span,
  .hero--plain.hero--gold .eyebrow { color: var(--navy); }
  .hero--plain .hero__text { max-width: 800px; }
</style>
