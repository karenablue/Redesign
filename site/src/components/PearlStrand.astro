---
/**
 * PearlStrand — seven pearls on a gold line: the Seven Pearls, the site's
 * own name for the seven Founders. Used only where seven Founders are in
 * view (the homepage 1922, the Our Founders portraits), so the count means
 * something. Plain geometry in the brand colours, not an illustration: the
 * FY2027 guide rules out clip art and decorative overlays.
 *
 * The pearls sit at the start and the line runs on to the container's edge.
 * Decorative, so hidden from assistive tech.
 *
 * props:
 *   tone   "light" (default, on white or cream) | "dark" (on navy)
 */
interface Props {
  tone?: "light" | "dark";
}
const { tone = "light" } = Astro.props;
---

<span class:list={["pearls", `pearls--${tone}`]} aria-hidden="true">
  {Array.from({ length: 7 }).map(() => (
    <i></i>
  ))}
</span>

<style>
  .pearls {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2vw, 1.4rem);
    width: 100%;
    height: 14px;
  }
  .pearls::before {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: var(--gold);
  }
  /* A gold pearl with a soft white highlight: gold and white only. */
  .pearls i {
    position: relative;
    flex: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 34% 32%,
      rgba(255, 255, 255, 0.85) 0 16%,
      var(--gold) 46%
    );
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--gold) 70%, var(--navy));
  }
  .pearls--dark i {
    box-shadow: 0 0 0 1px var(--gold);
  }
</style>
