---
/**
 * PillarRail — the Sorority's pillars on a connected rail: a Sigma in a
 * circle for each, joined by a gold hairline, with the label beneath.
 *
 * The line is drawn with a pseudo-element behind the circles rather than as
 * separate segments, so it stays continuous at any width and any count.
 *
 * props:
 *   items  labels, in order (defaults to the four pillars)
 */
const { items = ["Sisterhood", "Scholarship", "Service", "Leadership"] } = Astro.props;
---

<ul class="rail">
  {items.map((label) => (
    <li class="rail__item">
      <span class="rail__mark" aria-hidden="true">&Sigma;</span>
      <span class="rail__label">{label}</span>
    </li>
  ))}
</ul>

<style>
  .rail {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    align-items: start;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* One continuous rule behind the marks, inset so it starts and ends at the
     first and last circle rather than the container edge. */
  .rail::before {
    content: "";
    position: absolute;
    top: 27px;
    left: 12.5%;
    right: 12.5%;
    height: 1px;
    background: var(--gold);
  }
  .rail__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }
  .rail__mark {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1px solid var(--gold);
    border-radius: 50%;
    background: var(--white);
    color: var(--royal);
    font-family: var(--font-head);
    font-size: 1.5rem;
    line-height: 1;
  }
  .rail__label {
    color: var(--royal);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  /* Stacked on phones: the rail turns vertical and runs down the marks. */
  @media (max-width: 640px) {
    .rail {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      gap: var(--space-5);
      justify-items: start;
    }
    .rail::before {
      top: 28px;
      bottom: 28px;
      left: 28px;
      right: auto;
      width: 1px;
      height: auto;
    }
    .rail__item {
      flex-direction: row;
      align-items: center;
      gap: var(--space-5);
      text-align: left;
    }
  }
</style>
