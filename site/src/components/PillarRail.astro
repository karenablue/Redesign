---
/**
 * PillarRail — the Sorority's pillars as three cards: a Sigma in a gold
 * circle, the pillar, and one sentence on what it means.
 *
 * The mark is decorative (the heading carries the meaning), so it is hidden
 * from assistive tech.
 */
interface Pillar {
  label: string;
  body: string;
}

const pillars: Pillar[] = [
  {
    label: "Sisterhood",
    body: "Lifelong bonds rooted in genuine support, shared purpose, and lasting unity.",
  },
  {
    label: "Scholarship",
    body: "Academic excellence and intellectual growth, born from our educator roots.",
  },
  {
    label: "Service",
    body: "Transformative community impact, health advocacy, and global outreach.",
  },
];
---

<ul class="pillars">
  {pillars.map((p) => (
    <li class="pillar">
      <span class="pillar__mark" aria-hidden="true">&Sigma;</span>
      <h3 class="pillar__label">{p.label}</h3>
      <p class="pillar__body">{p.body}</p>
    </li>
  ))}
</ul>

<style>
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pillar {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-8) var(--space-6);
    border: 1px solid rgba(32, 65, 165, 0.2);
    border-radius: var(--radius-lg);
    background: var(--white);
    text-align: center;
  }
  .pillar__mark {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: var(--space-5);
    border: 1px solid var(--gold);
    border-radius: 50%;
    color: var(--royal);
    font-family: var(--font-head);
    font-size: 1.75rem;
    line-height: 1;
  }
  .pillar__label {
    margin: 0 0 var(--space-3);
    color: var(--royal);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .pillar__body {
    margin: 0;
    max-width: 24rem;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.7;
  }
  @media (max-width: 780px) {
    .pillars {
      grid-template-columns: minmax(0, 1fr);
      max-width: 32rem;
      margin-inline: auto;
    }
  }
</style>
