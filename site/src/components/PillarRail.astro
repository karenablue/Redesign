---
/**
 * PillarRail — the Sorority's pillars as three cards: a line icon, the pillar,
 * and one sentence on what it means.
 *
 * Icons are inline SVG line art (no clip art, per FY2027) and decorative, so
 * they are hidden from assistive tech; the heading carries the meaning.
 */
interface Pillar {
  label: string;
  body: string;
  icon: string;
}

const pillars: Pillar[] = [
  {
    label: "Sisterhood",
    body: "Lifelong bonds rooted in genuine support, shared purpose, and lasting unity.",
    // three figures
    icon: "M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM3 19c0-2.8 2.7-4.5 6-4.5s6 1.7 6 4.5M16 14c2.4.2 4 1.8 4 4",
  },
  {
    label: "Scholarship",
    body: "Academic excellence and intellectual growth, born from our educator roots.",
    // open book
    icon: "M12 7.5C10.5 6.2 8.4 5.5 4.5 5.5v11c3.9 0 6 .7 7.5 2 1.5-1.3 3.6-2 7.5-2v-11c-3.9 0-6 .7-7.5 2Zm0 0v11",
  },
  {
    label: "Service",
    body: "Transformative community impact, health advocacy, and global outreach.",
    // open hands around a heart
    icon: "M12 20c-4-2.2-7-5-7-8a3.2 3.2 0 0 1 5.6-2.1l1.4 1.5 1.4-1.5A3.2 3.2 0 0 1 19 12c0 3-3 5.8-7 8Z",
  },
];
---

<ul class="pillars">
  {pillars.map((p) => (
    <li class="pillar">
      <span class="pillar__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d={p.icon} />
        </svg>
      </span>
      <h3 class="pillar__label">{p.label}</h3>
      <p class="pillar__body">{p.body}</p>
    </li>
  ))}
</ul>

<style>
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pillar {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-8) var(--space-6);
    border: 1px solid rgba(32, 65, 165, 0.2);
    border-radius: var(--radius-lg);
    background: var(--white);
    text-align: center;
  }
  .pillar__icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: var(--space-5);
    border: 1px solid var(--gold);
    border-radius: 50%;
    color: var(--royal);
  }
  .pillar__icon svg {
    width: 30px;
    height: 30px;
  }
  .pillar__label {
    margin: 0 0 var(--space-3);
    color: var(--royal);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .pillar__body {
    margin: 0;
    max-width: 24rem;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.7;
  }
  @media (max-width: 780px) {
    .pillars {
      grid-template-columns: minmax(0, 1fr);
      max-width: 32rem;
      margin-inline: auto;
    }
  }
</style>
