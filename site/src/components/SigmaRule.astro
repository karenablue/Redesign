---
/**
 * SigmaRule — decorative "—— Σ ——" divider used to separate sections on
 * several bio/directory pages (become-a-member, headquarters, affiliates,
 * the leadership roster pages, media-relations, vendor).
 *
 * chapter-locator.astro keeps its own two-tone (gold/royal on a colored
 * background) version of this divider rather than using this component —
 * it's a real visual variant, not a copy-paste duplicate.
 */
---
<div class="sigma-rule" aria-hidden="true">
  <span class="sigma-line"></span>
  <span class="sigma-medallion">&Sigma;</span>
  <span class="sigma-line"></span>
</div>

<style>
  .sigma-rule { display: flex; align-items: center; gap: var(--space-5); max-width: 74rem; margin-inline: auto; padding-block: var(--space-8); }
  .sigma-line { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, var(--gold)); }
  .sigma-line:last-child { background: linear-gradient(270deg, transparent, var(--gold)); }
  .sigma-medallion { width: 3.25rem; height: 3.25rem; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--gold); color: var(--gold); font-size: 1.4rem; }
</style>
