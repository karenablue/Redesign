---
/**
 * Faq — an accordion of <details> items. One shared implementation behind
 * two visual treatments already used on the site:
 *   variant="soft"      cream card, chevron glyph (homepage)
 *   variant="bordered"  ruled list: 1px rules between items, +/- glyph
 *                       (become-a-member)
 *
 * props:
 *   items      [{ q, a }]
 *   variant    "soft" (default) | "bordered"
 *   openFirst  open the first item by default (default false)
 *   width      "default" | "narrow" (wraps in .container--narrow)
 */
interface FaqItem {
  q: string;
  a: string;
}
interface Props {
  items?: FaqItem[];
  variant?: "soft" | "bordered";
  openFirst?: boolean;
  width?: "default" | "narrow";
}

const { items = [], variant = "soft", openFirst = false, width = "default" } = Astro.props;
---

<div class:list={["faq", `faq--${variant}`, { "container--narrow": width === "narrow" }]}>
  {items.map((item, i) => (
    <details class="faq__item" open={openFirst && i === 0}>
      <summary>{item.q}</summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq {
    display: grid;
    margin-inline: auto;
  }
  .faq__item {
    border-radius: var(--radius);
  }
  .faq__item summary {
    cursor: pointer;
    font-weight: 700;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item p {
    margin: var(--space-3) 0 0;
  }

  .faq--soft {
    gap: var(--space-3);
  }
  .faq--soft .faq__item {
    background: var(--cream-2);
    padding: 1.1rem 1.4rem;
  }
  .faq--soft .faq__item summary {
    color: var(--ink);
  }
  .faq--soft .faq__item summary::after {
    content: "\25be";
    color: var(--royal);
  }
  .faq--soft .faq__item[open] summary::after {
    content: "\25b4";
  }
  .faq--soft .faq__item p {
    color: var(--royal);
  }

  .faq--bordered {
    border-top: 1px solid var(--line);
  }
  .faq--bordered .faq__item {
    border-radius: 0;
    border-bottom: 1px solid var(--line);
    padding: var(--space-4) 0;
  }
  .faq--bordered .faq__item summary {
    color: var(--royal);
    text-align: left;
  }
  /* Royal, not gold: the glyph is the control's only affordance, and gold
     on white is 2:1, under the 3:1 needed for a meaningful graphic. */
  .faq--bordered .faq__item summary::after {
    content: "+";
    flex: none;
    color: var(--royal);
    font-weight: 700;
  }
  .faq--bordered .faq__item summary:hover {
    color: var(--accent-hover);
  }
  .faq--bordered .faq__item[open] summary::after {
    content: "\2013";
  }
  .faq--bordered .faq__item p {
    color: var(--muted);
  }
</style>
