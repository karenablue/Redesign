---
/**
 * StatBand — big institutional numerals on the royal gradient, no card chrome.
 * Matches the Make source's Stats component.
 *
 * props:
 *   stats  [{ value: "500+", label: "Chapters Worldwide" }, …]
 *   tone   "navy" (default) | "white" | "cream"
 *   anchor show the Σ divider ornament below the row (default true on navy)
 */
interface Stat {
  value: string;
  label: string;
  icon?: { viewBox: string; path: string };
}
interface Props {
  stats?: Stat[];
  tone?: "navy" | "white" | "cream";
  anchor?: boolean;
}

const { stats = [], tone = "navy", anchor } = Astro.props;
const showAnchor = anchor ?? tone === "navy";
---

<section class:list={["statband", `statband--${tone}`]}>
  <div class="container statband__inner">
    <dl class="statband__row">
      {stats.map((s) => (
        <div class="statband__item">
          {s.icon && (
            <span class="statband__icon" aria-hidden="true">
              <svg viewBox={s.icon.viewBox} fill="currentColor" fill-rule="evenodd">
                <path d={s.icon.path} />
              </svg>
            </span>
          )}
          <dt class="statband__value" data-count data-value={s.value}>
            {s.value}
          </dt>
          <dd class="statband__label">{s.label}</dd>
        </div>
      ))}
    </dl>
    {showAnchor && (
      <div class="statband__anchor" aria-hidden="true">
        <span class="statband__anchor-line"></span>
        <span class="statband__sigma">&Sigma;</span>
        <span class="statband__anchor-line statband__anchor-line--r"></span>
      </div>
    )}
  </div>
</section>

<style>
  .statband--navy {
    color: #fff;
    /* solid royal — a flat, saturated block anchors the page harder than
       the soft gradient did; gold hairlines above/below stay as the accent */
    background: var(--royal);
    position: relative;
  }
  .statband--navy::before,
  .statband--navy::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(223, 177, 54, 0.5), transparent);
  }
  .statband--navy::before {
    top: 0;
  }
  .statband--navy::after {
    bottom: 0;
  }
  .statband--white {
    background: var(--white);
  }
  .statband--cream {
    background: var(--cream);
  }

  .statband__inner {
    /* Tightened ~18% — there was a lot of empty blue below the stats before
       the Sigma ornament. Monumental, not full-screen. */
    padding-block: clamp(2.5rem, 1.7rem + 3.2vw, 3.25rem);
  }

  .statband__row {
    display: flex;
    align-items: stretch;
    justify-content: center;
    margin: 0;
  }
  .statband__item {
    flex: 1;
    min-width: 0;
    text-align: center;
    padding-inline: clamp(0.5rem, 2vw, 1.75rem);
    position: relative;
  }
  .statband__item + .statband__item::before {
    content: "";
    position: absolute;
    left: 0;
    /* Extended from 8%/8% — the line stopped near the label baseline;
       running it closer to the full height frames each stat more
       deliberately. */
    top: 2%;
    bottom: 2%;
    width: 1px;
    background: rgba(255, 255, 255, 0.12);
  }
  .statband--white .statband__item + .statband__item::before,
  .statband--cream .statband__item + .statband__item::before {
    background: var(--line);
  }

  .statband__icon {
    display: block;
    width: 26px;
    height: 26px;
    margin: 0 auto var(--space-3);
    color: var(--gold);
  }
  .statband__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .statband--white .statband__icon,
  .statband--cream .statband__icon {
    color: var(--gold);
  }

  .statband__value {
    font-family: var(--font-label);
    font-weight: 500; /* LEMON MILK Medium — heaviest brand-allowed weight */
    /* sized so all 5 stats stay on one row, non-overlapping, from 1024px up */
    font-size: clamp(1.2rem, 0.35rem + 2.25vw, 2.4rem);
    line-height: 1;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: #fff;
    margin: 0 0 var(--space-3);
  }
  .statband--white .statband__value,
  .statband--cream .statband__value {
    color: var(--royal);
  }

  .statband__label {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }
  .statband--white .statband__label,
  .statband--cream .statband__label {
    color: var(--muted);
  }

  .statband__anchor {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    opacity: 0.5;
  }
  .statband__anchor-line {
    width: 3rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold));
  }
  .statband__anchor-line--r {
    background: linear-gradient(270deg, transparent, var(--gold));
  }
  .statband__sigma {
    /* Georgia here matches the Figma Make "Decorative Sigma Anchor" exactly —
       a single ornamental glyph, the one serif in the system. */
    font-family: Georgia, "Times New Roman", serif;
    font-size: 28px;
    line-height: 1;
    color: var(--gold);
  }

  /* Tablet range — tighten the gutters so the widest numeral ("100,000+")
     never crosses into the next column's divider. */
  @media (max-width: 1120px) {
    .statband__item {
      padding-inline: clamp(0.3rem, 1.4vw, 1rem);
    }
  }

  @media (max-width: 720px) {
    .statband__row {
      flex-wrap: wrap;
      gap: var(--space-8) 0;
    }
    .statband__item {
      flex-basis: 50%;
    }
    .statband__item + .statband__item::before {
      display: none;
    }
  }
</style>

<script>
  // Counts each stat up from 0 when it scrolls into view. The SSR'd text is
  // the real final value, so this only enhances — no JS / reduced-motion
  // leaves the correct number in place.
  interface ParsedStat {
    prefix: string;
    suffix: string;
    target: number;
    hasComma: boolean;
    decimals: number;
  }

  function parseStatValue(raw: string): ParsedStat | null {
    const match = raw.match(/^([^\d]*)(\d[\d,]*(?:\.\d+)?)([^\d]*)$/);
    if (!match) return null;
    const [, prefix, numStr, suffix] = match;
    return {
      prefix,
      suffix,
      target: parseFloat(numStr.replace(/,/g, "")),
      hasComma: numStr.includes(","),
      decimals: numStr.includes(".") ? numStr.split(".")[1].length : 0,
    };
  }

  function formatStatNumber(
    n: number,
    { hasComma, decimals }: Pick<ParsedStat, "hasComma" | "decimals">
  ) {
    const fixed = n.toFixed(decimals);
    if (!hasComma) return fixed;
    const [intPart, decPart] = fixed.split(".");
    const withCommas = Number(intPart).toLocaleString("en-US");
    return decPart ? `${withCommas}.${decPart}` : withCommas;
  }

  function animateStat(el: HTMLElement, parsed: ParsedStat) {
    const duration = 1400;
    const start = performance.now();
    function tick(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = `${parsed.prefix}${formatStatNumber(parsed.target * eased, parsed)}${parsed.suffix}`;
      if (progress < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const items = document.querySelectorAll("[data-count]");

  if (!reduceMotion && items.length && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          const parsed = parseStatValue(el.dataset.value ?? "");
          if (parsed) animateStat(el, parsed);
          observer.unobserve(el);
        }
      },
      { threshold: 0.4 }
    );
    items.forEach((el) => observer.observe(el));
  }
</script>
