---
/**
 * StatBand — the "at a glance" number row that appears on most pages
 * (founded 1922, N chapters, N members …).
 *
 * props:
 *   stats  [{ value: "1922", label: "Founded" }, …]
 *   tone   "cream" (default) | "white" | "navy"
 *   eyebrow / title  optional heading above the stats
 */
const { stats = [], tone = "cream", eyebrow, title } = Astro.props;
---
<section class:list={["statband", `statband--${tone}`, { "on-dark": tone === "navy" }]}>
  <div class="container">
    {(eyebrow || title) && (
      <div class="section-heading centered">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {title && <h2>{title}</h2>}
      </div>
    )}
    <dl class="statband__grid">
      {stats.map((s) => (
        <div class="statband__item">
          <dt class="statband__value">{s.value}</dt>
          <dd class="statband__label">{s.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .statband { padding-block: clamp(2.75rem, 6vw, 4.25rem); }
  .statband--white { background: var(--white); }
  .statband--cream { background: var(--cream); }
  .statband--navy {
    color: var(--white);
    background: linear-gradient(160deg, #22459f 0%, var(--royal) 55%, #1c3c8f 100%);
  }
  .statband__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-8) 0;
    margin: 0;
  }
  .section-heading + .statband__grid { margin-top: var(--space-12); }
  .statband__item { text-align: center; padding-inline: var(--space-4); }
  .statband__item + .statband__item { border-left: 1px solid rgba(255, 255, 255, 0.22); }
  .statband--white .statband__item + .statband__item,
  .statband--cream .statband__item + .statband__item { border-left-color: var(--line); }
  .statband__value {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 800;
    color: var(--royal);
    line-height: 1;
  }
  .statband--navy :global(h2) { color: #fff; }
  .statband--navy .statband__value { color: #fff; }
  .statband__label {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .statband--navy .statband__label { color: rgba(255, 255, 255, 0.7); }
</style>
