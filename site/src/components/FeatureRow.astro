---
/**
 * FeatureRow — an image beside a block of copy, alternating sides down the
 * page. The recurring "big topic" layout on the old site (program features,
 * initiative spotlights, region features). Put several in a row; pass
 * flip on every other one, or use the `index` prop and let it auto-alternate.
 *
 * props:
 *   eyebrow   small label (e.g. "National Program 01")
 *   title     heading
 *   image     image path (root-absolute)
 *   imageAlt  alt text (required with image)
 *   fit       "cover" (default, photo) | "contain" (logo/wordmark on a panel)
 *   flip      image on the right instead of the left
 *   index     if given, even -> normal, odd -> flipped (overrides `flip`)
 *   tone      "white" (default) | "cream"
 * slot: body copy + any links/buttons
 */
import { withBase } from "../lib/url.js";

const {
  eyebrow,
  title,
  image,
  imageAlt = "",
  fit = "cover",
  flip = false,
  index,
  tone = "white",
} = Astro.props;
const flipped = typeof index === "number" ? index % 2 === 1 : flip;
---

<section class:list={["frow", `frow--${tone}`, { "frow--flip": flipped }]}>
  <div class="container frow__inner">
    <figure class:list={["frow__media", `frow__media--${fit}`]}>
      <img src={withBase(image)} alt={imageAlt} loading="lazy" />
    </figure>
    <div class="frow__copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      {title && <h3>{title}</h3>}
      <slot />
    </div>
  </div>
</section>

<style>
  .frow {
    padding-block: clamp(2rem, 4.5vw, 3.25rem);
  }
  .frow--white {
    background: var(--white);
  }
  .frow--cream {
    background: var(--cream);
  }
  .frow__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: center;
  }
  .frow--flip .frow__media {
    order: 2;
  }
  .frow__media {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .frow__media--cover {
  }
  .frow__media--cover img {
    width: 100%;
    aspect-ratio: 5 / 3.4;
    max-height: 360px;
    object-fit: cover;
    display: block;
  }
  .frow__media--contain {
    background: var(--cream-2);
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    aspect-ratio: 5 / 3.4;
    max-height: 360px;
  }
  .frow__media--contain img {
    max-width: 78%;
    max-height: 78%;
    object-fit: contain;
    display: block;
  }
  .frow__copy :global(h3) {
    font-size: var(--text-h3);
    margin-bottom: var(--space-4);
  }
  .frow__copy :global(p) {
    color: var(--muted);
  }
  .frow__copy :global(p:last-child) {
    margin-bottom: 0;
  }
  @media (max-width: 820px) {
    .frow__inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .frow--flip .frow__media {
      order: 0;
    }
    .frow__media--cover img,
    .frow__media--contain {
      max-height: 300px;
    }
  }
</style>
