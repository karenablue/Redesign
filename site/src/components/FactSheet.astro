---
/**
 * FactSheet — Herstory's "Key Facts", shared. A data sheet, not boxes: each
 * fact sits under a thin gold rule, with a small caps label and a royal
 * value (Karena, Sept 2026, on the Herstory facts). Use only facts the page
 * already states.
 *
 * props:
 *   items  [{ label, lines, href?, external?, body? }]
 *          lines   the value, one string per line (an address, a number)
 *          href    makes the value a link (tel:, mailto:, a page)
 *          body    an optional sentence under the value
 *   cols   columns on wide screens (default: one per item, up to 4)
 */
import { withBase } from "../lib/url.js";

interface Fact {
  label: string;
  lines: string[];
  href?: string;
  external?: boolean;
  body?: string;
}
interface Props {
  items: Fact[];
  cols?: number;
}

const { items, cols = Math.min(items.length, 4) } = Astro.props;
const hrefFor = (href: string) => (/^(https?:|mailto:|tel:)/.test(href) ? href : withBase(href));
---

<dl class="facts" data-cols={cols} style={`--facts-cols:${cols}`}>
  {items.map((f) => (
    <div class="fact">
      <dt>{f.label}</dt>
      <dd class="fact__value">
        {f.href ? (
          <a
            href={hrefFor(f.href)}
            target={f.external ? "_blank" : undefined}
            rel={f.external ? "noopener" : undefined}
          >
            {f.lines.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))}
            {f.external && <span class="visually-hidden"> (opens in a new tab)</span>}
          </a>
        ) : (
          f.lines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))
        )}
      </dd>
      {f.body && <dd class="fact__body">{f.body}</dd>}
    </div>
  ))}
</dl>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(var(--facts-cols), minmax(0, 1fr));
    gap: clamp(1.75rem, 3.5vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem);
    margin: 0;
  }
  .facts[data-cols="1"] {
    row-gap: var(--space-6);
  }
  .fact {
    padding-top: var(--space-4);
    border-top: 1px solid var(--gold);
  }
  .fact dt {
    margin: 0 0 var(--space-2);
    color: var(--accent-text);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .fact__value {
    margin: 0;
    color: var(--royal);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .fact__value a {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  .fact__value a:hover {
    color: var(--accent-hover);
  }
  .fact__body {
    margin: var(--space-2) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }
  @media (max-width: 900px) {
    .facts:not([data-cols="1"]) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 540px) {
    .facts[data-cols] {
      grid-template-columns: 1fr;
    }
  }
</style>
