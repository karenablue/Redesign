---
/**
 * LegalDoc — shared shell for Privacy Policy, Cookie Notice, Terms of Use.
 * Renders a cream hero (breadcrumb, eyebrow, h1, "Last updated"), an optional
 * draft note, lead paragraphs, a numbered in-page TOC, the sections, and a
 * final contact block. All content is passed as data.
 *
 * props:
 *   title       page + <h1> text
 *   updated     "Last updated" string
 *   draftNote   optional callout shown above the intro (omit for finalized docs)
 *   intro       string[] of lead paragraphs
 *   sections    { id, title, blocks[] }[]  — blocks are
 *               { p: string } | { subhead: string } | { list: string[] } | { address: string[] }
 */
import PageHero from "./PageHero.astro";

interface Block {
  p?: string;
  subhead?: string;
  list?: string[];
  address?: string[];
}
interface Section {
  id: string;
  title: string;
  blocks: Block[];
}
interface Props {
  title: string;
  updated: string;
  draftNote?: string;
  intro?: string[];
  sections: Section[];
}

const { title, updated, draftNote, intro = [], sections } = Astro.props;
// The last word of the title takes the accent, as on every page opening.
const words = title.split(" ");
const titleLast = words.length > 1 ? words.pop() : undefined;
const titleLead = words.join(" ");
---

<PageHero
  tone="paper"
  editorial
  id="document-top"
  crumbs={[{ label: "Home", href: "/" }, { label: title }]}
  eyebrow="Legal"
  title={titleLead}
  highlight={titleLast}
  copy={`Last updated ${updated}`}
  size="compact"
/>

<section class="legal-body">
  <div class="container">
    <div class="legal-overview">
      {draftNote && (
        <p class="legal-note" role="note">
          {draftNote}
        </p>
      )}

      {intro.map((p) => (
        <p class="legal-intro">{p}</p>
      ))}
    </div>
    <div class="legal-layout">
      <nav class="legal-toc" aria-labelledby="legal-toc-title">
        <div class="legal-toc__heading">
          <p class="eyebrow" id="legal-toc-title">
            In This Document
          </p>
          <span>{sections.length} sections</span>
        </div>
        <ol>
          {sections.map((s) => (
            <li>
              <a href={`#${s.id}`}>{s.title}</a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="legal-reading">
        {sections.map((s) => (
          <section class="legal-section" id={s.id}>
            <h2>{s.title}</h2>
            {s.blocks.map((b) =>
              b.subhead ? (
                <h3>{b.subhead}</h3>
              ) : b.list ? (
                <ul>
                  {b.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              ) : b.address ? (
                <address>
                  {b.address.map((line) => (
                    <span>{line}</span>
                  ))}
                </address>
              ) : (
                <p>{b.p}</p>
              )
            )}
            <a class="legal-section__top" href="#document-top">
              Back to top <span aria-hidden="true">&uarr;</span>
            </a>
          </section>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .legal-overview {
    max-width: 760px;
    margin: 0 auto var(--space-10);
  }
  .legal-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.7fr);
    gap: var(--space-12);
    align-items: start;
  }
  .legal-layout .legal-toc {
    position: sticky;
    top: var(--space-24);
    max-height: calc(100svh - 8rem);
    overflow-y: auto;
    margin: 0;
    background: var(--cream);
    border-radius: 0;
  }
  .legal-layout .legal-toc a {
    display: block;
    padding-block: var(--space-1);
    font-size: var(--text-sm);
  }
  @media (max-width: 900px) {
    .legal-layout {
      grid-template-columns: 1fr;
    }
    .legal-layout .legal-toc {
      position: static;
      max-height: none;
    }
  }

  .legal-body {
    background: var(--white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .legal-note {
    padding: var(--space-4) var(--space-5);
    margin: 0 0 var(--space-8);
    background: var(--tint);
    /* A hairline, not a 3px gold side-tab. This is a filled, rounded callout
       surface, so DESIGN.md's Hairline Rule applies exactly as it did to
       .pf-mission; the tint fill already separates it. (Unlike herstory's
       left rules, which sit on actual pull quotes and are sanctioned.) */
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .legal-intro {
    color: var(--muted);
  }

  .legal-toc {
    margin: var(--space-8) 0 var(--space-12);
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--tint);
  }
  .legal-toc__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .legal-toc__heading p,
  .legal-toc__heading span {
    margin: 0;
  }
  .legal-toc__heading span {
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .legal-toc ol {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: 0;
    list-style: none; /* section titles carry their own "N." prefix */
    color: var(--royal);
  }
  .legal-toc a {
    color: inherit;
    font-weight: 700;
    text-decoration: none;
  }
  .legal-toc a:hover {
    /* The table of contents sits on white, where gold text would be 2:1.
       Hover deepens to royal and adds a brand-gold underline instead. */
    color: var(--accent-hover);
    text-decoration-line: underline;
    text-decoration-color: var(--gold);
  }

  .legal-section {
    scroll-margin-top: 72px;
    margin-top: var(--space-10);
  }
  .legal-section h2 {
    font-size: var(--text-h3);
    margin: 0 0 var(--space-4);
  }
  .legal-section h3 {
    font-size: var(--text-md);
    margin: var(--space-6) 0 var(--space-3);
  }
  .legal-section p {
    color: var(--muted);
  }
  .legal-section ul {
    margin: 0 0 var(--space-6);
    padding-left: 1.2rem;
    display: grid;
    gap: var(--space-1);
    color: var(--muted);
  }
  .legal-section address {
    font-style: normal;
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-4);
    color: var(--muted);
  }
  .legal-section a {
    color: var(--royal-dark);
    font-weight: 700;
  }
  .legal-section .legal-section__top {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    text-decoration: none;
  }
</style>
