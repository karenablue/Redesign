---
/**
 * PageHero — the Herstory opening, shared. A navy band with a very large
 * LEMON MILK title whose second part is the accent (gold on navy), an
 * optional real photograph across the right of the band under a navy
 * gradient, an optional ghosted year, and an optional jump bar beneath.
 *
 * Photographs are always real Sigma Gamma Rho images, right-sized in
 * public/optimized/ (scripts/optimize-heroes.mjs), which also writes the
 * name-640.webp copy phones load. `archival` sets them in
 * greyscale, as Herstory does, for history pages; present-day pages keep
 * the royal and gold in colour. Serious and task pages pass no image.
 *
 * Each page can add one detail of its own, so the openings don't all read
 * alike: a gold year `badge` on the photo (Herstory's 1922 badge), a
 * `caption` on the photo, or a gold-ruled numeral `detail` under the
 * actions. Use only facts the page itself states.
 *
 * props:
 *   eyebrow, title, highlight (the accent part), copy
 *   lead       a bolder first sentence, before `copy`
 *   image      root-absolute path in /optimized/, decorative (alt="")
 *   focal      object-position for the photo
 *   archival   greyscale the photo
 *   badge      { label, value } gold circle on the photo's edge
 *   caption    short line set on the photo
 *   detail     { value, label } numeral and line under the actions
 *   watermark  a ghosted year or word; shown only on pages without a photo
 *   crumbs     Breadcrumb items
 *   jump       [{ href, label }] in-page links for the bar under the band
 *   jumpLabel  accessible name for the jump bar
 *   size       "tall" | "regular" | "compact"
 *   id         anchor id for the band (e.g. a "back to top" target)
 *   settle     the photo settles into place once, slowly (motion pilot)
 *   stack      put the accent part on its own line ("Five regions. / One standard.")
 * default slot: actions (buttons) or a tool such as a search form
 */
import Breadcrumb from "./Breadcrumb.astro";
import { withBase } from "../lib/url.js";
import { reg } from "../lib/reg.js";

interface Props {
  eyebrow?: string;
  title: string;
  highlight?: string;
  copy?: string;
  lead?: string;
  image?: string;
  focal?: string;
  archival?: boolean;
  badge?: { label: string; value: string };
  caption?: string;
  detail?: { value: string; label: string };
  watermark?: string;
  crumbs?: { label: string; href?: string }[];
  jump?: { href: string; label: string }[];
  jumpLabel?: string;
  size?: "tall" | "regular" | "compact";
  stack?: boolean;
  settle?: boolean;
  id?: string;
}

const {
  eyebrow,
  title,
  highlight,
  copy,
  lead,
  image,
  focal = "50% 40%",
  archival = false,
  badge,
  caption,
  detail,
  watermark,
  crumbs,
  jump,
  jumpLabel = "On this page",
  size = "regular",
  stack = false,
  settle = false,
  id,
} = Astro.props;

// Long titles step down a size so they still sit on two or three lines.
// A stacked title is sized by its longer line.
const length = stack
  ? Math.max(title.length, (highlight ?? "").length)
  : `${title} ${highlight ?? ""}`.trim().length;
const scale = length <= 14 ? "xl" : length <= 22 ? "lg" : length <= 48 ? "md" : "sm";
---

<section
  id={id}
  class:list={[
    "ph",
    "on-dark",
    `ph--${size}`,
    `ph--${scale}`,
    {
      "ph--photo": image,
      "ph--archival": archival,
      "ph--stack": stack,
      "ph--lead": lead,
      "ph--settle": settle,
    },
  ]}
>
  {image && (
    <div class="ph__media">
      <img
        src={withBase(image)}
        srcset={`${withBase(image.replace(/\.webp$/, "-640.webp"))} 640w, ${withBase(image)} 1200w`}
        sizes="(max-width: 820px) 100vw, 62vw"
        alt=""
        fetchpriority="high"
        style={`object-position:${focal}`}
      />
      {caption && <p class="ph__caption">{caption}</p>}
    </div>
  )}
  <div class="ph__overlay" aria-hidden="true"></div>
  {image && badge && (
    <p class="ph__badge">
      <small>{badge.label}</small>
      <strong>{badge.value}</strong>
    </p>
  )}
  {!image && watermark && (
    <span class:list={["ph__watermark", { "ph__watermark--long": watermark.length > 4 }]} aria-hidden="true">
      {watermark}
    </span>
  )}
  <div class="container ph__content">
    {crumbs && <Breadcrumb items={crumbs} tone="dark" />}
    {eyebrow && <p class="eyebrow ph__eyebrow" set:html={reg(eyebrow)} />}
    <h1 class="ph__title">
      <Fragment set:html={reg(title)} />
      {highlight && (
        <>
          {" "}
          <span set:html={reg(highlight)} />
        </>
      )}
    </h1>
    {lead && <p class="ph__lead">{lead}</p>}
    {copy && <p class="ph__copy">{copy}</p>}
    {Astro.slots.has("default") && (
      <div class="ph__actions">
        <slot />
      </div>
    )}
    {detail && (
      <p class="ph__detail">
        <span class="ph__detail-value">{detail.value}</span>
        <span class="ph__detail-label">{detail.label}</span>
      </p>
    )}
  </div>
</section>
{jump && jump.length > 0 && (
  <nav class="ph-jump" aria-label={jumpLabel}>
    <div class="container">
      <span>Explore</span>
      {jump.map((j) => (
        <a href={j.href}>{j.label}</a>
      ))}
    </div>
  </nav>
)}

<style>
  .ph {
    position: relative;
    overflow: hidden;
    display: grid;
    align-content: center;
    color: #fff;
    background: var(--navy);
  }
  .ph--tall {
    min-height: 560px;
  }
  .ph--regular {
    min-height: 460px;
  }
  .ph--compact {
    min-height: 0;
  }

  /* The photo fills the right of the band; the gradient carries the navy
     across it so the type always sits on a solid ground. */
  .ph__media {
    position: absolute;
    inset: 0 0 0 auto;
    width: 62%;
  }
  .ph__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Fade the photo in from the left so it has no hard edge. */
    mask-image: linear-gradient(90deg, transparent 0%, #000 40%);
  }
  .ph--archival .ph__media img {
    filter: grayscale(100%);
  }
  .ph__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(8, 22, 51, 1) 0%,
      rgba(8, 22, 51, 0.96) 40%,
      rgba(8, 22, 51, 0.72) 56%,
      rgba(14, 37, 88, 0.36) 78%,
      rgba(8, 22, 51, 0.18) 100%
    );
  }
  .ph:not(.ph--photo) .ph__overlay {
    background: radial-gradient(120% 90% at 85% 0%, rgba(32, 65, 165, 0.55), transparent 60%);
  }

  /* Sits whole inside the band's bottom-right corner, below the title. */
  .ph__watermark {
    position: absolute;
    bottom: var(--space-8);
    right: max(var(--gutter), calc((100% - var(--container)) / 2));
    font-family: var(--font-label);
    font-size: clamp(5rem, 10vw, 10rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.05);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }
  .ph__watermark--long {
    font-size: clamp(3.5rem, 7vw, 7rem);
  }

  .ph__caption {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    z-index: 2;
    margin: 0;
    padding: var(--space-2) var(--space-3);
    background: rgba(8, 22, 51, 0.72);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* Herstory's year badge: a gold disc on the photo, in the band's
     bottom-right corner, clear of the title. */
  .ph__badge {
    position: absolute;
    z-index: 3;
    bottom: clamp(1.5rem, 4vw, 2.5rem);
    right: max(var(--gutter), calc((100% - var(--container)) / 2));
    width: 96px;
    height: 96px;
    margin: 0;
    display: grid;
    place-content: center;
    text-align: center;
    border-radius: 50%;
    color: var(--navy);
    background: var(--gold);
    box-shadow: 0 12px 26px rgba(8, 22, 51, 0.28);
  }
  .ph__badge small {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .ph__badge strong {
    margin-top: 2px;
    font-family: var(--font-label);
    font-weight: 400;
    font-size: 26px;
    line-height: 1;
  }

  .ph__content {
    position: relative;
    z-index: 2;
    padding-block: clamp(4rem, 9vw, 6rem);
  }
  .ph--compact .ph__content {
    padding-block: clamp(3rem, 6vw, 4.25rem);
  }
  .ph__content > :global(.breadcrumb) {
    margin-bottom: var(--space-6);
  }
  .ph__eyebrow {
    margin-bottom: var(--space-4);
  }
  .ph__title {
    margin: 0;
    max-width: 14ch;
    font-family: var(--font-label);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .ph--xl .ph__title {
    font-size: clamp(2.5rem, 8.5vw, 7.25rem);
  }
  .ph--lg .ph__title {
    max-width: 16ch;
    font-size: clamp(2.1rem, 6vw, 5rem);
  }
  .ph--md .ph__title {
    max-width: 20ch;
    font-size: clamp(1.8rem, 4.6vw, 3.75rem);
    line-height: 1.02;
  }
  .ph--sm .ph__title {
    max-width: 30ch;
    font-size: clamp(1.6rem, 3.4vw, 2.75rem);
    line-height: 1.08;
  }
  .ph__title span {
    color: var(--accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-underline);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }
  .ph--stack .ph__title {
    max-width: none;
  }
  .ph--stack .ph__title span {
    display: block;
  }
  .ph__lead {
    max-width: 40rem;
    margin: var(--space-8) 0 0;
    color: #fff;
    font-size: var(--text-md);
    font-weight: 700;
    line-height: 1.6;
  }
  .ph__lead + .ph__copy {
    margin-top: var(--space-4);
  }
  .ph__copy {
    max-width: 40rem;
    margin: var(--space-8) 0 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--text-md);
    line-height: 1.75;
  }
  .ph__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .ph__detail {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    max-width: 30rem;
    margin: var(--space-10) 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--gold);
  }
  .ph__detail-value {
    flex: none;
    font-family: var(--font-label);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    line-height: 1;
    color: var(--gold);
  }
  .ph__detail-label {
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.5;
  }

  .ph-jump {
    background: var(--navy);
    border-top: 1px solid var(--line-dark);
  }
  .ph-jump .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    min-height: 4rem;
    padding-block: var(--space-3);
  }
  .ph-jump span {
    color: var(--gold);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .ph-jump a {
    color: var(--white);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
  }
  .ph-jump a:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 0.3em;
  }

  /* Phones and small tablets: the text sits on solid navy, first, so the
     buttons stay on the first screen; the photo follows as a strip under
     it, where it can be seen, rather than hiding behind a dark overlay. */
  /* The photo settles into place once, over 14 seconds (global.css). */
  .ph--settle .ph__media img {
    animation: sgr-settle 14s var(--ease-out-strong) both;
  }
  @media (prefers-reduced-motion: reduce) {
    .ph--settle .ph__media img {
      animation: none;
    }
  }

  @media (max-width: 820px) {
    .ph {
      grid-template-rows: auto auto;
      align-content: start;
    }
    .ph__content {
      grid-row: 1;
    }
    .ph__media {
      position: relative;
      inset: auto;
      grid-row: 2;
      width: 100%;
      height: clamp(190px, 52vw, 320px);
    }
    .ph__media img {
      mask-image: linear-gradient(180deg, transparent 0%, #000 45%);
    }
    .ph--photo .ph__overlay {
      display: none;
    }
    .ph:not(.ph--photo) .ph__overlay {
      background: radial-gradient(120% 70% at 100% 0%, rgba(32, 65, 165, 0.5), transparent 60%);
    }
    .ph--tall,
    .ph--regular {
      min-height: 0;
    }
    /* The ghosted watermark would sit on the text. */
    .ph__watermark {
      display: none;
    }
    .ph__badge {
      width: 76px;
      height: 76px;
    }
    .ph__badge strong {
      font-size: 20px;
    }
  }

  /* Phones: tighter spacing and a step down in type, so the title, the
     words and the first button fit on the first screen. Nothing is hidden. */
  @media (max-width: 640px) {
    .ph__content,
    .ph--compact .ph__content {
      padding-block: var(--space-8) var(--space-8);
    }
    .ph--photo .ph__content {
      padding-bottom: var(--space-4);
    }
    .ph__content > :global(.breadcrumb) {
      margin-bottom: var(--space-4);
    }
    .ph__eyebrow {
      margin-bottom: var(--space-3);
    }
    .ph--xl .ph__title {
      font-size: 2.35rem;
    }
    .ph--lg .ph__title {
      font-size: 2rem;
    }
    .ph--md .ph__title {
      font-size: 1.7rem;
    }
    .ph--sm .ph__title {
      font-size: 1.5rem;
    }
    .ph__lead,
    .ph__copy {
      margin-top: var(--space-5);
      font-size: var(--text-base);
      line-height: 1.6;
    }
    .ph__lead + .ph__copy {
      margin-top: var(--space-3);
    }
    .ph__actions {
      margin-top: var(--space-6);
    }
    .ph__detail {
      margin-top: var(--space-6);
    }
    /* With a bold lead line, the buttons follow it and the longer paragraph
       comes after them, so the buttons stay on the first screen. The
       paragraph is prose, not a control, so focus order is unchanged. */
    .ph--lead .ph__content {
      display: flex;
      flex-direction: column;
    }
    .ph--lead .ph__actions {
      order: 1;
    }
    .ph--lead .ph__copy {
      order: 2;
      margin-top: var(--space-6);
    }
    .ph--lead .ph__detail {
      order: 3;
    }
  }
</style>
