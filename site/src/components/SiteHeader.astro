---
/**
 * SiteHeader — brand row + primary nav bar + action buttons + search.
 * Reads primaryNav / headerActions / searchIndex from src/data/nav.js, so the
 * navigation is defined once for the whole site (the old site had this markup
 * duplicated in 24 files).
 *
 * props:
 *   activeTop  label of the current top-level section, e.g. "About" — used to
 *              highlight the matching nav item.
 */
import { primaryNav, headerActions, searchIndex } from "../data/nav.js";
import { withBase } from "../lib/url.js";
import Button from "./Button.astro";

const { activeTop } = Astro.props;
const search = searchIndex().map((p) => ({ t: p.label, u: withBase(p.href) }));
---
<header class="site-header">
  <div class="container brand-row">
    <a class="brand" href={withBase("/")} aria-label="Sigma Gamma Rho home">
      <img src={withBase("/images/SGR-Logo-Shield.png")} alt="Sigma Gamma Rho Sorority coat of arms" width="72" height="72" />
      <span class="brand__copy">
        <span class="brand__kicker">&mdash;&nbsp; National Website &bull; Est. 1922 &nbsp;&mdash;</span>
        <span class="brand__title">Sigma Gamma Rho Sorority, Incorporated<sup>&reg;</sup></span>
      </span>
    </a>
  </div>

  <div class="nav-bar">
    <div class="container nav-bar__inner">
      <nav class="site-nav" aria-label="Primary">
        <ul class="site-nav__list">
          {primaryNav.map((item) => (
            <li class:list={["site-nav__item", { "is-active": item.label === activeTop }]}>
              {item.children ? (
                <>
                  <button type="button" class="site-nav__link" aria-expanded="false">
                    {item.label}
                  </button>
                  <ul class="site-nav__menu">
                    {item.children.map((c) => (
                      <li><a href={withBase(c.href)}>{c.label}</a></li>
                    ))}
                  </ul>
                </>
              ) : (
                <a class="site-nav__link" href={withBase(item.href)}>{item.label}</a>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <div class="header-actions">
        <div class="header-search">
          <button type="button" class="search-toggle" aria-label="Search the site" aria-expanded="false">
            <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </button>
          <div class="search-panel" hidden>
            <input type="search" class="search-input" placeholder="Search the site&hellip;" aria-label="Search the site" />
            <div class="search-results" role="listbox" aria-label="Search results"></div>
          </div>
        </div>
        {headerActions.map((a) => (
          <Button href={a.href} variant={a.variant === "solid" ? "solid" : "outline"} class="header-actions__btn">
            {a.label}
          </Button>
        ))}
      </div>
    </div>
  </div>
</header>

<script is:inline define:vars={{ PAGES: search }}>
  (function () {
    var toggle = document.querySelector(".search-toggle");
    var panel = document.querySelector(".search-panel");
    var input = document.querySelector(".search-input");
    var results = document.querySelector(".search-results");
    if (toggle && panel && input && results) {
      var open = function () { panel.hidden = false; toggle.setAttribute("aria-expanded", "true"); input.focus(); };
      var close = function () { panel.hidden = true; toggle.setAttribute("aria-expanded", "false"); input.value = ""; results.innerHTML = ""; };
      toggle.addEventListener("click", function (e) { e.stopPropagation(); panel.hidden ? open() : close(); });
      document.addEventListener("click", function (e) { if (!panel.hidden && !panel.contains(e.target) && e.target !== toggle) close(); });
      document.addEventListener("keydown", function (e) { if (e.key === "Escape") close(); });
      input.addEventListener("input", function () {
        var q = input.value.trim().toLowerCase();
        results.innerHTML = "";
        if (!q) return;
        var hits = PAGES.filter(function (p) { return p.t.toLowerCase().indexOf(q) !== -1; }).slice(0, 8);
        if (!hits.length) { results.innerHTML = '<p class="search-results__empty">No results found</p>'; return; }
        hits.forEach(function (p) {
          var a = document.createElement("a");
          a.href = p.u; a.textContent = p.t; a.setAttribute("role", "option");
          results.appendChild(a);
        });
      });
    }

    /* Dropdown: open on hover via CSS; here we wire keyboard + tap for the
       button triggers so it works without a pointer. */
    document.querySelectorAll(".site-nav__item > .site-nav__link[aria-expanded]").forEach(function (btn) {
      var item = btn.parentElement;
      btn.addEventListener("click", function () {
        var openNow = item.classList.toggle("is-open");
        btn.setAttribute("aria-expanded", String(openNow));
      });
      item.addEventListener("focusout", function (e) {
        if (!item.contains(e.relatedTarget)) { item.classList.remove("is-open"); btn.setAttribute("aria-expanded", "false"); }
      });
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }
  .brand-row { display: flex; align-items: center; min-height: 104px; }
  .brand { display: flex; align-items: center; gap: var(--space-5); text-decoration: none; }
  .brand img { width: 76px; height: 76px; object-fit: contain; }
  .brand__copy { display: flex; flex-direction: column; align-items: center; }
  .brand__kicker {
    color: var(--gold);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }
  .brand__title {
    margin-top: 5px;
    color: var(--royal);
    font-size: clamp(1.25rem, 2.4vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    border-bottom: 2px solid var(--gold);
    padding-bottom: 2px;
  }
  .brand__title sup { font-size: 0.5em; }

  .nav-bar { background: var(--royal); border-block: 3px solid var(--gold); }
  .nav-bar__inner { display: flex; align-items: center; gap: var(--space-3); min-height: 52px; }

  .site-nav { flex: 1; }
  .site-nav__list { display: flex; flex-wrap: wrap; gap: 0; margin: 0; padding: 0; list-style: none; }
  .site-nav__item { position: relative; }
  .site-nav__link {
    display: flex;
    align-items: center;
    padding: 0.9rem 0.8rem;
    border: 0;
    background: none;
    color: var(--white);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
    text-decoration: none;
  }
  .site-nav__item.is-active > .site-nav__link,
  .site-nav__item:hover > .site-nav__link,
  .site-nav__item:focus-within > .site-nav__link { color: var(--gold-bright); }

  .site-nav__menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    display: none;
    flex-direction: column;
    margin: 0;
    padding: var(--space-2) 0;
    list-style: none;
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    z-index: 50;
  }
  .site-nav__item:hover .site-nav__menu,
  .site-nav__item:focus-within .site-nav__menu,
  .site-nav__item.is-open .site-nav__menu { display: flex; }
  .site-nav__menu a {
    padding: 0.65rem 1rem;
    color: #2c3951;
    font-size: var(--text-xs);
    line-height: 1.45;
    text-decoration: none;
  }
  .site-nav__menu a:hover, .site-nav__menu a:focus { color: var(--royal); background: #f5f7fc; outline: none; }

  .header-actions { display: flex; align-items: center; gap: var(--space-2); margin-left: auto; }
  .header-actions :global(.header-actions__btn) { font-size: var(--text-xs); padding: 0.55rem 1rem; }
  .header-actions :global(.btn--outline) { color: var(--white); border-color: var(--gold-bright); }

  .header-search { position: relative; }
  .search-toggle {
    width: 36px; height: 36px;
    display: grid; place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--radius);
    background: transparent;
    color: var(--white);
    cursor: pointer;
  }
  .search-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    width: min(320px, 80vw);
    padding: var(--space-3);
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }
  .search-input {
    width: 100%;
    padding: 0.6rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font: inherit;
  }
  .search-results { display: flex; flex-direction: column; margin-top: var(--space-2); }
  .search-results a { padding: 0.5rem 0.6rem; color: var(--ink); font-size: var(--text-sm); text-decoration: none; border-radius: 6px; }
  .search-results a:hover, .search-results a:focus { background: #f5f7fc; color: var(--royal); }
  .search-results__empty { margin: 0; padding: 0.5rem 0.6rem; color: var(--muted); font-size: var(--text-sm); }

  @media (max-width: 900px) {
    .nav-bar__inner { flex-wrap: wrap; padding-block: var(--space-2); }
    .site-nav__list { width: 100%; }
    .site-nav__menu { position: static; box-shadow: none; padding-left: var(--space-4); }
    .header-actions { margin-left: 0; width: 100%; justify-content: flex-start; }
  }
</style>
