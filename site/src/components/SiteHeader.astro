---
/**
 * SiteHeader — brand row + primary nav bar + action buttons + search.
 * Reads primaryNav / headerActions / searchIndex from src/data/nav.js, so the
 * navigation is defined once for the whole site (the old site had this markup
 * duplicated in 24 files).
 *
 * props:
 *   activeTop  label of the current top-level section, e.g. "About" — used to
 *              highlight the matching nav item.
 */
import { primaryNav, headerActions, searchIndex } from "../data/nav.js";
import { reg } from "../lib/reg.js";
import { withBase } from "../lib/url.js";
import Button from "./Button.astro";

const { activeTop } = Astro.props;
const search = searchIndex().map((p) => ({ t: p.label, u: withBase(p.href) }));
---

<header class="site-header">
  <div class="header-wrap brand-row">
    <a class="brand" href={withBase("/")} aria-label="Sigma Gamma Rho home">
      <img
        class="brand__shield"
        src={withBase("/images/SGR-Logo-Shield.png")}
        alt="Sigma Gamma Rho Sorority Shield"
        width="80"
        height="80"
      />
      <span class="brand__copy">
        <span class="brand__kicker">
          <span class="brand__kicker-rule" aria-hidden="true"></span>
          National Website &bull; Est. 1922
          <span class="brand__kicker-rule" aria-hidden="true"></span>
        </span>
        <span class="brand__title">
          Sigma Gamma Rho Sorority, Incorporated<sup>&reg;</sup>
        </span>
        <span class="brand__rule" aria-hidden="true"></span>
      </span>
    </a>
  </div>

  <div class="nav-bar">
    <div class="header-wrap nav-bar__inner">
      <!-- Collapses to a single drawer below 1280px, toggled by .nav-toggle;
           `display: contents` above that width so it's invisible to the flex
           layout and .site-nav / .header-actions lay out exactly as before. -->
      <div class="nav-panel" id="nav-panel">
        <nav class="site-nav" aria-label="Primary">
          <ul class="site-nav__list">
            {primaryNav.map((item) => (
              <li class:list={["site-nav__item", { "is-active": item.label === activeTop }]}>
                {item.children ? (
                  <>
                    <button type="button" class="site-nav__link" aria-expanded="false">
                      {item.label}
                      <span class="site-nav__chevron" aria-hidden="true"></span>
                    </button>
                    <ul class="site-nav__menu">
                      {item.children.map((c) => (
                        <li>
                          <a href={withBase(c.href)}>{c.label}</a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <a class="site-nav__link" href={withBase(item.href)}>
                    {item.label}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </nav>

        <div class="header-actions">
          <div class="header-search">
            <button
              type="button"
              class="search-toggle"
              aria-label="Search the site"
              aria-expanded="false"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <circle cx="11" cy="11" r="7" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
              </svg>
            </button>
            <div class="search-panel" hidden>
              <div class="search-field">
                <svg
                  class="search-field__icon"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <circle cx="11" cy="11" r="7" />
                  <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <input
                  type="search"
                  class="search-input"
                  placeholder="Search the site&hellip;"
                  aria-label="Search the site"
                />
              </div>
              <div class="search-results" role="listbox" aria-label="Search results"></div>
            </div>
          </div>
          {headerActions.map((a) => (
            <Button
              href={a.href}
              variant={a.variant === "solid" ? "solid" : "outline"}
              class="header-actions__btn"
            >
              {/* one inline element: .btn is a flex row with a gap, so a bare
                  <sup> would be spaced away from the label */}
              <span set:html={reg(a.label)} />
            </Button>
          ))}
        </div>
      </div>

      <button
        type="button"
        class="nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-panel"
      >
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
      </button>
    </div>
  </div>
</header>

<script is:inline define:vars={{ PAGES: search }}>
  (function () {
    const toggle = document.querySelector(".search-toggle");
    const panel = document.querySelector(".search-panel");
    const input = document.querySelector(".search-input");
    const results = document.querySelector(".search-results");
    if (toggle && panel && input && results) {
      const open = function () {
        panel.hidden = false;
        toggle.setAttribute("aria-expanded", "true");
        input.focus();
      };
      const close = function () {
        panel.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
        input.value = "";
        results.innerHTML = "";
      };
      toggle.addEventListener("click", function (e) {
        e.stopPropagation();
        if (panel.hidden) open();
        else close();
      });
      document.addEventListener("click", function (e) {
        if (!panel.hidden && !panel.contains(e.target) && e.target !== toggle) close();
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") close();
      });
      input.addEventListener("input", function () {
        const q = input.value.trim().toLowerCase();
        results.innerHTML = "";
        if (!q) return;
        const hits = PAGES.filter(function (p) {
          return p.t.toLowerCase().indexOf(q) !== -1;
        }).slice(0, 8);
        if (!hits.length) {
          results.innerHTML = '<p class="search-results__empty">No results found</p>';
          return;
        }
        hits.forEach(function (p) {
          const a = document.createElement("a");
          a.href = p.u;
          a.textContent = p.t;
          a.setAttribute("role", "option");
          results.appendChild(a);
        });
      });
    }

    /* Dropdowns are click-only. The trigger button toggles .is-open; opening
       one closes the others; a click or Escape anywhere else closes them. */
    const navItems = Array.prototype.slice.call(
      document.querySelectorAll(".site-nav__item > .site-nav__link[aria-expanded]")
    );

    function closeAllMenus(except) {
      navItems.forEach(function (b) {
        const it = b.parentElement;
        if (it === except) return;
        it.classList.remove("is-open");
        b.setAttribute("aria-expanded", "false");
      });
    }

    navItems.forEach(function (btn) {
      const item = btn.parentElement;
      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        const openNow = !item.classList.contains("is-open");
        closeAllMenus(item);
        item.classList.toggle("is-open", openNow);
        btn.setAttribute("aria-expanded", String(openNow));
      });
    });

    document.addEventListener("click", function (e) {
      if (!e.target.closest || !e.target.closest(".site-nav__item")) closeAllMenus();
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeAllMenus();
    });

    /* Hamburger toggle — below 1280px, .nav-panel (nav links + search +
       CTAs) is hidden until this opens it as a full-width drawer. */
    const navBar = document.querySelector(".nav-bar");
    const navToggle = document.querySelector(".nav-toggle");
    if (navBar && navToggle) {
      const setOpen = function (open) {
        navBar.classList.toggle("is-menu-open", open);
        navToggle.setAttribute("aria-expanded", String(open));
        navToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        if (!open) closeAllMenus();
      };
      navToggle.addEventListener("click", function (e) {
        e.stopPropagation();
        setOpen(!navBar.classList.contains("is-menu-open"));
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && navBar.classList.contains("is-menu-open")) {
          setOpen(false);
          navToggle.focus();
        }
      });
      // Resizing/rotating past the collapse breakpoint shouldn't leave the
      // drawer stuck open underneath the now-restored inline nav.
      const desktopQuery = window.matchMedia("(min-width: 1280px)");
      const syncToBreakpoint = function (e) {
        if (e.matches) setOpen(false);
      };
      if (desktopQuery.addEventListener) {
        desktopQuery.addEventListener("change", syncToBreakpoint);
      } else {
        desktopQuery.addListener(syncToBreakpoint);
      }
    }
  })();
</script>

<style>
  /* Brand identity bar — matched to the Figma Make Header.tsx:
     96px shield w/ gold drop-shadow, 24px gap, LEFT-aligned copy block,
     11px/3px-tracked kicker between two 12px gold rules, 32px Montserrat
     wordmark, 16px sup ®, and a 320px gold→transparent gradient underline. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }
  /* Figma Make header spans the full width with ~80px side gutters,
     not the site's 1100px container. */
  .header-wrap {
    width: 100%;
    padding-inline: clamp(1.25rem, 5.5vw, 5rem);
  }
  .brand-row {
    display: flex;
    align-items: center;
    /* Tightened from 1.25rem — at 96px the shield already made this row
       more than 2x the nav row's height, so the nav read as miniature by
       comparison rather than as one unified header system. */
    padding-block: 1rem;
    border-bottom: 4px solid var(--gold);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-width: 0;
    text-decoration: none;
  }
  .brand__shield {
    width: 80px;
    height: 80px;
    object-fit: contain;
    flex-shrink: 0;
    filter: drop-shadow(0 4px 12px rgba(223, 177, 54, 0.25));
  }
  .brand__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }
  .brand__kicker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 4px;
    /* the brand row is white, so this needs the type-safe gold */
    color: var(--accent-text);
    font-size: 0.6875rem; /* 11px */
    font-weight: 700;
    letter-spacing: 0.27em; /* ~3px at 11px */
    text-transform: uppercase;
  }
  .brand__kicker-rule {
    width: 12px;
    height: 1px;
    background: var(--gold);
  }
  .brand__title {
    color: var(--royal);
    font-family: var(--font-body);
    font-size: 2rem; /* 32px */
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .brand__title sup {
    font-size: 0.5em; /* 16px */
    vertical-align: super;
    margin-left: 2px;
  }
  .brand__rule {
    width: 20rem; /* 320px */
    max-width: 100%;
    height: 1px;
    margin-top: 6px;
    background: linear-gradient(to right, var(--gold), rgba(223, 177, 54, 0.5), transparent);
  }

  /* Nav bar — navy, 4px gold bottom rule, 64px row, links centred, 32px gap,
     16px Montserrat 700, no dropdown arrows, gold underline-reveal on hover. */
  .nav-bar {
    background: var(--royal);
    /* top divider comes from .brand-row's gold border */
    border-bottom: 4px solid var(--gold);
  }
  .nav-bar__inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    /* Bumped from 64px alongside shrinking the brand row — narrows the gap
       between "big logo area" and "tiny navigation" so the two rows read as
       one header system rather than two mismatched ones. */
    min-height: 72px;
  }
  /* Transparent to layout above the collapse breakpoint — .site-nav and
     .header-actions remain direct flex children of .nav-bar__inner. */
  .nav-panel {
    display: contents;
  }

  .site-nav {
    flex: 1;
  }
  .site-nav__list {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav__item {
    position: relative;
  }
  .site-nav__link {
    display: flex;
    align-items: center;
    padding: 0.5rem 0;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--white);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.025em;
    white-space: nowrap;
    cursor: pointer;
    text-decoration: none;
    transition:
      color 0.3s ease,
      border-color 0.3s ease;
  }
  /* Simple underline reveal — a gold rule wipes in under the link on hover
     or keyboard focus. */
  .site-nav__link:hover,
  .site-nav__link:focus-visible {
    border-bottom-color: var(--gold);
  }
  /* Current section / open dropdown — gold text with a persistent underline. */
  .site-nav__item.is-active > .site-nav__link,
  .site-nav__item.is-open > .site-nav__link {
    /* Brand gold on the royal bar is 4.44:1, just under AA for this size,
       and there is only one gold. So the active item is white and the gold
       carries the accent as its underline. */
    color: #fff;
    border-bottom-color: var(--gold);
  }
  /* Mobile-only expand/collapse indicator — the desktop dropdown stays
     arrow-free, but a stacked accordion needs the affordance. */
  .site-nav__chevron {
    display: none;
    width: 7px;
    height: 7px;
    margin-left: var(--space-3);
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav__link,
    .site-nav__chevron,
    .site-nav__menu,
    .nav-toggle__bar {
      transition: none;
    }
  }

  .site-nav__menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    display: flex;
    flex-direction: column;
    margin: 0.5rem 0 0;
    padding: var(--space-2) 0;
    list-style: none;
    background: var(--white);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--radius);
    box-shadow: 0 20px 44px rgba(8, 22, 51, 0.16);
    z-index: 50;
  }
  /* click-only (not hover-open — that doesn't work on touch) — the trigger
     button toggles .is-open. Above the collapse breakpoint this fades and
     slides in rather than snapping open. */
  @media (min-width: 1280px) {
    .site-nav__menu {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      pointer-events: none;
      transition:
        opacity 0.18s ease,
        transform 0.18s ease,
        visibility 0.18s;
    }
    .site-nav__item.is-open .site-nav__menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
    }
  }
  .site-nav__menu a {
    /* Block, not the default inline — an inline element only pads the
       first line of a wrapped label ("International Corporate
       Headquarters" wraps to 2 lines), leaving the continuation flush
       against the panel edge with no padding. */
    display: block;
    padding: 0.625rem 1.25rem;
    color: #374151;
    font-size: var(--text-sm);
    line-height: 1.45;
    text-decoration: none;
    transition:
      background 0.12s ease,
      color 0.12s ease;
  }
  .site-nav__menu a:hover,
  .site-nav__menu a:focus {
    color: #fff;
    background: var(--royal);
    outline: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-left: auto;
    flex-shrink: 0;
  }
  /* Figma nav CTAs: rounded-md (not pill), 13px, 600, 24/10 padding, no wrap */
  .header-actions :global(.header-actions__btn) {
    border-radius: var(--radius);
    padding: 0.625rem 1.5rem;
    font-size: var(--text-sm);
    font-weight: 700;
    white-space: nowrap;
  }
  /* Just above the 1280px collapse the bar has almost no slack; the ® on
     "Join ΣΓΡ®" pushed it 6px over. Slightly tighter buttons absorb that. */
  @media (max-width: 1360px) {
    .header-actions :global(.header-actions__btn) {
      padding-inline: 1.2rem;
    }
  }
  /* solid = Poodle Portal: gold fill, navy text */
  .header-actions :global(.header-actions__btn:not(.btn--outline)) {
    --btn-fg: var(--navy);
  }
  /* The global solid-button hover is royal, which would vanish into this
     royal bar (and navy on royal is 2:1). Here it goes white instead. */
  .header-actions :global(.header-actions__btn:not(.btn--outline):hover) {
    --btn-bg: #fff;
    --btn-border: #fff;
    --btn-fg: var(--navy);
  }
  /* outline = Join ΣΓΡ: gold text + 2px gold border, transparent */
  .header-actions :global(.btn--outline) {
    /* on the royal bar — see the .is-active note above */
    --btn-fg: #fff;
    border-width: 2px;
    border-color: var(--gold);
  }
  .header-actions :global(.btn--outline:hover) {
    --btn-fg: var(--navy);
  }

  /* Hamburger — hidden above the collapse breakpoint, morphs to an X when
     the drawer is open. */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    /* 44px, not 40: WCAG 2.5.5 (AAA) asks for 44x44, and this is the only
       control on a phone that opens the whole navigation. It already passed
       AA's 24px floor at 40px, so this is polish rather than a fix. */
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    flex-shrink: 0;
  }
  .nav-toggle__bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--white);
    border-radius: 1px;
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .header-search {
    position: relative;
  }
  .search-toggle {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--white);
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .search-toggle:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--gold);
  }
  .search-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    width: min(360px, calc(100vw - 2rem));
    padding: var(--space-3);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 44px rgba(8, 22, 51, 0.22);
  }
  /* little caret pointing back up at the toggle */
  .search-panel::before {
    content: "";
    position: absolute;
    top: -7px;
    right: 12px;
    width: 12px;
    height: 12px;
    background: var(--white);
    border-left: 1px solid var(--line);
    border-top: 1px solid var(--line);
    transform: rotate(45deg);
  }

  .search-field {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-field__icon {
    position: absolute;
    left: 0.75rem;
    color: var(--muted-2);
    pointer-events: none;
  }
  .search-input {
    width: 100%;
    padding: 0.6rem 0.8rem 0.6rem 2.2rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--tint);
    font: inherit;
    font-size: var(--text-sm);
    color: var(--ink);
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .search-input::placeholder {
    color: var(--muted-2);
  }
  .search-input:focus {
    outline: none;
    background: var(--white);
    border-color: var(--gold);
  }
  /* hide the browser's native clear (×) button */
  .search-input::-webkit-search-cancel-button,
  .search-input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }

  .search-results {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-2);
  }
  .search-results:empty {
    display: none;
  }
  /* Result rows are created at runtime by the inline script, so scoped
     selectors can't reach them — pierce the scope with :global(). */
  .search-results :global(a) {
    display: block;
    padding: 0.55rem 0.7rem;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius);
  }
  .search-results :global(a:hover),
  .search-results :global(a:focus) {
    background: var(--tint);
    color: var(--royal);
    outline: none;
  }
  .search-results :global(.search-results__empty) {
    margin: 0;
    padding: 0.55rem 0.7rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  /* Below this width the full nav + search + two buttons no longer fit on one
     row. Rather than wrapping everything onto the header (a wall of chips
     before any page content), it collapses behind a hamburger into a
     full-width accordion drawer — nav links stack vertically, each dropdown
     expands in place instead of floating over its neighbors. */
  @media (max-width: 1279px) {
    .nav-bar__inner {
      flex-wrap: wrap;
      padding-block: var(--space-2);
    }
    .nav-toggle {
      display: inline-flex;
      margin-left: auto;
    }
    .nav-panel {
      display: none;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      gap: var(--space-2);
      padding-block: var(--space-2) var(--space-4);
    }
    .nav-bar.is-menu-open .nav-panel {
      display: flex;
    }

    .site-nav {
      width: 100%;
    }
    .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .site-nav__item {
      position: static;
      border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    }
    .site-nav__item:last-child {
      border-bottom: 0;
    }
    .site-nav__link {
      width: 100%;
      justify-content: space-between;
      padding: 0.9rem 0.25rem;
    }
    .site-nav__chevron {
      display: inline-block;
    }
    .site-nav__item.is-open .site-nav__chevron {
      transform: rotate(-135deg);
    }

    /* Accordion, not a floating panel — expands in normal flow so it pushes
       the next item down instead of overlapping it. */
    .site-nav__menu {
      display: none;
      position: static;
      width: 100%;
