---
/**
 * SiteHeader — brand row + primary nav bar + action buttons + search.
 * Reads primaryNav / headerActions / searchIndex from src/data/nav.js, so the
 * navigation is defined once for the whole site (the old site had this markup
 * duplicated in 24 files).
 *
 * props:
 *   activeTop  label of the current top-level section, e.g. "About" — used to
 *              highlight the matching nav item.
 */
import { primaryNav, headerActions, searchIndex } from "../data/nav.js";
import { withBase } from "../lib/url.js";
import Button from "./Button.astro";

const { activeTop } = Astro.props;
const search = searchIndex().map((p) => ({ t: p.label, u: withBase(p.href) }));
---

<header class="site-header">
  <div class="header-wrap brand-row">
    <a class="brand" href={withBase("/")} aria-label="Sigma Gamma Rho home">
      <img
        class="brand__shield"
        src={withBase("/images/SGR-Logo-Shield.png")}
        alt="Sigma Gamma Rho Sorority Shield"
        width="96"
        height="96"
      />
      <span class="brand__copy">
        <span class="brand__kicker">
          <span class="brand__kicker-rule" aria-hidden="true"></span>
          National Website &bull; Est. 1922
          <span class="brand__kicker-rule" aria-hidden="true"></span>
        </span>
        <span class="brand__title">
          Sigma Gamma Rho Sorority, Incorporated<sup>&reg;</sup>
        </span>
        <span class="brand__rule" aria-hidden="true"></span>
      </span>
    </a>
  </div>

  <div class="nav-bar">
    <div class="header-wrap nav-bar__inner">
      <nav class="site-nav" aria-label="Primary">
        <span class="site-nav__pill" aria-hidden="true"></span>
        <ul class="site-nav__list">
          {primaryNav.map((item) => (
            <li class:list={["site-nav__item", { "is-active": item.label === activeTop }]}>
              {item.children ? (
                <>
                  <button type="button" class="site-nav__link" aria-expanded="false">
                    {item.label}
                  </button>
                  <ul class="site-nav__menu">
                    {item.children.map((c) => (
                      <li>
                        <a href={withBase(c.href)}>{c.label}</a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a class="site-nav__link" href={withBase(item.href)}>
                  {item.label}
                </a>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <div class="header-actions">
        <div class="header-search">
          <button
            type="button"
            class="search-toggle"
            aria-label="Search the site"
            aria-expanded="false"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <circle cx="11" cy="11" r="7" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </button>
          <div class="search-panel" hidden>
            <div class="search-field">
              <svg
                class="search-field__icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <circle cx="11" cy="11" r="7" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
              </svg>
              <input
                type="search"
                class="search-input"
                placeholder="Search the site&hellip;"
                aria-label="Search the site"
              />
            </div>
            <div class="search-results" role="listbox" aria-label="Search results"></div>
          </div>
        </div>
        {headerActions.map((a) => (
          <Button
            href={a.href}
            variant={a.variant === "solid" ? "solid" : "outline"}
            class="header-actions__btn"
          >
            {a.label}
          </Button>
        ))}
      </div>
    </div>
  </div>
</header>

<script is:inline define:vars={{ PAGES: search }}>
  (function () {
    const toggle = document.querySelector(".search-toggle");
    const panel = document.querySelector(".search-panel");
    const input = document.querySelector(".search-input");
    const results = document.querySelector(".search-results");
    if (toggle && panel && input && results) {
      const open = function () {
        panel.hidden = false;
        toggle.setAttribute("aria-expanded", "true");
        input.focus();
      };
      const close = function () {
        panel.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
        input.value = "";
        results.innerHTML = "";
      };
      toggle.addEventListener("click", function (e) {
        e.stopPropagation();
        if (panel.hidden) open();
        else close();
      });
      document.addEventListener("click", function (e) {
        if (!panel.hidden && !panel.contains(e.target) && e.target !== toggle) close();
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") close();
      });
      input.addEventListener("input", function () {
        const q = input.value.trim().toLowerCase();
        results.innerHTML = "";
        if (!q) return;
        const hits = PAGES.filter(function (p) {
          return p.t.toLowerCase().indexOf(q) !== -1;
        }).slice(0, 8);
        if (!hits.length) {
          results.innerHTML = '<p class="search-results__empty">No results found</p>';
          return;
        }
        hits.forEach(function (p) {
          const a = document.createElement("a");
          a.href = p.u;
          a.textContent = p.t;
          a.setAttribute("role", "option");
          results.appendChild(a);
        });
      });
    }

    /* Dropdowns are click-only. The trigger button toggles .is-open; opening
       one closes the others; a click or Escape anywhere else closes them. */
    const navItems = Array.prototype.slice.call(
      document.querySelectorAll(".site-nav__item > .site-nav__link[aria-expanded]")
    );

    function closeAllMenus(except) {
      navItems.forEach(function (b) {
        const it = b.parentElement;
        if (it === except) return;
        it.classList.remove("is-open");
        b.setAttribute("aria-expanded", "false");
      });
    }

    navItems.forEach(function (btn) {
      const item = btn.parentElement;
      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        const openNow = !item.classList.contains("is-open");
        closeAllMenus(item);
        item.classList.toggle("is-open", openNow);
        btn.setAttribute("aria-expanded", String(openNow));
      });
    });

    document.addEventListener("click", function (e) {
      if (!e.target.closest || !e.target.closest(".site-nav__item")) closeAllMenus();
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeAllMenus();
    });

    /* Sliding pill: a floating highlight that glides behind the hovered /
       focused nav link and settles back on the active section on mouse-leave.
       Disabled below 1180px, where the nav wraps to its own stacked rows. */
    const nav = document.querySelector(".site-nav");
    const pill = nav && nav.querySelector(".site-nav__pill");
    const navList = nav && nav.querySelector(".site-nav__list");

    if (nav && pill && navList) {
      const PAD = 14;
      const wide = window.matchMedia("(min-width: 1181px)");
      const links = Array.prototype.slice.call(navList.querySelectorAll(".site-nav__link"));
      const activeLink = navList.querySelector(".site-nav__item.is-active > .site-nav__link");
      let hovered = null;

      function movePill(el) {
        if (!el || !wide.matches) {
          pill.classList.remove("is-visible");
          return;
        }
        const navRect = nav.getBoundingClientRect();
        const r = el.getBoundingClientRect();
        pill.style.width = r.width + PAD * 2 + "px";
        pill.style.transform = "translate(" + (r.left - navRect.left - PAD) + "px, -50%)";
        pill.classList.add("is-visible");
      }
      function settle() {
        movePill(hovered || activeLink);
      }

      links.forEach(function (link) {
        link.addEventListener("mouseenter", function () {
          hovered = link;
          movePill(link);
        });
        link.addEventListener("focus", function () {
          hovered = link;
          movePill(link);
        });
        link.addEventListener("blur", function () {
          hovered = null;
          settle();
        });
      });
      navList.addEventListener("mouseleave", function () {
        hovered = null;
        settle();
      });
      window.addEventListener("resize", settle);
      wide.addEventListener("change", settle);
      requestAnimationFrame(settle);
    }
  })();
</script>

<style>
  /* Brand identity bar — matched to the Figma Make Header.tsx:
     96px shield w/ gold drop-shadow, 24px gap, LEFT-aligned copy block,
     11px/3px-tracked kicker between two 12px gold rules, 32px Montserrat
     wordmark, 16px sup ®, and a 320px gold→transparent gradient underline. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }
  /* Figma Make header spans the full width with ~80px side gutters,
     not the site's 1100px container. */
  .header-wrap {
    width: 100%;
    padding-inline: clamp(1.25rem, 5.5vw, 5rem);
  }
  .brand-row {
    display: flex;
    align-items: center;
    padding-block: 1.25rem;
    border-bottom: 4px solid var(--gold);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    text-decoration: none;
  }
  .brand__shield {
    width: 96px;
    height: 96px;
    object-fit: contain;
    flex-shrink: 0;
    filter: drop-shadow(0 4px 12px rgba(223, 177, 54, 0.25));
  }
  .brand__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .brand__kicker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 4px;
    color: var(--gold);
    font-size: 0.6875rem; /* 11px */
    font-weight: 700;
    letter-spacing: 0.27em; /* ~3px at 11px */
    text-transform: uppercase;
  }
  .brand__kicker-rule {
    width: 12px;
    height: 1px;
    background: var(--gold);
  }
  .brand__title {
    color: var(--royal);
    font-family: var(--font-body);
    font-size: 2rem; /* 32px */
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .brand__title sup {
    font-size: 0.5em; /* 16px */
    vertical-align: super;
    margin-left: 2px;
  }
  .brand__rule {
    width: 20rem; /* 320px */
    max-width: 100%;
    height: 1px;
    margin-top: 6px;
    background: linear-gradient(to right, var(--gold), rgba(223, 177, 54, 0.5), transparent);
  }

  /* Nav bar — matched to Figma Make Header.tsx: navy, 4px gold bottom rule,
     64px row, links centred, 32px gap, 16px Montserrat 600, no dropdown
     arrows, gold hover. */
  .nav-bar {
    background: var(--royal);
    /* top divider comes from .brand-row's gold border */
    border-bottom: 4px solid var(--gold);
  }
  .nav-bar__inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 64px;
  }

  .site-nav {
    flex: 1;
    position: relative;
  }
  /* Sliding pill — a floating highlight that glides behind the hovered link
     and settles on the active section. Positioned by JS (offsetLeft/width of
     the target link, relative to .site-nav). */
  .site-nav__pill {
    position: absolute;
    top: 50%;
    left: 0;
    width: 0;
    height: 2.25rem;
    transform: translate(0, -50%);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    opacity: 0;
    pointer-events: none;
    z-index: 0;
    transition:
      transform 0.32s cubic-bezier(0.34, 1.15, 0.4, 1),
      width 0.32s cubic-bezier(0.34, 1.15, 0.4, 1),
      opacity 0.2s ease;
  }
  .site-nav__pill.is-visible {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav__pill {
      transition: opacity 0.2s ease;
    }
  }
  .site-nav__list {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav__item {
    position: relative;
  }
  .site-nav__link {
    display: flex;
    align-items: center;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: var(--white);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.025em;
    white-space: nowrap;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .site-nav__item.is-active > .site-nav__link,
  .site-nav__item.is-open > .site-nav__link,
  .site-nav__link:hover,
  .site-nav__link:focus-visible {
    color: var(--gold);
  }

  .site-nav__menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    display: none;
    flex-direction: column;
    margin: 0.5rem 0 0;
    padding: var(--space-2) 0;
    list-style: none;
    background: var(--white);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--radius);
    box-shadow: 0 20px 44px rgba(8, 22, 51, 0.16);
    z-index: 50;
  }
  /* click-only — the trigger button toggles .is-open (no hover-open) */
  .site-nav__item.is-open .site-nav__menu {
    display: flex;
  }
  .site-nav__menu a {
    padding: 0.625rem 1.25rem;
    color: #374151;
    font-size: var(--text-sm);
    line-height: 1.45;
    text-decoration: none;
    transition:
      background 0.12s ease,
      color 0.12s ease;
  }
  .site-nav__menu a:hover,
  .site-nav__menu a:focus {
    color: #fff;
    background: var(--royal);
    outline: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-left: auto;
    flex-shrink: 0;
  }
  /* Figma nav CTAs: rounded-md (not pill), 13px, 600, 24/10 padding, no wrap */
  .header-actions :global(.header-actions__btn) {
    border-radius: var(--radius);
    padding: 0.625rem 1.5rem;
    font-size: var(--text-sm);
    font-weight: 700;
    white-space: nowrap;
  }
  /* solid = Poodle Portal: gold fill, navy text */
  .header-actions :global(.header-actions__btn:not(.btn--outline)) {
    --btn-fg: var(--navy);
  }
  /* outline = Join ΣΓΡ: gold text + 2px gold border, transparent */
  .header-actions :global(.btn--outline) {
    --btn-fg: var(--gold);
    border-width: 2px;
    border-color: var(--gold);
  }
  .header-actions :global(.btn--outline:hover) {
    --btn-fg: var(--navy);
  }

  .header-search {
    position: relative;
  }
  .search-toggle {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--white);
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .search-toggle:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--gold);
  }
  .search-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    width: min(360px, calc(100vw - 2rem));
    padding: var(--space-3);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 44px rgba(8, 22, 51, 0.22);
  }
  /* little caret pointing back up at the toggle */
  .search-panel::before {
    content: "";
    position: absolute;
    top: -7px;
    right: 12px;
    width: 12px;
    height: 12px;
    background: var(--white);
    border-left: 1px solid var(--line);
    border-top: 1px solid var(--line);
    transform: rotate(45deg);
  }

  .search-field {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-field__icon {
    position: absolute;
    left: 0.75rem;
    color: var(--muted-2);
    pointer-events: none;
  }
  .search-input {
    width: 100%;
    padding: 0.6rem 0.8rem 0.6rem 2.2rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--tint);
    font: inherit;
    font-size: var(--text-sm);
    color: var(--ink);
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .search-input::placeholder {
    color: var(--muted-2);
  }
  .search-input:focus {
    outline: none;
    background: var(--white);
    border-color: var(--gold);
  }
  /* hide the browser's native clear (×) button */
  .search-input::-webkit-search-cancel-button,
  .search-input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }

  .search-results {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-2);
  }
  .search-results:empty {
    display: none;
  }
  /* Result rows are created at runtime by the inline script, so scoped
     selectors can't reach them — pierce the scope with :global(). */
  .search-results :global(a) {
    display: block;
    padding: 0.55rem 0.7rem;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius);
  }
  .search-results :global(a:hover),
  .search-results :global(a:focus) {
    background: var(--tint);
    color: var(--royal);
    outline: none;
  }
  .search-results :global(.search-results__empty) {
    margin: 0;
    padding: 0.55rem 0.7rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  /* Below this width the full nav + search + two buttons no longer fit on one
     row; drop the nav to its own full-width row and the actions beneath it
     rather than letting "Contact" wrap awkwardly. */
  @media (max-width: 1180px) {
    .nav-bar__inner {
      flex-wrap: wrap;
      padding-block: var(--space-2);
    }
    .site-nav__pill {
      display: none;
    }
    .site-nav__list {
      width: 100%;
      column-gap: 0.4rem;
    }
    .site-nav__menu {
      position: static;
      box-shadow: none;
      padding-left: var(--space-4);
    }
    .header-actions {
      margin-left: 0;
      width: 100%;
      justify-content: flex-start;
    }
  }
</style>
