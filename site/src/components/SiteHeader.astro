---
/**
 * SiteHeader — two decks (Karena's wireframe, 2026-09-17):
 *   Deck 1  brand masthead on Bright White: the Coat of Arms at 100px, the
 *           wordmark, then search and the two utility actions.
 *   Deck 2  royal navigation ribbon, sticky on scroll, five sections.
 *
 * Reads primaryNav / headerActions / searchIndex from src/data/nav.js, so the
 * navigation is defined once for the whole site (the old site had this markup
 * duplicated in 24 files). Below 1280px the ribbon collapses to a drawer.
 *
 * props:
 *   activeTop  label of the current top-level section, e.g. "About" — used
 *              to highlight the matching nav item.
 */
import { primaryNav, headerActions, searchIndex } from "../data/nav.js";
import { reg } from "../lib/reg.js";
import { withBase } from "../lib/url.js";
import Button from "./Button.astro";

const { activeTop } = Astro.props;
const search = searchIndex().map((p) => ({ t: p.label, u: withBase(p.href) }));
const joinAction = headerActions.find((action) => action.label === "Join");
---

<header class="site-header">
  <div class="header-wrap masthead">
    <a class="brand" href={withBase("/")} aria-label="Sigma Gamma Rho home">
      <img
        class="brand__crest"
        src={withBase("/optimized/sgr-crest-256.webp")}
        alt="Sigma Gamma Rho Sorority coat of arms"
        width="100"
        height="100"
      />
      <span class="brand__wordmark">
        <span class="brand__name">Sigma Gamma Rho</span>
        <span class="brand__legal">
          Sorority, Inc.<sup>&reg;</sup>
        </span>
      </span>
    </a>

    <div class="masthead__actions">
      <div class="header-search">
        <button
          type="button"
          class="search-toggle"
          aria-label="Search the site"
          aria-expanded="false"
          aria-controls="site-search-panel"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <span class="search-toggle__label" aria-hidden="true">
            Search
          </span>
        </button>
        <div class="search-panel" id="site-search-panel" hidden>
          <div class="search-panel__header">
            <p class="search-panel__title">Search the site</p>
            <button type="button" class="search-panel__close" aria-label="Close search">
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M5 5l14 14M19 5L5 19" />
              </svg>
            </button>
          </div>
          <div class="search-field">
            <svg
              class="search-field__icon"
              viewBox="0 0 24 24"
              aria-hidden="true"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <circle cx="11" cy="11" r="7" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input
              type="search"
              class="search-input"
              placeholder="Try membership, chapters, programs&hellip;"
              aria-label="Search the site"
            />
          </div>
          <p class="search-results__heading" hidden>
            Matching pages
          </p>
          <div class="search-results" aria-label="Search results" aria-live="polite"></div>
        </div>
      </div>
      {headerActions.map((x) => (
        <Button
          href={x.href}
          variant={x.variant === "solid" ? "solid" : "outline"}
          class="masthead__btn"
          {...(x.external ? { target: "_blank", rel: "noopener" } : {})}
        >
          {/* one inline element: .btn is a flex row with a gap, so a bare
              <sup> would be spaced away from the label */}
          <span set:html={reg(x.label)} />
        </Button>
      ))}
    </div>
  </div>

  {/* Deck 2 — the only part that sticks, so the masthead scrolls away and
      the ribbon keeps the sections reachable. */}
  <div class="nav-bar">
    <div class="header-wrap nav-bar__inner">
      {/* Below 1280px this is the whole ribbon: the sticky bar becomes the
          menu trigger rather than an empty strip. */}
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-panel">
        <span class="nav-toggle__bars" aria-hidden="true">
          <span class="nav-toggle__bar"></span>
          <span class="nav-toggle__bar"></span>
          <span class="nav-toggle__bar"></span>
        </span>
        <span class="nav-toggle__label">Menu</span>
      </button>
      {joinAction && (
        <a class="nav-join" href={withBase(joinAction.href)}>
          Explore Membership <span aria-hidden="true">&rarr;</span>
        </a>
      )}
      <div class="nav-panel" id="nav-panel">
        <nav class="site-nav" aria-label="Primary">
          <ul class="site-nav__list">
            {primaryNav.map((item) => (
              <li class:list={["site-nav__item", { "is-active": item.label === activeTop }]}>
                {item.children ? (
                  <>
                    <button type="button" class="site-nav__link" aria-expanded="false">
                      {item.label}
                      <span class="site-nav__chevron" aria-hidden="true"></span>
                    </button>
                    <ul class="site-nav__menu">
                      {item.children.map((c) => (
                        <li>
                          <a href={withBase(c.href)}>{c.label}</a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <a class="site-nav__link" href={withBase(item.href)}>
                    {item.label}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </nav>
        {/* On phones the masthead buttons are hidden; they live here instead,
            at the foot of the open menu. */}
        <div class="nav-panel__actions">
          {headerActions.map((x) => (
            <Button
              href={x.href}
              variant={x.variant === "solid" ? "solid" : "outline"}
              {...(x.external ? { target: "_blank", rel: "noopener" } : {})}
            >
              <span set:html={reg(x.label)} />
            </Button>
          ))}
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline define:vars={{ PAGES: search }}>
  (function () {
    const toggle = document.querySelector(".search-toggle");
    const panel = document.querySelector(".search-panel");
    const closeButton = document.querySelector(".search-panel__close");
    const input = document.querySelector(".search-input");
    const results = document.querySelector(".search-results");
    const resultsHeading = document.querySelector(".search-results__heading");
    if (toggle && panel && closeButton && input && results && resultsHeading) {
      const open = function () {
        panel.hidden = false;
        toggle.setAttribute("aria-expanded", "true");
        input.focus();
      };
      const close = function () {
        panel.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
        input.value = "";
        results.innerHTML = "";
        resultsHeading.hidden = true;
      };
      toggle.addEventListener("click", function (e) {
        e.stopPropagation();
        if (panel.hidden) open();
        else close();
      });
      closeButton.addEventListener("click", function () {
        close();
        toggle.focus();
      });
      document.addEventListener("click", function (e) {
        if (!panel.hidden && !panel.contains(e.target) && e.target !== toggle) close();
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && !panel.hidden) {
          const restoreFocus = panel.contains(document.activeElement);
          close();
          if (restoreFocus) toggle.focus();
        }
      });
      input.addEventListener("input", function () {
        const q = input.value.trim().toLowerCase();
        results.innerHTML = "";
        resultsHeading.hidden = true;
        if (!q) return;
        const hits = PAGES.filter(function (p) {
          return p.t.toLowerCase().indexOf(q) !== -1;
        }).slice(0, 8);
        if (!hits.length) {
          results.innerHTML =
            '<p class="search-results__empty">No matching pages. Try another search.</p>';
          return;
        }
        resultsHeading.hidden = false;
        hits.forEach(function (p) {
          const a = document.createElement("a");
          a.href = p.u;
          a.textContent = p.t;
          results.appendChild(a);
        });
      });
    }

    /* Dropdowns are click-only. The trigger button toggles .is-open; opening
       one closes the others; a click or Escape anywhere else closes them. */
    const navItems = Array.prototype.slice.call(
      document.querySelectorAll(".site-nav__item > .site-nav__link[aria-expanded]")
    );

    function closeAllMenus(except) {
      navItems.forEach(function (b) {
        const it = b.parentElement;
        if (it === except) return;
        it.classList.remove("is-open");
        b.setAttribute("aria-expanded", "false");
      });
    }

    navItems.forEach(function (btn) {
      const item = btn.parentElement;
      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        const openNow = !item.classList.contains("is-open");
        closeAllMenus(item);
        item.classList.toggle("is-open", openNow);
        btn.setAttribute("aria-expanded", String(openNow));
      });
    });

    document.addEventListener("click", function (e) {
      if (!e.target.closest || !e.target.closest(".site-nav__item")) closeAllMenus();
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeAllMenus();
    });

    /* Hamburger toggle — below 1280px, .nav-panel (nav links + search +
       CTAs) is hidden until this opens it as a full-width drawer. */
    const navBar = document.querySelector(".nav-bar");
    const navToggle = document.querySelector(".nav-toggle");
    if (navBar && navToggle) {
      const setOpen = function (open) {
        navBar.classList.toggle("is-menu-open", open);
        navToggle.setAttribute("aria-expanded", String(open));
        navToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        if (!open) closeAllMenus();
      };
      navToggle.addEventListener("click", function (e) {
        e.stopPropagation();
        setOpen(!navBar.classList.contains("is-menu-open"));
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && navBar.classList.contains("is-menu-open")) {
          setOpen(false);
          navToggle.focus();
        }
      });
      // Resizing/rotating past the collapse breakpoint shouldn't leave the
      // drawer stuck open underneath the now-restored inline nav.
      const desktopQuery = window.matchMedia("(min-width: 1280px)");
      const syncToBreakpoint = function (e) {
        if (e.matches) setOpen(false);
      };
      /** @type {MediaQueryList & { addListener?: (listener: (this: MediaQueryList, ev: MediaQueryListEvent) => void) => void }} */
      const legacyDesktopQuery = desktopQuery;
      if (typeof desktopQuery.addEventListener === "function") {
        desktopQuery.addEventListener("change", syncToBreakpoint);
      } else if (typeof legacyDesktopQuery.addListener === "function") {
        legacyDesktopQuery.addListener.call(desktopQuery, syncToBreakpoint);
      }
    }
  })();
</script>

<style>
  .site-header {
    position: relative;
    z-index: 1000;
    background: var(--bright-white);
  }
  /* Same measure as .container, so the crest, nav and page copy share one
     left edge at every width. */
  .header-wrap {
    width: min(var(--container), calc(100% - (var(--gutter) * 2)));
    margin-inline: auto;
  }

  /* ---------- Deck 1 — brand masthead ---------- */
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 110px;
  }
  .brand {
    display: flex;
    align-items: center;
    min-width: 0;
    text-decoration: none;
  }
  .brand__crest {
    width: 100px;
    height: 100px;
    object-fit: contain;
    flex-shrink: 0;
  }
  /* A 1px gold hairline ties the crest to the stacked name, with 16px of
     clear space either side (APA-style lockup). */
  .brand__wordmark {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    margin-left: 16px;
    padding-left: 16px;
    border-left: 1px solid var(--gold);
  }
  .brand__name {
    font-family: var(--font-head);
    font-weight: 500;
    font-size: clamp(1.25rem, 0.9rem + 1vw, 1.75rem);
    line-height: 1.05;
    letter-spacing: 0.05em;
    color: var(--royal);
    text-transform: uppercase;
  }
  .brand__legal {
    font-family: var(--font-body);
    font-size: 0.6875rem; /* 11px */
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .brand__legal sup {
    font-size: max(0.5em, 8px);
    vertical-align: super;
  }

  .masthead__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }
  .masthead__actions :global(.masthead__btn) {
    padding: 0.6rem 1.4rem;
    font-size: var(--text-sm);
    white-space: nowrap;
  }
  /* Gold fill carries navy text (8.9:1); on hover the global .btn fills
     royal, so the label goes white with it. */
  .masthead__actions :global(.masthead__btn:not(.btn--outline)) {
    --btn-fg: var(--navy);
  }
  .masthead__actions :global(.masthead__btn:not(.btn--outline):hover) {
    --btn-fg: #fff;
  }
  .masthead__actions :global(.btn--outline) {
    --btn-fg: var(--royal);
    border-width: 2px;
  }
  /* Filling with gold on hover puts royal text at 4.44:1, so it goes navy
     (8.9:1) like every other gold-filled button. */
  .masthead__actions :global(.btn--outline:hover) {
    --btn-fg: var(--navy);
  }

  /* ---------- Deck 2 — sticky navigation ribbon ---------- */
  .nav-bar {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--royal);
    border-block: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 10px 24px rgba(8, 22, 51, 0.16);
  }
  .nav-bar__inner {
    display: flex;
    align-items: center;
    min-height: 48px;
  }
  .nav-join {
    display: none;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 44px;
    margin-left: auto;
    padding-inline: var(--space-3);
    border-radius: var(--radius);
    background: var(--gold);
    color: var(--navy);
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
  }
  .nav-join:hover {
    background: var(--white);
    color: var(--royal);
  }
  /* Transparent to layout above the collapse breakpoint. */
  .nav-panel {
    display: contents;
  }
  .site-nav {
    flex: 1;
  }
  .nav-panel__actions {
    display: none;
  }
  .site-nav__list {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 3.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav__item {
    position: relative;
  }
  .site-nav__link {
    display: flex;
    align-items: center;
    padding: 0.35rem 0;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: #fff;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    text-decoration: none;
    transition:
      color 0.3s ease,
      border-color 0.3s ease;
  }
  .site-nav__link:hover,
  .site-nav__link:focus-visible {
    border-bottom-color: var(--gold);
  }
  /* Current section / open dropdown: white text, gold rule. Brand gold as
     text on royal is 4.44:1, so the gold stays in the underline. */
  .site-nav__item.is-active > .site-nav__link,
  .site-nav__item.is-open > .site-nav__link {
    color: #fff;
    border-bottom-color: var(--gold);
  }
  .site-nav__chevron {
    display: none;
    width: 7px;
    height: 7px;
    margin-left: var(--space-3);
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav__link,
    .site-nav__chevron,
    .site-nav__menu,
    .nav-toggle__bar {
      transition: none;
    }
  }

  .site-nav__menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 260px;
    display: flex;
    flex-direction: column;
    margin: 0.5rem 0 0;
    padding: var(--space-2) 0;
    list-style: none;
    background: var(--white);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--radius);
    box-shadow: 0 20px 44px rgba(8, 22, 51, 0.18);
    z-index: 50;
    opacity: 0;
    visibility: hidden;
  }
  .site-nav__item.is-open > .site-nav__menu {
    opacity: 1;
    visibility: visible;
  }
  .site-nav__menu a {
    display: block;
    padding: 0.55rem var(--space-5);
    color: var(--royal);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .site-nav__menu a:hover,
  .site-nav__menu a:focus {
    background: var(--tint);
    color: var(--accent-hover);
  }

  /* ---------- hamburger ---------- */
  .nav-toggle {
    display: none;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    flex-shrink: 0;
  }
  /* 44px of target, per WCAG 2.5.5. */
  .nav-toggle__bars {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
  }
  .nav-toggle__bar {
    display: block;
    width: 22px;
    height: 2px;
    background: #fff;
    border-radius: 1px;
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ---------- search ---------- */
  .header-search {
    position: static;
  }
  .search-toggle {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding-inline: var(--space-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--royal);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background 0.15s ease,
      color 0.15s ease;
  }
  .search-toggle:hover,
  .search-toggle[aria-expanded="true"] {
    border-color: var(--royal);
    background: var(--tint);
  }
  .search-toggle svg {
    flex-shrink: 0;
  }
  .search-panel {
    position: absolute;
    right: max(var(--gutter), calc((100vw - var(--container)) / 2));
    top: 100%;
    width: min(440px, calc(100vw - (var(--gutter) * 2)));
    padding: var(--space-5);
    background: var(--bright-white);
    border: 1px solid var(--line-strong);
    border-top: 3px solid var(--gold);
    border-radius: 0 0 var(--radius) var(--radius);
    box-shadow: var(--shadow-md);
    z-index: 60;
  }
  .search-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .search-panel__title {
    margin: 0;
    color: var(--royal);
    font-family: var(--font-label);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .search-panel__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: calc(var(--space-2) * -1);
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--royal);
    cursor: pointer;
  }
  .search-panel__close:hover {
    background: var(--tint);
  }
  .search-field {
    position: relative;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--white);
  }
  .search-field:focus-within {
    border-color: var(--royal);
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .search-field__icon {
    position: absolute;
    left: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    color: var(--royal);
  }
  .search-input {
    width: 100%;
    min-height: 52px;
    padding: var(--space-3) var(--space-4) var(--space-3) var(--space-10);
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    font: inherit;
    font-size: var(--text-base);
    color: var(--ink);
  }
  .search-input::placeholder {
    color: var(--muted-2);
  }
  .search-input:focus {
    outline: none;
  }
  .search-input::-webkit-search-cancel-button,
  .search-input::-webkit-search-decoration {
    -webkit-appearance: none;
  }
  .search-results__heading {
    margin: var(--space-5) 0 var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .search-results {
    display: grid;
  }
  /* Result rows are created at runtime by the inline script, so scoped
     styles cannot reach them. */
  .search-results :global(a) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 48px;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--line);
    color: var(--royal);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
  }
  .search-results :global(a::after) {
    content: "→";
    flex-shrink: 0;
  }
  .search-results :global(a:hover),
  .search-results :global(a:focus-visible) {
    background: var(--tint);
  }
