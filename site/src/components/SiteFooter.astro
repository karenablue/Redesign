---
/**
 * SiteFooter — brand + social, link columns, contact block, bottom bar.
 * Content comes from src/data/nav.js (footerColumns / footerContact /
 * socialLinks). The column grid uses fr units, not the fixed-px tracks the
 * old footer shipped with.
 */
import { footerColumns, footerContact, footerLegal, socialLinks } from "../data/nav.js";
import { withBase } from "../lib/url.js";
import { socialPaths } from "../lib/social-icons";

const year = new Date().getFullYear();
---

<footer class="site-footer on-dark">
  <div class="container site-footer__top">
    <div class="site-footer__brand">
      <a href={withBase("/")} class="site-footer__logo" aria-label="Sigma Gamma Rho home">
        <img
          src={withBase("/optimized/sgr-crest-256.webp")}
          alt="Sigma Gamma Rho Sorority coat of arms"
          width="128"
          height="128"
        />
        <span class="site-footer__wordmark">
          <span>Sigma Gamma Rho</span>
          <em>
            Sorority, Inc.<sup>&reg;</sup>
          </em>
        </span>
      </a>
      <ul class="site-footer__social">
        {socialLinks.map((s) => (
          <li>
            <a href={s.href} aria-label={s.label}>
              <svg
                viewBox="0 0 32 32"
                aria-hidden="true"
                fill="currentColor"
                width="18"
                height="18"
              >
                <path d={socialPaths[s.label]} fill-rule="evenodd" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>

    {footerColumns.map((col) => (
      <nav class="site-footer__col" aria-label={col.title}>
        <p class="site-footer__col-title">{col.title}</p>
        <ul>
          {col.links.map((l) => (
            <li>
              <a
                href={withBase(l.href)}
                {...(l.external ? { target: "_blank", rel: "noopener" } : {})}
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}

    <div class="site-footer__col site-footer__contact">
      <p class="site-footer__col-title">{footerContact.title}</p>
      <address>
        {footerContact.lines.map((line) => (
          <span>{line}</span>
        ))}
        <a href={`tel:${footerContact.phone}`}>{footerContact.phoneLabel}</a>
        <a href={`mailto:${footerContact.email}`}>{footerContact.email}</a>
      </address>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <span>&copy; {year} Sigma Gamma Rho Sorority, Inc. All rights reserved.</span>
    <span class="site-footer__legal">
      {footerLegal.map((l) => (
        <a href={withBase(l.href)}>{l.label}</a>
      ))}
    </span>
  </div>
  {/* Every page closes on the motto at poster scale (2026-09-27): the
      homepage's display-type signature, carried to all pages. */}
  <div class="container site-footer__motto">
    <p class="site-footer__motto-words">
      <span>Greater Service,</span>
      <span>
        Greater Progress<sup class="reg">&reg;</sup>
      </span>
    </p>
    <p class="site-footer__tagline">Far Over 100 Years</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    color: rgba(255, 255, 255, 0.82);
    background: linear-gradient(135deg, var(--deep-blue) 0%, var(--royal) 100%);
  }
  .site-footer__top {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-10) var(--space-8);
    padding-block: clamp(4rem, 3rem + 4vw, 6rem) var(--space-12);
  }
  /* Brand and contact share the first row; the six nav sections sit under them. */
  .site-footer__top > :first-child {
    grid-column: 1 / 4;
    grid-row: 1;
  }
  .site-footer__contact {
    grid-column: 4 / 7;
    grid-row: 1;
  }
  .site-footer__logo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* FY2027 minimum for the full Coat of Arms is 1 1/3in x 1in, so the
       crest runs at 128px here and nothing crowds it: clear space below is
       a third of its height. */
    gap: var(--space-10);
    text-decoration: none;
    color: var(--white);
  }
  .site-footer__wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .site-footer__wordmark > span {
    font-family: var(--font-label);
    font-size: 1.25rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
  }
  .site-footer__wordmark em {
    font-style: normal;
    font-weight: 400;
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.6);
  }
  .site-footer__social {
    display: flex;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__social a {
    width: 36px;
    height: 36px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    transition: background 0.18s ease;
  }
  .site-footer__social a:hover {
    background: var(--gold);
  }

  .site-footer__col-title {
    margin: 0 0 var(--space-4);
    font-family: var(--font-label);
    color: var(--gold);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  .site-footer__col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__col li {
    margin-bottom: var(--space-3);
  }
  .site-footer__col a {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }
  .site-footer__col a:hover {
    color: var(--gold);
  }
  .site-footer__col address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.85);
  }
  .site-footer__col address span:first-child {
    color: rgba(255, 255, 255, 0.6);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line-dark);
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.6);
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }
  .site-footer__legal a {
    text-decoration: none;
    color: rgba(255, 255, 255, 0.6);
  }
  .site-footer__legal a:hover {
    color: var(--gold);
  }
  /* Gold is allowed on this dark ground; at this size it passes as large
     text on the royal end of the gradient too. Sized to the column (cqi). */
  .site-footer__motto {
    container-type: inline-size;
    padding-block: clamp(2.5rem, 5vw, 4rem) var(--space-8);
  }
  .site-footer__motto-words {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 9.4cqi;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--gold);
  }
  .site-footer__motto-words .reg {
    font-size: 0.3em;
    vertical-align: 1.9em;
  }
  .site-footer__tagline {
    margin: var(--space-5) 0 0;
    color: rgba(255, 255, 255, 0.78);
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: var(--text-md);
  }

  @media (max-width: 1100px) {
    .site-footer__top {
      grid-template-columns: repeat(3, 1fr);
    }
    .site-footer__top > :first-child,
    .site-footer__contact {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }
  @media (max-width: 900px) {
    .site-footer__top {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .site-footer__top {
      grid-template-columns: 1fr;
    }
  }
</style>
