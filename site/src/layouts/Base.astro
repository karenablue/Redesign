---
/**
 * Base — the one <head>, header, and footer for every page. Page files supply
 * only their <main> content via the default slot.
 *
 * props:
 *   title        <title> text (site name is appended)
 *   description   meta description
 *   activeTop     current top-level nav label (see SiteHeader)
 *   image         social share image path (root-absolute), optional
 */
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { withBase } from "../lib/url.js";

const {
  title,
  description = "Sigma Gamma Rho Sorority, Incorporated — Greater Service, Greater Progress.",
  activeTop,
  image = "/images/SGR-Logo-Shield.png",
} = Astro.props;

const fullTitle = title
  ? `${title} | Sigma Gamma Rho Sorority, Inc.`
  : "Sigma Gamma Rho Sorority, Incorporated";
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={withBase(image)} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Design fonts: Montserrat (body). LEMON MILK (headings / eyebrows /
         labels / stat numerals) is self-hosted via @font-face in
         global.css; Oswald is its web fallback. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700&family=Oswald:wght@300;400;500&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader activeTop={activeTop} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <a
      class="donate-float"
      href="https://sgrho1922.org/donate"
      target="_blank"
      rel="noopener"
      aria-label="Donate"
      title="Donate"
    >
      <!-- hand-holding-heart -->
      <svg viewBox="0 0 576 512" aria-hidden="true" fill="currentColor">
        <path d="M275.3 250.5c7 7.4 18.4 7.4 25.4 0l108.9-114.2c31.6-33.2 29.8-88.5-5.6-119.3-30.8-26.8-76.7-22-104.9 7.5l-11.1 11.6-11.1-11.6C238.7 4.9 192.8.1 162 26.9c-35.4 30.8-37.2 86.1-5.6 119.3l119.9 104.3zM528.6 179.5c-14.6-14.6-38.2-14.6-52.8 0L387.4 267.9c-11.5 11.5-27.1 17.9-43.4 17.9H288c-8.8 0-16-7.2-16-16s7.2-16 16-16h55.9c16.3 0 30.1-11.7 32.5-27.9 3-20.5-12.9-38.1-32.9-38.1H176c-27.1 0-53.4 9.4-74.4 26.6L59.4 288H16c-8.8 0-16 7.2-16 16v128c0 8.8 7.2 16 16 16h356.8c14.5 0 28.6-4.9 40-14l91.4-73.2c19.5-15.6 20.9-44.7 3-62.1l-40.1-39.1c19.6-19.6 19.6-51.3 0-70.9l61.5-61.6z"></path>
      </svg>
    </a>

    <style is:global>
      .donate-float {
        width: 64px;
        height: 64px;
        position: fixed;
        right: 28px;
        bottom: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--gold);
        color: #fff;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);
        z-index: 9999;
        cursor: pointer;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          background-color 0.2s ease;
      }
      .donate-float:hover {
        transform: translateY(-3px) scale(1.04);
        box-shadow: 0 14px 30px rgba(0, 0, 0, 0.26);
        background: var(--gold-dark);
      }
      .donate-float:active {
        transform: translateY(-1px) scale(0.98);
      }
      .donate-float:focus-visible {
        outline: 3px solid #fff;
        outline-offset: 3px;
      }
      .donate-float svg {
        width: 26px;
        height: 26px;
      }
      @media (max-width: 768px) {
        .donate-float {
          width: 58px;
          height: 58px;
          right: 18px;
          bottom: 18px;
        }
        .donate-float svg {
          width: 22px;
          height: 22px;
        }
      }

      .skip-link {
        position: absolute;
        left: var(--space-4);
        top: -3rem;
        z-index: 2000;
        padding: 0.6rem 1rem;
        background: var(--royal);
        color: var(--white);
        font-size: var(--text-sm);
        line-height: 1;
        border-radius: 0 0 var(--radius) var(--radius);
        transition: top 0.15s ease;
      }
      .skip-link:focus {
        top: 0;
      }
    </style>
  </body>
</html>
