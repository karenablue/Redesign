---
/**
 * Base — the one <head>, header, and footer for every page. Page files supply
 * only their <main> content via the default slot.
 *
 * props:
 *   title        <title> text (site name is appended)
 *   description   meta description
 *   activeTop     current top-level nav label (see SiteHeader)
 *   image         social share image path (root-absolute), optional
 */
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { withBase } from "../lib/url.js";

const {
  title,
  description = "Sigma Gamma Rho Sorority, Incorporated — Greater Service, Greater Progress.",
  activeTop,
  image = "/images/SGR-Logo-Shield.png",
} = Astro.props;

const fullTitle = title
  ? `${title} | Sigma Gamma Rho Sorority, Inc.`
  : "Sigma Gamma Rho Sorority, Incorporated";
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={withBase(image)} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Design fonts: Montserrat (body). LEMON MILK (headings / eyebrows /
         labels / stat numerals) is self-hosted via @font-face in
         global.css; Oswald is its web fallback. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Oswald:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader activeTop={activeTop} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <a
      class="donate-float"
      href="https://sgrho1922.org/donate"
      target="_blank"
      rel="noopener"
      aria-label="Donate"
      title="Donate"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
        <path d="M12 21s-7.5-4.35-10-9C.5 8.5 2 4.5 6 4.5c2.2 0 3.8 1.3 4.6 2.7.8-1.4 2.4-2.7 4.6-2.7 4 0 5.5 4 3 7.5-2.5 4.65-10 9-10 9Z"></path>
      </svg>
    </a>

    <style is:global>
      .donate-float {
        width: 64px;
        height: 64px;
        position: fixed;
        right: 28px;
        bottom: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--gold);
        color: #fff;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);
        z-index: 9999;
        cursor: pointer;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          background-color 0.2s ease;
      }
      .donate-float:hover {
        transform: translateY(-3px) scale(1.04);
        box-shadow: 0 14px 30px rgba(0, 0, 0, 0.26);
        background: var(--gold-dark);
      }
      .donate-float:active {
        transform: translateY(-1px) scale(0.98);
      }
      .donate-float:focus-visible {
        outline: 3px solid #fff;
        outline-offset: 3px;
      }
      .donate-float svg {
        width: 26px;
        height: 26px;
      }
      @media (max-width: 768px) {
        .donate-float {
          width: 58px;
          height: 58px;
          right: 18px;
          bottom: 18px;
        }
        .donate-float svg {
          width: 22px;
          height: 22px;
        }
      }

      .skip-link {
        position: absolute;
        left: var(--space-4);
        top: -3rem;
        z-index: 2000;
        padding: 0.6rem 1rem;
        background: var(--royal);
        color: var(--white);
        font-size: var(--text-sm);
        line-height: 1;
        border-radius: 0 0 var(--radius) var(--radius);
        transition: top 0.15s ease;
      }
      .skip-link:focus {
        top: 0;
      }
    </style>
  </body>
</html>
