---
/**
 * Base — the one <head>, header, and footer for every page. Page files supply
 * only their <main> content via the default slot.
 *
 * props:
 *   title        <title> text (site name is appended)
 *   description   meta description
 *   activeTop     current top-level nav label (see SiteHeader)
 *   image         social share image path (root-absolute), optional
 */
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { withBase } from "../lib/url.js";

const {
  title,
  description = "Sigma Gamma Rho Sorority, Incorporated — Greater Service, Greater Progress.",
  activeTop,
  image = "/images/SGR-Logo-Shield.png",
} = Astro.props;

const fullTitle = title
  ? `${title} | Sigma Gamma Rho Sorority, Inc.`
  : "Sigma Gamma Rho Sorority, Incorporated";
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={withBase(image)} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Design fonts: Montserrat (body). LEMON MILK (headings / eyebrows /
         labels / stat numerals) is self-hosted via @font-face in
         global.css; Oswald is its web fallback. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700&family=Oswald:wght@300;400;500&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader activeTop={activeTop} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <a
      class="donate-float"
      href="https://sgrho1922.org/donate"
      target="_blank"
      rel="noopener"
      aria-label="Donate"
      title="Donate"
    >
      <!-- hand-holding-heart (Font Awesome 6 free, CC BY 4.0) -->
      <svg viewBox="0 0 576 512" aria-hidden="true" fill="currentColor">
        <path d="M163.9 136.9c-29.4-29.8-29.4-78.2 0-108s77.1-29.8 106.5 0L288 46.7l17.6-17.8c29.4-29.8 77.1-29.8 106.5 0s29.4 78.2 0 108L310.3 240.9c-6.4 6.5-14.9 9.8-23.4 9.7-8.5 .1-17-3.2-23.4-9.7L163.9 136.9zM568.2 336.3c13.1 17.8 9.3 42.8-8.5 55.9L433.1 485.5c-23.4 17.2-51.6 26.5-80.7 26.5L192 512 32 512c-17.7 0-32-14.3-32-32l0-64c0-17.7 14.3-32 32-32l35.6 0 40.8-32.6c16.6-13.3 37.2-20.5 58.5-20.5l71.5 0 42.6 0c17.7 0 32 14.3 32 32s-14.3 32-32 32l-42.6 0-40.5 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l112.5 0 84.6-63.5c17.8-13.4 43.1-9.7 56.4 8.1l7 9.3zM384 384l-.7 0 .7 0z"></path>
      </svg>
    </a>

    <style is:global>
      .donate-float {
        width: 64px;
        height: 64px;
        position: fixed;
        right: 28px;
        bottom: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--gold);
        color: #fff;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);
        z-index: 9999;
        cursor: pointer;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          background-color 0.2s ease;
      }
      .donate-float:hover {
        transform: translateY(-3px) scale(1.04);
        box-shadow: 0 14px 30px rgba(0, 0, 0, 0.26);
        background: var(--gold-dark);
      }
      .donate-float:active {
        transform: translateY(-1px) scale(0.98);
      }
      .donate-float:focus-visible {
        outline: 3px solid #fff;
        outline-offset: 3px;
      }
      .donate-float svg {
        width: 32px;
        height: 32px;
      }
      @media (max-width: 768px) {
        .donate-float {
          width: 58px;
          height: 58px;
          right: 18px;
          bottom: 18px;
        }
        .donate-float svg {
          width: 28px;
          height: 28px;
        }
      }

      .skip-link {
        position: absolute;
        left: var(--space-4);
        top: -3rem;
        z-index: 2000;
        padding: 0.6rem 1rem;
        background: var(--royal);
        color: var(--white);
        font-size: var(--text-sm);
        line-height: 1;
        border-radius: 0 0 var(--radius) var(--radius);
        transition: top 0.15s ease;
      }
      .skip-link:focus {
        top: 0;
      }
    </style>
  </body>
</html>
