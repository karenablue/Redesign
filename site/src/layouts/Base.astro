---
/**
 * Base — the one <head>, header, and footer for every page. Page files supply
 * only their <main> content via the default slot.
 *
 * props:
 *   title        <title> text (site name is appended)
 *   description   meta description
 *   activeTop     current top-level nav label (see SiteHeader)
 *   image         social share image path (root-absolute), optional
 *   noindex       keep the page out of search engines (design concepts)
 *   preloadImage  the page's largest above-the-fold image (root-absolute),
 *                 fetched first at high priority. Pass it only for an image
 *                 the browser cannot discover early, such as a video poster.
 */
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { withBase } from "../lib/url.js";

const {
  title,
  description = "Sigma Gamma Rho Sorority, Incorporated — Greater Service, Greater Progress.",
  activeTop,
  image = "/images/SGR-Logo-Shield.png",
  bodyClass,
  preloadImage,
  noindex = false,
} = Astro.props;

const fullTitle = title
  ? `${title} | Sigma Gamma Rho Sorority, Inc.`
  : "Sigma Gamma Rho Sorority, Incorporated";
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={withBase(image)} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* LEMON MILK is self-hosted and set on every heading. Fetched late, it
        arrives after first paint and re-wraps long titles (a layout shift
        of 0.12 on Affiliates on a slow phone). Preloading the two weights
        headings use lets it land before the first paint. */}
    <link rel="preload" as="font" type="font/woff" href={withBase("/fonts/LemonMilkMedium-mLZYV.woff")} crossorigin />
    <link rel="preload" as="font" type="font/woff" href={withBase("/fonts/LemonMilkRegular-X3XE2.woff")} crossorigin />
    {preloadImage && (
      <link rel="preload" as="image" href={withBase(preloadImage)} fetchpriority="high" />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Design fonts:
         · Montserrat — body / UI / nav / buttons
         · Playfair Display — editorial voice (multi-word headlines, quotes)
         LEMON MILK (display headers / stat numerals) is self-hosted via
         @font-face in global.css; Oswald is its web fallback.
         See AGENTS.md §6 for the three roles. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700&family=Oswald:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&display=swap"
    />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader activeTop={activeTop} />
    {/* tabindex="-1" is what makes the skip link above actually work: a bare
        <main id="main"> is not focusable, so browsers scroll to it but leave
        focus on the link, and the next Tab continues through the header the
        user just tried to skip. -1 keeps it out of the tab order while
        allowing programmatic focus. */}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    {/* Scroll reveals and count-ups; see src/scripts/motion.ts. */}
    <script>
      import "../scripts/motion.ts";
    </script>

    <style is:global>
      .skip-link {
        position: absolute;
        left: var(--space-4);
        top: -3rem;
        z-index: 2000;
        padding: 0.6rem 1rem;
        background: var(--royal);
        color: var(--white);
        font-size: var(--text-sm);
        line-height: 1;
        border-radius: 0 0 var(--radius) var(--radius);
        transition: top 0.15s ease;
      }
      .skip-link:focus {
        top: 0;
      }
      /* #main is focusable only as the skip link's destination. Without this,
         the global `:focus-visible` rule draws a 3px gold outline around the
         entire page body on arrival. The scroll jump is the visible feedback
         here, and #main is not a tab stop, so no indicator is lost. */
      main#main:focus,
      main#main:focus-visible {
        outline: none;
      }
    </style>
  </body>
</html>
