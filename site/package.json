{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/link-images.mjs && node scripts/vendor-maplibre.mjs",
    "dev": "astro dev --open",
    "preview:ci": "node scripts/link-images.mjs && node scripts/vendor-maplibre.mjs && astro build && node scripts/serve-dist.mjs 4322",
    "start": "astro dev --open",
    "prebuild": "node scripts/link-images.mjs && node scripts/vendor-maplibre.mjs",
    "build": "astro build",
    "preview": "astro preview --open",
    "astro": "astro",
    "check": "astro check",
    "test": "npm run build && playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:chapters": "node scripts/sync-chapters.mjs",
    "verify": "npm run check && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "maplibre-gl": "^6.11.2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.12.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.0"
  }
}
