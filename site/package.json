{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/link-images.mjs",
    "dev": "astro dev --open",
    "start": "astro dev --open",
    "prebuild": "node scripts/link-images.mjs",
    "build": "astro build",
    "preview": "astro preview --open",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check && npm run lint && npm run format:check"
  },
  "dependencies": {
    "astro": "^7.2.10"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.12.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.0"
  }
}
