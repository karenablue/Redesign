# build output
dist/
# generated types
.astro/
# local junction to ../images (recreated by scripts/link-images) — see README
public/images
# MapLibre browser build, copied from node_modules by scripts/vendor-maplibre.mjs
public/vendor

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# scratch screenshots
_*.png

# playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Third-party agent skills, vendored by `npx skills add`. Not committed:
# they carry their own licences and are one command to restore —
#   npx skills add emilkowalski/skill
#   npx skills add Leonxlnx/taste-skill
.agents/
# .claude/skills/ is 26 symlinks INTO .agents/. Since .agents/ is ignored,
# committing these would hand anyone cloning a folder of dangling symlinks.
# They are recreated by the same two commands above.
.claude/skills/

# Impeccable's hook cache. config.json IS committed — it records the
# sanctioned rule exceptions (see `impeccable hooks`) — but the cache is
# machine-local derived state.
.impeccable/hook.cache.json
